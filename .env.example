# =========================================================
# Bweb Agence — Modèle de variables d'environnement
# Copier en `.env` et compléter. Renseigner aussi ces variables
# dans Vercel → Project → Settings → Environment Variables.
#
# ⚠ AJOUTER UNE VARIABLE DANS VERCEL NE SUFFIT PAS.
# Vercel fige les variables dans le déploiement au moment du BUILD : une
# variable ajoutée après coup n'existe pas pour le déploiement en cours,
# même si le panneau Settings l'affiche. Il faut relancer un build —
# Deployments → dernier déploiement → ··· → Redeploy — sinon le code
# continue de la voir absente, sans le moindre message d'erreur.
# Vérifier aussi que la case « Production » est cochée, et pas seulement
# Preview et Development.
# =========================================================

PUBLIC_SUPABASE_URL="https://VOTRE-PROJET.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxx"

SUPABASE_SERVICE_ROLE_KEY="service_role_secret"

BIRD_API_KEY="bk_eu1_xxx"
BIRD_FROM="Bweb Agence <no-reply@votre-domaine-verifie.com>"
BIRD_REPLY_TO="info@bwebagence.com"

# --- Paiement formations (Money Fusion) ---
# URL du relais PHP hébergé sur Hostinger (IP fixe whitelistée).
# Les identifiants Money Fusion (MONEYFUSION_API_URL, etc.) vivent dans
# payment-php/config.php sur Hostinger, PAS ici.
PAYMENT_API_URL="https://pay.bwebagence.com"

# --- Tunnel webinaire → ACQ Hub ---
# Les inscriptions de /webinaire-initiation sont relayées par
# /api/webinaire/inscription vers l'Edge Function `ingest` d'ACQ Hub.
# INGEST_URL : URL complète de la fonction (…/functions/v1/ingest).
# La clé est celle du tunnel `webinaire-initiation` : ACQ Hub en stocke le
# hash dans la table `tunnels`, on envoie la valeur en clair dans l'en-tête
# x-tunnel-key. Les DEUX sont nécessaires : s'il en manque une, la route
# répond `not_configured` et le formulaire bascule sur WhatsApp.
INGEST_URL="https://VOTRE-PROJET.supabase.co/functions/v1/ingest"
TUNNEL_KEY_WEBINAIRE_INITIATION="A_COMPLETER_cle_du_tunnel"

# --- Synchro quotidienne des contacts du site → ACQ Hub ---
# Une passe par jour pousse vers `ingest` les contacts nouveaux ou modifiés
# (src/lib/syncHub.ts), pour garder les deux bases au même niveau. C'est
# OPTIONNEL : sans ces variables la synchro ne fait rien et rien n'est cassé —
# le site reste la source de vérité de ce qui est soumis chez lui.
# TUNNEL_KEY_SITE : clé du tunnel dédié. Elle ne s'invente pas — c'est ACQ Hub
# qui la génère (format « tnl_… »), et il n'en stocke que le hash : la valeur en
# clair n'est affichée QU'UNE FOIS, à sa création.
#   ACQ Hub → Tunnels → créer un tunnel de slug `site-bwebagence`
#          → sur sa fiche, générer la clé d'ingestion → copier ici et dans Vercel.
# Aucun repli sur la clé d'un autre tunnel : `ingest` retrouve le tunnel par le
# hash de la clé puis exige que HUB_TUNNEL_SITE corresponde à son slug. Une clé
# empruntée ⇒ `tunnel_mismatch`, et chaque contact finit en file d'erreurs.
TUNNEL_KEY_SITE="A_COMPLETER_tnl_genere_par_acq_hub"
# Doit être EXACTEMENT le slug du tunnel créé dans ACQ Hub.
HUB_TUNNEL_SITE="site-bwebagence"

# Sel de l'empreinte d'IP des soumissions (src/lib/leads.ts). Optionnel : une
# valeur par défaut existe, mais une valeur propre au projet rend l'empreinte
# inexploitable hors de chez nous. Générer une valeur aléatoire.
LEAD_IP_SALT="A_COMPLETER_valeur_aleatoire"

# Secret du cron de réconciliation (/api/reconcile-paiements).
# Vercel l'ajoute automatiquement en en-tête Authorization pour ses crons ;
# un cron externe (Hostinger) l'envoie via ?key=... Générer une valeur aléatoire.
CRON_SECRET="A_COMPLETER_valeur_aleatoire"

# --- Ventes Chariow (webhook « Pulse ») ---
# Les parcours se vendent sur Chariow ; /api/webhooks/chariow reçoit
# l'événement `successful.sale` et l'inscrit dans la timeline du contact.
#
# CHARIOW_PULSE_SECRET n'est NI la clé d'API, NI l'identifiant de boutique :
# c'est le secret de signature propre au Pulse, généré par Chariow (préfixe
# « whsec_ »). Le récupérer dans :
#   Chariow → Automations → Pulses → votre Pulse → Overview → Signing secret
# Le Pulse doit pointer sur https://www.bwebagence.com/api/webhooks/chariow
# — AVEC LE WWW — et être abonné au déclencheur « Successful Sale ».
# ⚠ Le domaine nu redirige en 301 vers www, et un 301 transforme un POST en
# GET : un Pulse configuré sans le www n'envoie jamais sa vente. Le point
# d'entrée répond 405 sur un GET pour rendre l'erreur visible dans l'onglet
# Deliveries, au lieu de la laisser passer pour un succès.
#
# Sans AUCUN de ces secrets, le point d'entrée refuse toute livraison (503) :
# on ne traite jamais un corps dont on ne peut pas prouver l'origine, l'URL
# étant publique. Chariow finira alors par désactiver le Pulse et vous
# préviendra.
#
# DEUX BOUTIQUES, DEUX SECRETS. Depuis le 21/08/2026 les parcours se vendent sur
# la boutique de l'agence, mais celle de Godwin continue d'alimenter le site.
# Les deux Pulses écrivent sur la MÊME URL, chacun avec son propre secret : le
# point d'entrée les essaie tous et il suffit qu'un corresponde. Le jour où
# l'ancienne boutique s'arrête, supprimez simplement sa variable — le code n'a
# pas besoin d'être touché.
CHARIOW_PULSE_SECRET="A_COMPLETER_whsec_du_pulse_boutique_godwinsoola"
CHARIOW_PULSE_SECRET_AGENCE="A_COMPLETER_whsec_du_pulse_boutique_bwebagence"

# ---------- Meta — API Conversions (suivi côté serveur) ----------
# Sans ces deux variables, rien n'est envoyé : le site tourne à l'identique.
# Le jeton se génère dans le Gestionnaire d'événements Meta, sur le pixel :
# Paramètres → API de conversions → Générer un jeton d'accès.
META_PIXEL_ID="4342601752668466"
META_CAPI_TOKEN="A_COMPLETER"

# ---------- Google Analytics 4 (visites, pour l'entonnoir de l'admin) ----------
# Sans ces trois variables, l'écran d'analyse affiche « Google Analytics non
# connecté » et démarre l'entonnoir à l'inscription : rien d'autre ne change.
#
# GA4_PROPERTY_ID est l'identifiant NUMÉRIQUE de la propriété (Admin ->
# Paramètres de la propriété), à ne pas confondre avec le « G-XXXXXXXXXX ».
#
# La clé privée vient du fichier JSON du compte de service. Ses retours à la
# ligne peuvent être collés sous forme de « \n » littéraux : le code les
# rétablit, parce qu'une interface web les aplatit presque toujours.
# Le compte de service doit figurer en LECTEUR dans Admin -> Gestion des accès
# à la propriété : sans ça l'appel répond 403 sans autre explication.
GA4_PROPERTY_ID="A_COMPLETER_identifiant_numerique"
GA_SA_EMAIL="A_COMPLETER@A_COMPLETER.iam.gserviceaccount.com"
GA_SA_PRIVATE_KEY="A_COMPLETER_-----BEGIN PRIVATE KEY-----\n…"
