---
/* =========================================================
   PREUVE SOCIALE — les avis du programme, en trois lignes défilantes
   ---------------------------------------------------------
   POURQUOI PAS LE WIDGET CHARIOW. Il rend une IFRAME servie par
   boutique.godwinsoola.com : son contenu appartient à un autre domaine, donc ni
   la largeur réelle, ni la mise en lignes, ni le sens de défilement ne sont
   pilotables depuis le site. Trois lignes alternées y étaient impossibles.

   LE DÉFILEMENT. Chaque ligne contient ses cartes DEUX FOIS et se translate de
   la moitié de sa largeur : au moment où la copie arrive à la position de
   l'originale, l'animation repart — la boucle est invisible. Les lignes paires
   vont à gauche, les impaires à droite. Trois durées voisines mais distinctes,
   pour que les lignes ne se synchronisent pas : l'œil suivrait un bloc au lieu
   de lire.
   ========================================================= */
/* Avis du programme « Stabiliser 800 000 FCFA/mois » (prd_o1tpb1), relevés sur
   Chariow le 21/08/2026 — 110 avis, 100 % positifs — et figés ici, anonymisés
   à la capture. La page n'attend donc aucun appel réseau, et le bandeau ne peut
   pas se vider si la boutique répond mal. À rafraîchir depuis l'API Chariow
   quand une clé sera configurée. */
import avisChariow from "../data/avis-chariow.json";

interface Props {
  /** Nombre de lignes superposées. */
  lignes?: number;
  titre?: string;
}
const { lignes = 3, titre = "Ce qu'en disent les apprenants" } = Astro.props;

const avis = avisChariow as { auteur: string; texte: string; quand: string }[];

/* Répartition en serpentin : la ligne 1 prend le 1er, le 4e, le 7e… Les avis les
   plus récents se retrouvent en tête de chaque ligne, plutôt que tous concentrés
   sur la première. */
const pistes = Array.from({ length: lignes }, (_, i) => avis.filter((_, j) => j % lignes === i));
const assez = avis.length >= lignes * 2;
---

{assez && (
  <section class="ps" aria-label={titre}>
    <p class="ps-titre">{titre}</p>
    <div class="ps-pistes">
      {pistes.map((piste, i) => (
        <div class="ps-piste" data-sens={i % 2 === 0 ? "gauche" : "droite"}>
          {/* La liste est doublée pour que la boucle ne se voie pas ; la copie
              est masquée aux lecteurs d'écran, qui liraient tout en double. */}
          <div class="ps-ruban" style={`--duree:${96 + i * 18}s`}>
            {[0, 1].map((copie) => (
              <ul class="ps-lot" aria-hidden={copie === 1 ? "true" : undefined}>
                {piste.map((a) => (
                  <li class="ps-item">
                    <span class="ps-pastille" aria-hidden="true">★</span>
                    <p class="ps-avis">«&nbsp;{a.texte}&nbsp;»</p>
                    <b>{a.auteur}</b>
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
)}

<style>
  /* Pleine largeur, quel que soit le conteneur qui l'accueille : la section
     sort de la grille sans provoquer de défilement horizontal (100vw inclut la
     barre de défilement, d'où le calcul sur la largeur réelle du document). */
  .ps {
    width: 100%;
    margin-inline: 0;
    padding: 22px 0 6px;
    overflow: hidden;
  }
  .ps-titre {
    margin: 0 0 12px;
    text-align: center;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-gray-500);
  }
  .ps-pistes { display: flex; flex-direction: column; gap: 10px; }
  .ps-piste { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .ps-ruban { display: flex; width: max-content; animation: ps-defile var(--duree, 30s) linear infinite; }
  .ps-piste[data-sens="droite"] .ps-ruban { animation-direction: reverse; }
  .ps-lot { display: flex; gap: 10px; margin: 0; padding: 0 5px 0 0; list-style: none; }
  /* Rectangle, pas gélule : un texte de plusieurs lignes dans une forme
     arrondie à l'extrême laisse des angles vides et casse l'alignement.
     Fond crème et étoile dorée — la carte de témoignage du site. */
  .ps-item {
    display: grid; grid-template-columns: auto 1fr; gap: 5px 10px;
    align-items: start; width: 340px;
    background: #fffaf0; border: 1px solid #f4e3c1; border-radius: 14px;
    padding: 14px 17px; box-shadow: var(--shadow-sm);
    font-size: 0.83rem; color: var(--c-gray-600);
  }
  .ps-pastille { color: #f0a500; font-size: 0.95rem; line-height: 1.5; grid-row: 1 / span 2; }
  .ps-avis {
    grid-column: 2; margin: 0; font-style: italic; line-height: 1.5; color: var(--c-gray-700);
    /* Quatre lignes au plus : au-delà, la carte devient un pavé que personne ne
       lit pendant qu'elle passe. */
    display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden;
  }
  .ps-item b { grid-column: 2; font-size: 0.78rem; font-weight: 700; color: var(--c-ink); }

  /* Au survol, la ligne s'arrête : de quoi finir une phrase qui accroche. */
  .ps-piste:hover .ps-ruban { animation-play-state: paused; }

  /* -50% : la moitié du ruban, c'est-à-dire exactement la première copie. */
  @keyframes ps-defile {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Le mouvement est décoratif : qui demande moins d'animation garde le
     bandeau, immobile et lisible. */
  @media (prefers-reduced-motion: reduce) {
    .ps-ruban { animation: none; }
    .ps-piste { overflow-x: auto; }
  }

  @media (max-width: 640px) {
    .ps-item { width: 272px; font-size: 0.79rem; padding: 12px 14px; }
  }
</style>
