---
import { mainNav, navCta } from "../config/site";
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(href + "/"));
/* Mode « focus CRO » : aucune sortie de page. Le logo n'est pas cliquable,
   ni navigation, ni CTA, ni menu mobile — utilisé sur les landings de vente. */
const { bare = false } = Astro.props;
---

{bare ? (
  <header class="site-header site-header--bare">
    <div class="container">
      <span class="brand brand--static" aria-label="Bweb Academy"><img src="/images/logo.svg" alt="Bweb Academy" width="171" height="40" /></span>
    </div>
  </header>
) : (
<Fragment>
<header class="site-header">
  <div class="container">
    <a href="/" class="brand" aria-label="Bweb Agence — accueil"><img src="/images/logo.svg" alt="Bweb Agence" width="171" height="40" /></a>
    <nav class="main-nav" aria-label="Navigation principale">
      {mainNav.map((item) => (
        item.children ? (
          <div class="nav-item has-dropdown">
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined} aria-haspopup="true" class={isActive(item.href) ? "is-active" : undefined}>
              {item.label}
              <svg class="nav-item__chevron" viewBox="0 0 12 8" fill="none" aria-hidden="true"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <div class="nav-dropdown">
              <div class="nav-dropdown__inner mega-panel" role="menu">
                <div class="mega-grid">
                  {item.children.slice(0, 6).map((child) => (
                    /* Une catégorie qui a des offres nommées (sousPages) devient
                       une CELLULE : le lien de la catégorie, puis ses offres en
                       dessous. Le lien ne peut pas les contenir — une ancre dans
                       une ancre n'est pas du HTML valide, et le clavier n'y
                       arriverait jamais. Les catégories sans offre restent une
                       simple ancre, exactement comme avant. */
                    child.sousPages?.length ? (
                      <div class="mega-cell">
                        <a href={child.href} role="menuitem" class:list={["mega-item", { "is-active": isActive(child.href) }]}>
                          <span class="mega-item__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={child.icon} />
                          </span>
                          <span class="mega-item__body">
                            <span class="mega-item__title">{child.label}</span>
                            <span class="mega-item__desc">{child.description}</span>
                          </span>
                        </a>
                        <ul class="mega-sub" aria-label={`Offres — ${child.label}`}>
                          {child.sousPages.map((sous) => (
                            <li>
                              <a href={sous.href} role="menuitem" class:list={["mega-sub__link", { "is-active": isActive(sous.href) }]}>
                                <span class="mega-sub__title">{sous.label}</span>
                                {sous.description && <span class="mega-sub__desc">{sous.description}</span>}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ) : (
                      <a href={child.href} role="menuitem" class:list={["mega-item", { "is-active": isActive(child.href) }]}>
                        <span class="mega-item__icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={child.icon} />
                        </span>
                        <span class="mega-item__body">
                          <span class="mega-item__title">{child.label}</span>
                          <span class="mega-item__desc">{child.description}</span>
                        </span>
                      </a>
                    )
                  ))}
                </div>
                {item.children.length > 6 && (
                  <div class="mega-extra">
                    {item.children.slice(6).map((child) => (
                      <a href={child.href} role="menuitem" class:list={["mega-extra__item", { "is-active": isActive(child.href) }]}>
                        <span class="mega-item__icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={child.icon} />
                        </span>
                        <span class="mega-item__title">{child.label}</span>
                        <span class="mega-item__desc">{child.description}</span>
                        {"image" in child && child.image && (
                          <img class="mega-extra__img" src={child.image} alt="" loading="lazy" />
                        )}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </div>
        ) : (
          <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined} class={isActive(item.href) ? "is-active" : undefined}>{item.label}</a>
        )
      ))}
    </nav>
    <div class="nav-cta">
      {navCta.map((cta) => (
        <a href={cta.href} class={`btn ${cta.variant} btn-sm`}>{cta.label}</a>
      ))}
    </div>
    <button class="nav-toggle" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-nav"><span></span></button>
  </div>
</header>

<div class="mobile-nav" id="mobile-nav">
  <button class="mobile-nav__close" type="button" aria-label="Fermer le menu">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
  </button>
  <nav aria-label="Navigation mobile">
    {mainNav.map((item) => (
      item.children ? (
        <div class="mobile-nav-item">
          <div class="mobile-nav-item__row">
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
            <button type="button" class="mobile-nav-item__toggle" aria-expanded="false" aria-label={`Afficher ${item.label}`}>
              <svg class="mobile-nav-item__chevron" viewBox="0 0 12 8" fill="none" aria-hidden="true"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
          <div class="mobile-nav-submenu">
            <div class="mobile-nav-submenu__inner">
              {item.children.map((child) => (
                <Fragment>
                  <a href={child.href} tabindex="-1" class="mega-item" aria-current={isActive(child.href) ? "page" : undefined}>
                    <span class="mega-item__icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={child.icon} />
                    </span>
                    <span class="mega-item__body">
                      <span class="mega-item__title">{child.label}</span>
                      <span class="mega-item__desc">{child.description}</span>
                    </span>
                  </a>
                  {/* Offres de la catégorie, en retrait sous elle. Elles vivent
                      DANS le sous-menu dépliable existant : initMobileNav pose
                      déjà le tabindex de tous ses liens, celles-ci comprises. */}
                  {child.sousPages?.length && (
                    <ul class="mobile-nav-sub" aria-label={`Offres — ${child.label}`}>
                      {child.sousPages.map((sous) => (
                        <li>
                          <a href={sous.href} tabindex="-1" class="mobile-nav-sub__link" aria-current={isActive(sous.href) ? "page" : undefined}>
                            {sous.label}
                            {sous.description && <span>{sous.description}</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </Fragment>
              ))}
            </div>
          </div>
        </div>
      ) : (
        <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
      )
    ))}
  </nav>
  <div class="mobile-nav-cta">
    {navCta.map((cta) => (
      <a href={cta.href} class={`btn ${cta.variant === "btn-primary" ? "btn-primary" : "btn-outline-light"} btn-block`}>{cta.label}</a>
    ))}
  </div>
</div>
</Fragment>
)}
