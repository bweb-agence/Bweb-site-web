---
import { footerNav, contact, site } from "../config/site";
/* Mode « focus CRO » : footer minimal, sans aucun lien de navigation
   (utilisé sur les landings de vente pour ne pas offrir de sortie de page).
   On conserve uniquement la marque, le copyright et la gestion des cookies
   (un bouton, pas un lien — requis pour le consentement). */
const { bare = false } = Astro.props;
const socials = [
  { key: "facebook", label: "Facebook", href: contact.social.facebook },
  { key: "instagram", label: "Instagram", href: contact.social.instagram },
  { key: "linkedin", label: "LinkedIn", href: contact.social.linkedin },
].filter((s) => s.href); // masqué tant que le réseau n'a pas d'URL
---

{bare ? (
  <footer class="site-footer site-footer--bare">
    <div class="container">
      <div class="footer-bottom footer-bottom--bare">
        <img src="/images/logo-white.svg" alt="Bweb Agence" width="120" height="28" />
        <p>&copy; <span data-year>2026</span> {site.name}. Tous droits réservés.</p>
        <button type="button" class="footer-cookies-btn" data-cc="show-preferencesModal">Gérer les cookies</button>
      </div>
    </div>
  </footer>
) : (
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-grid">
        <div class="footer-brand">
          <img src="/images/logo-white.svg" alt="Bweb Agence" width="130" height="30" />
          <p>Cabinet de conseil, de formation et d'accompagnement à l'IA, au service des entreprises et organisations africaines.</p>
          {socials.length > 0 && (
          <div class="footer-social">
            {socials.map((s) => (
              <a href={s.href || "#"} aria-label={s.label} rel={s.href ? "noopener" : undefined} target={s.href ? "_blank" : undefined}>
                {s.key === "facebook" && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 21v-8h2.7l.4-3.3H14V7.6c0-.9.3-1.6 1.7-1.6H17V3.1C16.6 3 15.6 3 14.5 3 12.1 3 10.4 4.5 10.4 7.2v2.5H8V13h2.4v8"/></svg>)}
                {s.key === "instagram" && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r=".8" fill="currentColor" stroke="none"/></svg>)}
                {s.key === "linkedin" && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><line x1="7.5" y1="10" x2="7.5" y2="17"/><circle cx="7.5" cy="6.7" r="1" fill="currentColor" stroke="none"/><path d="M11.5 17v-4.2c0-1.5.9-2.6 2.3-2.6 1.4 0 2.2 1 2.2 2.6V17"/><line x1="11.5" y1="10" x2="11.5" y2="17"/></svg>)}
              </a>
            ))}
          </div>
          )}
        </div>
        <div class="footer-col">
          <h5>Navigation</h5>
          <ul>{footerNav.navigation.map((l) => (<li><a href={l.href}>{l.label}</a></li>))}</ul>
        </div>
        <div class="footer-col">
          <h5>Services</h5>
          <ul>{footerNav.services.map((l) => (<li><a href={l.href}>{l.label}</a></li>))}</ul>
        </div>
        <div class="footer-col">
          <h5>Contact</h5>
          <ul class="footer-contact">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3h3l1.5 4-2 1.5a11 11 0 0 0 5.5 5.5l1.5-2 4 1.5v3c0 1-.8 1.8-1.8 1.7C10.5 17.5 6.5 13.5 4.8 6.8 4.7 5.8 5.5 5 6.5 5z"/></svg><a href={`tel:+${contact.whatsapp.primary}`}>{contact.phoneDisplay}</a></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><polyline points="3 7 12 13 21 7"/></svg><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.1 7-11.5A7 7 0 0 0 5 9.5C5 14.9 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.4"/></svg><span>{contact.address.city}, {contact.address.country}</span></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 16 14"/></svg><span>{contact.address.hours}</span></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; <span data-year>2026</span> {site.name}. Tous droits réservés.</p>
      <div class="footer-legal">
        {footerNav.legal.map((l) => (<a href={l.href}>{l.label}</a>))}
        <button type="button" class="footer-cookies-btn" data-cc="show-preferencesModal">Gérer les cookies</button>
      </div>
    </div>
  </div>
</footer>
)}
