---
/**
 * Champ de formulaire admin : libellé + contrôle (slot) + aide optionnelle.
 * Le contrôle (input/select/textarea) va dans le slot par défaut ; utilisez
 * les classes .a-input / .a-select / .a-textarea.
 *
 * @example
 *   <Field label="Objet" for="subject" hint="Accepte les variables">
 *     <input class="a-input" id="subject" />
 *   </Field>
 */
interface Props {
  label?: string;
  hint?: string;
  for?: string;
  class?: string;
}
const { label, hint, for: forId, class: cls } = Astro.props;
---

<div class:list={["a-field", cls]}>
  {label && <label for={forId}>{label}</label>}
  <slot />
  {hint && <div class="hint">{hint}</div>}
</div>
