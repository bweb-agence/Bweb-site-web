---
/* Champ téléphone international.
   Repli sans JS : un <select name="phone_cc"> avec TOUS les pays (drapeau,
   nom, indicatif). Avec JS (src/scripts/phoneField.ts) il est enrichi en
   combobox RECHERCHABLE (bouton + recherche + liste), façon grandes
   plateformes. L'indicatif est fusionné au numéro par forms.ts. */
import { COUNTRIES } from "../data/countries";
export interface Props { id?: string; required?: boolean }
const { id = "phone", required = true } = Astro.props;
const flag = (iso: string) => iso.toUpperCase().replace(/./g, (c) => String.fromCodePoint(127397 + c.charCodeAt(0)));
const list = [...COUNTRIES].sort((a, b) => a.name.localeCompare(b.name, "fr"));
const DEFAULT = "CI";
---
<div class="phone-field" data-phone-field>
  <select name="phone_cc" class="phone-cc" aria-label="Indicatif pays (choisir le pays)">
    {list.map((c) => (
      <option value={"+" + c.dial} data-iso={c.iso} data-dial={c.dial} data-name={c.name} data-flag={flag(c.iso)} selected={c.iso === DEFAULT}>
        {flag(c.iso)} {c.name} (+{c.dial})
      </option>
    ))}
  </select>
  <input id={id} type="tel" name="phone" inputmode="tel" autocomplete="tel-national" required={required} placeholder="07 00 00 00 00" />
</div>
