---
/* HOME-DIFFERENCE — « Des outils épars -> une solution utile »
   Section CLAIRE (pas un hero) : traits foncés sur fond clair.
   Des chips-outils dispersés font circuler leurs données vers un tableau de
   bord unifié dont la courbe de résultats grimpe. Métaphore : on ne vend pas
   des outils, on construit une solution utile. */
const chips = [
  { x: 74,  y: 118, r: -6, d: "0s",   icon: '<circle cx="0" cy="0" r="4"/><path d="M0 -9v3 M0 6v3 M-9 0h3 M6 0h3 M-6.4 -6.4l2.1 2.1 M4.3 4.3l2.1 2.1 M6.4 -6.4l-2.1 2.1 M-4.3 4.3l-2.1 2.1"/>' }, // outil
  { x: 150, y: 66,  r: 7,  d: ".2s",  icon: '<ellipse cx="0" cy="-6" rx="8" ry="3"/><path d="M-8 -6v12c0 1.7 3.6 3 8 3s8-1.3 8-3v-12"/><path d="M-8 0c0 1.7 3.6 3 8 3s8-1.3 8-3"/>' }, // données
  { x: 60,  y: 208, r: 5,  d: ".4s",  icon: '<line x1="-8" y1="8" x2="-8" y2="-3"/><line x1="0" y1="8" x2="0" y2="-8"/><line x1="8" y1="8" x2="8" y2="1"/><line x1="-11" y1="9.5" x2="11" y2="9.5"/>' }, // analyse
  { x: 92,  y: 300, r: -4, d: ".6s",  icon: '<path d="M-8 -6h16a1.6 1.6 0 0 1 1.6 1.6v6A1.6 1.6 0 0 1 8 3H-1l-4 3V3h-3A1.6 1.6 0 0 1-9.6 1.6v-6A1.6 1.6 0 0 1-8 -6z"/>' }, // message
  { x: 168, y: 334, r: -8, d: ".8s",  icon: '<path d="M-9 -3v4l13 5v-14z"/><path d="M-9 -3h-1a1.5 1.5 0 0 0 0 4h1"/><path d="M4 3.5c2 0 3.2-1.3 3.2-3.2"/>' }, // diffusion
];
const bars = [{ x: 286, h: 30, d: "0s" }, { x: 312, h: 50, d: ".3s" }, { x: 338, h: 40, d: ".6s" }];
---
<div class="illus-diff" aria-hidden="true">
  <svg viewBox="0 0 480 400" role="img">
    <title>Des outils épars réunis en une solution utile</title>

    <!-- flux outils -> solution -->
    {chips.map((c, i) => (
      <g>
        <path class="diff-wire" d={`M${c.x} ${c.y} Q ${(c.x + 250) / 2} ${c.y} 250 ${170 + i * 12}`} />
        <circle class="diff-flow" r="3" style={`offset-path:path('M${c.x} ${c.y} Q ${(c.x + 250) / 2} ${c.y} 250 ${170 + i * 12}');animation-delay:${c.d}`} />
      </g>
    ))}

    <!-- chips outils -->
    {chips.map((c) => (
      <g class="diff-chip" style={`--d:${c.d}`} transform={`translate(${c.x},${c.y}) rotate(${c.r})`}>
        <rect class="diff-chip-bg" x="-23" y="-23" width="46" height="46" rx="12" />
        <g class="diff-chip-ic" set:html={c.icon} />
      </g>
    ))}

    <!-- solution : tableau de bord unifié -->
    <g class="diff-solution">
      <rect class="diff-panel-glow" x="248" y="92" width="204" height="220" rx="20" />
      <rect class="diff-panel" x="252" y="96" width="196" height="212" rx="16" />
      <line class="diff-head" x1="272" y1="124" x2="360" y2="124" />
      <circle class="diff-hdot" cx="428" cy="124" r="4" />
      <line class="diff-axis" x1="276" y1="232" x2="424" y2="232" />
      {bars.map((b) => (
        <rect class="diff-bar" x={b.x} y={232 - b.h} width="16" height={b.h} rx="3" style={`--h:${b.h}px;--d:${b.d}`} />
      ))}
      <polyline class="diff-curve" points="276 210 312 176 350 190 392 150 424 132" />
      <g class="diff-badge" transform="translate(424,276)">
        <circle r="15" /><polyline points="-6 0 -2 4 6 -5" />
      </g>
    </g>
  </svg>
</div>

<style>
  .illus-diff { position: relative; width: 100%; max-width: 480px; margin: 0 auto; aspect-ratio: 480 / 400; }
  .illus-diff svg { width: 100%; height: 100%; display: block; overflow: visible; }

  .diff-wire { fill: none; stroke: #ccd6ee; stroke-width: 1.4; stroke-dasharray: 3 6; }
  .diff-flow { fill: var(--c-blue); filter: drop-shadow(0 0 4px rgba(31,108,237,.5)); animation: diff-flow 3.4s linear infinite; }

  .diff-chip-bg { fill: #fff; stroke: var(--c-border); stroke-width: 1.4; filter: drop-shadow(0 8px 18px rgba(2,11,80,.1)); }
  .diff-chip-ic { fill: none; stroke: var(--c-blue); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .diff-chip { animation: diff-pulse 4.5s ease-in-out infinite; animation-delay: var(--d); transform-box: view-box; }

  .diff-panel-glow { fill: rgba(31,108,237,.08); }
  .diff-panel { fill: #fff; stroke: var(--c-border); stroke-width: 1.4; filter: drop-shadow(0 18px 40px rgba(2,11,80,.14)); }
  .diff-head { stroke: #c7d2ea; stroke-width: 4; stroke-linecap: round; }
  .diff-hdot { fill: #dbe4f5; }
  .diff-axis { stroke: #e2e8f5; stroke-width: 1.4; }
  .diff-bar { fill: var(--c-blue); opacity: .9; transform-box: fill-box; transform-origin: bottom; animation: diff-rise 4.4s ease-in-out infinite; animation-delay: var(--d); }
  .diff-curve { fill: none; stroke: var(--c-green); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 2px 5px rgba(0,200,158,.35)); stroke-dasharray: 260; stroke-dashoffset: 260; animation: diff-draw 4.4s ease-in-out infinite; }
  .diff-badge circle { fill: var(--c-green); }
  .diff-badge polyline { fill: none; stroke: #fff; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .diff-badge { opacity: 0; animation: diff-badge 4.4s ease-in-out infinite; }

  @keyframes diff-flow { 0% { offset-distance: 0%; opacity: 0; } 12% { opacity: 1; } 88% { opacity: 1; } 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes diff-pulse { 0%, 100% { opacity: .82; } 50% { opacity: 1; } }
  @keyframes diff-rise { 0%, 100% { transform: scaleY(.4); } 46%, 74% { transform: scaleY(1); } }
  @keyframes diff-draw { 0% { stroke-dashoffset: 260; } 58%, 100% { stroke-dashoffset: 0; } }
  @keyframes diff-badge { 0%, 62% { opacity: 0; } 76%, 100% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .diff-flow, .diff-chip, .diff-bar, .diff-curve, .diff-badge { animation: none; }
    .diff-curve { stroke-dashoffset: 0; } .diff-badge { opacity: 1; } .diff-flow { display: none; }
  }
</style>
