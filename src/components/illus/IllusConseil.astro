---
/* HERO-CONSEIL — « Feuille de route + diagnostic »
   Une loupe scanne un tableau d'indicateurs, puis un chemin jalonné se
   dessine, valide ses étapes et mène à une flèche ROI. Métaphore :
   diagnostiquer, prioriser, tracer la route — décider vite, investir juste. */
const PATH = "M140 196 C 210 196 220 166 276 158 S 386 138 446 112";
const checks = [
  { x: 186, y: 184, d: "1.4" },
  { x: 292, y: 152, d: "2.2" },
  { x: 404, y: 126, d: "3.0" },
];
---
<div class="hero-illus" data-parallax style="--hi-accent:#1F6CED;--hi-accent2:#8B7CF6" aria-hidden="true">
  <span class="hi-glow"></span>
  <svg class="hi-scene cons" viewBox="0 0 520 420" role="img">
    <title>Un diagnostic qui débouche sur une feuille de route priorisée</title>

    <!-- panneau diagnostic + indicateurs -->
    <g class="cons-diag">
      <rect class="cons-panel" x="56" y="118" width="86" height="76" rx="12" />
      <rect class="cons-bar" x="72"  y="176" width="12" height="30" style="--h:30px;--d:0s" />
      <rect class="cons-bar" x="93"  y="176" width="12" height="46" style="--h:46px;--d:.3s" />
      <rect class="cons-bar" x="114" y="176" width="12" height="36" style="--h:36px;--d:.6s" />
      <!-- loupe qui scanne -->
      <g class="cons-lens">
        <circle cx="0" cy="0" r="13" />
        <line x1="9" y1="9" x2="17" y2="17" />
      </g>
    </g>

    <!-- chemin qui se dessine -->
    <path class="cons-path-ghost" d={PATH} />
    <path class="cons-path" d={PATH} />
    <circle class="cons-dot" r="4" style={`offset-path:path('${PATH}')`} />

    <!-- jalons validés -->
    {checks.map((c) => (
      <g transform={`translate(${c.x},${c.y})`}>
        <g class="cons-check" style={`--d:${c.d}`}>
          <circle class="cons-check-ring" r="9" />
          <polyline class="cons-check-mark" points="-4 0 -1 3 4 -4" />
        </g>
      </g>
    ))}

    <!-- résultat : flèche ROI -->
    <g class="cons-roi" transform="translate(446,112)">
      <circle class="cons-roi-aura" r="30" />
      <polyline class="cons-roi-trend" points="-16 12 -5 0 2 6 15 -12" />
      <polyline class="cons-roi-head" points="7 -12 15 -12 15 -4" />
      <text class="cons-roi-lbl" x="0" y="30">ROI</text>
    </g>
  </svg>
</div>

<style>
  .cons-panel { fill: rgba(255,255,255,.05); stroke: rgba(255,255,255,.16); stroke-width: 1.2; }
  .cons-bar { fill: var(--hi-accent); opacity: .85; transform-box: fill-box; transform-origin: bottom; animation: cons-rise 4.6s ease-in-out infinite; animation-delay: var(--d); }
  .cons-lens { fill: none; stroke: #fff; stroke-width: 2; stroke-linecap: round; transform-box: view-box; animation: cons-scan 4.6s ease-in-out infinite; }

  .cons-path-ghost { fill: none; stroke: rgba(255,255,255,.1); stroke-width: 2.4; }
  .cons-path { fill: none; stroke: var(--hi-accent); stroke-width: 2.6; stroke-linecap: round; filter: drop-shadow(0 0 5px color-mix(in srgb, var(--hi-accent) 70%, transparent)); stroke-dasharray: 460; stroke-dashoffset: 460; animation: cons-draw 4.6s ease-in-out infinite; }
  .cons-dot { fill: #fff; filter: drop-shadow(0 0 5px var(--hi-accent)); animation: cons-travel 4.6s ease-in-out infinite; }

  .cons-check-ring { fill: color-mix(in srgb, var(--hi-accent) 22%, transparent); stroke: var(--hi-accent); stroke-width: 1.6; }
  .cons-check-mark { fill: none; stroke: #fff; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .cons-check { opacity: 0; transform-box: fill-box; transform-origin: center; animation: cons-pop 4.6s ease-in-out infinite; animation-delay: var(--d); }

  .cons-roi-aura { fill: var(--hi-accent2); opacity: .22; filter: blur(8px); transform-box: fill-box; transform-origin: center; animation: cons-glow 4.6s ease-in-out infinite; }
  .cons-roi-trend, .cons-roi-head { fill: none; stroke: var(--hi-accent2); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .cons-roi-lbl { font-family: var(--f-display); font-weight: 800; font-size: 12px; fill: #fff; text-anchor: middle; letter-spacing: .1em; }

  @keyframes cons-rise { 0%, 100% { transform: scaleY(.35); } 40%, 70% { transform: scaleY(1); } }
  @keyframes cons-scan { 0%, 100% { transform: translate(74px,150px); } 50% { transform: translate(126px,150px); } }
  @keyframes cons-draw { 0% { stroke-dashoffset: 460; } 55%, 100% { stroke-dashoffset: 0; } }
  @keyframes cons-travel { 0% { offset-distance: 0%; opacity: 0; } 8% { opacity: 1; } 55% { offset-distance: 100%; opacity: 1; } 62%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes cons-pop { 0%, 100% { opacity: 0; transform: scale(.4); } 70%, 92% { opacity: 1; transform: scale(1); } }
  @keyframes cons-glow { 0%, 60% { opacity: .1; } 85% { opacity: .35; } 100% { opacity: .1; } }
  @media (prefers-reduced-motion: reduce) {
    .cons-bar, .cons-lens, .cons-path, .cons-dot, .cons-check, .cons-roi-aura { animation: none; }
    .cons-path { stroke-dashoffset: 0; } .cons-check { opacity: 1; } .cons-dot { display: none; }
  }
</style>
