---
/* HERO-FORMATIONS (catalogue) — « Bibliothèque de compétences »
   Un éventail de cartes-modules (thématiques variées) qui se met en avant
   l'une après l'autre, + deux modes : présentiel et en ligne.
   Distinct du hero 'service formation' (cerveau). Remplit le cadre. */
const cards = [
  { a: -40, d: "0s",   icon: '<path d="M0 -10c1 4.4 2.5 6 7 7-4.5 1-6 2.6-7 7-1-4.4-2.5-6-7-7 4.5-1 6-2.6 7-7z"/>' },                         // IA
  { a: -20, d: "1.2s", icon: '<path d="M-9 -3v4l13 5v-14z"/><path d="M-9 -3h-1a1.5 1.5 0 0 0 0 4h1"/><path d="M4 3.5c2 0 3.2-1.3 3.2-3.2"/>' }, // marketing
  { a: 0,   d: "2.4s", icon: '<line x1="-8" y1="8" x2="-8" y2="-3"/><line x1="0" y1="8" x2="0" y2="-8"/><line x1="8" y1="8" x2="8" y2="1"/><line x1="-11" y1="9.5" x2="11" y2="9.5"/>' }, // data
  { a: 20,  d: "3.6s", icon: '<polyline points="-3 -7 -9 0 -3 7"/><polyline points="3 -7 9 0 3 7"/>' },                                       // web
  { a: 40,  d: "4.8s", icon: '<circle cx="0" cy="0" r="8"/><circle cx="0" cy="0" r="3.2"/>' },                                                // vente/cible
];
---
<div class="hero-illus" data-parallax style="--hi-accent:#00C89E;--hi-accent2:#1F6CED" aria-hidden="true">
  <span class="hi-glow"></span>
  <svg class="hi-scene cat" viewBox="0 0 520 420" role="img">
    <title>Un catalogue de formations, en présentiel et en ligne</title>
    <defs>
      <linearGradient id="cat-grad" x1="0" y1="0" x2="1" y2="1">
        <stop class="cat-a" offset="0%" /><stop class="cat-b" offset="100%" />
      </linearGradient>
    </defs>

    <!-- éventail de cartes -->
    {cards.map((c) => (
      <g transform={`translate(260,405) rotate(${c.a})`}>
        <g transform="translate(0,-200)">
          <g class="cat-pop" style={`--d:${c.d}`}>
            <rect class="cat-card" x="-38" y="-58" width="76" height="116" rx="12" />
            <circle class="cat-icbg" cx="0" cy="-26" r="17" />
            <g class="cat-ic" transform="translate(0,-26)" set:html={c.icon} />
            <rect class="cat-line" x="-24" y="8" width="48" height="7" rx="3.5" />
            <rect class="cat-line" x="-24" y="24" width="32" height="7" rx="3.5" />
          </g>
        </g>
      </g>
    ))}

    <!-- modes -->
    <g class="cat-mode" transform="translate(178,382)">
      <rect class="cat-pill" x="-62" y="-16" width="124" height="32" rx="16" />
      <g class="cat-mode-ic" transform="translate(-40,0)">
        <circle cx="-4" cy="-3" r="3" /><circle cx="5" cy="-2" r="2.6" /><path d="M-11 6c0-3.6 3-5.6 6.4-5.6s6.4 2 6.4 5.6" />
      </g>
      <text class="cat-mode-lbl" x="-20" y="4">Présentiel</text>
    </g>
    <g class="cat-mode" transform="translate(350,382)">
      <rect class="cat-pill" x="-58" y="-16" width="116" height="32" rx="16" />
      <g class="cat-mode-ic" transform="translate(-38,0)">
        <rect x="-9" y="-7" width="18" height="13" rx="2" /><polygon points="-2 -2 4 0 -2 2" />
      </g>
      <text class="cat-mode-lbl" x="-16" y="4">En ligne</text>
    </g>
  </svg>
</div>

<style>
  .cat-a { stop-color: var(--hi-accent); } .cat-b { stop-color: var(--hi-accent2); }
  .cat-card { fill: rgba(255,255,255,.055); stroke: rgba(255,255,255,.2); stroke-width: 1.3; animation: cat-hi 6s ease-in-out infinite; animation-delay: var(--d); }
  .cat-icbg { fill: rgba(255,255,255,.06); stroke: rgba(255,255,255,.2); stroke-width: 1; }
  .cat-ic { fill: none; stroke: #fff; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; opacity: .92; }
  .cat-line { fill: rgba(255,255,255,.16); }
  .cat-pop { transform-box: fill-box; transform-origin: center; animation: cat-pop 6s ease-in-out infinite; animation-delay: var(--d); }

  .cat-pill { fill: rgba(255,255,255,.05); stroke: rgba(255,255,255,.2); stroke-width: 1.2; }
  .cat-mode-ic { fill: none; stroke: var(--hi-accent); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .cat-mode-lbl { font-family: var(--f-display); font-weight: 600; font-size: 13px; fill: rgba(255,255,255,.92); dominant-baseline: middle; }
  .cat-mode { animation: cat-mode 5s ease-in-out infinite; }
  .cat-mode:last-of-type { animation-delay: 2.5s; }

  @keyframes cat-pop { 0%, 100% { transform: scale(.94); } 12%, 20% { transform: scale(1.06); } }
  @keyframes cat-hi { 0%, 100% { stroke: rgba(255,255,255,.16); } 12%, 20% { stroke: var(--hi-accent); } }
  @keyframes cat-mode { 0%, 100% { opacity: .82; } 50% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .cat-card, .cat-pop, .cat-mode { animation: none; }
  }
</style>
