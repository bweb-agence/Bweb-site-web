---
/* HERO-REALISATIONS — « Un portfolio qui prouve l'impact »
   Un mur de mini-écrans projets (dashboard, courbe, e-commerce, chat,
   satisfaction, croissance) qui s'allument en cascade, avec des métriques
   animées. Remplit le cadre. */
const cards = [
  { x: 150, y: 150, t: "dash",  d: "0s"   },
  { x: 284, y: 138, t: "chart", d: ".4s"  },
  { x: 412, y: 158, t: "grid",  d: ".8s"  },
  { x: 156, y: 272, t: "chat",  d: "1.2s" },
  { x: 290, y: 278, t: "ring",  d: "1.6s" },
  { x: 414, y: 266, t: "arrow", d: "2s"   },
];
---
<div class="hero-illus" data-parallax style="--hi-accent:#1F6CED;--hi-accent2:#E0A400" aria-hidden="true">
  <span class="hi-glow"></span>
  <svg class="hi-scene rea" viewBox="0 0 520 420" role="img">
    <title>Un mur de projets qui prouvent leur impact</title>
    <defs>
      <linearGradient id="rea-grad" x1="0" y1="0" x2="1" y2="1">
        <stop class="rea-a" offset="0%" /><stop class="rea-b" offset="100%" />
      </linearGradient>
    </defs>

    {cards.map((c) => (
      <g class="rea-card" style={`--d:${c.d}`} transform={`translate(${c.x},${c.y})`}>
        <rect class="rea-frame" x="-58" y="-42" width="116" height="84" rx="11" />
        <line class="rea-top" x1="-46" y1="-30" x2="46" y2="-30" />
        <circle class="rea-tdot" cx="-46" cy="-30" r="1.8" />

        {c.t === "dash" && (
          <g>
            <line class="rea-axis" x1="-40" y1="24" x2="40" y2="24" />
            <rect class="rea-bar" x="-34" y="0" width="12" height="24" style="--h:24px;--bd:0s" />
            <rect class="rea-bar" x="-12" y="0" width="12" height="24" style="--h:24px;--bd:.3s" />
            <rect class="rea-bar" x="10" y="0" width="12" height="24" style="--h:24px;--bd:.6s" />
            <rect class="rea-bar rea-bar--hi" x="32" y="0" width="12" height="24" style="--h:24px;--bd:.9s" />
          </g>
        )}
        {c.t === "chart" && (
          <polyline class="rea-line" points="-42 18 -20 2 2 10 24 -12 44 -20" />
        )}
        {c.t === "grid" && (
          <g class="rea-grid">
            <rect x="-40" y="-14" width="24" height="18" rx="3" /><rect x="-8" y="-14" width="24" height="18" rx="3" /><rect x="24" y="-14" width="20" height="18" rx="3" />
            <rect x="-40" y="10" width="24" height="14" rx="3" /><rect x="-8" y="10" width="24" height="14" rx="3" /><rect x="24" y="10" width="20" height="14" rx="3" />
          </g>
        )}
        {c.t === "chat" && (
          <g class="rea-chat">
            <path d="M-42 -8 h34 a4 4 0 0 1 4 4 v8 a4 4 0 0 1 -4 4 h-24 l-8 6 v-6 a4 4 0 0 1 -6 -4 v-8 a4 4 0 0 1 4 -4 z" />
            <rect class="rea-chat2" x="6" y="8" width="38" height="16" rx="6" />
          </g>
        )}
        {c.t === "ring" && (
          <g>
            <circle class="rea-ring-bg" cx="0" cy="2" r="20" />
            <circle class="rea-ring" cx="0" cy="2" r="20" />
            <polyline class="rea-ring-chk" points="-7 2 -2 7 8 -5" />
          </g>
        )}
        {c.t === "arrow" && (
          <g class="rea-arrow">
            <line x1="-42" y1="22" x2="44" y2="22" />
            <polyline class="rea-arrow-l" points="-38 14 -14 -4 6 6 40 -20" />
            <polyline points="30 -20 40 -20 40 -10" />
          </g>
        )}
      </g>
    ))}
  </svg>
</div>

<style>
  .rea-a { stop-color: var(--hi-accent); } .rea-b { stop-color: var(--hi-accent2); }
  .rea-card { opacity: .4; animation: rea-appear 6s ease-in-out infinite; animation-delay: var(--d); }
  .rea-frame { fill: rgba(255,255,255,.05); stroke: rgba(255,255,255,.18); stroke-width: 1.3; }
  .rea-card { --gd: var(--d); }
  .rea-frame { animation: rea-glow 6s ease-in-out infinite; animation-delay: var(--d); }
  .rea-top { stroke: rgba(255,255,255,.2); stroke-width: 1.2; }
  .rea-tdot { fill: rgba(255,255,255,.4); }

  .rea-axis { stroke: rgba(255,255,255,.2); stroke-width: 1.1; }
  .rea-bar { fill: var(--hi-accent); opacity: .85; transform-box: fill-box; transform-origin: bottom; animation: rea-rise 4.5s ease-in-out infinite; animation-delay: var(--bd); }
  .rea-bar--hi { fill: url(#rea-grad); }
  .rea-line, .rea-arrow-l { fill: none; stroke: var(--hi-accent2); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 0 4px color-mix(in srgb, var(--hi-accent2) 55%, transparent)); stroke-dasharray: 130; stroke-dashoffset: 130; animation: rea-draw 4.5s ease-in-out infinite; }
  .rea-grid rect { fill: rgba(255,255,255,.08); stroke: rgba(255,255,255,.16); stroke-width: 1; }
  .rea-chat path, .rea-chat2 { fill: rgba(255,255,255,.08); stroke: rgba(255,255,255,.22); stroke-width: 1.2; }
  .rea-chat2 { fill: color-mix(in srgb, var(--hi-accent) 24%, transparent); }
  .rea-ring-bg { fill: none; stroke: rgba(255,255,255,.16); stroke-width: 4; }
  .rea-ring { fill: none; stroke: url(#rea-grad); stroke-width: 4; stroke-linecap: round; transform: rotate(-90deg); transform-box: fill-box; transform-origin: center; stroke-dasharray: 126; stroke-dashoffset: 126; animation: rea-fill 4.5s ease-in-out infinite; }
  .rea-ring-chk { fill: none; stroke: #fff; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; opacity: 0; animation: rea-chk 4.5s ease-in-out infinite; }
  .rea-arrow line, .rea-arrow polyline:last-child { stroke: rgba(255,255,255,.3); stroke-width: 1.6; fill: none; stroke-linecap: round; stroke-linejoin: round; }

  @keyframes rea-appear { 0%, 100% { opacity: .45; } 30%, 70% { opacity: 1; } }
  @keyframes rea-glow { 0%, 100% { stroke: rgba(255,255,255,.16); } 40% { stroke: color-mix(in srgb, var(--hi-accent) 60%, white); } }
  @keyframes rea-rise { 0%, 100% { transform: scaleY(.35); } 45%, 72% { transform: scaleY(1); } }
  @keyframes rea-draw { 0% { stroke-dashoffset: 130; } 55%, 100% { stroke-dashoffset: 0; } }
  @keyframes rea-fill { 0% { stroke-dashoffset: 126; } 55%, 100% { stroke-dashoffset: 34; } }
  @keyframes rea-chk { 0%, 55% { opacity: 0; } 70%, 100% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .rea-card, .rea-frame, .rea-bar, .rea-line, .rea-arrow-l, .rea-ring, .rea-ring-chk { animation: none; }
    .rea-card { opacity: 1; } .rea-line, .rea-arrow-l { stroke-dashoffset: 0; } .rea-ring { stroke-dashoffset: 34; } .rea-ring-chk { opacity: 1; }
  }
</style>
