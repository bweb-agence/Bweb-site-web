    .methodo-v2 .split-block { grid-template-columns: 1fr 1fr; gap: 0px; align-items: center; }
  }
  /* Sous-titre contraint pour un rendu sur 3 lignes, indépendamment de la largeur de colonne. */
  .methodo-v2 .lead { max-width: 480px; }

  .methodo-carousel { position: relative; }
  .methodo-blur {
    position: absolute; top: -30px; right: -30px; width: 260px; height: 260px; border-radius: 50%;
    background: radial-gradient(circle, rgba(31, 108, 237, .16), rgba(31, 108, 237, 0) 70%);
    pointer-events: none; z-index: 0;
  }
  .methodo-pages { position: relative; min-height: 400px; }
  /* Glissement horizontal (pas un simple fondu) : donne la sensation d'avancer
     le long du parcours plutôt qu'un changement instantané. */
  .methodo-page { position: absolute; inset: 0; transition: opacity .7s var(--ease), transform .7s var(--ease); }
  .methodo-page.is-right { opacity: 0; transform: translateX(48px); }
  .methodo-page.is-left { opacity: 0; transform: translateX(-48px); }
  .methodo-page[hidden] { display: none; }

  .methodo-zigzag { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; overflow: visible; }
  .methodo-zigzag path { fill: none; stroke: var(--c-orange); stroke-width: 3.5; stroke-dasharray: 6 8; stroke-linecap: round; }

  .methodo-slot { position: absolute; transform: translate(-50%, -50%); z-index: 2; }
  .methodo-slot--start { left: 15%; top: 82%; }
  .methodo-slot--high { left: 50%; top: 15%; }
  .methodo-slot--end { left: 85%; top: 82%; }
  .methodo-slot--empty { display: none; }

  .methodo-dot {
    display: block; width: 14px; height: 14px; border-radius: 50%; background: #fff;
    border: 3px solid var(--c-blue); box-shadow: 0 0 0 6px rgba(31, 108, 237, .14); position: relative; z-index: 2;
  }
  .methodo-dot--final { background: var(--c-blue); box-shadow: 0 0 0 8px rgba(31, 108, 237, .2); }

