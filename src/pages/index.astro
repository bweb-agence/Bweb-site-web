---
import BaseLayout from "../layouts/BaseLayout.astro";
import CosmicHero from "../components/CosmicHero.astro";
import EcosystemViz from "../components/EcosystemViz.astro";
---

<BaseLayout title="Bweb — Conseil, formation & accompagnement en IA et nouvelles technologies" description="Cabinet de conseil et de formation, Bweb aide dirigeants et équipes en Afrique à comprendre, maîtriser et exploiter l'intelligence artificielle et les outils numériques.">
<!-- ============ HERO ============ -->
<section class="hero hero--cosmic" data-nav-section="Accueil">
  <CosmicHero />
  <div class="hero-veil" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-content text-white">
      <div class="eyebrow-pill" data-hero-in><b>Nouveau</b> Diagnostic IA offert
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>
      </div>
      <h1 data-hero-in>Prenez une longueur d'avance grâce à l'IA.</h1>
      <p class="lead" data-hero-in>Cabinet de conseil et de formation, Bweb aide les dirigeants et les équipes — en Côte d'Ivoire et en Afrique — à décider et à agir avec un temps d'avance sur l'intelligence artificielle et les outils numériques.</p>
      <div class="hero-actions" data-hero-in>
        <a href="/devis" class="btn btn-primary">
          Réserver un diagnostic
          <svg class="icon-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>
        </a>
        <a href="/formations" class="btn btn-outline-light">Découvrir nos formations</a>
      </div>
    </div>

    <!-- Preuves chiffrées (uniquement les chiffres) -->
    <div class="hero-stats reveal" data-delay=".15">
      <div class="hstat"><div class="n">15 000<span class="suffix">+</span></div><div class="l">Personnes formées &amp; accompagnées</div></div>
      <div class="hstat"><div class="n">97<span class="suffix">%</span></div><div class="l">de satisfaction</div></div>
      <div class="hstat"><div class="n">6-7</div><div class="l">experts dédiés</div></div>
      <div class="hstat"><div class="n">CI &amp; Afrique</div><div class="l">zone d'intervention</div></div>
    </div>
  </div>
</section>

<div class="ticker-band">
  <div class="marquee-track">
    <span class="ticker-item"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 6.4L20 10l-6.2 1.6L12 18l-1.8-6.4L4 10l6.2-1.6z"/></svg>Stratégie IA</span>
    <span class="ticker-item"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 6.4L20 10l-6.2 1.6L12 18l-1.8-6.4L4 10l6.2-1.6z"/></svg>Diagnostic digital</span>
    <span class="ticker-item"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 6.4L20 10l-6.2 1.6L12 18l-1.8-6.4L4 10l6.2-1.6z"/></svg>Formation IA</span>
    <span class="ticker-item"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 6.4L20 10l-6.2 1.6L12 18l-1.8-6.4L4 10l6.2-1.6z"/></svg>Automatisation</span>
    <span class="ticker-item"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 6.4L20 10l-6.2 1.6L12 18l-1.8-6.4L4 10l6.2-1.6z"/></svg>Décision &amp; data</span>
    <span class="ticker-item"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 6.4L20 10l-6.2 1.6L12 18l-1.8-6.4L4 10l6.2-1.6z"/></svg>Accompagnement</span>
  </div>
</div>

<!-- ============ PRESENTATION RAPIDE ============ -->
<section class="section" data-nav-section="Présentation">
  <div class="container">
    <div class="split-block">
      <div class="reveal">
        <div class="eyebrow">Qui sommes-nous</div>
        <h2>Le partenaire IA des entreprises qui veulent avancer plus vite.</h2>
        <p class="lead text-reveal" style="margin:20px 0 28px">Bweb accompagne les entreprises — PME, groupes et organisations — à faire de l'IA et du numérique un avantage concret : des décisions plus rapides, des équipes plus autonomes et des opérations plus efficaces.</p>
        <ul class="tick-list" style="margin-bottom:32px">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 13 10 18 19 7"/></svg>Des gains de productivité mesurables</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 13 10 18 19 7"/></svg>Des équipes formées et autonomes sur l'IA</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 13 10 18 19 7"/></svg>Des décisions appuyées par vos données</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 13 10 18 19 7"/></svg>Une intégration sans casser vos process</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 13 10 18 19 7"/></svg>Un accompagnement orienté ROI et résultats</li>
        </ul>
        <a href="/a-propos" class="btn btn-outline">Découvrir Bweb Agence
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>
        </a>
      </div>
      <div class="visual reveal" data-delay=".15">
        <EcosystemViz />
      </div>
    </div>
  </div>
</section>

<!-- ============ SERVICES PRINCIPAUX ============ -->
<section class="section section-gray" data-nav-section="Services">
  <div class="container">
    <div class="section-head-row">
      <div class="section-head reveal">
        <div class="eyebrow">Conseil · Formation · IA</div>
        <h2>Quatre expertises, une promesse : votre autonomie.</h2>
      </div>
      <a href="/services" class="btn btn-outline reveal">Voir tous nos services
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>
      </a>
    </div>
    <div class="grid grid-4" data-stagger>
      <div class="card service-card">
        <div class="icon-tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7c2.5 2.6 4 5.8 4 5s-1.5-2.4-4-5c-2.5 2.6-4 4.2-4 5s1.5-2.4 4-5z"/><path d="M14.5 9.5 12 12l-2.5 2.5L12 12l2.5-2.5z" fill="currentColor" stroke="none"/></svg></div>
        <h3>Conseil stratégique</h3>
        <p>On éclaire vos décisions : diagnostic IA &amp; numérique, stratégie et feuille de route priorisée — pour investir là où ça compte vraiment.</p>
        <ul>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Diagnostic &amp; audit digital</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Stratégie digitale</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Plan d'action personnalisé</li>
        </ul>
        <a href="/services-conseil-strategie" class="card-link">En savoir plus
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>
        </a>
      </div>

      <div class="card service-card">
        <div class="icon-tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9l10-5 10 5-10 5L2 9z"/><path d="M6 11.5V16c0 1.5 3 3 6 3s6-1.5 6-3v-4.5"/><line x1="22" y1="9" x2="22" y2="15"/></svg></div>
        <h3>Formation professionnelle</h3>
        <p>On rend vos équipes autonomes : formations pratiques à l'IA, au marketing et aux outils numériques. Elles repartent capables, pas dépendantes.</p>
        <ul>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Marketing digital &amp; IA</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Vente en ligne</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Création de contenu</li>
        </ul>
        <a href="/services-formation" class="card-link">En savoir plus
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>
        </a>
      </div>

      <div class="card service-card">
        <div class="icon-tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 4 20 8.5 12 13 4 8.5"/><polyline points="4 13 12 17.5 20 13"/><polyline points="4 17 12 21.5 20 17"/></svg></div>
        <h3>Digitalisation &amp; accompagnement</h3>
        <p>On met les bons outils en place avec vous : sites, boutiques, CRM et process — déployés et pris en main par vos équipes.</p>
        <ul>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Sites &amp; boutiques en ligne</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Mise en place de CRM</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Outils métiers &amp; process</li>
        </ul>
        <a href="/services-digitalisation" class="card-link">En savoir plus
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>
        </a>
      </div>

      <div class="card service-card dark">
        <div class="icon-tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="6" width="12" height="12" rx="2"/><rect x="9" y="9" width="6" height="6" rx="1"/><line x1="12" y1="1.5" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="22.5"/><line x1="1.5" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="22.5" y2="12"/></svg></div>
        <h3>Automatisation &amp; IA</h3>
        <p>On fait travailler l'IA et l'automatisation pour vous : workflows, relances, agents conversationnels et intégration de l'IA à vos outils. Vos tâches répétitives tournent toutes seules.</p>
        <ul>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Automatisation des tâches &amp; workflows</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Agents IA &amp; chatbots (WhatsApp, web…)</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Intégration de l'IA à vos outils</li>
        </ul>
        <a href="/services-automatisation-ia" class="card-link">En savoir plus
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ============ PUBLICS ACCOMPAGNES ============ -->
<section class="section" data-nav-section="Publics">
  <div class="container">
    <div class="section-head center reveal">
      <div class="eyebrow" style="justify-content:center">Pour qui</div>
      <h2>Conçu pour votre réalité, quelle que soit votre taille.</h2>
      <p class="lead mx-auto" style="max-width:56ch;margin-top:16px">De l'entrepreneur solo au grand groupe : nous accompagnons celles et ceux qui veulent avancer avec l'IA et le numérique.</p>
    </div>
    <ul class="audience-cloud reveal" data-stagger>
      <li class="aud"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2c3 1 5 4 5 8 0 2-1 4-2 5l-3 3-3-3c-1-1-2-3-2-5 0-4 2-7 5-8z"/><circle cx="12" cy="9" r="1.6" fill="currentColor" stroke="none"/></svg>Entrepreneurs</li>
      <li class="aud is-accent"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="3" y1="12" x2="21" y2="12"/></svg>PME</li>
      <li class="aud"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><line x1="15.5" y1="15.5" x2="21" y2="21"/></svg>Porteurs de projets</li>
      <li class="aud is-green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.5-9.5-9C.7 7.4 2.3 4 5.7 4c2 0 3.3 1.1 4.3 2.4C11 5.1 12.3 4 14.3 4c3.4 0 5 3.4 3.2 7-2.5 4.5-9.5 9-9.5 9z"/></svg>Associations</li>
      <li class="aud"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 4 20 8.5 12 13 4 8.5"/><polyline points="4 13 12 17.5 20 13"/></svg>Entreprises</li>
      <li class="aud"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9l10-5 10 5-10 5L2 9z"/><path d="M6 11.5V16c0 1.5 3 3 6 3s6-1.5 6-3v-4.5"/></svg>Organismes de formation</li>
      <li class="aud is-accent"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.5-9.5-9C.7 7.4 2.3 4 5.7 4c2 0 3.3 1.1 4.3 2.4C11 5.1 12.3 4 14.3 4c3.4 0 5 3.4 3.2 7-2.5 4.5-9.5 9-9.5 9z"/></svg>Femmes entrepreneures</li>
      <li class="aud"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 19a5.6 5.6 0 0 1 11 0"/></svg>Indépendants</li>
    </ul>
  </div>
</section>

<!-- ============ CHIFFRES ============ -->
<section class="section section-dark text-white" data-nav-section="Chiffres clés">
  <div class="mesh-bg"></div>
  <div class="container">
    <div class="grid-4-col collapse_tablet" data-stagger>
      <div class="stat-block">
        <div class="stat-num"><span class="js-counter" data-count="15000">0</span><span class="suffix">+</span></div>
        <div class="stat-label">Personnes formées</div>
      </div>
      <div class="stat-block">
        <div class="stat-num"><span class="js-counter" data-count="97">0</span><span class="suffix">%</span></div>
        <div class="stat-label">De satisfaction client</div>
      </div>
      <div class="stat-block">
        <div class="stat-num">6-7</div>
        <div class="stat-label">Collaborateurs experts</div>
      </div>
      <div class="stat-block">
        <div class="stat-num" style="font-size:clamp(1.4rem,1.1rem+1vw,2rem)">Plusieurs</div>
        <div class="stat-label">Entreprises &amp; organisations accompagnées</div>
      </div>
    </div>
  </div>
</section>

<!-- ============ POURQUOI CHOISIR ============ -->
<section class="section" data-nav-section="Pourquoi nous">
  <div class="container">
    <div class="split-block">
      <div class="visual reveal">
        <div class="mockup-frame">
          <div class="dots"><span></span><span></span><span></span></div>
          <div class="mockup-screen">
            <div class="bar w-40"></div>
            <div class="graph"></div>
            <div class="bar w-60"></div>
            <div class="bar w-80"></div>
          </div>
        </div>
      </div>
      <div class="reveal" data-delay=".1">
        <div class="eyebrow">Notre différence</div>
        <h2 style="margin-bottom:8px">Nous ne proposons pas seulement des outils. Nous construisons des solutions utiles.</h2>
        <div style="margin-top:24px">
          <div class="why-item">
            <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><line x1="3" y1="12" x2="21" y2="12"/><path d="M12 3c2.5 2.6 4 5.8 4 9s-1.5 6.4-4 9c-2.5-2.6-4-5.8-4-9s1.5-6.4 4-9z"/></svg></div>
            <div><h4>Réalités africaines</h4><p>Une bonne compréhension des réalités africaines et du contexte ivoirien.</p></div>
          </div>
          <div class="why-item">
            <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="16" rx="2"/><line x1="3.5" y1="10" x2="20.5" y2="10"/></svg></div>
            <div><h4>Solutions adaptées</h4><p>Adaptées à vos besoins réels et à votre budget, sans superflu.</p></div>
          </div>
          <div class="why-item">
            <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9l10-5 10 5-10 5L2 9z"/><path d="M6 11.5V16c0 1.5 3 3 6 3s6-1.5 6-3v-4.5"/></svg></div>
            <div><h4>Approche pédagogique</h4><p>Une méthode pratique qui rend vos équipes autonomes.</p></div>
          </div>
          <div class="why-item">
            <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.5-9.5-9C.7 7.4 2.3 4 5.7 4c2 0 3.3 1.1 4.3 2.4C11 5.1 12.3 4 14.3 4c3.4 0 5 3.4 3.2 7-2.5 4.5-9.5 9-9.5 9z"/></svg></div>
            <div><h4>Accompagnement continu</h4><p>Avant, pendant et après le projet — nous restons disponibles.</p></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ STATEMENT ============ -->
<section class="section-dark text-center" style="overflow:hidden;padding:clamp(56px,6vw,90px) 0 clamp(120px,11vw,170px)">
  <div class="mesh-bg"></div>
  <div class="container">
    <div class="stack-text reveal-scale" style="color:#fff">
      <span class="solid display-huge">Des résultats.</span>
      <span class="ghost display-huge" aria-hidden="true">Des résultats.</span>
    </div>
  </div>
</section>

<!-- ============ REALISATIONS ============ -->
<section class="section section-cream" data-nav-section="Réalisations">
  <div class="container">
    <div class="section-head-row">
      <div class="section-head reveal">
        <div class="eyebrow">Portfolio</div>
        <h2>Quelques réalisations.</h2>
      </div>
      <a href="/realisations" class="btn btn-outline reveal">Découvrir nos réalisations
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>
      </a>
    </div>
    <div class="grid grid-3" data-stagger>
      <div class="case-card">
        <div class="case-media">
          <div class="grid-lines"></div>
          <div class="mockup" style="width:80%">
            <div class="mockup-frame" style="padding:10px">
              <div class="mockup-screen" style="padding:12px;gap:8px">
                <div class="bar w-60"></div><div class="graph" style="height:40px"></div><div class="bar w-40"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="case-body">
          <div class="client">ACOPCI</div>
          <p>Accompagnement en formation et structuration digitale d'une organisation professionnelle.</p>
          <div class="case-tags"><span class="badge">Formation</span><span class="badge badge-placeholder">Détails à venir</span></div>
        </div>
      </div>
      <div class="case-card">
        <div class="case-media">
          <div class="grid-lines"></div>
          <div class="mockup" style="width:80%">
            <div class="mockup-frame" style="padding:10px;background:var(--g-blue)">
              <div class="mockup-screen" style="padding:12px;gap:8px">
                <div class="chip-row"><div class="chip"></div><div class="chip b"></div></div><div class="bar w-80"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="case-body">
          <div class="client">Ivoire 2C</div>
          <p>Accompagnement digital pour renforcer la présence en ligne et les outils de gestion.</p>
          <div class="case-tags"><span class="badge">Digitalisation</span><span class="badge badge-placeholder">Détails à venir</span></div>
        </div>
      </div>
      <div class="case-card">
        <div class="case-media">
