</style>

<script>
  (() => {
    const carousel = document.querySelector(".methodo-carousel");
    if (!carousel) return;
    const pages = Array.from(carousel.querySelectorAll<HTMLElement>(".methodo-page"));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>(".methodo-page-dot"));
    const prevBtn = carousel.querySelector<HTMLButtonElement>("[data-methodo-prev]");
    const nextBtn = carousel.querySelector<HTMLButtonElement>("[data-methodo-next]");
    let current = 0;
    const SLIDE_MS = 550;

    function goTo(index: number) {
      if (index === current || index < 0 || index >= pages.length) return;
      const forward = index > current;
      const outClass = forward ? "is-left" : "is-right";
      const inClass = forward ? "is-right" : "is-left";
      const from = pages[current];
      const to = pages[index];
      from.classList.add(outClass);
      to.hidden = false;
      to.classList.add(inClass);
      requestAnimationFrame(() => requestAnimationFrame(() => to.classList.remove(inClass)));
      setTimeout(() => {
        from.hidden = true;
        from.classList.remove(outClass);
      }, SLIDE_MS);
      current = index;
      dots.forEach((d, i) => d.classList.toggle("is-active", i === index));
      if (prevBtn) prevBtn.disabled = index === 0;
      if (nextBtn) nextBtn.disabled = index === pages.length - 1;
    }

    prevBtn?.addEventListener("click", () => goTo(current - 1));
    nextBtn?.addEventListener("click", () => goTo(current + 1));
    dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));
  })();
</script>
