<style>
  /* Colonne texte plus large + titre plafonné : garantit 2 lignes maximum.
     Gardé au-dessus du breakpoint global (1080px) : en dessous, .split-block
     repasse déjà en 1 colonne (règle globale) et cette surcharge la casserait. */
