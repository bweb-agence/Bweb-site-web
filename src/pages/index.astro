    z-index: 0; pointer-events: none; user-select: none;
  }
  .methodo-slot--start .methodo-ghost { top: 14px; left: 10px; }
  .methodo-slot--end .methodo-ghost { top: 14px; left: auto; right: 10px; }
  .methodo-slot--high .methodo-ghost { bottom: 14px; left: 50%; transform: translateX(-50%); }

  .methodo-card { position: absolute; width: 175px; max-width: 40vw; z-index: 3; }
  .methodo-card h4 { font-size: 1.08rem; margin-bottom: 6px; }
  .methodo-card p { font-size: .92rem; color: var(--c-gray-600); line-height: 1.5; margin: 0; }
  /* Placée à côté du grand chiffre, du côté opposé au centre : ne croise jamais le tracé. */
