---
import { contact, whatsappLink } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import IllusConseil from "../components/illus/IllusConseil.astro";
---

<BaseLayout title="Conseil & stratégie IA pour entreprises | Bweb" description="Diagnostic, priorisation et plan d'action : Bweb conseille les entreprises pour décider vite et intégrer l'IA là où elle crée de la valeur." breadcrumbs={[{ name: "Accueil", path: "/" }, { name: "Services", path: "/services" }, { name: "Conseil & stratégie", path: "/services-conseil-strategie" }]}>
<section class="page-hero" data-nav-section="Conseil &amp; stratégie">
  <div class="mesh-bg"></div>
  <div class="grid-lines"></div>
  <div class="container">
    <div class="breadcrumb"><a href="/">Accueil</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
      <a href="/services">Services</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
      <span>Conseil &amp; stratégie</span>
    </div>
    <div class="page-hero-grid">
      <div class="text-white" data-hero-in>
        <div class="eyebrow on-dark">Conseil · Stratégie IA</div>
        <h1>Une stratégie claire, prête pour l'IA.</h1>
        <p class="lead">Nous diagnostiquons votre activité, priorisons vos chantiers et bâtissons un plan d'action concret — pour décider vite et intégrer l'IA là où elle crée réellement de la valeur.</p>
        <div class="hero-actions" style="margin-top:32px;margin-bottom:0">
          <a href="/devis" class="btn btn-warm">Demander un diagnostic</a>
          <a href="/services" class="btn btn-outline-light">Tous nos services</a>
        </div>
      </div>
      <div class="visual" data-hero-in>
        <IllusConseil />
      </div>
    </div>
  </div>
</section>

<section class="section" data-nav-section="Notre approche">
  <div class="container">
    <div class="split-block split-block--text-wide">
      <div class="reveal">
        <div class="eyebrow">Ce que comprend ce service</div>
        <h2>Un diagnostic complet avant toute recommandation.</h2>
        <p class="lead" style="margin:20px 0">Chaque accompagnement démarre par une compréhension fine de votre activité, de vos objectifs et de votre présence actuelle en ligne — pour proposer une stratégie réellement adaptée, et non une solution générique.</p>
      </div>
      <div class="card reveal" data-delay=".1">
        <ul class="tick-list">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Diagnostic digital</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Audit de présence en ligne</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Étude des besoins</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Élaboration de stratégie digitale</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Plan de communication</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Stratégie d'acquisition</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Accompagnement à l'adoption du numérique et de l'IA</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- L'offre d'entrée de la catégorie : c'est par là qu'un dirigeant commence,
     avant le diagnostic et l'accompagnement. -->
<section class="section section-tight-top" data-nav-section="Atelier Stratégie IA">
  <div class="container">
    <a class="cs-atelier reveal" href="/atelier-strategie-ia">
      <span class="cs-atelier__body">
        <span class="cs-atelier__eyebrow">Notre offre d'entrée</span>
        <span class="cs-atelier__title">Atelier Stratégie IA — une journée pour repartir avec votre plan</span>
        <span class="cs-atelier__desc">Pour les dirigeants de PME de 10 à 100 employés. 5 places par session · Abidjan · 200 000 FCFA.</span>
      </span>
      <span class="cs-atelier__cta">
        Découvrir l'atelier
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>
      </span>
    </a>
  </div>
</section>

<section class="section section-gray" data-nav-section="Autres services">
  <div class="container">
    <div class="section-head center reveal">
      <div class="eyebrow" style="justify-content:center">Explorez aussi</div>
      <h2>Nos autres services</h2>
    </div>
    <div class="grid grid-3" data-stagger>
      <a class="card service-card" href="/services-creation-saas"><h4>Création de SaaS</h4><p style="margin-top:8px">MVP, abonnements, tableau de bord d'administration.</p></a>
      <a class="card service-card" href="/services-digitalisation"><h4>Digitalisation des entreprises</h4><p style="margin-top:8px">CRM, outils métiers et process numériques.</p></a>
      <a class="card service-card" href="/services-automatisation-ia"><h4>Automatisation &amp; IA</h4><p style="margin-top:8px">WhatsApp, chatbots et agents conversationnels.</p></a>
    </div>
  </div>
</section>

<section class="section" data-nav-section="Contact">
  <div class="container">
    <div class="cta-band reveal-scale">
      <div class="mesh-bg"></div>
      <div class="grid-lines"></div>
      <div style="position:relative;z-index:2">
        <h2 class="text-white">Prêt à faire le point sur votre présence digitale ?</h2>
        <p class="lead text-white">Demandez un diagnostic et recevez un plan d'action concret.</p>
        <div class="hero-actions">
          <a href="/devis" class="btn btn-warm">Demander un diagnostic</a>
          <a href={whatsappLink()} class="btn btn-outline-light" data-whatsapp-link target="_blank" rel="noopener">Discuter sur WhatsApp</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Bandeau vers l'offre d'entrée de la catégorie. Une carte pleine largeur
     plutôt qu'une des trois cartes « Explorez aussi » : l'atelier n'est pas un
     service voisin, c'est la porte d'entrée de CETTE page. */
  .cs-atelier {
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 24px;
    padding: clamp(24px, 3vw, 36px) clamp(24px, 3.4vw, 44px);
    border-radius: var(--radius-lg); background: var(--c-skyblue);
    border: 1px solid rgba(31, 108, 237, .18);
    transition: transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
  }
  .cs-atelier:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .cs-atelier__body { display: flex; flex-direction: column; gap: 6px; max-width: 62ch; }
  .cs-atelier__eyebrow { font-size: .75rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--c-blue-darker); }
  .cs-atelier__title { font-family: var(--f-display); font-size: clamp(1.1rem, .95rem + .8vw, 1.5rem); font-weight: 800; color: var(--c-navy); line-height: 1.3; }
  .cs-atelier__desc { font-size: .93rem; color: var(--c-gray-700); }
  .cs-atelier__cta { display: inline-flex; align-items: center; gap: 8px; flex: none; white-space: nowrap; font-weight: 700; color: var(--c-blue); }
  .cs-atelier__cta svg { width: 18px; height: 18px; transition: transform var(--dur-fast) var(--ease); }
  .cs-atelier:hover .cs-atelier__cta svg { transform: translateX(4px); }
</style>
</BaseLayout>
