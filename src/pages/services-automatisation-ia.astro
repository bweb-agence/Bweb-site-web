---
import { contact, whatsappLink } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import IllusAutomatisation from "../components/illus/IllusAutomatisation.astro";
---

<BaseLayout title="Automatisation & IA pour entreprises | Bweb" description="WhatsApp, chatbots et IA : Bweb automatise les tâches répétitives des entreprises pour libérer du temps et gagner en productivité.">
<section class="page-hero" data-nav-section="Automatisation &amp; IA">
  <div class="mesh-bg"></div>
  <div class="grid-lines"></div>
  <div class="container">
    <div class="breadcrumb"><a href="/">Accueil</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
      <a href="/services">Services</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
      <span>Automatisation &amp; IA</span>
    </div>
    <div class="page-hero-grid">
      <div class="text-white" data-hero-in>
        <div class="eyebrow on-dark">Automatisation & IA</div>
        <h1>L'IA au service de votre productivité.</h1>
        <p class="lead">Réponses, relances et suivi des prospects : nous mettons l'IA et l'automatisation au travail pour libérer le temps de vos équipes.</p>
        <div class="hero-actions" style="margin-top:32px;margin-bottom:0">
          <a href="/devis" class="btn btn-warm">Automatiser mon activité</a>
          <a href="/services" class="btn btn-outline-light">Tous nos services</a>
        </div>
      </div>
      <div class="visual" data-hero-in>
        <IllusAutomatisation />
      </div>
    </div>
  </div>
</section>

<section class="section" data-nav-section="Notre approche">
  <div class="container">
    <div class="split-block">
      <div class="reveal">
        <div class="eyebrow">Ce que comprend ce service</div>
        <h2>Moins de tâches répétitives, plus de temps utile.</h2>
        <p class="lead" style="margin:20px 0">Nous mettons en place des automatisations simples et fiables pour que votre équipe se concentre sur ce qui compte réellement : la relation client et la vente.</p>
      </div>
      <div class="card reveal" data-delay=".1">
        <ul class="tick-list">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Automatisation WhatsApp</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Chatbots</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Agents conversationnels</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Réponses automatiques</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Automatisation des relances</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Gestion automatique des prospects</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Intégration de l'intelligence artificielle</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Création de processus automatisés</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="section section-gray" data-nav-section="Autres services">
  <div class="container">
    <div class="section-head center reveal">
      <div class="eyebrow" style="justify-content:center">Explorez aussi</div>
      <h2>Nos autres services</h2>
    </div>
    <div class="grid grid-3" data-stagger>
      <a class="card service-card" href="/services-digitalisation"><h4>Digitalisation des entreprises</h4><p style="margin-top:8px">CRM, outils métiers et process numériques.</p></a>
      <a class="card service-card" href="/services-conseil-strategie"><h4>Conseil &amp; stratégie digitale</h4><p style="margin-top:8px">Diagnostic et plan d'action personnalisé.</p></a>
      <a class="card service-card" href="/services-formation"><h4>Formation professionnelle</h4><p style="margin-top:8px">Marketing digital, IA, vente en ligne.</p></a>
    </div>
  </div>
</section>

<section class="section" data-nav-section="Contact">
  <div class="container">
    <div class="cta-band reveal-scale">
      <div class="mesh-bg"></div>
      <div class="grid-lines"></div>
      <div style="position:relative;z-index:2">
        <h2 class="text-white">Envie de gagner du temps au quotidien ?</h2>
        <p class="lead text-white">Identifions ensemble les tâches à automatiser en priorité.</p>
        <div class="hero-actions">
          <a href="/devis" class="btn btn-warm">Automatiser mon activité</a>
          <a href={whatsappLink()} class="btn btn-outline-light" data-whatsapp-link target="_blank" rel="noopener">Discuter sur WhatsApp</a>
        </div>
      </div>
    </div>
  </div>
</section>
</BaseLayout>
