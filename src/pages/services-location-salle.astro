---
export const prerender = false; // SSR : la disponibilité est lue à chaque requête.

import BaseLayout from "../layouts/BaseLayout.astro";
import { contact } from "../config/site";
import { supabase } from "../lib/supabase";

const wa = contact.whatsapp.primary;

/* Vraie disponibilité (Supabase). On lit la table publique `salle_indisponibilites`
   (aucune donnée personnelle) et on étend chaque plage [date_debut..date_fin] en
   jours "YYYY-MM-DD" injectés dans le calendrier. En cas d'erreur/inaccessibilité,
   on retombe proprement sur « aucune date bloquée » (le simulateur reste utilisable). */
const toKey = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;

let unavailableDates: string[] = [];
try {
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const { data, error } = await supabase
    .from("salle_indisponibilites")
    .select("date_debut,date_fin")
    .gte("date_fin", toKey(today));
  if (!error && data) {
    const set = new Set<string>();
    for (const row of data as { date_debut: string; date_fin: string }[]) {
      const end = new Date(`${row.date_fin}T00:00:00`);
      for (let d = new Date(`${row.date_debut}T00:00:00`); d <= end; d.setDate(d.getDate() + 1)) {
        set.add(toKey(d));
      }
    }
    unavailableDates = [...set];
  }
} catch {
  unavailableDates = [];
}
---

<BaseLayout
  title="Louer une salle de formation à Abidjan (70 places) | Bweb Agence"
  description="Louez une salle de formation moderne de 70 places à Abidjan : climatisée, Wi-Fi fibre, sonorisation, micro et écran inclus. Choisissez votre date, simulez votre devis en temps réel et réservez en quelques minutes."
  breadcrumbs={[{ name: "Accueil", path: "/" }, { name: "Services", path: "/services" }, { name: "Location de salle", path: "/services-location-salle" }]}
>
  <!-- ============================================================= -->
  <!-- 1. HERO                                                       -->
  <!-- ============================================================= -->
  <section class="page-hero" data-nav-section="Présentation">
    <div class="mesh-bg"></div>
    <div class="grid-lines"></div>
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Accueil</a>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18" /></svg>
        <a href="/services">Services</a>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18" /></svg>
        <span>Location de salle</span>
      </div>
      <div class="page-hero-grid">
        <div class="text-white" data-hero-in>
          <div class="eyebrow on-dark">Location de salle de formation</div>
          <h1>Louez une salle de formation moderne de 70 places à Abidjan</h1>
          <p class="lead text-white" style="margin:20px 0 0">
            Organisez vos formations, séminaires, conférences et ateliers dans une salle climatisée,
            entièrement équipée et prête à accueillir vos participants.
          </p>
          <div class="hero-actions" style="margin-top:32px;margin-bottom:0">
            <a href="#simulateur" class="btn btn-warm">Simuler mon devis</a>
            <a href={`https://wa.me/${wa}?text=${encodeURIComponent("Bonjour Bweb Agence, je souhaite réserver la salle de formation.")}`} class="btn btn-outline-light">Réserver maintenant</a>
          </div>
        </div>
        <div class="visual" data-hero-in>
          <div class="salle-hero-photo">
            <img src="/images/salle/salle-hero.webp" alt="Salle de formation Bweb à Abidjan — vue générale avec grand écran et sièges" width="1800" height="1350" fetchpriority="high" />
            <ul class="salle-hero-badges">
              <li>70 places</li>
              <li>Climatisation</li>
              <li>Wi-Fi inclus</li>
              <li>Sonorisation</li>
              <li>Micro inclus</li>
              <li>Écran de projection</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- 2. CHIFFRES CLÉS                                              -->
  <!-- ============================================================= -->
  <section class="section section-sm" data-nav-section="Chiffres clés">
    <div class="container">
      <div class="grid grid-4" data-stagger>
        <div class="card stat-block">
          <div class="stat-num"><span class="js-counter" data-count="70">70</span></div>
          <div class="stat-label">Places assises</div>
        </div>
        <div class="card stat-block">
          <div class="stat-num"><span class="js-counter" data-count="100">100</span><span class="suffix">%</span></div>
          <div class="stat-label">Climatisée</div>
        </div>
        <div class="card stat-block">
          <div class="stat-num" style="font-size:clamp(1.8rem,1.4rem+1.4vw,2.6rem)">Fibre</div>
          <div class="stat-label">Wi-Fi haut débit</div>
        </div>
        <div class="card stat-block">
          <div class="stat-num"><span class="js-counter" data-count="7">7</span><span class="suffix">j/7</span></div>
          <div class="stat-label">Disponible</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- 3. GALERIE                                                    -->
  <!-- ============================================================= -->
  <section class="section section-gray" data-nav-section="Galerie">
    <div class="container">
      <div class="section-head center reveal">
        <div class="eyebrow" style="justify-content:center">La salle en images</div>
        <h2>Un espace pensé pour vos événements professionnels</h2>
      </div>
      <div class="salle-gallery" data-stagger>
        <figure class="salle-shot salle-shot--wide"><img src="/images/salle/salle-vue-generale.webp" alt="Vue générale de la salle de formation" loading="lazy" width="1400" height="1050" /><figcaption>Vue générale</figcaption></figure>
        <figure class="salle-shot"><img src="/images/salle/salle-conference.webp" alt="Salle disposée en configuration conférence" loading="lazy" width="1400" height="1050" /><figcaption>Disposition conférence</figcaption></figure>
        <figure class="salle-shot"><img src="/images/salle/salle-ecran.webp" alt="Grand écran de projection sur pied" loading="lazy" width="1400" height="1050" /><figcaption>Écran de projection</figcaption></figure>
        <figure class="salle-shot"><img src="/images/salle/salle-accueil.webp" alt="Espace accueil à l'entrée de la salle de formation" loading="lazy" width="1400" height="1050" /><figcaption>Espace accueil</figcaption></figure>
        <figure class="salle-shot"><img src="/images/salle/salle-facade.webp" alt="Façade du bâtiment abritant la salle" loading="lazy" width="1400" height="1050" /><figcaption>Façade du bâtiment</figcaption></figure>
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- 4. ÉQUIPEMENTS INCLUS                                         -->
  <!-- ============================================================= -->
  <section class="section salle-equip" data-nav-section="Équipements">
    <div class="container">
      <div class="section-head center reveal">
        <div class="eyebrow" style="justify-content:center">Tout est compris</div>
        <h2>Les équipements inclus dans chaque réservation</h2>
        <p class="lead" style="margin:16px auto 0;max-width:52ch">
          Aucun supplément caché : votre salle arrive prête à l'emploi, propre et opérationnelle.
        </p>
      </div>
      <ul class="salle-equip-grid reveal">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7" /></svg>Climatisation</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7" /></svg>Wi-Fi haut débit</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7" /></svg>Sonorisation</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7" /></svg>Micro HF</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7" /></svg>Grand écran</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7" /></svg>Chaises avec support d'ordinateur</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7" /></svg>Prises électriques</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7" /></svg>Éclairage professionnel</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7" /></svg>Nettoyage avant chaque réservation</li>
      </ul>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- 5. SIMULATEUR DE DEVIS                                        -->
  <!-- ============================================================= -->
  <section class="section section-cream" id="simulateur" data-nav-section="Simulateur">
    <div class="container">
      <div class="section-head center reveal">
        <div class="eyebrow" style="justify-content:center">Configurateur en temps réel</div>
        <h2>Choisissez votre date, composez votre réservation</h2>
        <p class="lead" style="margin:16px auto 0;max-width:56ch">
          Sélectionnez la date de votre événement — le tarif week-end s'applique automatiquement le
          samedi et le dimanche — puis ajoutez vos options : le devis se met à jour instantanément.
        </p>
      </div>

      <div class="sim" data-sim data-wa={wa} data-unavailable={JSON.stringify(unavailableDates)}>
        <!-- Colonne gauche : configuration -->
        <div class="sim-config">
          <!-- Étape 1 : date -->
          <div class="sim-step">
            <div class="sim-step-head"><span class="sim-step-num">1</span> Date de l'événement</div>
            <div class="cal-head">
              <div class="cal-title" data-cal-title>—</div>
              <div class="cal-nav">
                <button type="button" data-cal-prev aria-label="Mois précédent">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6" /></svg>
                </button>
                <button type="button" data-cal-next aria-label="Mois suivant">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
                </button>
              </div>
            </div>
            <div class="cal-grid" data-cal-dow></div>
            <div class="cal-grid" data-cal-grid style="margin-top:5px"></div>
            <div class="cal-legend">
              <span><span class="cal-dot" style="background:var(--c-gray-100)"></span>Semaine</span>
              <span><span class="cal-dot cal-dot--we"></span>Week-end (tarif majoré)</span>
              <span><span class="cal-dot cal-dot--un"></span>Indisponible</span>
            </div>
            <div data-tariff></div>
          </div>

          <!-- Étape 2 : durée -->
          <div class="sim-step">
            <div class="sim-step-head"><span class="sim-step-num">2</span> Durée de location</div>
            <div class="sim-durations" data-durations></div>
            <div class="sim-slots" data-slots hidden>
              <button type="button" class="sim-slot is-active" data-slot="matin">Matin · 9h–12h30</button>
              <button type="button" class="sim-slot" data-slot="aprem">Après-midi · 13h30–17h30</button>
            </div>
          </div>

          <!-- Étape 3 : services inclus -->
          <div class="sim-step">
            <div class="sim-step-head"><span class="sim-step-num">3</span> Services inclus</div>
            <p class="sim-hint">Toujours compris dans le prix, sans supplément.</p>
            <div class="sim-inc-list">
              <span class="sim-inc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="5 13 10 18 19 7" /></svg>Climatisation</span>
              <span class="sim-inc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="5 13 10 18 19 7" /></svg>Wi-Fi</span>
              <span class="sim-inc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="5 13 10 18 19 7" /></svg>Sonorisation</span>
              <span class="sim-inc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="5 13 10 18 19 7" /></svg>Micro</span>
              <span class="sim-inc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="5 13 10 18 19 7" /></svg>Écran</span>
            </div>
          </div>

          <!-- Étape 4 : participants & options -->
          <div class="sim-step">
            <div class="sim-step-head"><span class="sim-step-num">4</span> Participants &amp; options</div>
            <div class="sim-pax">
              <input type="range" min="1" max="70" value="45" step="1" data-pax-range aria-label="Nombre de participants" />
              <input type="number" min="1" max="70" value="45" data-pax-num aria-label="Nombre de participants" />
              <span class="sim-pax-suffix">/ 70 places</span>
            </div>
            <div class="sim-divider"></div>
            <div class="sim-opts-label">Options complémentaires</div>
            <div class="sim-options" data-options></div>
          </div>
        </div>

        <!-- Colonne droite : récapitulatif sticky -->
        <aside class="sim-recap">
          <div class="sim-recap-card">
            <div class="sim-recap-head">
              <span class="eyebrow" style="margin:0">Votre devis</span>
              <span class="sim-recap-pax" data-recap-pax>45 participants</span>
            </div>
            <div class="sim-recap-date">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
              <span>Événement le&nbsp;<b data-recap-date>—</b></span>
            </div>
            <ul class="sim-recap-lines" data-recap-lines></ul>
            <div class="sim-total">
              <span>Total estimé</span>
              <strong data-total>—</strong>
            </div>
            <div class="sim-actions">
              <button type="button" class="btn btn-warm btn-block" data-action="reserver">Réserver cette date</button>
              <button type="button" class="btn btn-outline btn-block" data-action="pdf">Télécharger le devis PDF</button>
              <button type="button" class="btn btn-whatsapp btn-block" data-action="whatsapp">Recevoir sur WhatsApp</button>
            </div>
            <p class="sim-recap-note">Devis indicatif. La disponibilité de la date est confirmée par notre équipe sous quelques heures.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- 6. CONFIGURATIONS POPULAIRES                                  -->
  <!-- ============================================================= -->
  <section class="section" data-nav-section="Formules">
    <div class="container">
      <div class="section-head center reveal">
        <div class="eyebrow" style="justify-content:center">Prêtes à l'emploi</div>
        <h2>Formules populaires</h2>
        <p class="lead" style="margin:16px auto 0;max-width:52ch">
          Des formules accessibles, de la réunion express à la journée complète.
          Choisissez-en une : elle se charge dans le simulateur, prête à ajuster.
        </p>
      </div>
      <div class="preset-grid" data-presets>
        <!-- Séminaire demi-journée -->
        <div class="card preset-card">
          <span class="badge">Format demi-journée</span>
          <h3>Séminaire demi-journée</h3>
          <ul class="preset-list">
            <li>50 participants</li>
            <li>Demi-journée (matin ou après-midi)</li>
            <li>Climatisation, Wi-Fi &amp; sonorisation</li>
            <li>Micro HF &amp; grand écran inclus</li>
            <li>Pause café incluse</li>
            <li>Eau minérale pour chaque participant</li>
          </ul>
          <div class="preset-price">à partir de <strong data-preset-total="demi">—</strong> FCFA</div>
          <button type="button" class="btn btn-outline btn-block" data-preset="demi">Choisir cette formule</button>
        </div>
        <!-- Journée complète — vedette premium, au centre -->
        <div class="card preset-card preset-card--featured">
          <span class="badge badge-green">★ Le plus complet</span>
          <h3>Journée complète</h3>
          <ul class="preset-list">
            <li>70 participants (salle pleine)</li>
            <li>Journée complète · en semaine</li>
            <li>Tous les équipements inclus</li>
            <li>Pause café + eau minérale</li>
            <li>Paperboard</li>
            <li>Accueil &amp; émargement</li>
            <li>Captation photo de l'événement</li>
          </ul>
          <div class="preset-price"><strong data-preset-total="complete">—</strong> FCFA</div>
          <button type="button" class="btn btn-light btn-block" data-preset="complete">Choisir cette formule</button>
        </div>
        <!-- Conférence -->
        <div class="card preset-card">
          <span class="badge badge-orange">Grand format</span>
