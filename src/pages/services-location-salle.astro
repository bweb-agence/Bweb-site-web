          <button type="button" class="btn btn-outline btn-block" data-preset="conference">Choisir cette formule</button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- 7. POURQUOI CHOISIR NOTRE SALLE                               -->
  <!-- ============================================================= -->
  <section class="section section-gray" data-nav-section="Pourquoi nous">
    <div class="container">
      <div class="section-head center reveal">
        <div class="eyebrow" style="justify-content:center">Nos atouts</div>
        <h2>Pourquoi choisir notre salle</h2>
      </div>
      <div class="grid grid-4" data-stagger>
        <div class="card">
          <div class="salle-why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0Z" /><circle cx="12" cy="10" r="3" /></svg></div>
          <h4>Adresse repère à Cocody</h4>
          <p style="margin-top:8px">Au carrefour Miami Beach : une adresse connue, facile à trouver et rapidement accessible en taxi ou VTC.</p>
        </div>
        <div class="card">
          <div class="salle-why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7V5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2" /><rect x="3" y="7" width="18" height="12" rx="2" /><path d="M8 12h8" /></svg></div>
          <h4>Équipements professionnels</h4>
          <p style="margin-top:8px">Sonorisation, écran, micro et Wi-Fi fibre prêts à l'emploi.</p>
        </div>
        <div class="card">
          <div class="salle-why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a4 4 0 0 0-4 4c0 2 4 6 4 6s4-4 4-6a4 4 0 0 0-4-4Z" /><path d="M5 21c0-4 3-6 7-6s7 2 7 6" /></svg></div>
          <h4>Confort optimal</h4>
          <p style="margin-top:8px">Climatisation puissante, éclairage soigné et espace aéré.</p>
        </div>
        <div class="card">
          <div class="salle-why-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4" /><circle cx="12" cy="12" r="9" /></svg></div>
          <h4>Accompagnement personnalisé</h4>
          <p style="margin-top:8px">Une équipe dédiée pour préparer et réussir votre événement.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- 7b. LOCALISATION & CONTACT                                    -->
  <!-- ============================================================= -->
  <section class="section" data-nav-section="Localisation">
    <div class="container">
      <div class="section-head center reveal">
        <div class="eyebrow" style="justify-content:center">Nous trouver</div>
        <h2>Localisation &amp; contact</h2>
        <p class="lead" style="margin:16px auto 0;max-width:52ch">
          Une adresse repère au cœur de Cocody, facile à trouver et rapide d'accès.
        </p>
      </div>
      <div class="salle-loc">
        <div class="loc-info reveal">
          <div class="loc-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0Z" /><circle cx="12" cy="10" r="3" /></svg>
