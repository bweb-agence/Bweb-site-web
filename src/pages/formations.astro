---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import IllusFormations from "../components/illus/IllusFormations.astro";
import SessionCard from "../components/SessionCard.astro";
import { supabase } from "../lib/supabase";
import { themeColorMap, priceFCFA } from "../lib/format";

// Les 3 prochaines sessions (à venir), pour un aperçu du calendrier.
const { data: nextSessions } = await supabase
  .from("sessions")
  .select("slug,title,theme,venue,city,image_url,starts_at,status,level,mode,ticket_types(price,capacity,sold,compare_at_price)")
  .in("status", ["published", "full"])
  .gte("starts_at", new Date().toISOString())
  .order("starts_at", { ascending: true })
  .limit(3);
const sessions = nextSessions ?? [];

// Formations « bientôt » (à venir) — visibles même sans date publiée.
// Ordre croissant = ordre du parcours (l'Initiation = étape 01, la suite ici).
const { data: soonData } = await supabase
  .from("formations")
  .select("slug,title,summary,theme,level,duration,default_price")
  .eq("coming_soon", true)
  .order("created_at", { ascending: true })
  .limit(6);
const comingSoon = soonData ?? [];
const soonTotal = comingSoon.length + 1; // +1 : l'Initiation déjà en ligne (étape 01)

// Accent par niveau (raconte la progression du parcours).
const levelClass = (lvl?: string | null) => {
  const l = (lvl || "").toLowerCase();
  if (l.includes("débutant") || l.includes("debutant")) return "deb";
  if (l.includes("avancé") || l.includes("avance")) return "adv";
  return "int";
};
// Une icône par formation (repli : la boîte « produit »).
const soonIcons: Record<string, string> = {
  "creer-produit-digital": '<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.27 6.96 12 12.01l8.73-5.05M12 22.08V12"/>',
  "creer-offre-irresistible": '<path d="m12 3 2.35 4.76 5.25.76-3.8 3.7.9 5.23L12 15.9l-4.7 2.47.9-5.23-3.8-3.7 5.25-.76z"/>',
  "creer-gerer-boutique-produits-digitaux": '<path d="M3 9 4.2 4.4A1.5 1.5 0 0 1 5.65 3.3h12.7a1.5 1.5 0 0 1 1.45 1.1L21 9M3 9v10a1.5 1.5 0 0 0 1.5 1.5h15A1.5 1.5 0 0 0 21 19V9M3 9h18M8 13h8"/>',
  "vendre-publicite-contenu-organique": '<path d="M3 11v2a1 1 0 0 0 1 1h2l4 4V6L6 10H4a1 1 0 0 0-1 1z"/><path d="M14 8a4 4 0 0 1 0 8M17 5a7 7 0 0 1 0 14"/>',
  "passer-100000-a-500000-fcfa-produits-digitaux": '<path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M7 14l3.5-3.5 2.5 2.5L20 6M20 6h-4M20 6v4"/>',
  "passer-500000-a-1500000-fcfa-produits-digitaux": '<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="M12 15 9 12a11 11 0 0 1 5-8c2.53-1.53 5-1.5 6-1.5.09 1 .1 3.47-1.5 6a11 11 0 0 1-8 5z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>',
};
const soonIcon = (slug: string) => soonIcons[slug] || soonIcons["creer-produit-digital"];

// Couleurs des thèmes (source de vérité) pour des badges/dégradés uniformes.
const { data: themesData } = await supabase.from("themes").select("name,color");
const tmap = themeColorMap(themesData);
---

<BaseLayout title="Formations IA & digital pour entreprises | Bweb" description="Formations en IA, marketing digital, vente en ligne et productivité : Bweb rend vos équipes autonomes sur les nouvelles technologies." breadcrumbs={[{ name: "Accueil", path: "/" }, { name: "Formations", path: "/formations" }]}>
<section class="page-hero" data-nav-section="Formations">
  <div class="mesh-bg"></div>
  <div class="grid-lines"></div>
  <div class="container">
    <div class="breadcrumb"><a href="/">Accueil</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
      <span>Formations</span>
    </div>
    <div class="page-hero-grid">
      <div class="text-white" data-hero-in>
        <div class="eyebrow on-dark">Formations</div>
        <h1>Montez en compétence sur l'IA.</h1>
        <p class="lead">Bweb forme entreprises, associations et institutions aux compétences en IA et en digital qui font vraiment la différence au quotidien.</p>
        <div class="hero-actions" style="margin-top:32px;margin-bottom:0">
          <a href="/formations/calendrier" class="btn btn-warm">Voir le calendrier des formations</a>
          <a href="/devis" class="btn btn-outline-light">Demander le catalogue</a>
        </div>
      </div>
      <div class="visual" data-hero-in>
        <IllusFormations />
      </div>
    </div>
  </div>
</section>

<!-- ===== Prochaines sessions (aperçu du calendrier) ===== -->
<section class="section" data-nav-section="Prochaines dates">
  <div class="container">
    <div class="section-head center reveal">
      <div class="eyebrow" style="justify-content:center">Prochaines dates</div>
      <h2>Les prochaines formations au calendrier.</h2>
      <p class="lead" style="margin-top:16px">Réservez votre place aux prochaines dates en présentiel à Abidjan.</p>
    </div>

    {sessions.length > 0 ? (
      <>
        <div class="ev-grid" style="margin-top:var(--space-lg)">
          {sessions.map((s) => <SessionCard session={s} map={tmap} />)}
        </div>
        <div style="text-align:center;margin-top:var(--space-lg)">
          <a class="btn btn-outline" href="/formations/calendrier">
            Voir toutes les dates
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left:8px"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </>
    ) : (
      <div style="text-align:center;margin-top:var(--space-lg)">
        <p class="form-note">Les prochaines dates seront bientôt annoncées.</p>
        <a class="btn btn-outline" href="/formations/calendrier" style="margin-top:14px">Voir le calendrier des formations</a>
      </div>
    )}
  </div>
</section>

{comingSoon.length > 0 && (
  <section class="section section-gray" data-nav-section="Bientôt">
    <div class="container">
      <div class="section-head center reveal">
        <div class="eyebrow" style="justify-content:center">Bientôt</div>
        <h2>Des formations qui arrivent.</h2>
        <p class="lead" style="margin-top:14px">Découvrez-les et soyez prévenu·e dès l'ouverture des dates.</p>
      </div>
      <div class="soon-grid" style="margin-top:var(--space-lg)">
        {comingSoon.map((f, i) => (
          <a class={`soon-card ${levelClass(f.level)}`} href={`/formations/${f.slug}`}>
            <span class="soon-card__grid" aria-hidden="true"></span>
            <div class="soon-card__top">
              <span class="soon-card__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={soonIcon(f.slug)} /></span>
              <span class="soon-card__badge">Bientôt</span>
            </div>
            <div class="soon-card__meta">
              {f.level && <span class="soon-card__lvl">{f.level}</span>}
              {f.theme && <span class="soon-card__theme">{f.theme}</span>}
            </div>
            <h3>{f.title}</h3>
            {f.summary && <p>{f.summary}</p>}
            {(f.duration || f.default_price != null) && (
              <div class="soon-card__facts">
                {f.duration && (
                  <span class="f"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>{f.duration}</span>
                )}
                {f.default_price != null && (
                  <span class="f price"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 12.5 12.5 20.6a2 2 0 0 1-2.8 0l-6.3-6.3a2 2 0 0 1-.6-1.4V4.5A1.5 1.5 0 0 1 4.3 3h8.4a2 2 0 0 1 1.4.6l6.5 6.5a1.9 1.9 0 0 1 0 2.4z"/><circle cx="7.5" cy="7.5" r="1.2"/></svg>{priceFCFA(f.default_price)}</span>
                )}
              </div>
            )}
            <div class="soon-card__foot">
              <span class="soon-card__step">Étape <b>{String(i + 2).padStart(2, "0")}</b>/{String(soonTotal).padStart(2, "0")}</span>
              <span class="soon-card__go">Voir la formation
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<div class="ticker-band alt">
  <div class="marquee-track">
    <span class="ticker-item"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 6.4L20 10l-6.2 1.6L12 18l-1.8-6.4L4 10l6.2-1.6z"/></svg>Stratégie IA</span>
    <span class="ticker-item"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 6.4L20 10l-6.2 1.6L12 18l-1.8-6.4L4 10l6.2-1.6z"/></svg>Diagnostic digital</span>
    <span class="ticker-item"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 6.4L20 10l-6.2 1.6L12 18l-1.8-6.4L4 10l6.2-1.6z"/></svg>Formation IA</span>
    <span class="ticker-item"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 6.4L20 10l-6.2 1.6L12 18l-1.8-6.4L4 10l6.2-1.6z"/></svg>Automatisation</span>
