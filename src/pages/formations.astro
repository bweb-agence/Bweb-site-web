      <div class="audience-pill"><div class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></div><span>Formation en entreprise</span></div>
      <div class="audience-pill"><div class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 19a5.6 5.6 0 0 1 11 0"/></svg></div><span>Accompagnement individuel</span></div>
      <div class="audience-pill"><div class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 19a5.6 5.6 0 0 1 11 0"/><circle cx="17" cy="9" r="2.6"/></svg></div><span>Accompagnement en groupe</span></div>
    </div>
  </div>
</section>

<section class="section section-gray" data-nav-section="Contact">
  <div class="container">
    <div class="cta-band" style="background:var(--g-navy)">
      <div class="mesh-bg"></div>
      <div class="grid-lines"></div>
      <div style="position:relative;z-index:2">
        <h2 class="text-white">Envie de former votre équipe ?</h2>
        <p class="lead text-white">Recevez notre catalogue de formations avec programmes, durées et tarifs.</p>
        <div class="hero-actions">
          <a href="/devis" class="btn btn-warm">Demander le catalogue des formations</a>
          <a href="/contact" class="btn btn-outline-light">Nous contacter</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .soon-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  @media (max-width: 900px) { .soon-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .soon-grid { grid-template-columns: 1fr; } }

  .soon-card { --acc: var(--c-blue); position: relative; display: flex; flex-direction: column; background: #fff;
    border: 1px solid var(--c-border); border-radius: var(--radius-lg); padding: 24px 22px 20px; text-decoration: none;
    overflow: hidden; isolation: isolate; box-shadow: var(--shadow-sm);
    transition: transform .28s var(--ease), box-shadow .28s var(--ease), border-color .28s var(--ease); }
  .soon-card.deb { --acc: var(--c-green); }
  .soon-card.int { --acc: var(--c-blue); }
  .soon-card.adv { --acc: var(--c-orange); }
  /* rail d'accent en haut */
  .soon-card::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 4px; border-radius: 4px;
    background: linear-gradient(90deg, var(--acc), color-mix(in srgb, var(--acc) 40%, transparent));
    transform: scaleX(.28); transform-origin: left; transition: transform .4s var(--ease); }
  /* halo diffus au survol */
  .soon-card::after { content: ""; position: absolute; top: -40%; right: -30%; width: 260px; height: 260px; z-index: -1;
    background: radial-gradient(circle, color-mix(in srgb, var(--acc) 22%, transparent), transparent 70%);
    opacity: 0; transition: opacity .4s var(--ease); }
