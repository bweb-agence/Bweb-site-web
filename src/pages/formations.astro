        <h3>Produits digitaux</h3>
        <p>Créer et vendre des produits digitaux.</p>
        <span class="tb-go">Explorer <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      </article>
    </div>
  </div>
</section>

<!-- ===== Formats ===== -->
<section class="section section-gray" data-nav-section="Formats">
  <div class="container">
    <div class="section-head center reveal">
      <div class="eyebrow" style="justify-content:center">Formats</div>
      <h2>Un format adapté à votre disponibilité.</h2>
    </div>
    <div class="grid grid-4" data-stagger>
      <div class="audience-pill"><div class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 20s-7-4.5-9.5-9C.7 7.4 2.3 4 5.7 4c2 0 3.3 1.1 4.3 2.4C11 5.1 12.3 4 14.3 4c3.4 0 5 3.4 3.2 7-2.5 4.5-9.5 9-9.5 9z"/></svg></div><span>Présentiel</span></div>
      <div class="audience-pill"><div class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><line x1="3" y1="12" x2="21" y2="12"/><path d="M12 3c2.5 2.6 4 5.8 4 9s-1.5 6.4-4 9c-2.5-2.6-4-5.8-4-9s1.5-6.4 4-9z"/></svg></div><span>En ligne</span></div>
      <div class="audience-pill"><div class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="6" y="6" width="12" height="12" rx="2"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg></div><span>Atelier pratique</span></div>
      <div class="audience-pill"><div class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><polygon points="12 2.5 14.9 8.6 21.5 9.4 16.7 13.9 18 20.5 12 17.2 6 20.5 7.3 13.9 2.5 9.4 9.1 8.6"/></svg></div><span>Masterclass</span></div>
      <div class="audience-pill"><div class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></div><span>Formation en entreprise</span></div>
      <div class="audience-pill"><div class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 19a5.6 5.6 0 0 1 11 0"/></svg></div><span>Accompagnement individuel</span></div>
      <div class="audience-pill"><div class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 19a5.6 5.6 0 0 1 11 0"/><circle cx="17" cy="9" r="2.6"/></svg></div><span>Accompagnement en groupe</span></div>
    </div>
  </div>
</section>

<section class="section section-gray" data-nav-section="Contact">
  <div class="container">
    <div class="cta-band" style="background:var(--g-navy)">
      <div class="mesh-bg"></div>
      <div class="grid-lines"></div>
      <div style="position:relative;z-index:2">
        <h2 class="text-white">Envie de former votre équipe ?</h2>
        <p class="lead text-white">Recevez notre catalogue de formations avec programmes, durées et tarifs.</p>
        <div class="hero-actions">
          <a href="/devis" class="btn btn-warm">Demander le catalogue des formations</a>
          <a href="/contact" class="btn btn-outline-light">Nous contacter</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .soon-card { position: relative; display: flex; flex-direction: column; gap: 8px; background: #fff;
    border: 1px solid var(--c-border); border-radius: var(--radius-lg); padding: 22px 20px; text-decoration: none;
    box-shadow: var(--shadow-sm); transition: transform .15s var(--ease), box-shadow .15s var(--ease), border-color .15s; }
  .soon-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: color-mix(in srgb, var(--c-blue) 35%, var(--c-border)); }
  .soon-card__badge { align-self: flex-start; font-size: .7rem; font-weight: 800; color: #8a5a00; background: #fff2d6; padding: 4px 10px; border-radius: var(--radius-pill); }
  .soon-card__theme { font-size: .74rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; color: var(--c-blue); }
  .soon-card h3 { font-family: var(--f-display); font-weight: 800; font-size: 1.12rem; line-height: 1.15; color: var(--c-ink); margin: 2px 0 0; }
  .soon-card p { margin: 0; font-size: .88rem; color: var(--c-gray-600); line-height: 1.5; }
  .soon-card__go { margin-top: auto; padding-top: 8px; display: inline-flex; align-items: center; gap: 7px; font-weight: 800; font-size: .86rem; color: var(--c-blue); }
</style>
</BaseLayout>
