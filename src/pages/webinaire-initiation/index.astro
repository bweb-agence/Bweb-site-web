---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PhoneField from "../../components/PhoneField.astro";
import VideoLazy from "../../components/VideoLazy.astro";
import { contact } from "../../config/site";
/* Tuiles .tb-* partagées avec « Nos valeurs » (a-propos) et les thématiques
   (formations) : une seule source de vérité, ~2 Ko au lieu des 88 Ko de
   formations.css qu'une landing n'a aucune raison de charger. */
import "../../styles/tiles.css";

/* =========================================================
   WEBINAIRE « De ta compétence à tes premières ventes »
   Landing d'inscription — l'inscription EST la conversion.
   Le funnel : cette page → /webinaire-initiation/merci
   ========================================================= */

/* Le live est à 20 h heure d'Abidjan (UTC+0). Le « Z » est important :
   sans lui, le navigateur interpréterait 20:00 dans SON fuseau, et un
   inscrit à Paris verrait un décompte faux de 2 heures. */
const LIVE_ISO = "2026-09-06T20:00:00Z";
const PLACES = 500;

/* Vidéo de présentation du live. Coller l'ID YouTube (ex. "z_h3zF0Xzjk").
   Tant qu'il est vide, le bloc vidéo n'est pas rendu du tout — pas de
   lecteur mort sur la page. */
const VIDEO_ID = "";

/* Base du lien de secours : le prénom saisi y est ajouté côté client, pour
   que Godwin reçoive un message exploitable et pas un simple « bonjour ». */
const SECOURS_BASE = `https://wa.me/${contact.whatsapp.primary}?text=`;
---

<BaseLayout
  title="Webinaire gratuit — ta compétence en 325 000 FCFA/mois | Bweb Academy"
  description="Live unique le dimanche 6 septembre à 20 h (Abidjan) : la méthode en 3 étapes pour transformer une compétence que tu as déjà en produit digital à 325 000 FCFA/mois. Gratuit, 500 places."
  hideWhatsApp={true}
  bareChrome={true}
>
  <Fragment slot="head">
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '150267587094280');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none" alt=""
      src="https://www.facebook.com/tr?id=150267587094280&ev=PageView&noscript=1"/></noscript>
  </Fragment>

  <!-- ═══════════ 1 · HERO ═══════════ -->
  <header class="wb-hero">
    <div class="wb-hero-halo" aria-hidden="true"></div>
    <div class="container wb-hero-inner">
      <span class="wb-badge-live" data-hero-in>
        <span class="wb-dot" aria-hidden="true"></span>
        Événement en direct · Dimanche 6 septembre · 20 h
      </span>

      <h1 data-hero-in>
        Comment transformer ta compétence en 325&nbsp;000&nbsp;FCFA/mois&nbsp;:
        <span class="wb-h1-accent">la méthode exacte en 3 étapes.</span>
      </h1>

      <p class="lead wb-hero-sub" data-hero-in>
        Un live unique de 60 minutes où je te donne, gratuitement, la méthode que je facture <b>150&nbsp;000&nbsp;FCFA</b> en coaching privé — celle qui transforme un savoir-faire que tu as déjà en produit digital qui encaisse chaque mois.
      </p>

      <div data-hero-in>
        <a href="#inscription" class="wb-cta wb-cta--glow">Je réserve ma place — c'est gratuit <span class="wb-arrow">→</span></a>
        <p class="wb-cta-note">{PLACES} places · une seule date · replay 48 h réservé aux inscrits</p>
      </div>

      <div class="wb-countdown" data-hero-in>
        <span class="wb-cd-label">⏳ Le live démarre dans</span>
        <div class="wb-cd" data-countdown={LIVE_ISO}>
          <span class="wb-cd-box"><b data-cd="d">00</b><span>Jours</span></span>
          <span class="wb-cd-sep">:</span>
          <span class="wb-cd-box"><b data-cd="h">00</b><span>Heures</span></span>
          <span class="wb-cd-sep">:</span>
          <span class="wb-cd-box"><b data-cd="m">00</b><span>Min</span></span>
          <span class="wb-cd-sep">:</span>
          <span class="wb-cd-box"><b data-cd="s">00</b><span>Sec</span></span>
        </div>
      </div>

      <!-- Vidéo de présentation, juste sous le compte à rebours. -->
      <div class="wb-video-slot" data-hero-in>
        <VideoLazy
          id={VIDEO_ID}
          label="Découvre en 1 minute ce qu'on va construire ensemble"
          title="Présentation du webinaire — Godwin Soola"
          hint="VIDEO_ID · src/pages/webinaire-initiation/index.astro"
        />
      </div>
    </div>
  </header>

  <!-- ═══════════ 2 · CE QUE TU VAS RÉCUPÉRER ═══════════ -->
  <section class="section" data-nav-section="Le contenu">
    <div class="container">
      <div class="section-head center reveal">
        <div class="eyebrow" style="justify-content:center">Le contenu du live</div>
        <h2>Ce que tu repars avec, gratuitement, en 60 minutes</h2>
      </div>

      <!-- Mêmes tuiles que la section « Nos valeurs » du site (.tb-tile) :
           une seule identité visuelle sur l'ensemble du domaine. -->
      <div class="tb-bento wb-bento" data-stagger>
        <article class="tb-tile" style="--c:#1f6ced">
          <span class="tb-num">01</span>
          <span class="tb-ic"><svg viewBox="0 0 24 24"><path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3z"/><circle cx="17.5" cy="17.5" r="3.5"/></svg></span>
          <h3>La matrice compétence × problème × client</h3>
          <p>Le cadre exact pour savoir quoi vendre — et à qui — en 15 minutes, au lieu de 3 semaines.</p>
          <span class="wb-value-price">Valeur 50 000 FCFA</span>
        </article>
        <article class="tb-tile" style="--c:#00c89e">
          <span class="tb-num">02</span>
          <span class="tb-ic"><svg viewBox="0 0 24 24"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.9 8.9 0 0 1-3.8-.9L3 20.5l1.6-4.9A8.4 8.4 0 0 1 12 3.1a8.4 8.4 0 0 1 9 8.4z"/></svg></span>
          <h3>La règle des 10 conversations</h3>
          <p>Le script mot à mot pour valider ton idée <b>avant</b> de créer — et ne plus perdre 2 semaines sur un produit que personne n'achète.</p>
          <span class="wb-value-price">Valeur 50 000 FCFA</span>
        </article>
        <article class="tb-tile" style="--c:#ff835f">
          <span class="tb-num">03</span>
          <span class="tb-ic"><svg viewBox="0 0 24 24"><path d="M13 2 4.5 13H11l-1 9 8.5-11H12z"/></svg></span>
          <h3>« Vends avant de perfectionner »</h3>
          <p>Pourquoi ta première version suffit pour encaisser, avec 2 exemples réels d'élèves.</p>
          <span class="wb-value-price">Valeur 50 000 FCFA</span>
        </article>
      </div>

      <p class="wb-value-total reveal">
        Valeur totale&nbsp;: <b>150 000 FCFA</b> — ce soir-là, pour <span class="wb-free">0 FCFA</span>.
      </p>
    </div>
  </section>

  <!-- ═══════════ 3 · POURQUOI C'EST GRATUIT (rupture navy) ═══════════ -->
  <section class="section wb-why" data-nav-section="Pourquoi c'est gratuit">
    <div class="container wb-why-inner">
      <div class="eyebrow on-dark reveal" style="justify-content:center">La transparence d'abord</div>
      <h2 class="reveal">Pourquoi je te donne <span class="wb-gold">150 000 FCFA</span> de méthode, gratuitement</h2>
      <p class="wb-why-text reveal">
        D'habitude, je facture cette méthode 150 000 FCFA en coaching privé. Ce soir-là, je la donne
        en public pour une seule raison&nbsp;: te montrer, preuves à l'appui, que ta compétence a de
        la valeur — et que je peux t'aider à l'encaisser.
      </p>
      <p class="wb-why-text reveal"><b>C'est une occasion, pas une habitude.</b> Je ne le referai pas avant plusieurs semaines.</p>
    </div>
  </section>

  <!-- ═══════════ 4 · POUR QUI / PAS POUR QUI ═══════════ -->
  <section class="section section-gray" data-nav-section="Pour qui">
    <div class="container">
      <div class="section-head center reveal">
        <div class="eyebrow" style="justify-content:center">Le filtre</div>
        <h2>Ce live est fait pour toi… ou pas.</h2>
      </div>

      <div class="wb-fit-grid">
        <div class="wb-fit wb-fit--yes reveal">
          <h3><span class="wb-fit-ico" aria-hidden="true">✓</span> C'est pour toi si…</h3>
          <ul>
            <li>Tu as une compétence que d'autres pourraient payer pour apprendre</li>
            <li>Tu regardes des tutos mais tu ne lances jamais rien</li>
            <li>Tu veux un revenu en plus sans quitter ton travail</li>
          </ul>
        </div>
        <div class="wb-fit wb-fit--no reveal" data-delay=".1">
          <h3><span class="wb-fit-ico" aria-hidden="true">✕</span> Ce n'est pas pour toi si…</h3>
          <ul>
            <li>Tu cherches « de l'argent facile » sans rien faire</li>
            <li>Tu n'es pas prêt à exécuter — le live donne la méthode, c'est <b>toi</b> qui l'appliques</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ 5 · QUI ANIME ═══════════ -->
  <section class="section" data-nav-section="L'animateur">
    <div class="container">
      <div class="wb-host reveal">
        <div class="wb-host-photo" aria-hidden="true">
          <img src="/images/godwin-soola.webp" alt="" width="800" height="800" loading="lazy" decoding="async" />
        </div>
        <div class="wb-host-body">
          <div class="eyebrow">Animé par</div>
          <h2>Godwin Soola</h2>
          <p class="lead">Fondateur de Bweb Agence, cabinet de conseil et de formation à l'IA en Côte d'Ivoire.</p>
          <ul class="wb-host-stats">
            <li><b>17 116</b><span>personnes formées</span></li>
            <li><b>95 %</b><span>d'avis positifs sur 593 clients</span></li>
            <li><b>42 948 €</b><span>investis en publicité Facebook</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ 6 · FORMULAIRE (le seul CTA) ═══════════ -->
  <section class="section wb-form-section" id="inscription" data-nav-section="Réserver">
    <div class="container">
      <div class="wb-form-card reveal">
        <span class="wb-form-tag">Gratuit · {PLACES} places</span>
        <h2>Réserve ta place maintenant</h2>
        <p class="wb-form-intro">Dimanche 6 septembre, 20 h (heure d'Abidjan). Le lien arrive sur WhatsApp.</p>

        <form id="wbForm" novalidate>
          <div class="wb-field">
            <label for="wb-prenom">Prénom</label>
            <input id="wb-prenom" name="prenom" type="text" autocomplete="given-name" required minlength="2" maxlength="80" placeholder="Marius" />
          </div>

          <div class="wb-field">
            <label for="wb-phone">Numéro WhatsApp</label>
            <PhoneField id="wb-phone" />
          </div>

          <div class="wb-field">
            <label for="wb-email">E-mail</label>
            <input id="wb-email" name="email" type="email" autocomplete="email" required maxlength="160" placeholder="marius@exemple.com" />
          </div>

          <!-- Honeypot : invisible pour l'humain, rempli par les bots. -->
          <div class="wb-hp" aria-hidden="true">
            <label for="wb-website">Ne pas remplir</label>
            <input id="wb-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <p class="wb-form-error" id="wbError" role="alert" hidden></p>

          <!-- Filet de sécurité. La page est en mode CRO : ni navbar, ni bouton
               WhatsApp flottant, ni footer cliquable. Sans ce lien, un message
               d'erreur qui dit « écris-nous sur WhatsApp » envoie l'inscrit
               dans le vide. N'apparaît que sur les pannes techniques — une
               erreur de saisie se corrige dans le formulaire. -->
          <a class="wb-form-rescue" id="wbRescue" href="#" target="_blank" rel="noopener" hidden>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2m0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23a8.2 8.2 0 0 1 8.24 8.24c0 4.54-3.7 8.23-8.24 8.23m4.52-6.16c-.25-.13-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.22.25-.87.85-.87 2.07s.9 2.4 1.02 2.56c.12.17 1.75 2.67 4.25 3.75.59.25 1.05.4 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29"/></svg>
            Réserver ma place sur WhatsApp
          </a>

          <button type="submit" class="wb-cta wb-cta--block wb-cta--glow" id="wbSubmit">
            <span data-label>Je réserve ma place maintenant</span> <span class="wb-arrow">→</span>
          </button>
          <p class="wb-form-note">Gratuit. Lien envoyé sur WhatsApp. Une seule date, {PLACES} places.</p>
        </form>
      </div>
    </div>
  </section>

  <!-- ═══════════ 7 · URGENCE + FAQ ═══════════ -->
  <section class="section section-gray" data-nav-section="Questions">
    <div class="container wb-narrow">
      <p class="wb-urgency reveal">
        Les places partent dans l'ordre d'inscription. <b>Quand c'est plein, c'est plein.</b>
      </p>

      <div class="wb-faq reveal">
        <div class="wb-faq-item">
          <button class="wb-faq-q" type="button" aria-expanded="false">
            <span>C'est vraiment gratuit&nbsp;?</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
          <div class="wb-faq-a"><div class="wb-faq-a-in">Oui. Le live est gratuit et tu repars avec la méthode. À la fin, je présente la cohorte — optionnelle, 65 000 FCFA. Tu n'es obligé à rien.</div></div>
        </div>
        <div class="wb-faq-item">
          <button class="wb-faq-q" type="button" aria-expanded="false">
            <span>Je ne peux pas être là à 20 h&nbsp;?</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
          <div class="wb-faq-a"><div class="wb-faq-a-in">Un replay est disponible 48 h pour les inscrits. Mais tu perds la possibilité de poser tes questions en direct — et les personnes présentes au live ont accès à des choses que les autres n'ont pas.</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA collant mobile -->
  <div class="wb-sticky">
    <a href="#inscription" class="wb-cta wb-sticky-cta">Je réserve ma place — gratuit →</a>
  </div>

  <script is:inline define:vars={{ SECOURS_BASE }}>
    (function () {
      /* ---------- Compte à rebours vers le live ---------- */
      var root = document.querySelector("[data-countdown]");
      if (root) {
        var target = new Date(root.getAttribute("data-countdown")).getTime();
        var pad = function (v) { return String(v).padStart(2, "0"); };
        var tick = function () {
          var d = target - Date.now();
          if (d < 0) d = 0;
          root.querySelector('[data-cd="d"]').textContent = pad(Math.floor(d / 86400000));
          root.querySelector('[data-cd="h"]').textContent = pad(Math.floor((d % 86400000) / 3600000));
          root.querySelector('[data-cd="m"]').textContent = pad(Math.floor((d % 3600000) / 60000));
          root.querySelector('[data-cd="s"]').textContent = pad(Math.floor((d % 60000) / 1000));
        };
        tick();
        setInterval(tick, 1000);
      }

      /* ---------- FAQ ---------- */
      document.querySelectorAll(".wb-faq-q").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var item = btn.parentElement;
          var open = item.classList.contains("open");
          document.querySelectorAll(".wb-faq-item.open").forEach(function (i) {
            i.classList.remove("open");
            i.querySelector(".wb-faq-a").style.maxHeight = "0";
            i.querySelector(".wb-faq-q").setAttribute("aria-expanded", "false");
          });
          if (!open) {
            item.classList.add("open");
            var a = item.querySelector(".wb-faq-a");
            a.style.maxHeight = a.scrollHeight + "px";
            btn.setAttribute("aria-expanded", "true");
          }
        });
      });

      /* ---------- CTA collant : visible après le hero, masqué sur le formulaire ---------- */
      (function () {
        var sticky = document.querySelector(".wb-sticky");
        var hero = document.querySelector(".wb-hero");
        var form = document.getElementById("inscription");
        if (!sticky || !("IntersectionObserver" in window)) return;
        var pastHero = false, atForm = false;
        var update = function () { sticky.classList.toggle("show", pastHero && !atForm); };
        new IntersectionObserver(function (e) { pastHero = !e[0].isIntersecting; update(); }, { threshold: 0 }).observe(hero);
        if (form) new IntersectionObserver(function (e) { atForm = e[0].isIntersecting; update(); }, { threshold: 0 }).observe(form);
      })();

      /* ---------- Formulaire ---------- */
      var form = document.getElementById("wbForm");
      if (!form) return;
      var errorBox = document.getElementById("wbError");
      var rescue = document.getElementById("wbRescue");
      var submit = document.getElementById("wbSubmit");
      var label = submit.querySelector("[data-label]");
      var labelInitial = label.textContent;

      var MESSAGES = {
        prenom_invalide: "Merci d'indiquer ton prénom.",
        whatsapp_invalide: "Ce numéro WhatsApp ne semble pas valide.",
        email_invalide: "Cette adresse e-mail ne semble pas valide.",
        rate_limited: "Trop de tentatives. Patiente une minute avant de réessayer.",
        not_configured: "L'inscription en ligne est momentanément indisponible. Réserve ta place sur WhatsApp, je m'en occupe personnellement.",
        ingest_failed: "L'inscription n'a pas pu être enregistrée. Réessaie, ou réserve directement sur WhatsApp.",
        ingest_unreachable: "Connexion interrompue. Vérifie ton réseau et réessaie, ou passe par WhatsApp.",
        reseau: "Connexion interrompue. Vérifie ton réseau et réessaie, ou passe par WhatsApp.",
      };

      /* Pannes de notre côté : le visiteur n'y peut rien, on lui ouvre une
         autre porte. Les erreurs de saisie, elles, se corrigent sur place —
         y afficher WhatsApp ne ferait que détourner d'un champ à rectifier. */
      var PANNES = { not_configured: 1, ingest_failed: 1, ingest_unreachable: 1, reseau: 1 };

      var showError = function (key, prenom) {
        var code = MESSAGES[key] ? key : "reseau";
        errorBox.textContent = MESSAGES[code];
        errorBox.hidden = false;
        if (PANNES[code]) {
          rescue.href = SECOURS_BASE + encodeURIComponent(
            "Bonjour Godwin, je veux réserver ma place pour le live du dimanche 6 septembre." +
            (prenom ? " Je m'appelle " + prenom + "." : "") +
            " (Le formulaire du site n'a pas fonctionné.)"
          );
          rescue.hidden = false;
        } else {
          rescue.hidden = true;
        }
      };

      form.addEventListener("submit", function (e) {
        e.preventDefault();
        errorBox.hidden = true;
        rescue.hidden = true;

        var data = new FormData(form);
        var prenom = (data.get("prenom") || "").toString().trim();
        var email = (data.get("email") || "").toString().trim();
        // PhoneField fournit l'indicatif et le numéro séparément : on les fusionne.
        var whatsapp = ((data.get("phone_cc") || "") + " " + (data.get("phone") || "")).trim();

        // Validation côté client : un message immédiat vaut mieux qu'un aller-retour réseau.
        if (prenom.length < 2) return showError("prenom_invalide");
        if ((data.get("phone") || "").toString().replace(/\D/g, "").length < 6) return showError("whatsapp_invalide");
        if (!/^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i.test(email)) return showError("email_invalide");

        submit.disabled = true;
        label.textContent = "Réservation en cours…";

        fetch("/api/webinaire/inscription", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            prenom: prenom,
            whatsapp: whatsapp,
            email: email,
            website: (data.get("website") || "").toString(),
          }),
        })
          .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
          .then(function (res) {
            if (res && res.ok) {
              if (window.fbq) window.fbq("track", "Lead");
              window.location.href = "/webinaire-initiation/merci";
              return;
            }
            showError(res && res.error, prenom);
            submit.disabled = false;
            label.textContent = labelInitial;
          })
          .catch(function () {
            showError("reseau", prenom);
            submit.disabled = false;
            label.textContent = labelInitial;
          });
      });
    })();
  </script>
</BaseLayout>

<style>
  /* ===== CTA (pilule bleue, flèche animée) ===== */
  .wb-cta {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    padding: 19px 40px; border-radius: var(--radius-pill); white-space: nowrap;
    font-family: var(--f-display); font-weight: 700; font-size: 1.08rem; color: #fff;
    background: linear-gradient(135deg, #2f7bff, var(--c-blue) 55%, var(--c-blue-dark));
    box-shadow: 0 14px 38px -10px rgba(31,108,237,.6);
    border: 0; cursor: pointer;
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .wb-cta:hover { transform: translateY(-2px); box-shadow: 0 20px 46px -10px rgba(31,108,237,.72); }
