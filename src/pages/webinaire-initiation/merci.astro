---
/* Rendu à la demande, comme la landing : la date et la durée viennent de
   l'édition en cours (/admin/webinaires). Le live est mensuel. */
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import VideoLazy from "../../components/VideoLazy.astro";
import { site } from "../../config/site";
import { supabase } from "../../lib/supabase";
import "../../styles/funnel-confirm.css";

/* =========================================================
   WEBINAIRE — Page post-inscription
   ---------------------------------------------------------
   Trois rôles, dans cet ordre :
     1. confirmer (le doute tue la présence au live) ;
     2. pré-cadrer (l'inscrit arrive préparé, pas curieux) ;
     3. amorcer la boucle virale (il invite quelqu'un).
   Arrivée : redirection depuis le formulaire de /webinaire-initiation.
   ========================================================= */

const LANDING = `${site.url}/webinaire-initiation`;

/* Vidéo d'accueil : Godwin invite à rejoindre les canaux et annonce ce qui
   s'y passe. Coller l'ID YouTube (ex. "z_h3zF0Xzjk"). */
const VIDEO_ACCUEIL = "";

/* L'édition en cours (mêmes valeurs que la landing, même source).
   Les canaux ont leurs valeurs de secours ici pour la même raison que la date :
   si la base est injoignable, mieux vaut la page avec ses boutons que sans. */
const SECOURS = {
  starts_at: "2026-09-06T19:00:00Z",
  duration_min: 90,
  whatsapp_url: "https://chat.whatsapp.com/CNLf2TbhNQCBgUhT9zLdVc",
  telegram_url: "https://t.me/+eBmH_0ccOxkxNWRk",
};
const { data: editionRows } = await supabase.rpc("webinaire_public", { p_slug: "webinaire-initiation" });
const edition = (Array.isArray(editionRows) ? editionRows[0] : editionRows) ?? null;
const LIVE_ISO = edition?.starts_at ?? SECOURS.starts_at;
const DUREE = edition?.duration_min ?? SECOURS.duration_min;

/* Canaux où le lien du live est envoyé. Ils vivent sur l'édition et se règlent
   dans /admin/webinaires : le live est mensuel, son groupe change, et un lien
   écrit en dur signifiait un déploiement à chaque fois — avec, entre-temps, un
   bouton mort sur la page qu'un inscrit voit juste après s'être inscrit.
   Renseigner l'un, l'autre, ou les deux : la page s'adapte. */
const CANAUX = {
  whatsapp: edition?.whatsapp_url ?? SECOURS.whatsapp_url,
  telegram: edition?.telegram_url ?? SECOURS.telegram_url,
};
const aUnCanal = Boolean(CANAUX.whatsapp || CANAUX.telegram);
const montrerCanaux = aUnCanal || import.meta.env.DEV;

const TZ = "Africa/Abidjan";
const dateLive = new Date(LIVE_ISO);
const finLive = new Date(dateLive.getTime() + DUREE * 60_000);
const JOUR = (() => {
  const j = dateLive.toLocaleDateString("fr-FR", { weekday: "long", day: "numeric", month: "long", timeZone: TZ });
  return j.charAt(0).toUpperCase() + j.slice(1);
})();
const jour = JOUR.toLowerCase();
const HEURE = dateLive
  .toLocaleTimeString("fr-FR", { hour: "2-digit", minute: "2-digit", timeZone: TZ })
  .replace(":", " h ")
  .replace(/ h 00$/, " h");
const JOUR_SEMAINE = dateLive.toLocaleDateString("fr-FR", { weekday: "long", timeZone: TZ });
const JOUR_SEMAINE_MAJ = JOUR_SEMAINE.charAt(0).toUpperCase() + JOUR_SEMAINE.slice(1);

/* Google Agenda : un inscrit qui pose l'événement dans son agenda vient.
   Format attendu : horodatages UTC compacts, début et fin. */
const z = (d: Date) => d.toISOString().replace(/[-:]/g, "").replace(/\.\d{3}/, "");
const CAL = new URL("https://calendar.google.com/calendar/render");
CAL.searchParams.set("action", "TEMPLATE");
CAL.searchParams.set("text", "Live gratuit — De ta compétence à tes premières ventes");
CAL.searchParams.set("dates", `${z(dateLive)}/${z(finLive)}`);
CAL.searchParams.set("location", "En ligne (le lien arrive par e-mail)");
CAL.searchParams.set(
  "details",
  `Live de ${DUREE} minutes avec Godwin Soola (Bweb Academy).\n\nPrépare un carnet et connecte-toi 5 minutes en avance.\nLe lien de connexion arrive par e-mail avant le live.\n\n${LANDING}`,
);
const calendarUrl = CAL.href;

/* Partage : wa.me sans numéro ouvre le sélecteur de contacts WhatsApp. */
const shareText = `Je viens de réserver ma place pour ce live gratuit : « De ta compétence à tes premières ventes », ${jour} à ${HEURE}.

Godwin Soola y donne la méthode qu'il facture 150 000 FCFA en coaching privé — pour transformer une compétence qu'on a déjà en produit digital qui rapporte.

Il reste des places ici : ${LANDING}`;
const shareUrl = `https://wa.me/?text=${encodeURIComponent(shareText)}`;
---

<BaseLayout
  title={`C'est réservé — Rendez-vous ${jour} à ${HEURE} | Bweb Academy`}
  description="Ta place au live « De ta compétence à tes premières ventes » est confirmée. Voici ce qui t'attend et la seule chose à faire d'ici dimanche."
  noindex={true}
  hideWhatsApp={true}
  bareChrome={true}
>

  <!-- ═══════════ 1 · CONFIRMATION ═══════════ -->
  <header class="fc-hero">
    <div class="container fc-hero-inner">
      <div class="fc-seal" data-hero-in>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11" /></svg>
      </div>

      <h1 data-hero-in>C'est réservé. Bienvenue au live.</h1>

      <p class="lead fc-hero-sub" data-hero-in>
        Ta place au live du <b>{jour} à {HEURE}</b> (heure d'Abidjan) est verrouillée.
        Je t'envoie le lien par e-mail avant le live, et sur WhatsApp.
      </p>

      <!-- Les canaux passent AVANT le récapitulatif, et non après. Le
           visiteur vient de s'inscrire : la seule chose qu'on attend encore de
           lui, c'est de rejoindre le groupe — c'est par là qu'arrive le lien du
           live, et c'est ce qui décide de sa présence le jour J. Le rappel de
           la date, lui, ne demande aucune action : il peut attendre le
           deuxième écran. Auparavant les boutons commençaient à 808 px sur un
           téléphone, soit juste sous la ligne de flottaison. -->
      {montrerCanaux && (
        <div class="mc-canaux" data-hero-in>
          <p class="mc-canaux-lbl">C'est ici que j'envoie le lien du live</p>
          <div class="fc-actions">
            {CANAUX.whatsapp && (
              <a href={CANAUX.whatsapp} class="btn btn-whatsapp" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2m0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23a8.2 8.2 0 0 1 8.24 8.24c0 4.54-3.7 8.23-8.24 8.23m4.52-6.16c-.25-.13-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.22.25-.87.85-.87 2.07s.9 2.4 1.02 2.56c.12.17 1.75 2.67 4.25 3.75.59.25 1.05.4 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29"/></svg>
                Rejoindre le groupe WhatsApp
              </a>
            )}
            {CANAUX.telegram && (
              <a href={CANAUX.telegram} class="btn btn-telegram" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.6 4.3 2.9 11.5c-.9.3-.9 1.6.1 1.9l4.7 1.5 1.8 5.5c.2.7 1.1.9 1.6.4l2.6-2.5 4.6 3.4c.6.4 1.4.1 1.6-.6l3.2-15c.2-.8-.6-1.5-1.5-1.2M8.6 14.1l9.1-5.6c.2-.1.4.2.2.3l-7.5 6.8c-.3.2-.4.6-.5.9l-.3 2c0 .1-.2.2-.2 0l-1-3.2c-.1-.4 0-.9.2-1.2"/></svg>
                Rejoindre le canal Telegram
              </a>
            )}
            {!aUnCanal && <span class="mc-arenseigner">Lien d'invitation à renseigner dans <code>/admin/webinaires</code></span>}
          </div>
        </div>
      )}

      <div class="fc-recap" data-hero-in>
        <div class="fc-recap-row">
          <span class="fc-recap-ic">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="8" y1="3" x2="8" y2="7"/><line x1="16" y1="3" x2="16" y2="7"/></svg>
          </span>
          <span class="fc-recap-txt"><span>Quand</span><b>{JOUR} · {HEURE} (Abidjan)</b></span>
        </div>
        <div class="fc-recap-row">
          <span class="fc-recap-ic">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
          </span>
          <span class="fc-recap-txt"><span>Durée</span><b>{DUREE} minutes, en direct</b></span>
        </div>
        <div class="fc-recap-row">
          <span class="fc-recap-ic">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.9 8.9 0 0 1-3.8-.9L3 20.5l1.6-4.9A8.4 8.4 0 0 1 12 3.1a8.4 8.4 0 0 1 9 8.4z"/></svg>
          </span>
          <span class="fc-recap-txt"><span>Où</span><b>En ligne — lien envoyé sur WhatsApp</b></span>
        </div>
      </div>

      <div class="mc-video" data-hero-in>
        <VideoLazy
          id={VIDEO_ACCUEIL}
          label="Godwin t'explique ce qui t'attend dans le groupe"
          title="Bienvenue — ce qui t'attend d'ici au live"
          hint="VIDEO_ACCUEIL · src/pages/webinaire-initiation/merci.astro"
        />
      </div>

      <div class="fc-actions" data-hero-in>
        <a href={calendarUrl} class="btn btn-outline" target="_blank" rel="noopener">
          Ajouter à mon agenda
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="12" y1="14" x2="12" y2="18"/><line x1="10" y1="16" x2="14" y2="16"/></svg>
        </a>
      </div>
    </div>
  </header>

  <!-- ═══════════ 2 · CE QUI VA SE PASSER ═══════════ -->
  <section class="section section-gray">
    <div class="container">
      <div class="section-head center reveal">
        <div class="eyebrow" style="justify-content:center">Le déroulé</div>
        <h2>Voici ce qui t'attend</h2>
      </div>

      <div class="fc-steps reveal">
        <div class="fc-step">
          <span class="fc-step-tag">Avant le live</span>
          <h3>Tu reçois le lien du live par e-mail</h3>
          <p>Il arrive la veille puis le jour même, et aussi sur WhatsApp. Garde le numéro dans tes contacts pour être sûr de voir le message arriver.</p>
        </div>
        <div class="fc-step">
          <span class="fc-step-tag">J-0 · {JOUR_SEMAINE_MAJ} {HEURE}</span>
          <h3>On démarre — sois là 5 minutes en avance</h3>
          <p>Prépare un carnet et un stylo. Ce live se prend en notes, pas en spectateur : tu repars avec un plan, pas avec une vidéo de plus.</p>
        </div>
        <div class="fc-step fc-step--blue">
          <span class="fc-step-tag">À la fin</span>
          <h3>Je te montre la méthode complète, puis j'annonce la suite</h3>
          <p>La suite est optionnelle. Même si tu ne la prends pas, tu repars avec la méthode entière.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ 3 · PREMIÈRE ACTION ═══════════ -->
  <section class="section">
    <div class="container">
      <div class="fc-todo reveal">
        <span class="fc-todo-ic" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M9 3h6a1 1 0 0 1 1 1v1H8V4a1 1 0 0 1 1-1z"/><path d="M16 5h2a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h2"/><path d="m9 13 2 2 4-4"/></svg>
        </span>
        <div>
          <h2>Une chose à faire tout de suite</h2>
          <p>
            Note dans ton téléphone les <b>3 compétences</b> que tu utilises déjà pour aider les
            autres. Même celles qui te paraissent banales — ce sont souvent les plus vendables.
          </p>
          <p>On s'en servira pendant le live : c'est la base de ta première étape.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ 4 · INVITE UN AMI ═══════════ -->
  <section class="section fc-closing">
    <div class="container fc-closing-inner">
      <div class="eyebrow on-dark reveal" style="justify-content:center">Une dernière chose</div>
      <h2 class="reveal">Tu connais quelqu'un qui a une compétence et qui ne la vend pas&nbsp;?</h2>
      <p class="reveal">
        Envoie-lui le live. Il te remerciera — et vous serez deux à appliquer la méthode,
        ce qui change tout quand vient le moment de s'y mettre.
      </p>
      <a href={shareUrl} class="btn btn-whatsapp reveal" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2m0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23a8.2 8.2 0 0 1 8.24 8.24c0 4.54-3.7 8.23-8.24 8.23m4.52-6.16c-.25-.13-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.22.25-.87.85-.87 2.07s.9 2.4 1.02 2.56c.12.17 1.75 2.67 4.25 3.75.59.25 1.05.4 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29"/></svg>
        Partager sur WhatsApp
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== Rejoindre le canal (action principale de la page) ===== */
  .mc-canaux { margin-top: 34px; }
  .mc-canaux-lbl {
    font-family: var(--f-display); font-weight: 700; font-size: .8rem;
    text-transform: uppercase; letter-spacing: .09em; color: var(--c-success);
  }
  .mc-canaux .fc-actions { margin-top: 14px; }
  .btn-telegram { background: #229ed9; color: #fff; box-shadow: 0 10px 24px -8px rgba(34,158,217,.55); }
  .btn-telegram:hover { background: #1c87ba; color: #fff; }
  /* Repère de développement : jamais rendu en production. */
  .mc-arenseigner { font-size: .86rem; color: var(--c-gray-600); background: var(--c-cream); border: 1px dashed rgba(255,199,42,.7); padding: 10px 16px; border-radius: var(--radius-sm); }
  .mc-arenseigner code { font-family: ui-monospace, monospace; font-size: .82rem; color: var(--c-ink); }

  /* ===== Vidéo d'accueil ===== */
  .mc-video { max-width: 560px; margin: 26px auto 0; }

  /* L'agenda passe en action secondaire : le canal prime. */
  .mc-video + .fc-actions { margin-top: 22px; }

  /* ===== Mobile : les boutons de canal dans le premier écran =====
     La page est vue juste après une inscription venue de la publicité, sur
     téléphone. Le haut de page — sceau, titre, sous-titre — est resserré pour
     que les deux boutons soient visibles sans défiler. Les règles sont scopées
     à cette page : funnel-confirm.css sert aussi /parcours-initiation/bienvenue,
     qui n'a pas le même impératif. */
  @media (max-width: 640px) {
    .fc-hero { padding-top: clamp(94px, 20vw, 126px); padding-bottom: 32px; }
    .fc-seal { width: 62px; height: 62px; margin-bottom: 16px; }
    .fc-seal svg { width: 32px; height: 32px; }
    .fc-hero h1 { font-size: clamp(1.45rem, 5.4vw, 1.8rem); max-width: 16ch; }
    .fc-hero-sub { font-size: .94rem; line-height: 1.5; margin-top: 12px; }
    .mc-canaux { margin-top: 22px; }
    .mc-canaux .fc-actions { margin-top: 10px; }
    .fc-recap { margin-top: 24px; }
    .mc-video { margin-top: 22px; }
  }
</style>
