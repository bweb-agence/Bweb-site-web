---
import { whatsappLink } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import IllusSaas from "../components/illus/IllusSaas.astro";
---

<BaseLayout title="Création de SaaS sur-mesure | Bweb" description="MVP, plateforme d'abonnement ou outil métier : Bweb conçoit des applications SaaS robustes, évolutives et pensées pour vos utilisateurs.">
<section class="page-hero" data-nav-section="Création de SaaS">
  <div class="mesh-bg"></div>
  <div class="grid-lines"></div>
  <div class="container">
    <div class="breadcrumb"><a href="/">Accueil</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
      <a href="/services">Services</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
      <span>Création de SaaS</span>
    </div>
    <div class="page-hero-grid">
      <div class="text-white" data-hero-in>
        <div class="eyebrow on-dark">Applications SaaS</div>
        <h1>Votre idée, transformée en produit SaaS prêt à vendre.</h1>
        <p class="lead">MVP, plateforme d'abonnement ou outil métier : nous concevons des applications SaaS robustes, pensées pour vos utilisateurs et prêtes à grandir avec votre activité.</p>
        <div class="hero-actions" style="margin-top:32px;margin-bottom:0">
          <a href="/devis" class="btn btn-warm">Demander un devis pour mon SaaS</a>
          <a href="/services" class="btn btn-outline-light">Tous nos services</a>
        </div>
      </div>
      <div class="visual" data-hero-in>
        <IllusSaas />
      </div>
    </div>
  </div>
</section>

<section class="section" data-nav-section="Notre approche">
  <div class="container">
    <div class="split-block split-block--text-wide">
      <div class="reveal">
        <div class="eyebrow">Ce que comprend ce service</div>
        <h2>Un produit SaaS pensé pour votre activité, pas un prototype figé.</h2>
        <p class="lead" style="margin:20px 0">MVP à valider, plateforme d'abonnement ou outil métier interne : chaque application est conçue autour de vos utilisateurs, sécurisée et prête à évoluer avec votre croissance.</p>
      </div>
      <div class="card reveal" data-delay=".1">
        <ul class="tick-list">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>MVP &amp; prototype fonctionnel</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Espace multi-utilisateurs &amp; gestion des rôles</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Abonnements &amp; paiement en ligne</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Tableau de bord d'administration</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>API &amp; intégrations tierces</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Infrastructure évolutive &amp; hébergement</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Sécurité des données</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Maintenance &amp; évolutions continues</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="section section-gray" data-nav-section="Autres services">
  <div class="container">
    <div class="section-head center reveal">
      <div class="eyebrow" style="justify-content:center">Explorez aussi</div>
      <h2>Nos autres services</h2>
    </div>
    <div class="grid grid-3" data-stagger>
      <a class="card service-card" href="/services-conseil-strategie"><h4>Conseil &amp; stratégie digitale</h4><p style="margin-top:8px">Diagnostic et plan d'action personnalisé.</p></a>
      <a class="card service-card" href="/services-marketing-digital"><h4>Marketing digital</h4><p style="margin-top:8px">Réseaux sociaux, contenu et publicité.</p></a>
      <a class="card service-card" href="/services-digitalisation"><h4>Digitalisation des entreprises</h4><p style="margin-top:8px">CRM, outils métiers et process numériques.</p></a>
    </div>
  </div>
</section>

<section class="section" data-nav-section="Contact">
  <div class="container">
    <div class="cta-band reveal-scale">
      <div class="mesh-bg"></div>
      <div class="grid-lines"></div>
      <div style="position:relative;z-index:2">
        <h2 class="text-white">Un projet de SaaS en tête ?</h2>
        <p class="lead text-white">Décrivez-nous votre projet, nous revenons vers vous avec une proposition claire.</p>
        <div class="hero-actions">
          <a href="/devis" class="btn btn-warm">Demander un devis pour mon SaaS</a>
          <a href={whatsappLink()} class="btn btn-outline-light" data-whatsapp-link target="_blank" rel="noopener">Discuter sur WhatsApp</a>
        </div>
      </div>
    </div>
  </div>
</section>
</BaseLayout>
