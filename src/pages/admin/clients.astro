---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import Card from "../../components/starwind/card/Card.astro";
import Button from "../../components/starwind/button/Button.astro";

// KPIs — même traitement que le tableau de bord (cartes Starwind + accents).
const kpis = [
  { key: "clients", label: "Clients payants", accent: "green", icon: '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 19a5.6 5.6 0 0 1 11 0"/><path d="M16 5.5a3 3 0 0 1 0 5.5M22 19a6 6 0 0 0-4-5.6"/>' },
  { key: "prospects", label: "Prospects", accent: "blue", icon: '<circle cx="12" cy="8" r="3.4"/><path d="M5.5 20a6.5 6.5 0 0 1 13 0"/>' },
  { key: "ca", label: "CA confirmé", accent: "navy", icon: '<rect x="2.5" y="6" width="19" height="12" rx="2"/><circle cx="12" cy="12" r="2.4"/><path d="M6 10v4M18 10v4"/>' },
  { key: "taux", label: "Taux conversion", accent: "violet", icon: '<path d="M3 17l6-6 4 4 7-7"/><path d="M17 8h4v4"/>' },
  { key: "relance", label: "À relancer", accent: "amber", icon: '<path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/>' },
];
const accentClass: Record<string, string> = {
  green: "bg-success text-success-foreground",
  blue: "bg-blue/10 text-blue",
  navy: "bg-navy/10 text-navy",
  violet: "bg-[color-mix(in_srgb,#6b4df0_12%,#fff)] text-[#6b4df0]",
  amber: "bg-warning text-warning-foreground",
};
---

<AdminLayout title="Clients" active="clients">
  <div class="sw space-y-6">
    <!-- KPIs -->
    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-5">
      {kpis.map((k) => (
        <Card class="p-3.5 sm:p-5">
          <div class="flex items-center gap-2.5 sm:gap-3.5">
            <span class={`grid size-9 shrink-0 place-items-center rounded-xl sm:size-11 ${accentClass[k.accent]}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-[18px] sm:size-5" set:html={k.icon} />
            </span>
            <div class="min-w-0">
              <div class="text-[0.68rem] leading-tight font-bold tracking-wide text-muted-foreground uppercase sm:text-xs">{k.label}</div>
              <div class="mt-1 font-display text-lg leading-tight font-extrabold text-foreground tabular-nums sm:text-xl md:text-2xl" data-kpi={k.key}>—</div>
            </div>
          </div>
        </Card>
      ))}
    </div>

    <!-- Filtres + export : une seule ligne -->
    <div class="admin-toolbar crm-toolbar">
      <input class="admin-search" id="c-search" type="search" placeholder="Nom, e-mail, téléphone…" />
      <select class="admin-filter" id="c-status">
        <option value="">Tous les statuts</option>
        <option value="client">Clients payants</option>
        <option value="prospect">Prospects</option>
        <option value="relance">À relancer</option>
      </select>
      <select class="admin-filter" id="c-session"><option value="">Toutes les formations</option></select>
      <select class="admin-filter" id="c-gateway">
        <option value="">Toutes passerelles</option>
        <option value="paystack">Paystack</option>
        <option value="money_fusion">Money Fusion</option>
      </select>
      <select class="admin-filter" id="c-tag"><option value="">Tous les tags</option></select>
      <Button id="c-export" variant="outline" size="sm" class="crm-export">⬇ Exporter CSV</Button>
    </div>

    <!-- Liste -->
    <Card class="gap-0 overflow-hidden p-0">
      <div class="crm-head">
        <span></span><span>Client</span><span>Contact</span><span>Activité</span><span class="ta-r">Total dépensé</span><span class="ta-c">Statut</span><span></span>
      </div>
      <div class="crm-list" data-rows><div class="crm-loading">Chargement…</div></div>
    </Card>
  </div>

  <!-- Menu d'actions rapides (kebab) — position calculée, hors des cartes pour éviter le clip -->
  <div class="crm-rowmenu" id="crm-rowmenu" role="menu" hidden></div>

  <!-- Tiroir : fiche client -->
  <div class="a-drawer-overlay" id="overlay"></div>
  <aside class="a-drawer" id="drawer" aria-hidden="true">
    <div class="a-drawer-head">
      <div class="cd-head">
        <span class="avatar" data-d="avatar">—</span>
        <div>
          <h3 data-d="name">—</h3>
          <div class="meta" data-d="meta">—</div>
          <div style="margin-top:8px" data-d="badge"></div>
        </div>
      </div>
      <button class="icon-btn" id="close-btn">✕</button>
    </div>
    <div class="a-drawer-body" data-d="body"></div>
  </aside>
</AdminLayout>

<script>
  import { supabaseBrowser } from "../../lib/supabaseBrowser";
  import { esc, fmtFCFA, dshort, toast } from "../../scripts/adminUtils";
  import { site } from "../../config/site";

  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const rows = document.querySelector("[data-rows]")!;

  // ---- Types ----
  type Booking = {
    id: string; reference: string; session_id: string; quantity: number;
    full_name: string; email: string | null; phone: string | null; company: string | null;
    amount_due: number; amount_paid: number | null; is_deposit: boolean;
    payment_method: string | null; payment_reference: string | null; status: string; payment_status: string | null;
    attendance_mode: string | null; created_at: string;
    sessions?: { title: string; slug: string; starts_at: string | null; venue: string | null; city: string | null } | null;
    ticket_types?: { name: string } | null;
  };
  type Customer = {
    id: string; email: string; tags: string[]; notes: string | null;
    whatsapp_opt_in: boolean; email_opt_in: boolean; last_contacted_at: string | null;
  };
  type Client = {
    key: string; name: string; email: string; phone: string; company: string;
    bookings: Booking[]; status: "client" | "prospect" | "relance";
    ca: number; nbConfirmed: number; lastActivity: string; sessionIds: Set<string>; gateways: Set<string>;
    // Enrichissement CRM (table customers) — présent seulement si e-mail connu
    customer: Customer | null;
  };

  const PRESET_TAGS = ["VIP", "Entreprise", "Fidèle", "Chaud", "Froid"];

  const PALETTE = ["#1f6ced,#00c89e", "#ff835f,#ffc72a", "#7b5cff,#1f6ced", "#00c89e,#0aa886", "#565d80,#8b91ae", "#f2971d,#ff835f", "#1550b8,#1f6ced"];
  const methodLabel: Record<string, string> = { wave: "Wave", orange_money: "Orange Money", mobile_money: "Mobile Money", sur_place: "Sur place", money_fusion: "Money Fusion", paystack: "Paystack" };
  const statusMeta: Record<string, { cls: string; label: string }> = {
    client: { cls: "client", label: "Client" }, prospect: { cls: "prospect", label: "Prospect" }, relance: { cls: "relance", label: "À relancer" },
  };
  const modeLabel: Record<string, string> = { presentiel: "Présentiel", en_ligne: "En ligne" };
  const txPill: Record<string, string> = {
    confirmed: '<span class="tag-pill ok">Réussi</span>', pending: '<span class="tag-pill wait">En attente</span>',
    cancelled: '<span class="tag-pill full">Annulé</span>', waitlist: '<span class="tag-pill pub">Liste d\'attente</span>',
  };
  // État réel d'une transaction (paiement automatique) : payé / en attente /
  // échoué / abandon / annulé — cf. bookings.payment_status (migration 0024).
  const txStateOf = (b: Booking): string =>
    b.status === "confirmed" ? "paye" : b.status === "cancelled" ? "annule" : (b.payment_status || "attente");
  const txStatePill: Record<string, string> = {
    paye: '<span class="tag-pill ok">Réussi</span>', attente: '<span class="tag-pill wait">En attente</span>',
    echoue: '<span class="tag-pill fail">Échoué</span>', abandon: '<span class="tag-pill abandon">Abandon</span>',
    annule: '<span class="tag-pill full">Annulé</span>',
  };

  const digits = (s: string | null) => (s || "").replace(/\D/g, "");
  const firstName = (n: string) => (n || "").trim().split(/\s+/)[0] || "";
  const initials = (n: string) => {
    const p = (n || "").trim().split(/\s+/).filter(Boolean);
    return ((p[0]?.[0] || "") + (p[1]?.[0] || "")).toUpperCase() || "?";
  };
  const hash = (s: string) => { let h = 0; for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0; return Math.abs(h); };
  const avatarBg = (key: string) => `linear-gradient(135deg,${PALETTE[hash(key) % PALETTE.length]})`;
  const paidOf = (b: Booking) => Number(b.amount_paid) || (b.is_deposit ? Math.ceil(b.amount_due / 2) : b.amount_due);
  const nowMs = Date.now();

  let clients: Client[] = [];

  // ---- Agrégation : une ligne client = réservations regroupées par e-mail (repli : téléphone) ----
  function aggregate(bookings: Booking[]): Client[] {
    const map = new Map<string, Client>();
    for (const b of bookings) {
      const email = (b.email || "").trim().toLowerCase();
      const key = email || (digits(b.phone) ? "tel:" + digits(b.phone) : "");
      if (!key) continue;
      let c = map.get(key);
      if (!c) {
        c = { key, name: b.full_name || email || b.phone || "—", email: b.email || "", phone: b.phone || "", company: b.company || "", bookings: [], status: "prospect", ca: 0, nbConfirmed: 0, lastActivity: b.created_at, sessionIds: new Set(), gateways: new Set(), customer: null };
        map.set(key, c);
      }
      // Les réservations arrivent triées du + récent au + ancien : la 1re non vide gagne pour l'identité
      if (!c.email && b.email) c.email = b.email;
      if (!c.phone && b.phone) c.phone = b.phone;
      if (!c.company && b.company) c.company = b.company;
      c.bookings.push(b);
      if (b.session_id) c.sessionIds.add(b.session_id);
      if (b.payment_method) c.gateways.add(b.payment_method);
      if (b.created_at > c.lastActivity) c.lastActivity = b.created_at;
    }
    const list = [...map.values()];
    for (const c of list) {
      const confirmed = c.bookings.filter((b) => b.status === "confirmed");
      c.nbConfirmed = confirmed.length;
      c.ca = confirmed.reduce((a, b) => a + paidOf(b), 0);
      const hasPending = c.bookings.some((b) => b.status === "pending");
      c.status = confirmed.length ? "client" : hasPending ? "relance" : "prospect";
    }
    return list.sort((a, b) => (a.lastActivity < b.lastActivity ? 1 : -1));
  }

  function renderKpis() {
    const nbClients = clients.filter((c) => c.status === "client").length;
    const nbProspects = clients.filter((c) => c.status === "prospect").length;
    const nbRelance = clients.filter((c) => c.status === "relance").length;
    const ca = clients.reduce((a, c) => a + c.ca, 0);
    const taux = clients.length ? Math.round((nbClients / clients.length) * 100) : 0;
    const set = (k: string, v: string) => { const el = document.querySelector(`[data-kpi="${k}"]`); if (el) el.innerHTML = v; };
    set("clients", String(nbClients)); set("prospects", String(nbProspects));
    set("ca", fmtFCFA(ca)); set("taux", taux + " %"); set("relance", String(nbRelance));
  }

  function render(list: Client[]) {
    rows.innerHTML = list.length ? list.map((c, idx) => {
      const m = statusMeta[c.status];
      const contact = c.phone || c.email || "—";
      const allT = c.customer?.tags || [];
      const tags = allT.slice(0, 2).map((t) => `<span class="crm-tag sm">${esc(t)}</span>`).join("")
        + (allT.length > 2 ? `<span class="crm-tag sm more" title="${esc(allT.slice(2).join(", "))}">+${allT.length - 2}</span>` : "");
      return `<div class="crm-row" data-idx="${idx}" role="button" tabindex="0">
        <span class="avatar crm-av" style="background:${avatarBg(c.key)}">${esc(initials(c.name))}</span>
        <div class="crm-id"><b>${esc(c.name)}${tags ? ' <span class="crm-tags-inline">' + tags + "</span>" : ""}</b><span class="sub">${esc(c.email || "—")}</span></div>
        <div class="crm-contact">${esc(contact)}</div>
        <div class="crm-activity"><b>${c.bookings.length}</b> réserv.<span class="crm-dot">·</span>${dshort(c.lastActivity)}</div>
        <div class="crm-ca money">${fmtFCFA(c.ca)}</div>
        <div class="crm-status"><span class="tag-pill ${m.cls} dot">${m.label}</span></div>
        <div class="crm-actions">
          <button class="ic crm-kebab" data-menu="${idx}" title="Actions rapides" aria-label="Actions rapides" aria-haspopup="true"><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="1.9"/><circle cx="12" cy="12" r="1.9"/><circle cx="12" cy="19" r="1.9"/></svg></button>
        </div>
      </div>`;
    }).join("") : `<div class="crm-empty">Aucun client.</div>`;

    const open = (el: HTMLElement, e: Event) => { if (!(e.target as HTMLElement).closest("[data-menu]")) openDrawer(+el.dataset.idx!); };
    rows.querySelectorAll<HTMLElement>(".crm-row").forEach((row) => {
      row.addEventListener("click", (e) => open(row, e));
      row.addEventListener("keydown", (e) => { if ((e as KeyboardEvent).key === "Enter") open(row, e); });
    });
    rows.querySelectorAll<HTMLElement>("[data-menu]").forEach((el) =>
      el.addEventListener("click", (e) => { e.stopPropagation(); openRowMenu(list[+el.dataset.menu!], +el.dataset.menu!, el); }));
  }

  // ---- Menu d'actions rapides (kebab) ----
  const rowMenu = document.getElementById("crm-rowmenu")!;
  function closeRowMenu() { rowMenu.hidden = true; rowMenu.innerHTML = ""; rowMenu.classList.remove("open"); }
  function openRowMenu(c: Client, idx: number, btn: HTMLElement) {
    if (rowMenu.classList.contains("open") && rowMenu.dataset.idx === String(idx)) { closeRowMenu(); return; }
    const waOk = c.customer?.whatsapp_opt_in !== false;
    const mailOk = c.customer?.email_opt_in !== false;
    const svgEye = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
    const svgWa = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5-1.4A10 10 0 1 0 12 2z"/></svg>';
    const svgMail = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>';
    const svgTel = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>';
    const items: string[] = [`<button type="button" role="menuitem" data-act="view">${svgEye}Voir la fiche</button>`];
    if (digits(c.phone) && waOk) items.push(`<button type="button" role="menuitem" data-act="wa">${svgWa}WhatsApp</button>`);
    if (c.email && mailOk) items.push(`<a role="menuitem" data-act="mail" href="mailto:${encodeURIComponent(c.email)}">${svgMail}E-mail</a>`);
    if (c.phone) items.push(`<a role="menuitem" data-act="tel" href="tel:${esc(c.phone.replace(/\s/g, ""))}">${svgTel}Appeler</a>`);
    rowMenu.innerHTML = items.join("");
    rowMenu.dataset.idx = String(idx);
    rowMenu.hidden = false;
    rowMenu.classList.add("open");
    // Positionnement fixe sous le bouton (aligné à droite ; bascule vers le haut si besoin)
    const r = btn.getBoundingClientRect();
    const mw = rowMenu.offsetWidth, mh = rowMenu.offsetHeight;
    let left = Math.max(8, r.right - mw);
    let top = r.bottom + 6;
    if (top + mh > window.innerHeight - 8) top = Math.max(8, r.top - mh - 6);
    rowMenu.style.left = left + "px";
    rowMenu.style.top = top + "px";
    // Actions
    rowMenu.querySelector('[data-act="view"]')?.addEventListener("click", () => { closeRowMenu(); openDrawer(idx); });
    rowMenu.querySelector('[data-act="wa"]')?.addEventListener("click", () => { closeRowMenu(); markContacted(c); waGeneric(c); });
    rowMenu.querySelector('[data-act="mail"]')?.addEventListener("click", () => { markContacted(c); closeRowMenu(); });
    rowMenu.querySelector('[data-act="tel"]')?.addEventListener("click", () => { markContacted(c); closeRowMenu(); });
  }
  document.addEventListener("click", (e) => { if (!rowMenu.hidden && !(e.target as HTMLElement).closest("#crm-rowmenu, .crm-kebab")) closeRowMenu(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeRowMenu(); });
  window.addEventListener("resize", closeRowMenu);
  rows.addEventListener("scroll", closeRowMenu, true);

  // ---- Liens de relance / contact (un-à-un) ----
  const sessionUrl = (slug?: string | null) => slug ? `${site.url}/formations/session/${slug}` : `${site.url}/formations`;
  function waGeneric(c: Client) {
    const msg = `Bonjour ${firstName(c.name)} 👋 C'est l'équipe Bweb Agence.`;
    window.open(`https://wa.me/${digits(c.phone)}?text=${encodeURIComponent(msg)}`, "_blank", "noopener");
  }
  function relanceMsg(c: Client, b: Booking) {
    return `Bonjour ${firstName(c.name)} 👋 Vous aviez commencé à réserver « ${b.sessions?.title || "une formation"} » chez Bweb Agence, mais le paiement n'a pas été finalisé. Votre place est encore disponible — souhaitez-vous confirmer votre inscription ? Voici le lien : ${sessionUrl(b.sessions?.slug)}`;
  }

  // ---- Enrichissement CRM (table customers) ----
  // Persiste tags / notes / consentement / dernier contact. Création paresseuse
  // (upsert par e-mail) si la fiche customer n'existe pas encore.
  async function saveCustomer(c: Client, patch: Partial<Customer>): Promise<boolean> {
    if (!c.email) return false;
    const email = c.email.trim().toLowerCase();
    const { data, error } = await supabaseBrowser.from("customers")
      .upsert({ email, ...patch }, { onConflict: "email" })
      .select("id,email,tags,notes,whatsapp_opt_in,email_opt_in,last_contacted_at").single();
    if (error || !data) return false;
    c.customer = data as Customer;
    return true;
  }
  async function markContacted(c: Client) {
    if (!c.email) return;
    await saveCustomer(c, { last_contacted_at: new Date().toISOString() });
  }
  const allTags = () => [...new Set(clients.flatMap((c) => c.customer?.tags || []))].sort();

  // ---- Fiche client (tiroir) ----
  const drawer = document.getElementById("drawer")!, overlay = document.getElementById("overlay")!;
  const openD = () => { drawer.classList.add("open"); overlay.classList.add("open"); document.body.style.overflow = "hidden"; };
  const closeD = () => { drawer.classList.remove("open"); overlay.classList.remove("open"); document.body.style.overflow = ""; };

  function openDrawer(idx: number, keepScroll = false) {
    const c = clients[idx];
    const m = statusMeta[c.status];
    const bodyEl = document.querySelector('[data-d="body"]') as HTMLElement;
    const savedScroll = keepScroll ? bodyEl.scrollTop : 0;
    const setD = (k: string, html: string) => { const el = document.querySelector(`[data-d="${k}"]`)!; el.innerHTML = html; };
    (document.querySelector('[data-d="avatar"]') as HTMLElement).style.background = avatarBg(c.key);
    setD("avatar", esc(initials(c.name)));
    setD("name", esc(c.name));
    setD("meta", esc([c.email, c.phone].filter(Boolean).join(" · ") || "—") + (c.company ? ` · ${esc(c.company)}` : ""));
    setD("badge", `<span class="tag-pill ${m.cls} dot">${m.label}</span>`);

    // Stats
    const panier = c.nbConfirmed ? Math.round(c.ca / c.nbConfirmed) : 0;
    const confirmedSessions = new Map<string, Booking>();
    c.bookings.filter((b) => b.status === "confirmed").forEach((b) => { if (b.session_id) confirmedSessions.set(b.session_id, b); });
    const aVenir = [...confirmedSessions.values()].filter((b) => b.sessions?.starts_at && new Date(b.sessions.starts_at).getTime() > nowMs).length;

    // Formations (sessions engagées, statut le + avancé)
    const rank: Record<string, number> = { confirmed: 3, pending: 2, waitlist: 1, cancelled: 0 };
    const bySession = new Map<string, Booking>();
    for (const b of c.bookings) {
      if (!b.session_id) continue;
      const cur = bySession.get(b.session_id);
      if (!cur || (rank[b.status] || 0) > (rank[cur.status] || 0)) bySession.set(b.session_id, b);
    }
    const formationsHtml = [...bySession.values()].map((b) => {
      const d = b.sessions?.starts_at ? new Date(b.sessions.starts_at) : null;
      const day = d ? d.toLocaleDateString("fr-FR", { day: "numeric" }) : "•";
      const mon = d ? d.toLocaleDateString("fr-FR", { month: "short" }).replace(".", "") : "";
      const lieu = [b.attendance_mode ? modeLabel[b.attendance_mode] : "", b.sessions?.venue || b.sessions?.city || ""].filter(Boolean).join(" · ");
      const upcoming = d && d.getTime() > nowMs;
      const pill = b.status === "confirmed" && upcoming ? '<span class="tag-pill pub">À venir</span>' : (txPill[b.status] || "");
      return `<div class="cd-line">
        <span class="medal"><span class="d">${day}</span><span class="m">${esc(mon)}</span></span>
        <div class="lbody"><div class="lt">${esc(b.sessions?.title || "Formation")}</div><div class="ls">${d ? dshort(b.sessions?.starts_at) : "Date à venir"}${lieu ? " · " + esc(lieu) : ""}</div></div>
        <div class="lr">${pill}</div></div>`;
    }).join("") || `<p class="cd-empty">Aucune formation pour l'instant.</p>`;

    // Historique transactions
    const txHtml = c.bookings.map((b) => {
      const gw = b.payment_method ? methodLabel[b.payment_method] || b.payment_method : "—";
      const extra = [dshort(b.created_at), gw, b.is_deposit ? "acompte" : "", b.payment_reference ? "réf " + b.payment_reference.slice(0, 8) + "…" : ""].filter(Boolean).join(" · ");
      return `<div class="cd-line"${b.status === "cancelled" ? ' style="opacity:.7"' : ""}>
        <div class="lbody"><div class="lt">${esc(b.reference)} · ${esc(b.ticket_types?.name || "")}</div><div class="ls">${esc(extra)}</div></div>
        <div class="lr"><span class="money">${fmtFCFA(paidOf(b))}</span>${txStatePill[txStateOf(b)] || esc(b.status)}</div></div>`;
    }).join("");

    // Consentement (par défaut : accepte, tant que non explicitement désabonné)
    const cust = c.customer;
    const waOk = cust?.whatsapp_opt_in !== false;
    const mailOk = cust?.email_opt_in !== false;
    const hasPhone = !!digits(c.phone);
    const waMsgGeneric = "Bonjour " + firstName(c.name) + " 👋 C'est l'équipe Bweb Agence.";
    const svgWa = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5-1.4A10 10 0 1 0 12 2z"/></svg>';
    const svgMail = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>';

    // Relance : la dernière transaction non aboutie — en priorité une qui a
    // ÉCHOUÉ (paiement tenté sans être finalisé), sinon abandon, sinon en attente.
    const relanceBooking =
      c.bookings.find((b) => txStateOf(b) === "echoue") ||
      c.bookings.find((b) => txStateOf(b) === "abandon") ||
      c.bookings.find((b) => txStateOf(b) === "attente");
    let relanceHtml = "";
    if (relanceBooking) {
      const st = txStateOf(relanceBooking);
      const stLabel = st === "echoue" ? "Paiement échoué" : st === "abandon" ? "Paiement abandonné" : "Réservation en attente";
      const relanceDesc = `${stLabel} sur sa dernière transaction (${relanceBooking.reference}). Message pré-rempli avec son prénom et le lien de la formation.`;
      const svgInfo = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7.6h.01"/></svg>';
      const msg = relanceMsg(c, relanceBooking);
      const wa = hasPhone
        ? (waOk ? `<a class="abtn wa sm" data-track target="_blank" rel="noopener" href="https://wa.me/${digits(c.phone)}?text=${encodeURIComponent(msg)}">${svgWa}Relancer sur WhatsApp</a>` : `<span class="crm-optout">🔕 Désabonné WhatsApp</span>`)
        : "";
      const mail = c.email
        ? (mailOk ? `<a class="abtn sm" data-track target="_blank" rel="noopener" href="mailto:${encodeURIComponent(c.email)}?subject=${encodeURIComponent("Votre inscription chez Bweb Agence")}&body=${encodeURIComponent(msg)}">${svgMail}Relancer par e-mail</a>` : `<span class="crm-optout">🔕 Désabonné e-mail</span>`)
        : "";
      relanceHtml = `<div class="cd-relance">
        <div class="cd-relance-top">
          <b class="cd-relance-title" title="${esc(relanceDesc)}">Relancer ce client<span class="cd-relance-i" aria-hidden="true">${svgInfo}</span></b>
          <div class="btns">${wa}${mail}</div>
        </div></div>`;
    }

    // Actions de contact rapides — style secondaire (outline) pour laisser la
    // relance (bloc coloré plus bas) être l'action principale.
    const cWa = hasPhone && waOk ? `<a class="abtn sm" data-track target="_blank" rel="noopener" href="https://wa.me/${digits(c.phone)}?text=${encodeURIComponent(waMsgGeneric)}"><span class="ico-wa">${svgWa}</span>WhatsApp</a>` : "";
    const cMail = c.email && mailOk ? `<a class="abtn sm" data-track href="mailto:${encodeURIComponent(c.email)}">${svgMail}E-mail</a>` : "";
    const cTel = c.phone ? `<a class="abtn sm" data-track href="tel:${esc(c.phone.replace(/\s/g, ""))}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>Appeler</a>` : "";

    // Suivi client (tags / notes / consentement) — requiert un e-mail
    let enrichHtml: string;
    if (c.email) {
      const tags = cust?.tags || [];
      const presets = [...new Set([...PRESET_TAGS, ...tags])];
      const chips = presets.map((t) => `<button type="button" class="crm-tag toggle${tags.includes(t) ? " on" : ""}" data-tag="${esc(t)}">${esc(t)}</button>`).join("");
      const last = cust?.last_contacted_at ? dshort(cust.last_contacted_at) : "jamais";
      enrichHtml = `
        <div class="crm-tags-edit" data-tagbox>${chips}<input class="crm-tag-input" data-tag-new placeholder="+ tag" maxlength="24" /></div>
        <div class="crm-notes-wrap">
          <textarea class="a-textarea" data-notes placeholder="Notes internes (visibles admin uniquement)…" style="min-height:66px;margin-top:10px">${esc(cust?.notes || "")}</textarea>
          <span class="crm-saved" data-notes-saved hidden>Enregistré ✓</span>
        </div>
        <div class="crm-consent">
          <label><input type="checkbox" data-optin="whatsapp_opt_in" ${waOk ? "checked" : ""}/> Accepte WhatsApp</label>
          <label><input type="checkbox" data-optin="email_opt_in" ${mailOk ? "checked" : ""}/> Accepte e-mail</label>
        </div>
        <div class="crm-last">Dernier contact : <b data-lastcontact>${last}</b></div>`;
    } else {
      enrichHtml = `<p class="cd-empty">Ce client n'a pas d'e-mail — ajoutez-en un via une réservation pour activer tags, notes et consentement.</p>`;
    }

    setD("body", `
      <div class="cd-actions">${cWa}${cMail}${cTel}</div>
      <div class="cd-stats">
        <div class="cd-stat"><div class="k">CA confirmé</div><div class="v">${fmtFCFA(c.ca)}</div></div>
        <div class="cd-stat"><div class="k">Panier moyen</div><div class="v">${c.nbConfirmed ? fmtFCFA(panier) : "—"}</div></div>
        <div class="cd-stat"><div class="k">Formations</div><div class="v">${c.nbConfirmed}</div></div>
        <div class="cd-stat"><div class="k">À venir</div><div class="v">${aVenir}</div></div>
      </div>
      ${relanceHtml}
      <div class="cd-sect"><h4>Suivi client</h4>${enrichHtml}</div>
      <div class="cd-sect"><h4>Formations</h4>${formationsHtml}</div>
      <div class="cd-sect"><h4>Historique des transactions</h4>${txHtml}</div>`);
    wireDrawer(c, idx);
    if (keepScroll) bodyEl.scrollTop = savedScroll;
    openD();
  }

  // Branche les interactions du tiroir (contact, tags, notes, consentement)
  function wireDrawer(c: Client, idx: number) {
    const body = document.querySelector('[data-d="body"]')!;
    const bumpLast = () => { const el = body.querySelector("[data-lastcontact]"); if (el) el.textContent = dshort(new Date().toISOString()); };

    // Tout contact/relance = trace le dernier contact
    body.querySelectorAll<HTMLElement>("[data-track]").forEach((el) =>
      el.addEventListener("click", () => { markContacted(c).then(bumpLast); }));

    // Tags (préréglages + existants) : bascule + enregistrement
    const toggleTag = async (t: string, btn?: HTMLElement) => {
      const cur = new Set(c.customer?.tags || []);
      cur.has(t) ? cur.delete(t) : cur.add(t);
      const ok = await saveCustomer(c, { tags: [...cur] });
      if (!ok) { toast("Enregistrement impossible.", "err"); return false; }
      btn?.classList.toggle("on");
      populateTagFilter(); applyFilters();
      return true;
    };
    body.querySelectorAll<HTMLElement>("[data-tag]").forEach((btn) =>
      btn.addEventListener("click", () => toggleTag(btn.dataset.tag!, btn)));

    // Ajout d'un tag libre (Entrée)
    const newInput = body.querySelector<HTMLInputElement>("[data-tag-new]");
    newInput?.addEventListener("keydown", async (e) => {
      if (e.key !== "Enter") return;
      e.preventDefault();
      const v = newInput.value.trim();
      if (!v || (c.customer?.tags || []).includes(v)) { newInput.value = ""; return; }
      if (await toggleTag(v)) openDrawer(idx, true); // rebuild (nouvelle puce), scroll conservé
    });

    // Notes (enregistrées à la perte de focus) + indicateur discret « Enregistré ✓ »
    const notesEl = body.querySelector<HTMLTextAreaElement>("[data-notes]");
    const savedTag = body.querySelector<HTMLElement>("[data-notes-saved]");
    notesEl?.addEventListener("blur", async () => {
      if ((c.customer?.notes || "") === notesEl.value) return;
      if (await saveCustomer(c, { notes: notesEl.value })) {
        if (savedTag) { savedTag.hidden = false; setTimeout(() => { savedTag.hidden = true; }, 2200); }
      } else toast("Enregistrement impossible.", "err");
    });

    // Consentement (RGPD)
    body.querySelectorAll<HTMLInputElement>("[data-optin]").forEach((cb) =>
      cb.addEventListener("change", async () => {
        const ok = await saveCustomer(c, { [cb.dataset.optin!]: cb.checked } as Partial<Customer>);
        if (ok) { toast("Préférence enregistrée ✓"); openDrawer(idx, true); } // rebuild (maj boutons contact), scroll conservé
        else { cb.checked = !cb.checked; toast("Enregistrement impossible.", "err"); }
      }));
  }

  document.getElementById("close-btn")!.addEventListener("click", closeD);
  overlay.addEventListener("click", closeD);
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeD(); });

  // ---- Filtres ----
  function populateTagFilter() {
    const sel = $("c-tag"); const cur = sel.value;
    const tags = allTags();
    sel.innerHTML = '<option value="">Tous les tags</option>' + tags.map((t) => `<option value="${esc(t)}">${esc(t)}</option>`).join("");
    if (tags.includes(cur)) sel.value = cur;
  }
  function applyFilters() {
    const q = ($("c-search").value || "").toLowerCase().trim();
    const st = $("c-status").value, sess = $("c-session").value, gw = $("c-gateway").value, tag = $("c-tag").value;
    render(clients.filter((c) =>
      (!st || c.status === st) &&
      (!sess || c.sessionIds.has(sess)) &&
      (!gw || c.gateways.has(gw)) &&
      (!tag || (c.customer?.tags || []).includes(tag)) &&
      (!q || (c.name + " " + c.email + " " + c.phone).toLowerCase().includes(q))));
  }

  function exportCsv() {
    const head = ["Nom", "E-mail", "Téléphone", "Entreprise", "Réservations", "Confirmées", "CA confirmé", "Statut", "Tags", "WhatsApp OK", "E-mail OK", "Dernier contact", "Dernière activité", "Formations"];
    const lines = clients.map((c) => {
      const titles = [...new Set(c.bookings.map((b) => b.sessions?.title).filter(Boolean))].join(" | ");
      const cu = c.customer;
      return [c.name, c.email, c.phone, c.company, c.bookings.length, c.nbConfirmed, c.ca, statusMeta[c.status].label,
        (cu?.tags || []).join(" | "), cu ? (cu.whatsapp_opt_in ? "oui" : "non") : "", cu ? (cu.email_opt_in ? "oui" : "non") : "",
        cu?.last_contacted_at ? new Date(cu.last_contacted_at).toISOString() : "", new Date(c.lastActivity).toISOString(), titles]
        .map((v) => `"${String(v ?? "").replace(/"/g, '""')}"`).join(",");
    });
    const csv = [head.join(","), ...lines].join("\n");
    const url = URL.createObjectURL(new Blob(["﻿" + csv], { type: "text/csv;charset=utf-8" }));
    const a = document.createElement("a"); a.href = url; a.download = "clients-bweb.csv"; a.click(); URL.revokeObjectURL(url);
  }

  $("c-search").addEventListener("input", applyFilters);
  $("c-status").addEventListener("change", applyFilters);
  $("c-session").addEventListener("change", applyFilters);
  $("c-gateway").addEventListener("change", applyFilters);
  $("c-tag").addEventListener("change", applyFilters);
  document.getElementById("c-export")!.addEventListener("click", exportCsv);

  async function load() {
    const [{ data }, { data: custs }] = await Promise.all([
      supabaseBrowser.from("bookings")
        .select("id,reference,session_id,quantity,full_name,email,phone,company,amount_due,amount_paid,is_deposit,payment_method,payment_reference,status,payment_status,attendance_mode,created_at,sessions(title,slug,starts_at,venue,city),ticket_types(name)")
        .order("created_at", { ascending: false }),
      supabaseBrowser.from("customers").select("id,email,tags,notes,whatsapp_opt_in,email_opt_in,last_contacted_at"),
    ]);
    clients = aggregate((data || []) as unknown as Booking[]);
    // Fusion de l'enrichissement CRM (table customers) par e-mail
    const byEmail = new Map<string, Customer>();
    (custs || []).forEach((c: any) => byEmail.set(String(c.email).toLowerCase(), c as Customer));
    clients.forEach((c) => { if (c.email) c.customer = byEmail.get(c.email.toLowerCase()) || null; });
    renderKpis();
    populateTagFilter();
    applyFilters();
  }

  (async () => {
    const { data: { session } } = await supabaseBrowser.auth.getSession();
    if (!session) return; // AdminLayout gère la redirection
    const { data: ss } = await supabaseBrowser.from("sessions").select("id,title").order("starts_at", { ascending: false });
    $("c-session").innerHTML = '<option value="">Toutes les formations</option>' + (ss || []).map((s: any) => `<option value="${s.id}">${esc(s.title)}</option>`).join("");
    await load();
  })();
</script>
