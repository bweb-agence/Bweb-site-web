---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import Card from "../../components/starwind/card/Card.astro";
import Button from "../../components/starwind/button/Button.astro";
---

<AdminLayout title="Articles" active="articles">
  <div class="sw space-y-6">
    <div class="admin-toolbar">
      <div class="left">
        <input class="admin-search" id="art-search" type="search" placeholder="Rechercher un article…" />
      </div>
      <Button variant="primary" id="art-new">+ Nouvel article</Button>
    </div>

    <Card class="gap-0 overflow-hidden p-0">
      <div class="overflow-x-auto">
        <table class="admin-table min-w-[700px]">
          <thead><tr><th>Titre</th><th>Catégorie</th><th>SEO</th><th>Statut</th><th>Publié le</th><th></th></tr></thead>
          <tbody data-rows><tr class="a-loading-row"><td colspan="6">Chargement…</td></tr></tbody>
        </table>
      </div>
    </Card>
  </div>

  <!-- Tiroir éditeur -->
  <div class="a-drawer-overlay" id="art-overlay"></div>
  <aside class="a-drawer" id="art-drawer" aria-hidden="true">
    <div class="a-drawer-head">
      <h2 id="art-drawer-title">Nouvel article</h2>
      <button class="icon-btn" id="art-close" aria-label="Fermer">✕</button>
    </div>
    <div class="a-drawer-body">
      <input type="hidden" id="f-id" />
      <div class="a-field"><label for="f-title">Titre *</label><input class="a-input" id="f-title" /></div>
      <div class="a-field"><label for="f-slug">Slug (URL) *</label><input class="a-input" id="f-slug" /><div class="hint">Adresse : /blog/<span id="slug-preview">…</span></div></div>
      <div class="a-row2">
        <div class="a-field"><label for="f-category">Catégorie</label>
          <input class="a-input" id="f-category" list="cat-list" />
          <datalist id="cat-list"><option value="IA"></option><option value="Marketing"></option><option value="Automatisation"></option><option value="Vente en ligne"></option><option value="Cas clients"></option></datalist>
        </div>
        <div class="a-field"><label for="f-reading">Temps de lecture (min)</label><input class="a-input" id="f-reading" type="number" min="1" /></div>
      </div>
      <div class="a-field"><label for="f-excerpt">Extrait</label><textarea class="a-textarea" id="f-excerpt" rows="2"></textarea></div>
      <div class="a-field"><label for="f-cover">Image de couverture (URL)</label><input class="a-input" id="f-cover" placeholder="https://… (optionnel)" /></div>
      <div class="a-field"><label for="f-body">Corps de l'article (Markdown)</label><textarea class="a-textarea code" id="f-body" rows="12" placeholder="## Titre de section&#10;Votre texte…"></textarea></div>

      <div class="a-section-title">Publication &amp; SEO</div>
      <div class="a-row2">
        <div class="a-field"><label for="f-status">Statut</label><select class="a-select" id="f-status"><option value="draft">Brouillon</option><option value="published">Publié</option></select></div>
        <div class="a-field"><label for="f-author">Auteur</label><input class="a-input" id="f-author" value="Équipe Bweb" /></div>
      </div>
      <div class="a-field"><label for="f-pubdate">Date de publication</label><input class="a-input" id="f-pubdate" type="datetime-local" /><div class="hint">Laisser vide = date du jour à la publication.</div></div>
      <div class="a-field"><label for="f-seotitle">Titre SEO (optionnel)</label><input class="a-input" id="f-seotitle" /></div>
      <div class="a-field"><label for="f-seodesc">Description SEO (optionnel)</label><textarea class="a-textarea" id="f-seodesc" rows="2"></textarea></div>
    </div>
    <div class="a-drawer-foot">
      <span class="grow"></span>
      <button class="abtn" id="art-cancel">Annuler</button>
      <button class="abtn primary" id="art-save">Enregistrer</button>
    </div>
  </aside>
</AdminLayout>

<script>
  import { supabaseBrowser } from "../../lib/supabaseBrowser";
  import { slugify, esc, dshort, dtLocalValue, toast, confirmModal } from "../../scripts/adminUtils";
  import { analyzeSeo } from "../../scripts/editor/seo";
  import { marked } from "marked";

  function seoBadge(p: any): string {
    const html = p.body_html || (p.body_md ? (marked.parse(p.body_md, { async: false }) as string) : "");
    const r = analyzeSeo({ title: p.title, slug: p.slug, metaTitle: p.seo_title || "", metaDescription: p.seo_description || "",
      excerpt: p.excerpt || "", html, focusKeyword: p.focus_keyword || "", coverUrl: p.cover_url || "" });
    const c = r.grade === "ok" ? "success" : r.grade === "warn" ? "warning" : "danger";
    return `<span title="Score SEO ${r.score}/100" style="display:inline-flex;align-items:center;font-weight:800;font-size:.76rem;padding:3px 9px;border-radius:999px;background:var(--c-${c}-bg);color:var(--c-${c});font-variant-numeric:tabular-nums">${r.score}</span>`;
  }

  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const rows = document.querySelector("[data-rows]")!;
  const drawer = document.getElementById("art-drawer")!;
  const overlay = document.getElementById("art-overlay")!;
  let all: any[] = [];
  let slugTouched = false;

  const openDrawer = () => { drawer.classList.add("open"); overlay.classList.add("open"); document.body.style.overflow = "hidden"; };
  const closeDrawer = () => { drawer.classList.remove("open"); overlay.classList.remove("open"); document.body.style.overflow = ""; };

  function render(list: any[]) {
    if (!list.length) { rows.innerHTML = `<tr><td class="empty" colspan="6">Aucun article. Cliquez sur « Nouvel article ».</td></tr>`; return; }
    rows.innerHTML = list.map((p) => `
      <tr>
        <td><a href="/admin/editeur/article/${p.id}" class="row-title"><strong>${esc(p.title)}</strong></a><br><span style="color:var(--c-gray-500);font-size:.78rem">/blog/${esc(p.slug)}</span></td>
        <td>${esc(p.category || "—")}</td>
        <td>${seoBadge(p)}</td>
        <td>${p.status === "published" ? '<span class="tag-pill pub">Publié</span>' : '<span class="tag-pill draft">Brouillon</span>'}</td>
        <td>${p.status === "published" ? dshort(p.published_at) : "—"}</td>
        <td><div class="row-actions">
          ${p.status === "published" ? `<a class="icon-btn" href="/blog/${esc(p.slug)}" target="_blank" title="Voir"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></a>` : ""}
          <button class="icon-btn" data-edit="${p.id}" title="Éditer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></button>
          <button class="icon-btn danger" data-del="${p.id}" title="Supprimer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg></button>
        </div></td>
      </tr>`).join("");
    rows.querySelectorAll<HTMLElement>("[data-edit]").forEach((b) => b.addEventListener("click", () => edit(b.dataset.edit!)));
    rows.querySelectorAll<HTMLElement>("[data-del]").forEach((b) => b.addEventListener("click", () => del(b.dataset.del!)));
  }

  function applySearch() {
    const q = ($("art-search").value || "").toLowerCase();
    render(all.filter((p) => !q || (p.title + " " + (p.category || "")).toLowerCase().includes(q)));
  }

  async function load() {
    const { data, error } = await supabaseBrowser.from("posts").select("*").order("created_at", { ascending: false });
    if (error) { rows.innerHTML = `<tr><td class="empty" colspan="6">Erreur de chargement.</td></tr>`; return; }
    all = data || [];
    applySearch();
  }

  function fill(p: any) {
    $("f-id").value = p?.id || "";
    $("f-title").value = p?.title || "";
    $("f-slug").value = p?.slug || "";
    $("slug-preview").textContent = p?.slug || "…";
    $("f-category").value = p?.category || "";
    $("f-reading").value = p?.reading_minutes || "";
    $("f-excerpt").value = p?.excerpt || "";
    $("f-cover").value = p?.cover_url || "";
    $("f-body").value = p?.body_md || "";
    $("f-status").value = p?.status || "draft";
    $("f-author").value = p?.author || "Équipe Bweb";
    $("f-pubdate").value = p?.published_at ? dtLocalValue(p.published_at) : "";
    $("f-seotitle").value = p?.seo_title || "";
    $("f-seodesc").value = p?.seo_description || "";
    slugTouched = !!p?.slug;
    document.getElementById("art-drawer-title")!.textContent = p ? "Modifier l'article" : "Nouvel article";
  }

  function openNew() { location.href = "/admin/editeur/article/nouveau"; }
  function edit(id: string) { location.href = "/admin/editeur/article/" + id; }

  async function del(id: string) {
    const p = all.find((x) => x.id === id);
    if (!(await confirmModal({ title: "Supprimer l'article", message: `Supprimer « ${p?.title} » ?\nCette action est irréversible.`, danger: true, confirmLabel: "Supprimer" }))) return;
    const { error } = await supabaseBrowser.from("posts").delete().eq("id", id);
    if (error) { toast("Suppression impossible.", "err"); return; }
    toast("Article supprimé.");
    await load();
  }

  async function save() {
    const title = $("f-title").value.trim();
    let slug = $("f-slug").value.trim() || slugify(title);
    if (!title || !slug) { toast("Titre et slug obligatoires.", "err"); return; }
    const status = $("f-status").value;
    let publishedAt: string | null = $("f-pubdate").value ? new Date($("f-pubdate").value).toISOString() : null;
    if (status === "published" && !publishedAt) publishedAt = new Date().toISOString();

    const payload: any = {
      title, slug,
      category: $("f-category").value.trim() || null,
      reading_minutes: $("f-reading").value ? parseInt($("f-reading").value) : null,
      excerpt: $("f-excerpt").value.trim() || null,
      cover_url: $("f-cover").value.trim() || null,
      body_md: $("f-body").value,
      author: $("f-author").value.trim() || "Équipe Bweb",
      status,
      published_at: publishedAt,
      seo_title: $("f-seotitle").value.trim() || null,
      seo_description: $("f-seodesc").value.trim() || null,
    };
    const id = $("f-id").value;
    const saveBtn = document.getElementById("art-save")!;
    saveBtn.setAttribute("disabled", "true"); saveBtn.textContent = "Enregistrement…";
    const q = id ? supabaseBrowser.from("posts").update(payload).eq("id", id) : supabaseBrowser.from("posts").insert(payload);
    const { error } = await q;
    saveBtn.removeAttribute("disabled"); saveBtn.textContent = "Enregistrer";
    if (error) { toast(error.message.includes("duplicate") ? "Ce slug existe déjà." : "Enregistrement impossible.", "err"); return; }
    toast(id ? "Article mis à jour." : "Article créé.");
    closeDrawer();
    await load();
  }

  // Événements
  document.getElementById("art-new")!.addEventListener("click", openNew);
  document.getElementById("art-close")!.addEventListener("click", closeDrawer);
  document.getElementById("art-cancel")!.addEventListener("click", closeDrawer);
  overlay.addEventListener("click", closeDrawer);
  document.getElementById("art-save")!.addEventListener("click", save);
  $("art-search").addEventListener("input", applySearch);
  $("f-title").addEventListener("input", () => { if (!slugTouched) { const s = slugify($("f-title").value); $("f-slug").value = s; $("slug-preview").textContent = s || "…"; } });
  $("f-slug").addEventListener("input", () => { slugTouched = true; $("slug-preview").textContent = $("f-slug").value || "…"; });

  (async () => {
    const { data: { session } } = await supabaseBrowser.auth.getSession();
    if (!session) return;
    await load();
  })();
</script>

<style is:global>
  .admin-table .row-title { text-decoration: none; color: var(--c-ink); transition: color .15s; }
  .admin-table .row-title:hover { color: var(--c-blue); }
  .admin-table .row-title:hover strong { text-decoration: underline; }
</style>
