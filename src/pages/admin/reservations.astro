---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import Button from "../../components/starwind/button/Button.astro";

// Tuiles de stats — icônes statiques, valeurs remplies côté client.
const stats = [
  { key: "total", label: "Tentatives", accent: "blue", icon: '<path d="M9 11l3 3 8-8"/><path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"/>' },
  { key: "paye", label: "Payées", accent: "green", icon: '<rect x="2.5" y="6" width="19" height="12" rx="2"/><circle cx="12" cy="12" r="2.4"/>' },
  { key: "attente", label: "En attente", accent: "amber", icon: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>' },
  { key: "relance", label: "À relancer", accent: "violet", icon: '<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/>' },
];
---

<AdminLayout title="Réservations" active="reservations">
  <div class="sw space-y-4">
    <!-- Bascule Actives / Archives -->
    <div class="rz-viewbar">
      <div class="vb-sub" data-viewsub>Sessions à venir</div>
      <div class="rz-viewright">
        <button type="button" class="abtn primary" id="mb-open"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:15px;height:15px;vertical-align:-3px"><path d="M12 5v14M5 12h14"/></svg> Nouvelle réservation</button>
        <div class="rz-viewtoggle">
          <button data-view="active" class="on">Actives</button>
          <button data-view="archives"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8M10 12h4"/></svg> Archives <span data-archcount></span></button>
        </div>
      </div>
    </div>

    <!-- Stats -->
    <section class="rz-stats">
      {stats.map((s) => (
        <div class="rz-stat">
          <span class={`sic ${s.accent}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} /></span>
          <div><div class="k">{s.label}</div><div class="v" data-stat={s.key}>—</div><div class="ssub" data-statsub={s.key}></div></div>
        </div>
      ))}
    </section>

    <!-- Callout relance groupée -->
    <div class="rz-callout" data-callout hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
      <span data-callout-text></span>
      <a class="cta" href="/admin/campagnes">Campagne de relance →</a>
    </div>

    <!-- Toolbar -->
    <div class="rz-toolbar">
      <input class="admin-search" id="r-search" type="search" placeholder="Nom, e-mail, référence…" />
      <div class="rz-seg" data-seg></div>
      <div class="cdrop" id="r-sessiondrop">
        <button type="button" class="cdrop-btn" data-drop-toggle><span class="lbl">Toutes les sessions</span><svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m6 9 6 6 6-6"/></svg></button>
        <div class="cdrop-panel">
          <div class="cdrop-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg><input type="search" data-drop-search placeholder="Filtrer une session…" /></div>
          <div class="cdrop-list" data-drop-list></div>
          <div class="cdrop-foot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8M10 12h4"/></svg> <span data-drop-foot>Sessions à venir uniquement</span></div>
        </div>
      </div>
      <span style="flex:1"></span>
      <Button id="r-export" variant="outline" size="sm">⬇ Exporter CSV</Button>
    </div>

    <!-- Tableau -->
    <div class="dash-card">
      <div style="overflow-x:auto">
        <table class="admin-table" style="min-width:760px">
          <thead><tr><th>Participant</th><th>Session · Tarif</th><th>Moyen</th><th style="text-align:right">Montant</th><th>État</th><th>Action / Réf.</th></tr></thead>
          <tbody data-rows><tr class="a-loading-row"><td colspan="6">Chargement…</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Tiroir : nouvelle réservation manuelle (encaissement direct commercial) -->
  <div class="a-drawer-overlay" id="mb-overlay"></div>
  <aside class="a-drawer" id="mb-drawer" aria-hidden="true">
    <div class="a-drawer-head">
      <h2>Nouvelle réservation</h2>
      <button class="icon-btn" id="mb-close" aria-label="Fermer">✕</button>
    </div>
    <div class="a-drawer-body">
      <p class="hint">Paiement encaissé directement (Mobile Money / espèces). La place est réservée immédiatement et le billet part par e-mail au participant.</p>
      <div class="a-field"><label for="mb-session">Session *</label><select class="a-input" id="mb-session"><option value="">Chargement…</option></select></div>
      <div class="a-field"><label for="mb-ticket">Tarif *</label><select class="a-input" id="mb-ticket"><option value="">—</option></select></div>
      <div class="a-field" id="mb-attend-wrap" hidden><label>Participation *</label>
        <div class="mb-seg" id="mb-attend"><button type="button" data-att="presentiel" class="on">Présentiel</button><button type="button" data-att="en_ligne">En ligne (Zoom)</button></div>
      </div>
      <div class="a-grid2">
        <div class="a-field"><label for="mb-name">Nom du participant *</label><input class="a-input" id="mb-name" placeholder="Ex. Awa Koné" /></div>
        <div class="a-field"><label for="mb-qty">Quantité *</label><input class="a-input" id="mb-qty" type="number" min="1" max="20" value="1" /></div>
      </div>
      <div class="a-grid2">
        <div class="a-field"><label for="mb-email">E-mail * <span style="color:var(--c-gray-500);font-weight:400">(pour le billet)</span></label><input class="a-input" id="mb-email" type="email" placeholder="vous@exemple.com" /></div>
        <div class="a-field"><label for="mb-phone">Téléphone</label><input class="a-input" id="mb-phone" type="tel" placeholder="07 00 00 00 00" /></div>
      </div>
      <div class="a-field"><label>Moyen de paiement *</label>
        <div class="mb-seg wrap" id="mb-method">
          <button type="button" data-m="wave" class="on">Wave</button>
          <button type="button" data-m="orange_money">Orange Money</button>
          <button type="button" data-m="mtn_momo">MTN MoMo</button>
          <button type="button" data-m="especes">Espèces</button>
        </div>
      </div>
      <div class="mb-total">Total encaissé&nbsp;: <b data-mb-total>—</b></div>
      <p class="mb-msg" id="mb-msg" hidden></p>
    </div>
    <div class="a-drawer-foot">
      <span class="grow"></span>
      <button class="abtn" id="mb-cancel">Annuler</button>
      <button class="abtn primary" id="mb-save">Enregistrer + envoyer le billet</button>
    </div>
  </aside>
</AdminLayout>

<style is:global>
  .rz-viewright { display: flex; align-items: center; gap: 10px; }
  .a-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .mb-seg { display: flex; gap: 6px; }
  .mb-seg.wrap { flex-wrap: wrap; }
  .mb-seg button { flex: 1; min-width: 84px; border: 1px solid var(--c-border); background: #fff; border-radius: 10px; padding: 9px; font: inherit; font-size: .84rem; font-weight: 700; color: var(--c-gray-600); cursor: pointer; }
  .mb-seg button.on { border-color: var(--c-blue); background: rgba(31,108,237,.08); color: var(--c-blue-dark); }
  .mb-total { font-size: .9rem; color: var(--c-gray-700); background: var(--c-gray-100); border-radius: 10px; padding: 10px 12px; }
  .mb-total b { font-family: var(--f-display); font-weight: 800; }
  .mb-msg { margin: 0; font-size: .84rem; font-weight: 700; }
  .mb-msg.err { color: var(--c-danger); }
  @media (max-width: 560px) { .a-grid2 { grid-template-columns: 1fr; } }
</style>

<script>
  import { supabaseBrowser } from "../../lib/supabaseBrowser";
  import { esc, fmtFCFA, dshort, toast, reconciledRelanceIds } from "../../scripts/adminUtils";

  const now = Date.now();
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const rows = document.querySelector("[data-rows]")!;
  let all: any[] = [];
  // Ids des tentatives échouées/abandonnées déjà réglées par une autre tentative du même client.
  let reconciled = new Set<string>();
  let view: "active" | "archives" = "active";
  let statusFilter = "";
  let sessionFilter = "";

  const methodLabel: Record<string, string> = { wave: "Wave", orange_money: "Orange Money", mobile_money: "Mobile Money", sur_place: "Sur place", money_fusion: "Money Fusion", paystack: "Paystack" };
  const attendPill: Record<string, string> = { presentiel: "🏢 Sur place", en_ligne: "💻 En ligne" };
  const attendCsv: Record<string, string> = { presentiel: "Sur place", en_ligne: "En ligne" };
  const statePill: Record<string, string> = {
    paye: '<span class="tag-pill ok">Payé</span>', attente: '<span class="tag-pill wait">En attente</span>',
    echoue: '<span class="tag-pill fail">Échoué</span>', abandon: '<span class="tag-pill abandon">Abandon</span>',
    annule: '<span class="tag-pill draft">Annulée</span>',
  };
  const stateCsv: Record<string, string> = { paye: "Payée", attente: "En attente", echoue: "Échoué", abandon: "Abandon", annule: "Annulée" };

  // État réel (cf. migration 0024) ; « annule » = ancien status cancelled.
  const stateOf = (b: any): string => b.status === "confirmed" ? "paye" : b.status === "cancelled" ? "annule" : (b.payment_status || "attente");
  const dueOf = (b: any) => (b.is_deposit ? Math.ceil(b.amount_due / 2) : b.amount_due);
  const firstName = (n: string) => (n || "").trim().split(/\s+/)[0] || "";
  const digits = (s: string | null) => (s || "").replace(/\D/g, "");
  // Archivée = session passée (date) OU session explicitement archivée.
  const isArchived = (b: any): boolean => {
    const st = b.sessions?.starts_at ? new Date(b.sessions.starts_at).getTime() : null;
    return (st != null && st < now) || b.sessions?.status === "archived";
  };

  // Réservations du mode courant (hors annulées héritées).
  const viewBookings = () => all.filter((b) => stateOf(b) !== "annule" && (view === "archives" ? isArchived(b) : !isArchived(b)));

  async function viewProof(path: string) {
    const { data } = await supabaseBrowser.storage.from("payment-proofs").createSignedUrl(path, 120);
    if (data?.signedUrl) window.open(data.signedUrl, "_blank", "noopener"); else toast("Justificatif introuvable.", "err");
  }
  const relanceMsg = (b: any) => `Bonjour ${firstName(b.full_name)} 👋 Vous aviez commencé à réserver « ${b.sessions?.title || "une formation"} » chez Bweb Agence, mais le paiement n'a pas été finalisé. Votre place est encore disponible — souhaitez-vous confirmer votre inscription ?`;

  // ---------- Stats + segments + callout ----------
  function renderMeta() {
    const vb = viewBookings();
    const c: Record<string, number> = { paye: 0, attente: 0, echoue: 0, abandon: 0 };
    vb.forEach((b) => { c[stateOf(b)] = (c[stateOf(b)] || 0) + 1; });
    const total = vb.length;
    const ca = vb.filter((b) => stateOf(b) === "paye").reduce((a, b) => a + dueOf(b), 0);
    const taux = total ? Math.round((c.paye / total) * 100) : 0;
    // « À relancer » exclut les tentatives déjà réglées par une autre tentative du même client.
    const relanceItems = vb.filter((b) => ["echoue", "abandon"].includes(stateOf(b)) && !reconciled.has(b.id));
    const relanceCount = relanceItems.length;
    const recoverable = relanceItems.reduce((a, b) => a + dueOf(b), 0);

    const setStat = (k: string, v: string, sub: string) => {
      const el = document.querySelector(`[data-stat="${k}"]`); if (el) el.textContent = v;
      const s = document.querySelector(`[data-statsub="${k}"]`); if (s) s.innerHTML = sub;
    };
    setStat("total", String(total), view === "archives" ? "sessions passées" : "sessions à venir");
    setStat("paye", String(c.paye), `${fmtFCFA(ca)} · ${taux}%`);
    setStat("attente", String(c.attente), "paiement en cours");
    setStat("relance", String(relanceCount), relanceCount ? fmtFCFA(recoverable) + " récupérables" : "rien à relancer");

    // Segments
    const segs: [string, string, number][] = [["", "Tous", total], ["paye", "Payés", c.paye], ["attente", "Attente", c.attente], ["echoue", "Échoués", c.echoue], ["abandon", "Abandons", c.abandon]];
    const segBox = document.querySelector("[data-seg]")!;
    segBox.innerHTML = segs.map(([k, lbl, n]) => `<button data-seg-btn="${k}" class="${statusFilter === k ? "on" : ""}">${lbl} <span class="c">${n}</span></button>`).join("");
    segBox.querySelectorAll<HTMLElement>("[data-seg-btn]").forEach((btn) => btn.addEventListener("click", () => { statusFilter = btn.dataset.segBtn!; renderMeta(); applyFilters(); }));

    // Callout relance groupée (uniquement en vue Actives)
    const co = document.querySelector("[data-callout]") as HTMLElement;
    if (view === "active" && relanceCount > 0) {
      co.hidden = false;
      (document.querySelector("[data-callout-text]") as HTMLElement).textContent = `${relanceCount} paiement(s) échoué(s) ou abandonné(s) — relancez-les d'un clic depuis le tableau, ou en masse.`;
    } else co.hidden = true;

    // Compteur Archives + sous-titre
    const arch = all.filter((b) => stateOf(b) !== "annule" && isArchived(b)).length;
    const ac = document.querySelector("[data-archcount]"); if (ac) ac.textContent = arch ? `· ${arch}` : "";
    (document.querySelector("[data-viewsub]") as HTMLElement).textContent = view === "archives" ? "Sessions passées (archives)" : "Sessions à venir";
    (document.querySelector("[data-drop-foot]") as HTMLElement).textContent = view === "archives" ? "Sessions passées uniquement" : "Sessions à venir uniquement";
  }

  // ---------- Dropdown sessions ----------
  function renderSessionDropdown() {
    const vb = viewBookings();
    const map = new Map<string, { title: string; starts_at: string | null; n: number }>();
    for (const b of vb) { if (!b.session_id) continue; const e = map.get(b.session_id) || { title: b.sessions?.title || "Session", starts_at: b.sessions?.starts_at || null, n: 0 }; e.n++; map.set(b.session_id, e); }
    const list = [...map.entries()].sort((a, b) => (a[1].starts_at || "").localeCompare(b[1].starts_at || ""));
    const listBox = document.querySelector("[data-drop-list]")!;
    const opts = [`<div class="cdrop-opt ${sessionFilter === "" ? "on" : ""}" data-sess=""><span class="oi">∀</span><span class="ot"><b>Toutes les sessions</b><span>${vb.length} réservation(s)</span></span><svg class="ck" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg></div>`]
      .concat(list.map(([id, e]) => `<div class="cdrop-opt ${sessionFilter === id ? "on" : ""}" data-sess="${id}" data-search="${esc((e.title || "").toLowerCase())}"><span class="oi">${esc((e.title || "S").slice(0, 2))}</span><span class="ot"><b>${esc(e.title)}</b><span>${e.n} réservation(s)${e.starts_at ? " · " + dshort(e.starts_at) : ""}</span></span><svg class="ck" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg></div>`));
    listBox.innerHTML = opts.join("");
    listBox.querySelectorAll<HTMLElement>("[data-sess]").forEach((o) => o.addEventListener("click", () => {
      sessionFilter = o.dataset.sess!;
      (document.querySelector("#r-sessiondrop .lbl") as HTMLElement).textContent = o.querySelector("b")!.textContent!;
      document.getElementById("r-sessiondrop")!.classList.remove("open");
      renderSessionDropdown(); applyFilters();
    }));
    // reset label if selected session no longer in view
    if (sessionFilter && !map.has(sessionFilter)) { sessionFilter = ""; (document.querySelector("#r-sessiondrop .lbl") as HTMLElement).textContent = "Toutes les sessions"; }
  }

  // ---------- Table ----------
  function applyFilters() {
    const q = ($("r-search").value || "").toLowerCase();
    const list = viewBookings().filter((b) =>
      (!statusFilter || stateOf(b) === statusFilter) &&
      (!sessionFilter || b.session_id === sessionFilter) &&
      (!q || (b.full_name + " " + (b.email || "") + " " + b.reference + " " + (b.payment_reference || "")).toLowerCase().includes(q)));
    render(list);
  }

  const svgWa = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5-1.4A10 10 0 1 0 12 2z"/></svg>';
  const svgMail = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>';

  function render(list: any[]) {
    rows.innerHTML = list.length ? list.map((b) => {
      const st = stateOf(b);
      const isReconciled = (st === "echoue" || st === "abandon") && reconciled.has(b.id);
      const canRelance = view === "active" && (st === "echoue" || st === "abandon") && !isReconciled;
      let action: string;
      if (canRelance) {
        const msg = encodeURIComponent(relanceMsg(b));
        const wa = digits(b.phone) ? `<a class="rbtn wa" data-track target="_blank" rel="noopener" href="https://wa.me/${digits(b.phone)}?text=${msg}">${svgWa}Relancer</a>` : "";
        const mail = b.email ? `<a class="rbtn mail" data-track target="_blank" rel="noopener" href="mailto:${encodeURIComponent(b.email)}?subject=${encodeURIComponent("Votre inscription chez Bweb Agence")}&body=${msg}">${svgMail}</a>` : "";
        action = `<div class="rz-relance">${wa}${mail || (wa ? "" : "—")}</div>`;
      } else if (isReconciled) {
        // Tentative déjà réglée par une autre tentative du même client → pas de relance.
        action = `<span class="tag-pill ok" title="Ce client a payé via une autre tentative — ne pas relancer">✓ Déjà réglé</span>`;
      } else {
        const receipt = b.payment_proof_url ? `<button class="abtn sm" data-proof="${esc(b.payment_proof_url)}">Reçu</button>` : "";
        const payRef = b.payment_reference ? `<span class="pay-ref" title="Référence de paiement">${esc(b.payment_reference)}</span>` : (receipt ? "" : '<span style="color:var(--c-gray-400)">—</span>');
        action = `<div class="row-actions">${payRef}${receipt}</div>`;
      }
      return `<tr>
        <td><strong>${esc(b.full_name)}</strong><br><span class="mono-ref" style="font-size:.72rem">${esc(b.reference)}</span> <span style="color:var(--c-gray-500);font-size:.74rem">· ${esc(b.email || b.phone || "")}</span></td>
        <td>${esc(b.sessions?.title || "—")}<br><span style="color:var(--c-gray-500);font-size:.74rem">${b.quantity}× ${esc(b.ticket_types?.name || "")}${b.attendance_mode ? " · " + attendPill[b.attendance_mode] : ""} · ${dshort(b.created_at)}</span></td>
        <td>${esc(methodLabel[b.payment_method] || "—")}${b.is_deposit ? ' <span class="tag-pill wait">acompte</span>' : ""}</td>
        <td style="text-align:right;font-family:var(--f-display);font-weight:800;font-variant-numeric:tabular-nums">${fmtFCFA(dueOf(b))}</td>
        <td>${statePill[st] || esc(b.status)}</td>
        <td>${action}</td></tr>`;
    }).join("") : `<tr><td class="empty" colspan="6">${view === "archives" ? "Aucune réservation archivée." : "Aucune réservation."}</td></tr>`;

    rows.querySelectorAll<HTMLElement>("[data-proof]").forEach((el) => el.addEventListener("click", () => viewProof(el.dataset.proof!)));
    rows.querySelectorAll<HTMLElement>("[data-track]").forEach((el) => el.addEventListener("click", () => toast("Relance ouverte — pensez à envoyer le message.")));
  }

  function refreshAll() { renderMeta(); renderSessionDropdown(); applyFilters(); }

  function exportCsv() {
    const q = ($("r-search").value || "").toLowerCase();
    const list = viewBookings().filter((b) => (!statusFilter || stateOf(b) === statusFilter) && (!sessionFilter || b.session_id === sessionFilter) &&
      (!q || (b.full_name + " " + (b.email || "") + " " + b.reference).toLowerCase().includes(q)));
    const head = ["Référence", "Réf. paiement", "Date", "Nom", "E-mail", "Téléphone", "Session", "Participation", "Tarif", "Places", "Moyen", "Montant", "État"];
    const lines = list.map((b) => [b.reference, b.payment_reference || "", new Date(b.created_at).toISOString(), b.full_name, b.email, b.phone, b.sessions?.title, attendCsv[b.attendance_mode] || "", b.ticket_types?.name, b.quantity, methodLabel[b.payment_method] || "", dueOf(b), stateCsv[stateOf(b)] || b.status]
      .map((v) => `"${String(v ?? "").replace(/"/g, '""')}"`).join(","));
    const csv = [head.join(","), ...lines].join("\n");
    const url = URL.createObjectURL(new Blob(["﻿" + csv], { type: "text/csv;charset=utf-8" }));
    const a = document.createElement("a"); a.href = url; a.download = `reservations-${view}-bweb.csv`; a.click(); URL.revokeObjectURL(url);
  }

  async function load() {
    const { data } = await supabaseBrowser.from("bookings")
      .select("*, sessions(title,starts_at,status), ticket_types(name)").order("created_at", { ascending: false });
    all = data || [];
    reconciled = reconciledRelanceIds(all);
    refreshAll();
  }

  // ---------- Événements ----------
  $("r-search").addEventListener("input", applyFilters);
  document.getElementById("r-export")!.addEventListener("click", exportCsv);

  // Bascule Actives / Archives
  document.querySelectorAll<HTMLElement>("[data-view]").forEach((btn) => btn.addEventListener("click", () => {
    view = btn.dataset.view as any;
    document.querySelectorAll("[data-view]").forEach((b) => b.classList.toggle("on", b === btn));
    statusFilter = ""; sessionFilter = "";
    (document.querySelector("#r-sessiondrop .lbl") as HTMLElement).textContent = "Toutes les sessions";
    ($("r-search").value = "");
    refreshAll();
  }));

  // Dropdown open/close + recherche interne
  const drop = document.getElementById("r-sessiondrop")!;
  drop.querySelector("[data-drop-toggle]")!.addEventListener("click", (e) => { e.stopPropagation(); drop.classList.toggle("open"); const s = drop.querySelector("[data-drop-search]") as HTMLInputElement; if (drop.classList.contains("open")) setTimeout(() => s.focus(), 20); });
  drop.querySelector("[data-drop-search]")!.addEventListener("input", (e) => {
    const q = (e.target as HTMLInputElement).value.toLowerCase();
    drop.querySelectorAll<HTMLElement>(".cdrop-opt[data-search]").forEach((o) => { o.style.display = !q || (o.dataset.search || "").includes(q) ? "" : "none"; });
  });
  document.addEventListener("click", (e) => { if (!(e.target as HTMLElement).closest("#r-sessiondrop")) drop.classList.remove("open"); });

  // ---------- Nouvelle réservation manuelle (encaissement direct) ----------
  const mbEl = (id: string) => document.getElementById(id) as HTMLInputElement;
  const mbDrawer = document.getElementById("mb-drawer")!;
  const mbOverlay = document.getElementById("mb-overlay")!;
  let mbSessions: any[] = [];
  let mbMethod = "wave";
  let mbAttend = "presentiel";
  const fmtPlain = (n: number) => (Number(n) || 0).toLocaleString("fr-FR") + " F CFA";
  const mbOpen = () => { mbDrawer.classList.add("open"); mbOverlay.classList.add("open"); document.body.style.overflow = "hidden"; };
  const mbClose = () => { mbDrawer.classList.remove("open"); mbOverlay.classList.remove("open"); document.body.style.overflow = ""; };

  async function mbLoadSessions() {
    const { data } = await supabaseBrowser.from("sessions")
      .select("id,title,starts_at,mode,status, ticket_types(id,name,price,capacity,sold)")
      .in("status", ["published", "full"]).gte("starts_at", new Date().toISOString())
      .order("starts_at", { ascending: true });
    mbSessions = data || [];
    mbEl("mb-session").innerHTML = mbSessions.length
      ? `<option value="">Choisir une session…</option>` + mbSessions.map((s) => `<option value="${s.id}">${esc(s.title)} · ${dshort(s.starts_at)}</option>`).join("")
      : `<option value="">Aucune session à venir</option>`;
    mbSyncTickets();
  }
  const mbSession = () => mbSessions.find((s) => s.id === mbEl("mb-session").value);
  function mbSyncTickets() {
    const s = mbSession();
    const tts = ((s?.ticket_types) || []).slice().sort((a: any, b: any) => a.price - b.price);
    mbEl("mb-ticket").innerHTML = tts.length
      ? tts.map((t: any) => { const rem = Math.max(0, t.capacity - t.sold); return `<option value="${t.id}" data-price="${t.price}" ${rem <= 0 ? "disabled" : ""}>${esc(t.name)} — ${fmtPlain(t.price)}${rem <= 0 ? " (épuisé)" : ` · ${rem} pl.`}</option>`; }).join("")
      : `<option value="">—</option>`;
    document.getElementById("mb-attend-wrap")!.hidden = s?.mode !== "hybride";
    mbSyncTotal();
  }
  function mbSyncTotal() {
    const opt = (mbEl("mb-ticket") as unknown as HTMLSelectElement).selectedOptions[0];
    const price = opt ? parseInt(opt.getAttribute("data-price") || "0") : 0;
    const qty = Math.max(1, parseInt(mbEl("mb-qty").value || "1"));
    document.querySelector("[data-mb-total]")!.textContent = fmtPlain(price * qty);
  }
  document.getElementById("mb-open")?.addEventListener("click", () => { mbOpen(); if (!mbSessions.length) mbLoadSessions(); });
  document.getElementById("mb-close")?.addEventListener("click", mbClose);
  document.getElementById("mb-cancel")?.addEventListener("click", mbClose);
  mbOverlay.addEventListener("click", mbClose);
  mbEl("mb-session").addEventListener("change", mbSyncTickets);
  mbEl("mb-ticket").addEventListener("change", mbSyncTotal);
  mbEl("mb-qty").addEventListener("input", mbSyncTotal);
  document.querySelectorAll<HTMLElement>("#mb-method button").forEach((b) => b.addEventListener("click", () => {
    document.querySelectorAll("#mb-method button").forEach((x) => x.classList.remove("on")); b.classList.add("on"); mbMethod = b.dataset.m || "wave";
  }));
  document.querySelectorAll<HTMLElement>("#mb-attend button").forEach((b) => b.addEventListener("click", () => {
    document.querySelectorAll("#mb-attend button").forEach((x) => x.classList.remove("on")); b.classList.add("on"); mbAttend = b.dataset.att || "presentiel";
  }));
  document.getElementById("mb-save")?.addEventListener("click", async () => {
    const msg = document.getElementById("mb-msg")!; const show = (t: string) => { msg.textContent = t; msg.hidden = false; msg.className = "mb-msg err"; };
    const ticket = mbEl("mb-ticket").value;
    const name = mbEl("mb-name").value.trim();
    const email = mbEl("mb-email").value.trim();
    const phone = mbEl("mb-phone").value.trim();
    const qty = Math.max(1, parseInt(mbEl("mb-qty").value || "1"));
    if (!ticket) return show("Choisissez une session et un tarif.");
    if (name.length < 2) return show("Nom du participant requis.");
    if (!/.+@.+\..+/.test(email)) return show("E-mail valide requis (pour envoyer le billet).");
    const s = mbSession();
    const attendance = s?.mode === "hybride" ? mbAttend : (s?.mode === "en_ligne" ? "en_ligne" : "presentiel");
    const btn = document.getElementById("mb-save")!; btn.setAttribute("disabled", "true"); btn.textContent = "Enregistrement…"; msg.hidden = true;
    try {
      const { data: { session } } = await supabaseBrowser.auth.getSession();
      const res = await fetch("/api/manual-booking", {
        method: "POST", headers: { "Content-Type": "application/json", Authorization: `Bearer ${session?.access_token}` },
        body: JSON.stringify({ ticket_type_id: ticket, quantity: qty, full_name: name, email, phone, payment_method: mbMethod, attendance_mode: attendance }),
      });
      const j = await res.json();
      btn.removeAttribute("disabled"); btn.textContent = "Enregistrer + envoyer le billet";
      if (!j?.ok) { show(j?.message || (j?.error === "sold_out" ? "Plus assez de places." : "Enregistrement impossible.")); return; }
      toast(`Réservation ${j.reference} enregistrée — billet envoyé. ✓`);
      mbClose();
      mbEl("mb-name").value = ""; mbEl("mb-email").value = ""; mbEl("mb-phone").value = ""; mbEl("mb-qty").value = "1";
      await mbLoadSessions();
      await load();
    } catch { btn.removeAttribute("disabled"); btn.textContent = "Enregistrer + envoyer le billet"; show("Erreur réseau. Réessayez."); }
  });

  (async () => {
    const { data: { session } } = await supabaseBrowser.auth.getSession(); if (!session) return;
    await load();
  })();
</script>
