---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import Card from "../../components/starwind/card/Card.astro";
import Button from "../../components/starwind/button/Button.astro";
---

<AdminLayout title="Réservations" active="reservations">
  <div class="sw space-y-6">
    <div class="admin-toolbar">
      <div class="left">
        <input class="admin-search" id="r-search" type="search" placeholder="Nom, e-mail, référence…" />
        <select class="admin-filter" id="r-status">
          <option value="" selected>Tous les statuts</option><option value="attente">En attente</option><option value="paye">Confirmées</option><option value="echoue">Échouées</option><option value="abandon">Abandons</option>
        </select>
        <select class="admin-filter" id="r-session"><option value="">Toutes les sessions</option></select>
      </div>
      <Button id="r-export" variant="outline" size="sm">⬇ Exporter CSV</Button>
    </div>

    <Card class="gap-0 overflow-hidden p-0">
      <div class="overflow-x-auto">
        <table class="admin-table min-w-[720px]">
          <thead><tr><th>Participant</th><th>Session · Tarif</th><th>Moyen</th><th>Montant</th><th>Statut</th><th>Réf. / Reçu</th></tr></thead>
          <tbody data-rows><tr class="a-loading-row"><td colspan="6">Chargement…</td></tr></tbody>
        </table>
      </div>
    </Card>
  </div>
</AdminLayout>

<script>
  import { supabaseBrowser } from "../../lib/supabaseBrowser";
  import { esc, fmtFCFA, dshort, toast } from "../../scripts/adminUtils";

  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const rows = document.querySelector("[data-rows]")!;
  let all: any[] = [];
  const methodLabel: Record<string, string> = { wave: "Wave", orange_money: "Orange Money", mobile_money: "Mobile Money", sur_place: "Sur place" };
  const attendPill: Record<string, string> = {
    presentiel: '<span class="tag-pill pub">🏢 Sur place</span>',
    en_ligne: '<span class="tag-pill pub">💻 En ligne</span>',
  };
  const attendCsv: Record<string, string> = { presentiel: "Sur place", en_ligne: "En ligne" };
  // Paiement 100 % automatique : le « statut » reflète l'état réel de l'opération
  // de paiement, piloté par la passerelle — l'admin ne valide/refuse plus rien.
  const payPill: Record<string, string> = {
    attente: '<span class="tag-pill wait">En attente</span>', paye: '<span class="tag-pill ok">Confirmée</span>',
    echoue: '<span class="tag-pill fail">Échoué</span>', abandon: '<span class="tag-pill abandon">Abandon</span>',
    annule: '<span class="tag-pill draft">Annulée</span>',
  };
  // État affiché : réservation confirmée → payé ; annulée (héritage) → annulé ;
  // sinon l'état de paiement (attente / échoué / abandon).
  const stateOf = (b: any): string =>
    b.status === "confirmed" ? "paye" : b.status === "cancelled" ? "annule" : (b.payment_status || "attente");

  async function viewProof(path: string) {
    const { data } = await supabaseBrowser.storage.from("payment-proofs").createSignedUrl(path, 120);
    if (data?.signedUrl) window.open(data.signedUrl, "_blank", "noopener"); else toast("Justificatif introuvable.", "err");
  }

  function render(list: any[]) {
    rows.innerHTML = list.length ? list.map((b) => {
      const due = b.is_deposit ? Math.ceil(b.amount_due / 2) : b.amount_due;
      // Référence de paiement (jeton passerelle) + justificatif éventuel.
      const receipt = b.payment_proof_url ? `<button class="abtn sm" data-proof="${esc(b.payment_proof_url)}">Reçu</button>` : "";
      const payRef = b.payment_reference
        ? `<span class="pay-ref" title="Référence de paiement">${esc(b.payment_reference)}</span>`
        : (receipt ? "" : '<span style="color:var(--c-gray-400)">—</span>');
      return `<tr>
        <td><strong>${esc(b.full_name)}</strong><br><span class="mono-ref">${esc(b.reference)}</span> <span style="color:var(--c-gray-500);font-size:.76rem">· ${esc(b.email || b.phone || "")}</span></td>
        <td>${esc(b.sessions?.title || "")}${b.attendance_mode ? " " + attendPill[b.attendance_mode] : ""}<br><span style="color:var(--c-gray-500);font-size:.76rem">${b.quantity}× ${esc(b.ticket_types?.name || "")} · ${dshort(b.created_at)}</span></td>
        <td>${esc(methodLabel[b.payment_method] || "—")}${b.is_deposit ? ' <span class="tag-pill wait">acompte</span>' : ""}</td>
        <td style="font-variant-numeric:tabular-nums">${fmtFCFA(due)}</td>
        <td>${payPill[stateOf(b)] || esc(b.status)}</td>
        <td><div class="row-actions">${payRef}${receipt}</div></td></tr>`;
    }).join("") : `<tr><td class="empty" colspan="6">Aucune réservation.</td></tr>`;

    rows.querySelectorAll<HTMLElement>("[data-proof]").forEach((el) => el.addEventListener("click", () => viewProof(el.dataset.proof!)));
  }

  function applyFilters() {
    const q = ($("r-search").value || "").toLowerCase(); const st = $("r-status").value; const sess = $("r-session").value;
    render(all.filter((b) =>
      (!st || stateOf(b) === st) && (!sess || b.session_id === sess) &&
      (!q || (b.full_name + " " + (b.email || "") + " " + b.reference + " " + (b.payment_reference || "")).toLowerCase().includes(q))));
  }

  async function load() {
    const { data } = await supabaseBrowser.from("bookings")
      .select("*, sessions(title), ticket_types(name)").order("created_at", { ascending: false });
    all = data || [];
    applyFilters();
  }

  function exportCsv() {
    const list = all;
    const stateCsv: Record<string, string> = { attente: "En attente", paye: "Confirmée", echoue: "Échoué", abandon: "Abandon", annule: "Annulée" };
    const head = ["Référence", "Réf. paiement", "Date", "Nom", "E-mail", "Téléphone", "Session", "Participation", "Tarif", "Places", "Moyen", "Montant dû", "Payé", "Statut"];
    const lines = list.map((b) => [b.reference, b.payment_reference || "", new Date(b.created_at).toISOString(), b.full_name, b.email, b.phone, b.sessions?.title, attendCsv[b.attendance_mode] || "", b.ticket_types?.name, b.quantity, methodLabel[b.payment_method] || "", b.amount_due, b.amount_paid, stateCsv[stateOf(b)] || b.status]
      .map((v) => `"${String(v ?? "").replace(/"/g, '""')}"`).join(","));
    const csv = [head.join(","), ...lines].join("\n");
    const url = URL.createObjectURL(new Blob(["﻿" + csv], { type: "text/csv;charset=utf-8" }));
    const a = document.createElement("a"); a.href = url; a.download = "reservations-bweb.csv"; a.click(); URL.revokeObjectURL(url);
  }

  $("r-search").addEventListener("input", applyFilters);
  $("r-status").addEventListener("change", applyFilters);
  $("r-session").addEventListener("change", applyFilters);
  document.getElementById("r-export")!.addEventListener("click", exportCsv);

  (async () => {
    const { data: { session } } = await supabaseBrowser.auth.getSession(); if (!session) return;
    const { data: ss } = await supabaseBrowser.from("sessions").select("id,title").order("starts_at", { ascending: false });
    $("r-session").innerHTML = '<option value="">Toutes les sessions</option>' + (ss || []).map((s: any) => `<option value="${s.id}">${esc(s.title)}</option>`).join("");
    await load();
  })();
</script>
