---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import Button from "../../components/ui/Button.astro";
import Badge from "../../components/ui/Badge.astro";
import KpiCard from "../../components/ui/KpiCard.astro";
import Panel from "../../components/ui/Panel.astro";
import Field from "../../components/ui/Field.astro";
import Drawer from "../../components/ui/Drawer.astro";

const brand = ["--c-blue", "--c-blue-dark", "--c-navy", "--c-navy-soft", "--c-green", "--c-teal", "--c-orange", "--c-yellow", "--c-cream", "--c-ink"];
const neutrals = ["--c-gray-900", "--c-gray-800", "--c-gray-700", "--c-gray-600", "--c-gray-500", "--c-gray-400", "--c-gray-300", "--c-gray-100"];
const semantic = ["--c-success", "--c-success-bg", "--c-warning", "--c-warning-bg", "--c-danger", "--c-danger-bg"];
const accents = ["--acc-green", "--acc-blue", "--acc-navy", "--acc-violet", "--acc-amber", "--c-whatsapp"];
const radii = ["--radius-sm", "--radius-md", "--radius-lg", "--radius-xl", "--radius-pill"];
const shadows = ["--shadow-sm", "--shadow-md", "--shadow-lg", "--shadow-xl"];
const spaces = ["--space-3xs", "--space-2xs", "--space-xs", "--space-sm", "--space-md", "--space-lg", "--space-xl"];
const fontScale = [
  { v: "--fs-h1", l: "Display H1" }, { v: "--fs-h2", l: "Display H2" }, { v: "--fs-h3", l: "Display H3" },
  { v: "--fs-lg", l: "Lead" }, { v: "--fs-base", l: "Corps" }, { v: "--fs-sm", l: "Small" }, { v: "--fs-xs", l: "XS" },
];
---

<AdminLayout title="Design system">
  <p class="admin-sub">Fondations (tokens) et composants réutilisables de l'admin Bweb. Source unique : <code>src/styles/tokens.css</code> + <code>src/components/ui/</code>.</p>

  <!-- ============ TOKENS ============ -->
  <Panel title="Couleurs — marque" class="sg-panel">
    <div class="sg-swatches">{brand.map((c) => <div class="sg-swatch"><span class="sg-chip" style={`background:var(${c})`}></span><code>{c}</code></div>)}</div>
  </Panel>

  <Panel title="Couleurs — neutres" class="sg-panel">
    <div class="sg-swatches">{neutrals.map((c) => <div class="sg-swatch"><span class="sg-chip" style={`background:var(${c})`}></span><code>{c}</code></div>)}</div>
  </Panel>

  <Panel title="Couleurs — sémantiques & accents" class="sg-panel">
    <div class="sg-swatches">{[...semantic, ...accents].map((c) => <div class="sg-swatch"><span class="sg-chip" style={`background:var(${c})`}></span><code>{c}</code></div>)}</div>
  </Panel>

  <Panel title="Typographie" class="sg-panel">
    {fontScale.map((f) => (
      <div class="sg-type-row">
        <span class="sg-type-lbl"><code>{f.v}</code></span>
        <span style={`font-size:var(${f.v});font-family:${f.v.includes("h") ? "var(--f-display)" : "var(--f-body)"};font-weight:${f.v.includes("h") ? 800 : 500};line-height:1.15`}>Bweb Agence</span>
      </div>
    ))}
  </Panel>

  <div class="sg-2col">
    <Panel title="Espacement" class="sg-panel">
      {spaces.map((s) => (
        <div class="sg-space-row"><code>{s}</code><span class="sg-space-bar" style={`width:var(${s})`}></span></div>
      ))}
    </Panel>

    <Panel title="Rayons" class="sg-panel">
      <div class="sg-radii">{radii.map((r) => <div class="sg-radius"><span class="sg-radius-box" style={`border-radius:var(${r})`}></span><code>{r}</code></div>)}</div>
    </Panel>
  </div>

  <Panel title="Élévations" class="sg-panel">
    <div class="sg-shadows">{shadows.map((s) => <div class="sg-shadow"><span class="sg-shadow-box" style={`box-shadow:var(${s})`}></span><code>{s}</code></div>)}</div>
  </Panel>

  <!-- ============ COMPOSANTS ============ -->
  <h2 class="a-section-title" style="font-size:1.1rem">Composants</h2>

  <Panel title="Button" class="sg-panel">
    <div class="sg-row">
      <Button variant="primary">Primary</Button>
      <Button>Default</Button>
      <Button variant="wa">WhatsApp</Button>
      <Button variant="danger">Danger</Button>
      <Button variant="ghost">Ghost</Button>
      <Button variant="primary" size="sm">Small</Button>
      <Button href="#" variant="primary">Lien</Button>
    </div>
    <p class="sg-code">{'<Button variant="primary" size="sm">Enregistrer</Button>'}</p>
  </Panel>

  <Panel title="Badge (pastilles)" class="sg-panel">
    <div class="sg-row">
      <Badge variant="ok" dot>Confirmée</Badge>
      <Badge variant="wait">En attente</Badge>
      <Badge variant="pub">Publiée</Badge>
      <Badge variant="draft">Brouillon</Badge>
      <Badge variant="full">Complet</Badge>
      <Badge variant="client" dot>Client</Badge>
      <Badge variant="prospect" dot>Prospect</Badge>
      <Badge variant="relance" dot>À relancer</Badge>
    </div>
  </Panel>

  <Panel title="KpiCard" class="sg-panel">
    <div class="crm-kpis" style="margin:0">
      <KpiCard accent="green" label="Clients payants" value="38">
        <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 19a5.6 5.6 0 0 1 11 0"/></svg>
      </KpiCard>
      <KpiCard accent="blue" label="Prospects" value="51">
        <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="3.4"/><path d="M5.5 20a6.5 6.5 0 0 1 13 0"/></svg>
      </KpiCard>
      <KpiCard accent="amber" label="À relancer" value="17">
        <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/></svg>
      </KpiCard>
    </div>
  </Panel>

  <Panel title="Field (formulaire)" class="sg-panel">
    <div style="max-width:420px">
      <Field label="Objet de l'e-mail" for="sg-inp" hint="Accepte les variables {formation}.">
        <input class="a-input" id="sg-inp" placeholder="Nouvelle session…" />
      </Field>
      <Field label="Statut" for="sg-sel">
        <select class="a-select" id="sg-sel"><option>Brouillon</option><option>Publié</option></select>
      </Field>
    </div>
  </Panel>

  <Panel title="Drawer (tiroir)" class="sg-panel">
    <Button variant="primary" data-drawer-open="sg-drawer">Ouvrir le tiroir</Button>
    <Drawer id="sg-drawer" title="Exemple de tiroir">
      <p style="color:var(--c-gray-600)">Contenu du tiroir. Ferme avec ✕, l'overlay ou Échap.</p>
      <Button slot="foot" variant="primary">Action</Button>
    </Drawer>
  </Panel>
</AdminLayout>

<style>
  .sg-panel { padding: 18px; }
  .sg-swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 12px; }
  .sg-swatch { display: flex; flex-direction: column; gap: 6px; }
  .sg-chip { height: 46px; border-radius: 10px; border: 1px solid var(--c-border); }
  .sg-swatch code, .sg-space-row code, .sg-radius code, .sg-shadow code { font-size: 0.72rem; color: var(--c-gray-600); }
  .sg-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @media (max-width: 720px) { .sg-2col { grid-template-columns: 1fr; } }
  .sg-type-row { display: flex; align-items: baseline; gap: 16px; padding: 8px 0; border-bottom: 1px solid var(--c-border-soft); }
  .sg-type-lbl { flex: none; width: 84px; }
  .sg-space-row { display: flex; align-items: center; gap: 14px; padding: 5px 0; }
  .sg-space-row code { width: 96px; flex: none; }
  .sg-space-bar { height: 16px; background: var(--c-blue); border-radius: 4px; }
  .sg-radii, .sg-shadows { display: flex; flex-wrap: wrap; gap: 18px; }
  .sg-radius, .sg-shadow { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .sg-radius-box { width: 64px; height: 64px; background: var(--g-blue); }
  .sg-shadow-box { width: 90px; height: 60px; background: #fff; border-radius: 12px; }
  .sg-row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .sg-code { margin: 14px 0 0; font-family: ui-monospace, Menlo, monospace; font-size: 0.78rem; color: var(--c-gray-600); background: var(--surface-2); border: 1px solid var(--c-border-soft); border-radius: 8px; padding: 8px 10px; }
</style>
