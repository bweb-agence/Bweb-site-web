---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import Card from "../../components/starwind/card/Card.astro";
import Button from "../../components/starwind/button/Button.astro";

/* =========================================================
   ADMIN — Contacts
   -----------------------------------------------------------
   La base unifiée des personnes connues du site, dédupliquée sur l'e-mail OU le
   téléphone (table `contacts`). Un contact peut n'avoir qu'un numéro WhatsApp :
   c'est le cas d'un lead magnet, et c'est voulu.

   Deux statuts seulement : client (a payé au moins une fois) ou lead. La nuance
   se met dans les étiquettes, qui sont libres.
   ========================================================= */

/* Les quatre indicateurs comptent des PERSONNES : leurs icônes forment donc une
   même famille — la silhouette est identique partout, seul le signe qui la
   qualifie change (deux silhouettes pour l'ensemble, « + » pour les nouveaux,
   « ✓ » pour ceux qui ont payé, rien pour les leads). Un compteur illustré par
   un symbole abstrait rompait la lecture : on ne voyait plus qu'il s'agissait
   des mêmes gens, répartis autrement. */
const SILHOUETTE = '<circle cx="10" cy="8.5" r="3.3"/><path d="M3.6 20a6.4 6.4 0 0 1 12.8 0"/>';
const kpis = [
  { key: "total", label: "Contacts", accent: "navy",
    icon: '<circle cx="9" cy="8.5" r="3.3"/><path d="M2.6 20a6.4 6.4 0 0 1 12.8 0"/><path d="M16.2 6.1a3.3 3.3 0 0 1 0 5.6M21.4 20a6.4 6.4 0 0 0-4.2-6"/>' },
  { key: "nouveaux", label: "Nouveaux (7 j)", accent: "blue",
    icon: SILHOUETTE + '<path d="M18.5 4.6v5.2M15.9 7.2h5.2"/>' },
  { key: "clients", label: "Clients", accent: "green",
    icon: SILHOUETTE + '<path d="M15.8 7.4 17.6 9.2 21 5.6"/>' },
  { key: "leads", label: "Leads", accent: "violet",
    icon: '<circle cx="12" cy="8.5" r="3.3"/><path d="M5.6 20a6.4 6.4 0 0 1 12.8 0"/>' },
];
---

<AdminLayout title="Contacts" active="contacts">
  <div class="sw space-y-6">
    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
      {kpis.map((k) => (
        <Card class="p-3.5 sm:p-5">
          <div class="flex items-center gap-2.5 sm:gap-3.5">
            <span class={`kpi-ico ${k.accent} size-9 sm:size-11`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-[18px] sm:size-5" set:html={k.icon} />
            </span>
            <div class="min-w-0">
              <div class="text-[0.68rem] leading-tight font-bold tracking-wide text-muted-foreground uppercase sm:text-xs">{k.label}</div>
              <div class="mt-1 font-display text-lg leading-tight font-extrabold text-foreground tabular-nums sm:text-xl md:text-2xl" data-kpi={k.key}>—</div>
            </div>
          </div>
        </Card>
      ))}
    </div>

    <div class="admin-toolbar crm-toolbar">
      <input class="admin-search" id="c-search" type="search" placeholder="Nom, e-mail, téléphone…" />
      <select class="admin-filter" id="c-origine"><option value="">Toutes les origines</option></select>
      <select class="admin-filter" id="c-statut">
        <option value="">Clients et leads</option>
        <option value="client">Clients</option>
        <option value="lead">Leads</option>
      </select>
      <select class="admin-filter" id="c-tag"><option value="">Toutes les étiquettes</option></select>
      <select class="admin-filter" id="c-com">
        <option value="">Tous</option>
        <option value="email">Joignables par e-mail</option>
        <option value="whatsapp">Joignables sur WhatsApp</option>
        <option value="desabonnes">Désabonnés</option>
      </select>
      <Button id="c-export" variant="outline" size="sm" class="crm-export">⬇ Exporter CSV</Button>
    </div>

    <Card class="gap-0 p-0">
      <div class="acq-tablewrap">
        <table class="acq-table acq-tct">
          <colgroup>
            <col style="width:62px" /><col /><col style="width:26%" /><col style="width:160px" />
            <col style="width:100px" /><col style="width:140px" /><col style="width:34px" />
          </colgroup>
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Initiales</span></th><th scope="col">Contact</th><th scope="col">Coordonnées</th>
              <th scope="col">Origine</th><th scope="col" class="ta-c">Statut</th><th scope="col">Dernière activité</th><th scope="col"><span class="sr-only">Ouvrir</span></th>
            </tr>
          </thead>
          <tbody data-rows><tr><td colspan="7"><div class="acq-load">Chargement…</div></td></tr></tbody>
        </table>
      </div>
      <div class="acq-pager" data-pager></div>
    </Card>

    <p class="admin-legend">
      <b>Client</b> a payé au moins une fois · <b>Lead</b> pas encore. Transmis à ACQ Hub une fois par jour.
    </p>
  </div>

  <div class="a-drawer-overlay" id="overlay"></div>
  <aside class="a-drawer" id="drawer" aria-hidden="true" aria-label="Fiche du contact">
    <div class="a-drawer-head">
      <div class="cd-head">
        <span class="avatar" data-d="avatar">—</span>
        <div>
          <h3 data-d="nom">—</h3>
          <div class="meta" data-d="meta">—</div>
          <div style="margin-top:8px" data-d="badge"></div>
        </div>
      </div>
      <button class="icon-btn" id="close-btn" aria-label="Fermer">✕</button>
    </div>
    <div class="a-drawer-body" data-d="body"></div>
    <div class="a-drawer-foot" data-d="foot"></div>
  </aside>
</AdminLayout>

<script>
  import { supabaseBrowser } from "../../lib/supabaseBrowser";
  import { esc, toast, chargerTout } from "../../scripts/adminUtils";
  import {
    avatarBg, downloadCsv, dwhen, firstName, formLabel, initials,
    renderPager, utmSummary, digitsOnly, PAR_PAGE,
  } from "../../scripts/acquisition";

  type Contact = {
    id: string; email: string | null; phone: string | null;
    full_name: string | null; company: string | null; status: string;
    tags: string[]; notes: string | null;
    first_source: string | null; first_utm: Record<string, string> | null;
    email_opt_in: boolean; whatsapp_opt_in: boolean; unsubscribed_at: string | null;
    merge_candidate_id: string | null;
    first_seen_at: string; last_activity_at: string;
  };
  type Evenement = {
    id: string; type: string; title: string | null; amount: number | null;
    source: string | null; submission_id: string | null; occurred_at: string;
  };

  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const rows = document.querySelector("[data-rows]")!;
  const pagerEl = document.querySelector("[data-pager]") as HTMLElement;

  const ETIQUETTES_SUGGEREES = ["VIP", "Entreprise", "Fidèle", "Chaud", "À rappeler"];

  const badge = (statut: string) =>
    statut === "client"
      ? '<span class="tag-pill client dot">Client</span>'
      : '<span class="tag-pill pub dot">Lead</span>';

  /* Une timeline lisible : un pictogramme par nature d'événement, et un libellé
     qui dit ce qui s'est passé — pas le nom technique du type. */
  const EVENEMENTS: Record<string, { ico: string; fond: string; encre: string; defaut: string }> = {
    soumission:       { ico: "✉", fond: "#e3edff", encre: "#1550b8", defaut: "Formulaire envoyé" },
    webinaire_inscrit:{ ico: "▶", fond: "#e6f8f2", encre: "#0a9d76", defaut: "Inscription à un webinaire" },
    achat:            { ico: "★", fond: "#dcf5ec", encre: "#0a7d5f", defaut: "Achat" },
    reservation:      { ico: "★", fond: "#dcf5ec", encre: "#0a7d5f", defaut: "Réservation" },
    email_envoye:     { ico: "@", fond: "#eef1f8", encre: "#565d80", defaut: "E-mail envoyé" },
    campagne:         { ico: "◆", fond: "#eef1f8", encre: "#565d80", defaut: "Campagne" },
    desabonnement:    { ico: "⊘", fond: "#fbe7e7", encre: "#b02525", defaut: "Désabonnement" },
    note:             { ico: "✎", fond: "#fbf1d6", encre: "#8a6400", defaut: "Note" },
  };

  let contacts: Contact[] = [];
  let visibles: Contact[] = [];
  let page = 1;

  const nomDe = (c: Contact) => c.full_name || c.email || c.phone || "Sans nom";
  const origineDe = (c: Contact) =>
    c.first_source === "billetterie" ? "Billetterie (repris)" : c.first_source ? formLabel(c.first_source) : "—";

  /* ---------- Rendu ---------- */

  function renderKpis() {
    const semaine = Date.now() - 7 * 86_400_000;
    const set = (k: string, v: string) => { const el = document.querySelector(`[data-kpi="${k}"]`); if (el) el.textContent = v; };
    set("total", String(contacts.length));
    set("nouveaux", String(contacts.filter((c) => +new Date(c.first_seen_at) >= semaine).length));
    set("clients", String(contacts.filter((c) => c.status === "client").length));
    set("leads", String(contacts.filter((c) => c.status !== "client").length));
  }

  function render(list: Contact[]) {
    page = renderPager(pagerEl, list.length, page, (p) => { page = p; render(list); }, "contact");
    const tranche = list.slice((page - 1) * PAR_PAGE, page * PAR_PAGE);

    rows.innerHTML = tranche.length
      ? tranche.map((c, idx) => {
          const etiquettes = c.tags.slice(0, 2).map((t) => `<span class="crm-tag sm">${esc(t)}</span>`).join("")
            + (c.tags.length > 2 ? `<span class="crm-tag sm more" title="${esc(c.tags.slice(2).join(", "))}">+${c.tags.length - 2}</span>` : "");
          return `<tr data-idx="${idx}" tabindex="0" role="button" aria-label="Ouvrir la fiche de ${esc(nomDe(c))}">
            <td class="acq-avcell"><span class="avatar" style="background:${avatarBg(c.id)}">${esc(initials(nomDe(c)))}</span></td>
            <td class="acq-qui">
              <b>${esc(nomDe(c))}${c.company ? `<span class="sub" style="display:inline;margin-left:6px">${esc(c.company)}</span>` : ""}</b>
              ${etiquettes ? `<span class="crm-tags-inline">${etiquettes}</span>` : (c.email ? "" : `<span class="sub">sans e-mail</span>`)}
            </td>
            <td class="acq-coord acq-cell">${esc(c.email || "—")}<br>${esc(c.phone || "—")}</td>
            <td class="acq-origine acq-cell">${esc(origineDe(c))}</td>
            <td class="acq-statut ta-c">${badge(c.status)}</td>
            <td class="acq-vu acq-cell">${esc(dwhen(c.last_activity_at))}</td>
            <td class="acq-chev" aria-hidden="true">›</td>
          </tr>`;
        }).join("")
      : `<tr><td colspan="7"><div class="acq-vide">${contacts.length ? "Aucun contact ne correspond à ces filtres." : "Aucun contact pour l'instant."}</div></td></tr>`;

    rows.querySelectorAll<HTMLElement>("tr[data-idx]").forEach((row) => {
      const go = () => ouvrir(tranche[+row.dataset.idx!]);
      row.addEventListener("click", go);
      row.addEventListener("keydown", (e) => {
        const k = (e as KeyboardEvent).key;
        if (k === "Enter" || k === " ") { e.preventDefault(); go(); }
      });
    });
  }

  /* ---------- Fiche (tiroir) ---------- */

  const drawer = document.getElementById("drawer")!, overlay = document.getElementById("overlay")!;
  const setD = (k: string, html: string) => { document.querySelector(`[data-d="${k}"]`)!.innerHTML = html; };
  const fermer = () => { drawer.classList.remove("open"); overlay.classList.remove("open"); document.body.style.overflow = ""; };

  /** Enregistre une modification de la fiche (étiquettes, note, consentement). */
  async function enregistrer(c: Contact, patch: Partial<Contact>): Promise<boolean> {
    const { error } = await supabaseBrowser.from("contacts").update(patch).eq("id", c.id);
    if (error) return false;
    Object.assign(c, patch);
    return true;
  }

  async function ouvrir(c: Contact, garderScroll = false) {
    const body = document.querySelector('[data-d="body"]') as HTMLElement;
    const scroll = garderScroll ? body.scrollTop : 0;

    (document.querySelector('[data-d="avatar"]') as HTMLElement).style.background = avatarBg(c.id);
    setD("avatar", esc(initials(nomDe(c))));
    setD("nom", esc(nomDe(c)));
    setD("meta", esc([c.company, `connu depuis le ${new Date(c.first_seen_at).toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" })}`].filter(Boolean).join(" · ")));
    setD("badge", badge(c.status));

    const alerteFusion = c.merge_candidate_id
      ? `<div class="cd-sect" style="margin-top:0"><div class="acq-payload" style="padding:12px 15px;border-color:rgba(210,45,45,.25);background:#fbe7e7">
           <b>Doublon probable</b> — une autre fiche partage l'un de ses identifiants.
           Les deux ont été conservées : une fusion automatique qui se trompe est irréversible.
         </div></div>`
      : "";

    const etiquettesHtml = [...new Set([...ETIQUETTES_SUGGEREES, ...c.tags])]
      .map((t) => `<button type="button" class="crm-tag toggle${c.tags.includes(t) ? " on" : ""}" data-tag="${esc(t)}">${esc(t)}</button>`).join("");

    setD("body", `
      ${alerteFusion}
      <div class="cd-sect"${alerteFusion ? "" : ' style="margin-top:0"'}><h4>Coordonnées</h4>
        <dl class="acq-kv">
          <dt>E-mail</dt><dd>${c.email ? esc(c.email) : '<span style="color:var(--c-gray-500);font-weight:500">non communiqué</span>'}</dd>
          <dt>Téléphone</dt><dd>${esc(c.phone || "—")}</dd>
          <dt>Origine</dt><dd>${esc(origineDe(c))}</dd>
          <dt>Campagne d'origine</dt><dd>${esc(utmSummary(c.first_utm))}</dd>
        </dl>
      </div>

      <div class="cd-sect"><h4>Communication</h4>
        <label class="acq-optin"><input type="checkbox" data-optin="email_opt_in" ${c.email_opt_in ? "checked" : ""} ${c.email ? "" : "disabled"}> Joignable par e-mail</label>
        <label class="acq-optin"><input type="checkbox" data-optin="whatsapp_opt_in" ${c.whatsapp_opt_in ? "checked" : ""} ${c.phone ? "" : "disabled"}> Joignable sur WhatsApp</label>
        ${c.unsubscribed_at ? `<p class="acq-hint">Désabonné le ${esc(dwhen(c.unsubscribed_at))}.</p>` : ""}
      </div>

      <div class="cd-sect"><h4>Étiquettes</h4>
        <div class="crm-tags-edit">${etiquettesHtml}
          <input class="crm-tag-input" data-nouvelle-etiquette placeholder="+ ajouter" maxlength="24">
        </div>
      </div>

      <div class="cd-sect"><h4>Note interne <span data-note-ok class="acq-saved" hidden>Enregistré ✓</span></h4>
        <textarea class="a-textarea" data-note placeholder="Ce qu'il faut se rappeler de ce contact…">${esc(c.notes || "")}</textarea>
      </div>

      <div class="cd-sect"><h4>Historique</h4><div data-timeline><p class="acq-hint">Chargement…</p></div></div>`);

    const tel = digitsOnly(c.phone);
    const bonjour = `Bonjour ${firstName(c.full_name)} 👋 C'est l'équipe Bweb Agence.`;
    setD("foot", `
      ${c.email && c.email_opt_in
        ? `<a class="abtn primary sm" target="_blank" rel="noopener" href="mailto:${encodeURIComponent(c.email)}">Écrire</a>`
        : c.email ? `<span class="crm-optout">🔕 Désabonné e-mail</span>` : ""}
      ${tel && c.whatsapp_opt_in
        ? `<a class="abtn wa sm" target="_blank" rel="noopener" href="https://wa.me/${tel}?text=${encodeURIComponent(bonjour)}">WhatsApp</a>`
        : tel ? `<span class="crm-optout">🔕 Désabonné WhatsApp</span>` : ""}
      <span class="grow"></span>
      <button type="button" class="abtn" data-export-fiche>⬇ Exporter la fiche</button>`);

    drawer.classList.add("open"); overlay.classList.add("open"); document.body.style.overflow = "hidden";
    body.scrollTop = scroll;

    brancherFiche(c);
    chargerHistorique(c);
  }

  function brancherFiche(c: Contact) {
    const body = document.querySelector('[data-d="body"]') as HTMLElement;

    // Étiquettes : bascule immédiate, la liste se reconstruit sans perdre le scroll.
    body.querySelectorAll<HTMLElement>("[data-tag]").forEach((b) =>
      b.addEventListener("click", async () => {
        const t = b.dataset.tag!;
        const tags = c.tags.includes(t) ? c.tags.filter((x) => x !== t) : [...c.tags, t];
        if (await enregistrer(c, { tags })) { rafraichir(); ouvrir(c, true); }
        else toast("Enregistrement impossible.", "err");
      }));

    const nouvelle = body.querySelector<HTMLInputElement>("[data-nouvelle-etiquette]");
    nouvelle?.addEventListener("keydown", async (e) => {
      if ((e as KeyboardEvent).key !== "Enter") return;
      e.preventDefault();
      const v = nouvelle.value.trim();
      if (!v || c.tags.includes(v)) { nouvelle.value = ""; return; }
      if (await enregistrer(c, { tags: [...c.tags, v] })) { rafraichir(); ouvrir(c, true); }
      else toast("Enregistrement impossible.", "err");
    });

    // Note : enregistrée à la perte de focus, avec un accusé discret.
    const note = body.querySelector<HTMLTextAreaElement>("[data-note]");
    const accuse = body.querySelector<HTMLElement>("[data-note-ok]");
    note?.addEventListener("blur", async () => {
      if ((c.notes || "") === note.value) return;
      if (await enregistrer(c, { notes: note.value })) {
        if (accuse) { accuse.hidden = false; setTimeout(() => { accuse.hidden = true; }, 2200); }
      } else toast("Enregistrement impossible.", "err");
    });

    // Consentement : couper l'e-mail vaut désabonnement, et se date.
    body.querySelectorAll<HTMLInputElement>("[data-optin]").forEach((cb) =>
      cb.addEventListener("change", async () => {
        const champ = cb.dataset.optin as "email_opt_in" | "whatsapp_opt_in";
        const patch: Partial<Contact> = { [champ]: cb.checked } as Partial<Contact>;
        if (champ === "email_opt_in") patch.unsubscribed_at = cb.checked ? null : new Date().toISOString();
        if (await enregistrer(c, patch)) { toast("Préférence enregistrée ✓"); ouvrir(c, true); }
        else { cb.checked = !cb.checked; toast("Enregistrement impossible.", "err"); }
      }));

    // Le pied du tiroir est hors de `body` : on le cible directement. Une seule
    // écoute — le HTML du pied est reconstruit à chaque ouverture, donc rien ne
    // s'accumule d'une fiche à l'autre.
    document.querySelector<HTMLElement>('[data-d="foot"] [data-export-fiche]')
      ?.addEventListener("click", () => exporterFiche(c));
  }

  /** Historique chargé à l'ouverture de la fiche : inutile de tout tirer en liste. */
  async function chargerHistorique(c: Contact) {
    const cible = document.querySelector("[data-timeline]");
    if (!cible) return;
    const { data, error } = await supabaseBrowser
      .from("contact_events")
      .select("id,type,title,amount,source,submission_id,occurred_at")
      .eq("contact_id", c.id)
      .order("occurred_at", { ascending: false })
      .limit(100);

    if (error) { cible.innerHTML = `<p class="acq-hint">Historique indisponible.</p>`; return; }
    const evs = (data || []) as unknown as Evenement[];
    if (!evs.length) { cible.innerHTML = `<p class="acq-hint">Aucune activité enregistrée pour l'instant.</p>`; return; }

    cible.innerHTML = `<div class="acq-tl">${evs.map((e) => {
      const st = EVENEMENTS[e.type] || EVENEMENTS.soumission;
      const montant = e.amount ? ` · <span class="money">${e.amount.toLocaleString("fr-FR")} <small class="fcfa">F CFA</small></span>` : "";
      const lien = e.submission_id ? ` · <a href="/admin/soumissions?s=${encodeURIComponent(e.submission_id)}">voir la soumission</a>` : "";
      return `<div class="acq-tl-item">
        <div class="acq-tl-rail"><span class="acq-tl-dot" style="background:${st.fond};color:${st.encre}">${st.ico}</span><span class="acq-tl-line"></span></div>
        <div class="acq-tl-body">
          <div class="acq-tl-t">${esc(e.title || st.defaut)}</div>
          <div class="acq-tl-m">${esc(dwhen(e.occurred_at))}${montant}${lien}</div>
        </div>
      </div>`;
    }).join("")}</div>`;
  }

  document.getElementById("close-btn")!.addEventListener("click", fermer);
  overlay.addEventListener("click", fermer);
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") fermer(); });

  /* ---------- Filtres ---------- */

  function remplirFiltres() {
    const origines = [...new Map(contacts.map((c) => [c.first_source || "", origineDe(c)])).entries()]
      .filter(([k]) => k).sort((a, b) => a[1].localeCompare(b[1], "fr"));
    $("c-origine").innerHTML = '<option value="">Toutes les origines</option>'
      + origines.map(([k, l]) => `<option value="${esc(k)}">${esc(l)}</option>`).join("");

    const tags = [...new Set(contacts.flatMap((c) => c.tags))].sort((a, b) => a.localeCompare(b, "fr"));
    const courant = $("c-tag").value;
    $("c-tag").innerHTML = '<option value="">Toutes les étiquettes</option>'
      + tags.map((t) => `<option value="${esc(t)}">${esc(t)}</option>`).join("");
    if (tags.includes(courant)) $("c-tag").value = courant;
  }

  /** Recalcule la liste sans quitter la page où l'on se trouve. */
  function rafraichir() {
    const courante = page;
    appliquer();
    page = courante;
    render(visibles);
  }

  function appliquer() {
    const q = ($("c-search").value || "").toLowerCase().trim();
    const origine = $("c-origine").value, statut = $("c-statut").value;
    const tag = $("c-tag").value, com = $("c-com").value;

    page = 1;
    visibles = contacts.filter((c) =>
      (!origine || (c.first_source || "") === origine) &&
      (!statut || (statut === "client" ? c.status === "client" : c.status !== "client")) &&
      (!tag || c.tags.includes(tag)) &&
      (!com ||
        (com === "email" && !!c.email && c.email_opt_in) ||
        (com === "whatsapp" && !!c.phone && c.whatsapp_opt_in) ||
        (com === "desabonnes" && (!c.email_opt_in || !c.whatsapp_opt_in))) &&
      (!q || `${c.full_name || ""} ${c.email || ""} ${c.phone || ""} ${c.company || ""}`.toLowerCase().includes(q)));

    render(visibles);
  }

  function exporter() {
    downloadCsv(
      "contacts-bweb.csv",
      ["Nom", "E-mail", "Téléphone", "Entreprise", "Statut", "Origine", "Campagne d'origine", "Étiquettes", "E-mail OK", "WhatsApp OK", "Désabonné le", "Connu depuis", "Dernière activité", "Note"],
      visibles.map((c) => [
        c.full_name, c.email, c.phone, c.company,
        c.status === "client" ? "Client" : "Lead",
        origineDe(c), utmSummary(c.first_utm), c.tags.join(" | "),
        c.email_opt_in ? "oui" : "non", c.whatsapp_opt_in ? "oui" : "non",
        c.unsubscribed_at ? new Date(c.unsubscribed_at).toISOString() : "",
        new Date(c.first_seen_at).toISOString(), new Date(c.last_activity_at).toISOString(), c.notes,
      ]),
    );
  }

  function exporterFiche(c: Contact) {
    downloadCsv(
      `contact-${(c.full_name || c.email || c.phone || c.id).replace(/[^a-z0-9]+/gi, "-").toLowerCase()}.csv`,
      ["Champ", "Valeur"],
      [
        ["Nom", c.full_name], ["E-mail", c.email], ["Téléphone", c.phone], ["Entreprise", c.company],
        ["Statut", c.status === "client" ? "Client" : "Lead"], ["Origine", origineDe(c)],
        ["Campagne d'origine", utmSummary(c.first_utm)], ["Étiquettes", c.tags.join(" | ")],
        ["Joignable par e-mail", c.email_opt_in ? "oui" : "non"],
        ["Joignable sur WhatsApp", c.whatsapp_opt_in ? "oui" : "non"],
        ["Connu depuis", new Date(c.first_seen_at).toISOString()],
        ["Dernière activité", new Date(c.last_activity_at).toISOString()],
        ["Note", c.notes],
      ],
    );
  }

  $("c-search").addEventListener("input", appliquer);
  ["c-origine", "c-statut", "c-tag", "c-com"].forEach((id) => $(id).addEventListener("change", appliquer));
  document.getElementById("c-export")!.addEventListener("click", exporter);

  /* ---------- Chargement ---------- */

  (async () => {
    const { data: { session } } = await supabaseBrowser.auth.getSession();
    if (!session) return; // AdminLayout gère la redirection

    const { data, error } = await chargerTout(() => supabaseBrowser
      .from("contacts")
      .select("id,email,phone,full_name,company,status,tags,notes,first_source,first_utm,email_opt_in,whatsapp_opt_in,unsubscribed_at,merge_candidate_id,first_seen_at,last_activity_at")
      .order("last_activity_at", { ascending: false })
      .order("id", { ascending: false }));

    if (error) {
      rows.innerHTML = `<div class="acq-vide">Lecture impossible : ${esc(error.message)}</div>`;
      return;
    }
    contacts = (data || []) as unknown as Contact[];
    renderKpis();
    remplirFiltres();
    appliquer();

    // Arrivée depuis une soumission : on ouvre directement la bonne fiche.
    const cible = new URLSearchParams(location.search).get("c");
    if (cible) {
      const c = contacts.find((x) => x.id === cible);
      if (c) ouvrir(c);
    }
  })();
</script>
