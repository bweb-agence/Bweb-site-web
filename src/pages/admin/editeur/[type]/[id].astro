---
export const prerender = false;
import EditorLayout from "../../../../layouts/EditorLayout.astro";

const { type, id } = Astro.params;
const TYPES = ["article", "formation", "session"] as const;
if (!TYPES.includes(type as any)) return Astro.redirect("/admin");

const cfg = {
  article:   { label: "Article",   plural: "Articles",   back: "/admin/articles",   base: "/blog/",                 titleLabel: "Titre de l'article" },
  formation: { label: "Formation", plural: "Formations", back: "/admin/formations", base: "/formations/",           titleLabel: "Titre de la formation" },
  session:   { label: "Session",   plural: "Sessions",   back: "/admin/sessions",   base: "/formations/session/",   titleLabel: "Titre de la session" },
}[type as "article" | "formation" | "session"];

const isNew = id === "nouveau";
---

<EditorLayout title={`${isNew ? "Nouveau" : "Édition"} · ${cfg.label}`}>
  <div id="ed-root" data-type={type} data-id={isNew ? "" : id} data-base={cfg.base}>

    <!-- ============ Barre supérieure ============ -->
    <header class="ed-topbar">
      <a class="ed-icon" href={cfg.back} title="Retour à la liste" aria-label="Retour">←</a>
      <div class="ed-crumb"><span>{cfg.plural}</span><span class="sep">/</span><b id="ed-crumb-doc">{isNew ? `Nouveau ${cfg.label.toLowerCase()}` : "…"}</b></div>
      <div class="ed-spacer"></div>
      <span class="ed-autostate" id="ed-autostate" aria-live="polite"></span>
      {type !== "formation" && <span class="ed-status-pill" id="ed-status-pill"><span class="g"></span>Brouillon</span>}
      <a class="ed-btn ghost" id="ed-preview" href="#" target="_blank" rel="noopener" hidden>Aperçu</a>
      <button class="ed-btn" id="ed-save">Enregistrer</button>
      {type !== "formation" && <button class="ed-btn primary" id="ed-publish">Publier</button>}
    </header>

    <div class="ed-layout">
      <!-- ============ Zone d'édition ============ -->
      <main class="ed-main">
        <div class="ed-toolbar" id="ed-toolbar" role="toolbar" aria-label="Mise en forme">
          <div class="ed-style" data-style></div>
          <span class="ed-sep"></span>
          <button class="ed-tb" data-cmd="bold" title="Gras (Ctrl+B)"><b>B</b></button>
          <button class="ed-tb" data-cmd="italic" title="Italique (Ctrl+I)"><i>I</i></button>
          <button class="ed-tb" data-cmd="underline" title="Souligné (Ctrl+U)"><u>U</u></button>
          <button class="ed-tb" data-cmd="strike" title="Barré"><s>S</s></button>
          <button class="ed-tb" data-cmd="code" title="Code en ligne"><span class="mono">&lt;/&gt;</span></button>
          <span class="ed-sep"></span>
          <button class="ed-tb" data-cmd="bulletList" title="Liste à puces">☰</button>
          <button class="ed-tb" data-cmd="orderedList" title="Liste numérotée">1.</button>
          <button class="ed-tb" data-cmd="blockquote" title="Citation">❝</button>
          <button class="ed-tb" data-cmd="callout" title="Encadré (Ctrl+Maj+E)">💡</button>
          <button class="ed-tb" data-cmd="codeBlock" title="Bloc de code">▤</button>
          <span class="ed-sep"></span>
          <button class="ed-tb" data-cmd="link" title="Lien">🔗</button>
          <button class="ed-tb" data-cmd="image" title="Image">🖼</button>
          <button class="ed-tb" data-cmd="table" title="Tableau">▦</button>
          <button class="ed-tb" data-cmd="hr" title="Séparateur">―</button>
          <span class="ed-sep"></span>
          <button class="ed-tb" data-cmd="undo" title="Annuler">↺</button>
          <button class="ed-tb" data-cmd="redo" title="Rétablir">↻</button>
          <span class="ed-sep" data-table-only hidden></span>
          <button class="ed-tb" data-cmd="tableAddRow" data-table-only hidden title="Ajouter une ligne">＋▤</button>
          <button class="ed-tb" data-cmd="tableDelRow" data-table-only hidden title="Supprimer la ligne">－▤</button>
          <button class="ed-tb" data-cmd="tableAddCol" data-table-only hidden title="Ajouter une colonne">＋▥</button>
          <button class="ed-tb" data-cmd="tableDelCol" data-table-only hidden title="Supprimer la colonne">－▥</button>
          <button class="ed-tb danger" data-cmd="tableDel" data-table-only hidden title="Supprimer le tableau">🗑</button>
          <span class="ed-slashhint">Tapez <kbd>/</kbd> pour insérer un bloc</span>
        </div>

        <div class="ed-canvas-wrap">
          <div class="ed-canvas">
            <label class="ed-title-eyebrow" for="ed-title">{cfg.titleLabel}</label>
            <textarea class="ed-doc-title" id="ed-title" rows="1"
              placeholder={type === "article" ? "Écrivez ici le titre de l'article…" : type === "formation" ? "Écrivez ici le nom de la formation…" : "Écrivez ici le titre de la session…"}></textarea>
            <div class="ed-doc-meta" id="ed-doc-meta"></div>
            <div class="ed-body-label">Contenu</div>
            <div id="ed-editor" class="ed-mount"></div>
          </div>
        </div>
      </main>

      <!-- ============ Réglages ============ -->
      <aside class="ed-aside" id="ed-aside">

        {type !== "formation" && (
          <section class="ed-panel">
            <h4>Publication</h4>
            <div class="ed-field">
              <label>Statut</label>
              <div class="ed-seg" id="ed-status" role="group" aria-label="Statut">
                <button type="button" data-status="draft" aria-pressed="true">Brouillon</button>
                <button type="button" data-status="published" class="pub" aria-pressed="false">Publié</button>
                {type === "session" && <button type="button" data-status="cancelled" aria-pressed="false">Annulée</button>}
              </div>
            </div>
            {type === "article" && (
              <div class="ed-field"><label for="f-pubdate">Date de publication</label>
                <input class="ed-inp" id="f-pubdate" type="datetime-local" />
                <div class="ed-help">Vide = date du jour à la publication.</div>
              </div>
            )}
          </section>
        )}

        {/* -------- ARTICLE -------- */}
        {type === "article" && (
          <>
            <section class="ed-panel"><h4>Adresse (URL)</h4>
              <div class="ed-field"><div class="ed-slugbox"><span class="pre">/blog/</span><input id="f-slug" aria-label="Slug" /></div>
                <div class="ed-help">Générée depuis le titre — modifiable.</div></div>
            </section>
            <section class="ed-panel"><h4>Organisation</h4>
              <div class="ed-field"><label for="f-category">Catégorie</label>
                <input class="ed-inp" id="f-category" list="cat-list" />
                <datalist id="cat-list"><option value="IA"></option><option value="Marketing"></option><option value="Automatisation"></option><option value="Vente en ligne"></option><option value="Cas clients"></option></datalist></div>
              <div class="ed-row2">
                <div class="ed-field"><label for="f-author">Auteur</label><input class="ed-inp" id="f-author" value="Équipe Bweb" /></div>
                <div class="ed-field"><label for="f-reading">Lecture (min)</label><input class="ed-inp" id="f-reading" type="number" min="1" placeholder="auto" /></div>
              </div>
            </section>
            <section class="ed-panel"><h4>Extrait</h4>
              <div class="ed-field"><textarea class="ed-ta" id="f-excerpt" rows="3" placeholder="Résumé affiché sur la liste du blog…"></textarea></div>
            </section>
            <section class="ed-panel"><h4>Image de couverture</h4>
              <div class="ed-cover" id="ed-cover" data-target="f-cover"></div>
              <input type="hidden" id="f-cover" />
            </section>
            <section class="ed-panel ed-seo">
              <h4>Référencement (SEO)<span class="ed-seo-badge" id="ed-seo-badge">—</span></h4>
              <div class="ed-field"><label for="f-focus">Mot-clé cible</label>
                <input class="ed-inp" id="f-focus" placeholder="Ex. IA pour PME" />
                <div class="ed-help">L'expression sur laquelle vous voulez être trouvé.</div></div>
              <div class="ed-seo-preview" id="ed-seo-preview" aria-label="Aperçu Google">
                <div class="g-url" id="seo-url"></div>
                <div class="g-title" id="seo-title">Titre de l'article</div>
                <div class="g-desc" id="seo-desc">Ajoutez une description méta…</div>
              </div>
              <div class="ed-field"><label for="f-seotitle">Titre méta</label>
                <input class="ed-inp" id="f-seotitle" />
                <div class="ed-help" id="seo-title-count"></div></div>
              <div class="ed-field"><label for="f-seodesc">Description méta</label>
                <textarea class="ed-ta" id="f-seodesc" rows="3"></textarea>
                <div class="ed-help" id="seo-desc-count"></div></div>
              <div class="ed-seo-checks" id="ed-seo-checks"></div>
            </section>
          </>
        )}

        {/* -------- FORMATION -------- */}
        {type === "formation" && (
          <>
            <div class="ed-ftabs" role="tablist">
              <button type="button" class="ed-ftab is-active" data-ftab="details" aria-selected="true">Détails</button>
              <button type="button" class="ed-ftab" data-ftab="sessions" aria-selected="false">Sessions</button>
            </div>
            <div data-ftab-pane="details">
            <section class="ed-panel"><h4>Adresse (URL)</h4>
              <div class="ed-field"><div class="ed-slugbox"><span class="pre">/formations/</span><input id="f-slug" aria-label="Slug" /></div></div>
              <div class="ed-help" style="margin-top:2px">Les formations sont toujours visibles dans le catalogue.</div>
            </section>
            <section class="ed-panel"><h4>Détails</h4>
              <div class="ed-field"><label for="f-theme">Thème</label><input class="ed-inp" id="f-theme" list="th-list" />
                <datalist id="th-list"><option value="IA"></option><option value="Marketing"></option><option value="Vente en ligne"></option><option value="Automatisation"></option></datalist></div>
              <div class="ed-row2">
                <div class="ed-field"><label for="f-level">Niveau</label><input class="ed-inp" id="f-level" placeholder="Débutant accepté" /></div>
                <div class="ed-field"><label for="f-duration">Durée</label><input class="ed-inp" id="f-duration" placeholder="2 jours (14 h)" /></div>
              </div>
              <div class="ed-field"><label for="f-price">Prix indicatif (FCFA)</label><input class="ed-inp" id="f-price" type="number" min="0" /></div>
              <div class="ed-field"><label for="f-summary">Résumé (carte)</label><textarea class="ed-ta" id="f-summary" rows="3"></textarea></div>
              <div class="ed-row2">
                <div class="ed-field"><label for="f-instructor">Formateur (nom)</label><input class="ed-inp" id="f-instructor" placeholder="Ex. Awa K." /></div>
                <div class="ed-field"><label for="f-instructor-role">Formateur (rôle)</label><input class="ed-inp" id="f-instructor-role" placeholder="Ex. Consultante IA" /></div>
              </div>
              <div class="ed-field"><label for="f-instructor-photo">Photo formateur (URL)</label><input class="ed-inp" id="f-instructor-photo" placeholder="https://…/photo.jpg" /></div>
              <div class="ed-field"><label for="f-instructor-bio">Bio formateur</label><textarea class="ed-ta" id="f-instructor-bio" rows="2" placeholder="Courte présentation du formateur…"></textarea></div>
              <div class="ed-field"><label for="f-audience">À qui s'adresse cette formation</label><textarea class="ed-ta" id="f-audience" rows="2" placeholder="Ex. Entrepreneurs, indépendants, responsables marketing…"></textarea></div>
              <div class="ed-field"><label for="f-prerequis">Prérequis</label><textarea class="ed-ta" id="f-prerequis" rows="2" placeholder="Ex. Aucun prérequis. Apportez un ordinateur portable."></textarea></div>
              <div class="ed-field"><label for="f-included">Inclus en plus (1 par ligne)</label><textarea class="ed-ta" id="f-included" rows="2" placeholder="Déjeuner et pauses café inclus&#10;Accès à la communauté privée"></textarea></div>
            </section>
            <section class="ed-panel"><h4>Visuel (16/9)</h4>
              <div class="ed-cover" id="ed-cover" data-target="f-image"></div>
              <input type="hidden" id="f-image" />
            </section>
            <section class="ed-panel ed-seo">
              <h4>Référencement (SEO)<span class="ed-seo-badge" id="ed-seo-badge">—</span></h4>
              <div class="ed-field"><label for="f-focus">Mot-clé cible</label>
                <input class="ed-inp" id="f-focus" placeholder="Ex. formation IA Abidjan" />
                <div class="ed-help">L'expression sur laquelle vous voulez être trouvé.</div></div>
              <div class="ed-seo-preview" id="ed-seo-preview" aria-label="Aperçu Google">
                <div class="g-url" id="seo-url"></div>
                <div class="g-title" id="seo-title">Titre de la formation</div>
                <div class="g-desc" id="seo-desc">Ajoutez une description méta…</div>
              </div>
              <div class="ed-field"><label for="f-seotitle">Titre méta</label>
                <input class="ed-inp" id="f-seotitle" />
                <div class="ed-help" id="seo-title-count"></div></div>
              <div class="ed-field"><label for="f-seodesc">Description méta</label>
                <textarea class="ed-ta" id="f-seodesc" rows="3"></textarea>
                <div class="ed-help" id="seo-desc-count"></div></div>
              <div class="ed-seo-checks" id="ed-seo-checks"></div>
            </section>
            </div>
            <div data-ftab-pane="sessions" hidden>
            <section class="ed-panel"><h4>Dates &amp; sessions</h4>
              <div id="ed-fsessions-inline"><div class="ed-help">Chargement…</div></div>
              <button type="button" class="ed-addline" id="ed-fsession-add" hidden>+ Ajouter une date</button>
            </section>
            </div>
          </>
        )}

        {/* -------- SESSION -------- */}
        {type === "session" && (
          <>
            <section class="ed-panel"><h4>Adresse (URL)</h4>
              <div class="ed-field"><div class="ed-slugbox"><span class="pre">/…/session/</span><input id="f-slug" aria-label="Slug" /></div></div>
            </section>
            <section class="ed-panel"><h4>Détails</h4>
              <div class="ed-field"><label for="f-formation">Formation liée</label><select class="ed-sel" id="f-formation"><option value="">— Aucune —</option></select></div>
              <div class="ed-field"><label for="f-theme">Thème</label><input class="ed-inp" id="f-theme" list="th-list" />
                <datalist id="th-list"><option value="IA"></option><option value="Marketing"></option><option value="Vente en ligne"></option><option value="Automatisation"></option></datalist></div>
              <div class="ed-row2">
                <div class="ed-field"><label for="f-level">Niveau</label>
                  <select class="ed-sel" id="f-level">
                    <option value="">— Non précisé —</option>
                    <option value="debutant">Débutant</option>
                    <option value="intermediaire">Intermédiaire</option>
                    <option value="avance">Avancé</option>
                  </select>
                </div>
                <div class="ed-field"><label for="f-mode">Format</label>
                  <select class="ed-sel" id="f-mode">
                    <option value="presentiel">Présentiel</option>
                    <option value="en_ligne">En ligne (visio)</option>
                    <option value="hybride">Les deux (présentiel + en ligne)</option>
                  </select>
                </div>
              </div>
            </section>
            <section class="ed-panel"><h4>Quand</h4>
              <div class="ed-field"><label for="f-start">Début *</label><input class="ed-inp" id="f-start" type="datetime-local" /></div>
              <div class="ed-field"><label for="f-end">Fin</label><input class="ed-inp" id="f-end" type="datetime-local" /></div>
            </section>
            <section class="ed-panel" data-mode-presentiel><h4>Où (présentiel)</h4>
              <div class="ed-row2">
                <div class="ed-field"><label for="f-city">Ville</label><input class="ed-inp" id="f-city" value="Abidjan" /></div>
                <div class="ed-field"><label for="f-venue">Lieu</label><input class="ed-inp" id="f-venue" value="Espace de formation Bweb · Cocody" /></div>
              </div>
              <div class="ed-field"><label for="f-address">Adresse précise / accès (optionnel)</label><input class="ed-inp" id="f-address" placeholder="Rue, repère, étage, indications…" /></div>
            </section>
            <section class="ed-panel" data-mode-enligne hidden><h4>Visioconférence (en ligne)</h4>
              <div class="ed-field"><label for="f-meeting-url">Lien de connexion</label><input class="ed-inp" id="f-meeting-url" placeholder="https://meet… / zoom… / teams…" />
                <div class="ed-help">Affiché comme bouton « Rejoindre ». Laissez vide pour l'envoyer par e-mail après inscription.</div></div>
              <div class="ed-field"><label for="f-meeting-info">Consignes de connexion</label><textarea class="ed-ta" id="f-meeting-info" rows="3" placeholder="Plateforme, code d'accès, à quelle heure se connecter, prérequis techniques…"></textarea></div>
            </section>
            <section class="ed-panel"><h4>Billetterie</h4>
              <div class="ed-tt-list" id="ed-tt-list"></div>
              <button type="button" class="ed-addline" id="ed-tt-add">+ Ajouter un tarif</button>
              <div class="ed-help" style="margin-top:8px">Chaque tarif a sa propre capacité (anti‑surbooking).</div>
            </section>
            <section class="ed-panel"><h4>Order bumps</h4>
              <div class="ed-tt-list" id="ed-ob-list"></div>
              <button type="button" class="ed-addline" id="ed-ob-add">+ Ajouter un order bump</button>
              <div class="ed-help" style="margin-top:8px">Offres complémentaires proposées pendant la réservation (2 max). Choisissez le tarif d'une autre formation à ajouter au panier.</div>
            </section>
            <section class="ed-panel"><h4>Affiche (16/9)</h4>
              <div class="ed-cover" id="ed-cover" data-target="f-image"></div>
              <input type="hidden" id="f-image" />
            </section>
            <section class="ed-panel ed-seo">
              <h4>Référencement (SEO)<span class="ed-seo-badge" id="ed-seo-badge">—</span></h4>
              <div class="ed-field"><label for="f-focus">Mot-clé cible</label>
                <input class="ed-inp" id="f-focus" placeholder="Ex. formation IA Abidjan" />
                <div class="ed-help">L'expression sur laquelle vous voulez être trouvé.</div></div>
              <div class="ed-seo-preview" id="ed-seo-preview" aria-label="Aperçu Google">
                <div class="g-url" id="seo-url"></div>
                <div class="g-title" id="seo-title">Titre de la session</div>
                <div class="g-desc" id="seo-desc">Ajoutez une description méta…</div>
              </div>
              <div class="ed-field"><label for="f-seotitle">Titre méta</label>
                <input class="ed-inp" id="f-seotitle" />
                <div class="ed-help" id="seo-title-count"></div></div>
              <div class="ed-field"><label for="f-seodesc">Description méta</label>
                <textarea class="ed-ta" id="f-seodesc" rows="3"></textarea>
                <div class="ed-help" id="seo-desc-count"></div></div>
              <div class="ed-seo-checks" id="ed-seo-checks"></div>
            </section>
          </>
        )}

      </aside>
    </div>
  </div>

  <style>
    .ed-ftabs { display:flex; gap:6px; margin-bottom:14px; border-bottom:1px solid var(--ed-line,#e5e7eb); }
    .ed-ftab { flex:1; padding:8px 10px; border:0; background:transparent; font:inherit; font-weight:600; font-size:.85rem; color:var(--c-gray-500,#6b7280); cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-1px; }
    .ed-ftab.is-active { color:var(--c-primary,#1f6ced); border-bottom-color:currentColor; }
  </style>
  <script>
    import { initEditorPage } from "../../../../scripts/editorPage";
    initEditorPage();
  </script>
</EditorLayout>
