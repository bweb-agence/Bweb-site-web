---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import Card from "../../components/starwind/card/Card.astro";
import Button from "../../components/starwind/button/Button.astro";
---

<AdminLayout title="Webinaires" active="webinaires">
  <div class="sw space-y-6">
    <div class="admin-toolbar">
      <div class="left">
        <input class="admin-search" id="wb-search" type="search" placeholder="Rechercher une édition…" />
      </div>
      <Button variant="primary" id="wb-new">+ Nouvelle édition</Button>
    </div>

    <Card class="gap-0 overflow-hidden p-0">
      <p class="hint" style="padding:14px 18px 0">
        Le live est mensuel : <b>une ligne par édition</b>, regroupées par entonnoir. Le
        <b>lien du live</b> saisi ici part dans les rappels (la veille, le matin, une heure avant,
        à l'ouverture) — tant qu'il est vide, ces e-mails ne partent pas du tout, plutôt que
        d'annoncer un lien absent. Pour le mois suivant, <b>duplique</b> l'édition en cours :
        date décalée d'un mois, liens remis à zéro, inscrits repartis à neuf.
      </p>
      <div class="overflow-x-auto">
        <table class="admin-table min-w-[820px]">
          <thead><tr><th>Édition</th><th>Date</th><th>Lien du live</th><th>Inscrits</th><th>E-mails</th><th>État</th><th></th></tr></thead>
          <tbody data-rows><tr class="a-loading-row"><td colspan="7">Chargement…</td></tr></tbody>
        </table>
      </div>
    </Card>
  </div>

  <div class="a-drawer-overlay" id="wb-overlay"></div>
  <aside class="a-drawer" id="wb-drawer" aria-hidden="true">
    <div class="a-drawer-head">
      <h2 id="wb-drawer-title">Nouvelle édition</h2>
      <button class="icon-btn" id="wb-close" aria-label="Fermer">✕</button>
    </div>
    <div class="a-drawer-body">
      <input type="hidden" id="f-id" />
      <div class="a-field"><label for="f-title">Titre du live *</label><input class="a-input" id="f-title" placeholder="De ta compétence à tes premières ventes…" /></div>
      <div class="a-field"><label for="f-join">Lien du live</label><input class="a-input" id="f-join" placeholder="https://youtube.com/live/…" /><div class="hint">Envoyé dans les rappels. Vide = ces e-mails ne partent pas.</div></div>
      <div class="a-field"><label for="f-start">Date et heure *</label><input class="a-input" id="f-start" type="datetime-local" /><div class="hint">Heure d'Abidjan. Pilote le compte à rebours de la page et tout le calendrier d'envoi.</div></div>
      <div class="a-row2">
        <div class="a-field"><label for="f-duree">Durée (minutes)</label><input class="a-input" id="f-duree" type="number" min="5" value="90" /></div>
        <div class="a-field"><label for="f-places">Places annoncées</label><input class="a-input" id="f-places" type="number" min="0" value="500" /></div>
      </div>
      <div class="a-field"><label for="f-info">Consigne aux inscrits</label><input class="a-input" id="f-info" placeholder="Connecte-toi 5 minutes en avance, avec un carnet." /></div>
      <div class="a-field"><label for="f-whatsapp">Groupe WhatsApp</label><input class="a-input" id="f-whatsapp" placeholder="https://chat.whatsapp.com/…" /><div class="hint">Repris par la page de remerciement et par les deux premiers e-mails. Vide = le bloc disparaît partout.</div></div>
      <div class="a-field"><label for="f-telegram">Canal Telegram</label><input class="a-input" id="f-telegram" placeholder="https://t.me/…" /></div>
      <div class="a-field"><label for="f-replay">Lien du replay</label><input class="a-input" id="f-replay" placeholder="À renseigner après le live" /><div class="hint">Utilisé par l'e-mail du lendemain. À défaut, le lien du live est repris.</div></div>
      <div class="a-field"><label for="f-tunnel">Entonnoir *</label><input class="a-input" id="f-tunnel" value="webinaire-initiation" /><div class="hint">Identité stable, partagée par toutes les éditions. C'est la clé du formulaire d'inscription — ne pas la changer sans changer la page.</div></div>
      <div class="a-field"><label for="f-slug">Slug de l'édition *</label><input class="a-input" id="f-slug" /><div class="hint">Unique. Généré à partir de l'entonnoir et du mois.</div></div>
      <div class="a-field"><label for="f-depuis">Inscrits à partir du</label><input class="a-input" id="f-depuis" type="datetime-local" /><div class="hint">Sépare les éditions : seuls les inscrits d'après cette date reçoivent les e-mails de celle-ci. Vide = tous.</div></div>
      <div class="a-field"><label class="wb-toggle"><input type="checkbox" id="f-active" checked /> <span>Édition active</span></label></div>
    </div>
    <div class="a-drawer-foot">
      <span class="grow"></span>
      <button class="abtn" id="wb-cancel">Annuler</button>
      <button class="abtn primary" id="wb-save">Enregistrer</button>
    </div>
  </aside>

  <aside class="a-drawer" id="wb-stats" aria-hidden="true">
    <div class="a-drawer-head">
      <h2 id="wb-stats-title">Analyse</h2>
      <button class="icon-btn" id="wb-stats-close" aria-label="Fermer">✕</button>
    </div>
    <div class="a-drawer-body" id="wb-stats-body">
      <p class="hint">Chargement…</p>
    </div>
  </aside>
</AdminLayout>

<script>
  import { supabaseBrowser } from "../../lib/supabaseBrowser";
  import { esc, toast, confirmModal, dtLocalValue, dshort } from "../../scripts/adminUtils";

  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const rows = document.querySelector("[data-rows]")!;
  const drawer = document.getElementById("wb-drawer")!;
  const overlay = document.getElementById("wb-overlay")!;
  let all: any[] = [];
  let inscrits: Record<string, number> = {};
  let envois: Record<string, number> = {};

  const statsDrawer = document.getElementById("wb-stats")!;

  const openDrawer = () => { drawer.classList.add("open"); overlay.classList.add("open"); document.body.style.overflow = "hidden"; };
  const closeDrawer = () => { drawer.classList.remove("open"); overlay.classList.remove("open"); document.body.style.overflow = ""; };
  const closeStats = () => { statsDrawer.classList.remove("open"); overlay.classList.remove("open"); document.body.style.overflow = ""; };

  /* ---------- Analyse d'une édition ----------
     Tout vient de `webinaire_analytics` : un seul aller-retour, contre une
     dizaine si chaque étape était comptée depuis le navigateur. */
  const pct = (n: number, base: number) => (base > 0 ? Math.round((n / base) * 1000) / 10 : 0);
  const fcfa = (n: number) => new Intl.NumberFormat("fr-FR").format(n) + " FCFA";

  async function analyser(id: string) {
    const w = all.find((x) => x.id === id);
    document.getElementById("wb-stats-title")!.textContent = `Analyse — ${w?.title || ""}`;
    const body = document.getElementById("wb-stats-body")!;
    body.innerHTML = `<p class="hint">Chargement…</p>`;
    statsDrawer.classList.add("open"); overlay.classList.add("open"); document.body.style.overflow = "hidden";

    const { data, error } = await supabaseBrowser.rpc("webinaire_analytics", { p_webinaire_id: id });
    const a = Array.isArray(data) ? data[0] : data;
    if (error || !a) {
      body.innerHTML = `<p class="hint">Analyse indisponible (migration 0040 appliquée ?).</p>`;
      return;
    }

    /* Les visites viennent de Google Analytics, donc du serveur : la clé de
       service ne descend jamais dans le navigateur. La fenêtre GA est calée
       sur `premiere_inscription`, sinon le taux comparerait deux périodes. */
    let ga: any = null;
    if (a.premiere_inscription && w?.tunnel) {
      try {
        const { data: sess } = await supabaseBrowser.auth.getSession();
        const jeton = sess?.session?.access_token;
        if (jeton) {
          const r = await fetch(`/api/admin/ga-webinaire?tunnel=${encodeURIComponent(w.tunnel)}&depuis=${a.premiere_inscription}`,
            { headers: { Authorization: `Bearer ${jeton}` } });
          ga = await r.json();
        }
      } catch { /* l'analyse s'affiche sans les visites */ }
    }
    const visites: number | null = ga?.joignable ? ga.visites : null;

    /* ---------- 1. Acquisition ----------
       La seule conversion réellement mesurée à ce stade, donc la seule qui a
       droit aux gros chiffres : c'est elle qui pilote la publicité. */
    const acquisition = visites === null
      ? `<div class="wbz-acq wbz-acq--vide">
           <div class="wbz-end"><div class="wbz-lab">Visites</div><div class="wbz-num wbz-attente">—</div><div class="wbz-src">Google Analytics non connecté</div></div>
           <div class="wbz-mid"><div class="wbz-rate wbz-attente">— %</div><div class="wbz-rate-lab">s'inscrivent</div></div>
           <div class="wbz-end wbz-end--droite"><div class="wbz-lab">Inscriptions</div><div class="wbz-num wbz-bleu">${a.inscrits}</div><div class="wbz-src">Base du site</div></div>
         </div>`
      : `<div class="wbz-acq">
           <div class="wbz-end"><div class="wbz-lab">Visites</div><div class="wbz-num">${visites}</div><div class="wbz-src">Google Analytics · sessions</div></div>
           <div class="wbz-mid"><div class="wbz-rate">${pct(a.inscrits, visites || 1)} %</div><div class="wbz-rate-lab">s'inscrivent</div></div>
           <div class="wbz-end wbz-end--droite"><div class="wbz-lab">Inscriptions</div><div class="wbz-num wbz-bleu">${a.inscrits}</div><div class="wbz-src">Base du site</div></div>
         </div>`
      + (visites > a.inscrits
          ? `<p class="wbz-perte"><span class="wbz-point"></span><b>${visites - a.inscrits} visiteurs</b> sont repartis sans laisser leurs coordonnées.</p>`
          : "");

    /* ---------- 2. Séquence d'e-mails ----------
       Une CHRONOLOGIE, pas un entonnoir. Présenter « 0 rappel envoyé » comme
       une perte de 100 % était faux et alarmant : le rappel n'est simplement
       pas encore dû. On distingue donc trois états — parti, à venir, et
       « aurait dû partir », le seul qui demande une action. Les décalages
       reprennent les fenêtres d'envoi de src/lib/webinaireEmails.ts. */
    const debut = w?.starts_at ? new Date(w.starts_at).getTime() : 0;
    const H = 3600_000;
    const jourHeure = (t: number) =>
      new Date(t).toLocaleString("fr-FR", { day: "numeric", month: "long", hour: "2-digit", minute: "2-digit" });

    const mails = [
      { l: "Confirmation d'inscription", n: a.confirmations, du: 0, immediat: true },
      { l: "Rappel la veille", n: a.rappel_1d, du: debut - 24 * H },
      { l: "Rappel le matin du live", n: a.rappel_0d, du: debut - 10 * H },
      { l: "Rappel une heure avant", n: a.rappel_1h, du: debut - 1 * H },
      { l: "Lien du live", n: a.lien_live, du: debut },
      { l: "Replay", n: a.replay, du: debut + 24 * H },
    ];

    const maintenant = Date.now();
    const sequence = mails.map((m) => {
      if (m.immediat) {
        const manque = a.inscrits - m.n;
        return `<div class="wbz-row ${manque > 0 ? "wbz-row--manque" : "wbz-row--fait"}">
          <span class="wbz-mark">✓</span>
          <span><span class="wbz-who">${esc(m.l)}</span><span class="wbz-when">${manque > 0 ? `${manque} inscrit${manque > 1 ? "s" : ""} ne l'${manque > 1 ? "ont" : "a"} jamais reçue` : "partie à chaque inscrit"}</span></span>
          <span class="wbz-val"><b>${m.n}</b><span>sur ${a.inscrits}</span></span>
        </div>`;
      }
      const aVenir = m.du > maintenant;
      const rate = !aVenir && m.n === 0;
      const etat = aVenir ? "wbz-row--venir" : rate ? "wbz-row--manque" : "wbz-row--fait";
      return `<div class="wbz-row ${etat}">
        <span class="wbz-mark">${aVenir ? "·" : rate ? "!" : "✓"}</span>
        <span><span class="wbz-who">${esc(m.l)}</span><span class="wbz-when">${aVenir ? "prévu le " + jourHeure(m.du) : rate ? "aurait dû partir le " + jourHeure(m.du) : "parti le " + jourHeure(m.du)}</span></span>
        <span class="wbz-val"><b>${aVenir ? "—" : m.n}</b><span>${aVenir ? "à venir" : "sur " + a.inscrits}</span></span>
      </div>`;
    }).join("");

    /* ---------- 3. Résultat et santé ---------- */
    body.innerHTML = `
      <h3 class="wbz-titre">Acquisition</h3>
      ${acquisition}

      <h3 class="wbz-titre">Séquence avant le live</h3>
      <div class="wbz-seq">${sequence}</div>

      <h3 class="wbz-titre">Résultat</h3>
      <div class="wbz-cartes">
        <div class="wbz-carte wbz-carte--vente"><div class="wbz-lab">Ont acheté ensuite</div><div class="wbz-num">${a.acheteurs}</div><div class="wbz-note">${pct(a.acheteurs, a.inscrits || 1)} % des inscrits</div></div>
        <div class="wbz-carte"><div class="wbz-lab">Chiffre d'affaires</div><div class="wbz-num">${fcfa(a.chiffre_affaires)}</div><div class="wbz-note">achats postérieurs à l'inscription</div></div>
      </div>

      <h3 class="wbz-titre">Santé de la collecte</h3>
      <div class="wbz-cartes">
        <div class="wbz-carte"><div class="wbz-lab">Transmis à ACQ Hub</div><div class="wbz-num">${a.relais_ok}</div><div class="wbz-note">sur ${a.inscrits} inscrits</div></div>
        <div class="wbz-carte${a.relais_ko > 0 ? " wbz-carte--alerte" : ""}"><div class="wbz-lab">Relais en échec</div><div class="wbz-num">${a.relais_ko}</div><div class="wbz-note">${a.relais_ko > 0 ? "lead absent du CRM" : "aucun"}</div></div>
        <div class="wbz-carte"><div class="wbz-lab">Désabonnés</div><div class="wbz-num">${a.desabonnes}</div><div class="wbz-note">depuis l'inscription</div></div>
      </div>

      <p class="wbz-foot">Période : depuis le ${a.premiere_inscription || "—"}, première inscription de l'édition.${visites === null ? "" : " Les visites Google Analytics couvrent exactement la même fenêtre."}</p>`;
  }

  /** « webinaire-initiation-2026-10 » : l'entonnoir, puis le mois du live. */
  const slugEdition = (tunnel: string, iso: string) => {
    const d = new Date(iso);
    return `${tunnel}-${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, "0")}`;
  };

  function render(list: any[]) {
    if (!list.length) { rows.innerHTML = `<tr><td class="empty" colspan="7">Aucune édition. Cliquez sur « Nouvelle édition ».</td></tr>`; return; }
    rows.innerHTML = list.map((w) => `
      <tr>
        <td><strong>${esc(w.title)}</strong><br><span style="color:var(--c-gray-500);font-size:.78rem">${esc(w.slug)}</span></td>
        <td>${dshort(w.starts_at)}<br><span style="color:var(--c-gray-500);font-size:.78rem">${w.duration_min} min · ${w.places} places</span></td>
        <td>${w.join_url
          ? `<span class="tag-pill ok">Renseigné</span>`
          : `<span class="tag-pill full" title="Les rappels ne partiront pas tant qu'il manque">Manquant</span>`}</td>
        <td style="font-variant-numeric:tabular-nums">${inscrits[w.id] ?? "—"}</td>
        <td style="font-variant-numeric:tabular-nums">${envois[w.id] || 0}</td>
        <td>${w.active ? '<span class="tag-pill pub">Active</span>' : '<span class="tag-pill draft">Inactive</span>'}</td>
        <td><div class="row-actions">
          <button class="icon-btn" data-stats="${w.id}" title="Analyser cette édition"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 20h18"/><rect x="5" y="11" width="3.4" height="6" rx="1"/><rect x="10.3" y="7" width="3.4" height="10" rx="1"/><rect x="15.6" y="13" width="3.4" height="4" rx="1"/></svg></button>
          <button class="icon-btn" data-edit="${w.id}" title="Éditer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></button>
          <button class="icon-btn" data-dup="${w.id}" title="Dupliquer pour le mois suivant"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg></button>
          <button class="icon-btn danger" data-del="${w.id}" title="Supprimer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg></button>
        </div></td>
      </tr>`).join("");
    rows.querySelectorAll<HTMLElement>("[data-stats]").forEach((b) => b.addEventListener("click", () => analyser(b.dataset.stats!)));
    rows.querySelectorAll<HTMLElement>("[data-edit]").forEach((b) => b.addEventListener("click", () => edit(b.dataset.edit!)));
    rows.querySelectorAll<HTMLElement>("[data-dup]").forEach((b) => b.addEventListener("click", () => dupliquer(b.dataset.dup!)));
    rows.querySelectorAll<HTMLElement>("[data-del]").forEach((b) => b.addEventListener("click", () => del(b.dataset.del!)));
  }

  function applySearch() {
    const q = ($("wb-search").value || "").toLowerCase();
    render(all.filter((w) => !q || (w.title + " " + w.slug + " " + w.tunnel).toLowerCase().includes(q)));
  }

  async function load() {
    const { data, error } = await supabaseBrowser.from("webinaires").select("*").order("starts_at", { ascending: false });
    if (error) { rows.innerHTML = `<tr><td class="empty" colspan="7">Erreur de chargement (migrations 0035/0036 appliquées ?).</td></tr>`; return; }
    all = data || [];

    // Compteurs par édition : inscrits de la période, e-mails déjà partis.
    inscrits = {}; envois = {};
    await Promise.all(all.map(async (w: any) => {
      let q = supabaseBrowser.from("form_submissions").select("id", { count: "exact", head: true })
        .eq("form_key", w.tunnel).not("email", "is", null);
      if (w.inscrits_depuis) q = q.gte("submitted_at", w.inscrits_depuis);
      const [{ count: nbInscrits }, { count: nbEnvois }] = await Promise.all([
        q,
        supabaseBrowser.from("webinaire_emails").select("id", { count: "exact", head: true }).eq("webinaire_id", w.id),
      ]);
      inscrits[w.id] = nbInscrits || 0;
      envois[w.id] = nbEnvois || 0;
    }));
    applySearch();
  }

  function fill(w: any) {
    $("f-id").value = w?.id || "";
    $("f-title").value = w?.title || "";
    $("f-join").value = w?.join_url || "";
    $("f-start").value = w?.starts_at ? dtLocalValue(w.starts_at) : "";
    $("f-duree").value = (w?.duration_min ?? 90).toString();
    $("f-places").value = (w?.places ?? 500).toString();
    $("f-info").value = w?.join_info || "";
    $("f-replay").value = w?.replay_url || "";
    $("f-whatsapp").value = w?.whatsapp_url || "";
    $("f-telegram").value = w?.telegram_url || "";
    $("f-tunnel").value = w?.tunnel || "webinaire-initiation";
    $("f-slug").value = w?.slug || "";
    $("f-depuis").value = w?.inscrits_depuis ? dtLocalValue(w.inscrits_depuis) : "";
    $("f-active").checked = w ? !!w.active : true;
    document.getElementById("wb-drawer-title")!.textContent = w ? "Modifier l'édition" : "Nouvelle édition";
  }

  function openNew() { fill(null); openDrawer(); }
  function edit(id: string) { fill(all.find((x) => x.id === id)); openDrawer(); }

  /* Duplication : le geste du mois suivant. On décale d'un mois, on efface les
     liens (ceux du live précédent seraient pires que vides) et on cale la borne
     des inscrits sur le live précédent — tout ce qui arrive après lui appartient
     à la nouvelle édition. */
  async function dupliquer(id: string) {
    const w = all.find((x) => x.id === id);
    if (!w) return;
    const suivant = new Date(w.starts_at);
    suivant.setUTCMonth(suivant.getUTCMonth() + 1);
    const slug = slugEdition(w.tunnel, suivant.toISOString());
    if (!(await confirmModal({
      title: "Dupliquer pour le mois suivant",
      message: `Créer « ${slug} » le ${suivant.toLocaleString("fr-FR", { dateStyle: "full", timeStyle: "short" })} ?\n\nLes liens du live et du replay repartent vides, et seuls les inscrits postérieurs au live du ${new Date(w.starts_at).toLocaleDateString("fr-FR")} recevront ses e-mails.`,
      confirmLabel: "Dupliquer",
    }))) return;

    const { error } = await supabaseBrowser.from("webinaires").insert({
      tunnel: w.tunnel, slug, title: w.title,
      starts_at: suivant.toISOString(), duration_min: w.duration_min, places: w.places,
      join_url: null, join_info: w.join_info, replay_url: null,
      /* Les canaux se transmettent, eux : un groupe de discussion se garde d'un
         mois sur l'autre, contrairement au lien du live qui est propre à la
         séance. Ils restent modifiables sur la nouvelle édition. */
      whatsapp_url: w.whatsapp_url, telegram_url: w.telegram_url,
      inscrits_depuis: w.starts_at, active: true,
    });
    if (error) { toast((error.message || "").includes("duplicate") ? "Cette édition existe déjà." : "Duplication impossible.", "err"); return; }
    toast("Édition créée. Pense à coller le lien du live.");
    await load();
  }

  async function del(id: string) {
    const w = all.find((x) => x.id === id);
    if (!(await confirmModal({
      title: "Supprimer l'édition",
      message: `Supprimer « ${w?.title} » du ${dshort(w?.starts_at)} ?\n\nSon journal d'envois part avec elle : si elle était recréée, les inscrits recevraient une seconde fois les mêmes e-mails.`,
      danger: true, confirmLabel: "Supprimer",
    }))) return;
    const { error } = await supabaseBrowser.from("webinaires").delete().eq("id", id);
    if (error) { toast("Suppression impossible.", "err"); return; }
    toast("Édition supprimée.");
    await load();
  }

  async function save() {
    const title = $("f-title").value.trim();
    const tunnel = $("f-tunnel").value.trim();
    const startV = $("f-start").value;
    if (!title || !tunnel || !startV) { toast("Titre, entonnoir et date sont obligatoires.", "err"); return; }
    const startsAt = new Date(startV).toISOString();
    const depuisV = $("f-depuis").value;
    const payload: any = {
      title, tunnel,
      slug: $("f-slug").value.trim() || slugEdition(tunnel, startsAt),
      starts_at: startsAt,
      duration_min: parseInt($("f-duree").value || "90") || 90,
      places: parseInt($("f-places").value || "0") || 0,
      join_url: $("f-join").value.trim() || null,
      join_info: $("f-info").value.trim() || null,
      replay_url: $("f-replay").value.trim() || null,
      whatsapp_url: $("f-whatsapp").value.trim() || null,
      telegram_url: $("f-telegram").value.trim() || null,
      inscrits_depuis: depuisV ? new Date(depuisV).toISOString() : null,
      active: $("f-active").checked,
    };
    const id = $("f-id").value;
    const btn = document.getElementById("wb-save")!;
    btn.setAttribute("disabled", "true"); btn.textContent = "Enregistrement…";
    const { error } = id
      ? await supabaseBrowser.from("webinaires").update(payload).eq("id", id)
      : await supabaseBrowser.from("webinaires").insert(payload);
    btn.removeAttribute("disabled"); btn.textContent = "Enregistrer";
    if (error) {
      toast((error.message || "").includes("duplicate") ? "Ce slug existe déjà." : "Enregistrement impossible.", "err");
      return;
    }
    toast(id ? "Édition mise à jour." : "Édition créée.");
    closeDrawer();
    await load();
  }

  document.getElementById("wb-stats-close")!.addEventListener("click", closeStats);
  document.getElementById("wb-new")!.addEventListener("click", openNew);
  document.getElementById("wb-close")!.addEventListener("click", closeDrawer);
  document.getElementById("wb-cancel")!.addEventListener("click", closeDrawer);
  overlay.addEventListener("click", () => { closeDrawer(); closeStats(); });
  document.getElementById("wb-save")!.addEventListener("click", save);
  $("wb-search").addEventListener("input", applySearch);
  // Le slug suit l'entonnoir et le mois tant qu'on ne l'a pas écrit à la main.
  const majSlug = () => {
    const startV = $("f-start").value;
    if (!$("f-id").value && startV && $("f-tunnel").value) {
      $("f-slug").value = slugEdition($("f-tunnel").value.trim(), new Date(startV).toISOString());
    }
  };
  $("f-start").addEventListener("change", majSlug);
  $("f-tunnel").addEventListener("input", majSlug);

  (async () => {
    const { data: { session } } = await supabaseBrowser.auth.getSession();
    if (!session) return;
    await load();
  })();
</script>

<!-- `is:global` est INDISPENSABLE ici, et c'est le piège qui a rendu ce
     panneau illisible en production : Astro n'applique un style de page
     qu'aux éléments présents dans son gabarit, en leur ajoutant une marque.
     Or tout ce panneau est construit en JavaScript au moment du clic — ces
     éléments-là n'ont pas la marque, donc aucun sélecteur scopé ne les
     atteignait et tout s'affichait en texte brut. Le préfixe `wbz-` tient
     lieu de portée. -->
<style is:global>
  /* ===== Panneau d'analyse d'une édition ===== */
  .wbz-titre {
    display: flex; align-items: center; gap: 10px;
    font-size: .72rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase;
    color: var(--c-gray-500, #7c839c); margin: 26px 0 12px;
  }
  .wbz-titre:first-child { margin-top: 0; }
  .wbz-titre::after { content: ""; flex: 1; height: 1px; background: var(--c-border, #e6eaf4); }

  /* ---- Acquisition : les deux bouts et le taux au milieu ---- */
  .wbz-acq {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: stretch;
    border: 1px solid var(--c-border, #e6eaf4); border-radius: 16px; overflow: hidden;
    background: var(--c-gray-50, #f7f9fd);
  }
  .wbz-end { padding: 16px 18px; }
  .wbz-end--droite { text-align: right; }
  .wbz-lab { font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--c-gray-500, #7c839c); }
  .wbz-num { font-size: 1.9rem; font-weight: 700; line-height: 1.05; margin-top: 4px; font-variant-numeric: tabular-nums; color: var(--c-ink, #0a0e27); }
  .wbz-src { font-size: .74rem; color: var(--c-gray-500, #7c839c); margin-top: 2px; }
  .wbz-bleu { color: var(--c-blue, #1f6ced); }
  .wbz-attente { color: var(--c-gray-500, #7c839c); }
  .wbz-mid {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 0 16px; background: #fff;
    border-left: 1px solid var(--c-border, #e6eaf4); border-right: 1px solid var(--c-border, #e6eaf4);
  }
  .wbz-rate { font-size: 1.35rem; font-weight: 700; color: var(--c-blue, #1f6ced); font-variant-numeric: tabular-nums; }
  .wbz-rate-lab { font-size: .66rem; letter-spacing: .08em; text-transform: uppercase; color: var(--c-gray-500, #7c839c); }

  .wbz-perte { display: flex; align-items: center; gap: 9px; margin: 10px 0 0; font-size: .85rem; color: var(--c-gray-600, #5c6488); }
  .wbz-point { width: 8px; height: 8px; border-radius: 50%; background: var(--c-danger, #cb2b2b); flex: none; }
  .wbz-perte b { color: var(--c-danger, #cb2b2b); font-variant-numeric: tabular-nums; }

  /* ---- Séquence : une chronologie, trois états ---- */
  .wbz-seq { border: 1px solid var(--c-border, #e6eaf4); border-radius: 16px; overflow: hidden; }
  .wbz-row {
    display: grid; grid-template-columns: 24px 1fr auto; align-items: center; gap: 12px;
    padding: 12px 16px; border-bottom: 1px solid var(--c-border, #e6eaf4);
  }
  .wbz-row:last-child { border-bottom: 0; }
  .wbz-mark { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font-size: .7rem; font-weight: 700; }
  .wbz-row--fait .wbz-mark { background: rgba(8,124,95,.12); color: var(--c-success, #087c5f); }
  .wbz-row--venir .wbz-mark { background: var(--c-gray-100, #eef1f8); color: var(--c-gray-500, #7c839c); }
  .wbz-row--manque .wbz-mark { background: rgba(203,43,43,.13); color: var(--c-danger, #cb2b2b); }
  .wbz-row--manque { background: rgba(203,43,43,.06); }
  .wbz-who { display: block; font-weight: 600; font-size: .92rem; color: var(--c-ink, #0a0e27); }
  .wbz-when { display: block; font-size: .76rem; color: var(--c-gray-500, #7c839c); margin-top: 1px; }
  .wbz-row--manque .wbz-when { color: var(--c-danger, #cb2b2b); font-weight: 600; }
  .wbz-val { text-align: right; font-variant-numeric: tabular-nums; }
  .wbz-val b { font-size: 1.05rem; color: var(--c-ink, #0a0e27); }
  .wbz-val span { display: block; font-size: .7rem; color: var(--c-gray-500, #7c839c); }
  .wbz-row--venir .wbz-val b { color: var(--c-gray-500, #7c839c); font-weight: 500; }
  .wbz-row--manque .wbz-val b { color: var(--c-danger, #cb2b2b); }

  /* ---- Cartes de résultat ---- */
  .wbz-cartes { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 10px; }
  .wbz-carte { background: var(--c-gray-50, #f7f9fd); border: 1px solid var(--c-border, #e6eaf4); border-radius: 14px; padding: 14px 16px; }
  .wbz-carte .wbz-num { font-size: 1.6rem; }
  .wbz-note { font-size: .74rem; color: var(--c-gray-500, #7c839c); margin-top: 2px; }
  .wbz-carte--vente .wbz-num { color: var(--c-success, #087c5f); }
  .wbz-carte--alerte { border-color: var(--c-danger, #cb2b2b); background: rgba(203,43,43,.06); }
  .wbz-carte--alerte .wbz-num { color: var(--c-danger, #cb2b2b); }

  .wbz-foot { margin-top: 24px; padding-top: 12px; border-top: 1px solid var(--c-border, #e6eaf4); font-size: .78rem; color: var(--c-gray-500, #7c839c); }

  @media (max-width: 560px) {
    .wbz-acq { grid-template-columns: 1fr; }
    .wbz-end--droite { text-align: left; }
    .wbz-mid {
      flex-direction: row; gap: 10px; justify-content: flex-start; padding: 10px 18px;
      border-left: 0; border-right: 0;
      border-top: 1px solid var(--c-border, #e6eaf4); border-bottom: 1px solid var(--c-border, #e6eaf4);
    }
  }
</style>

<style is:global>
  .wb-toggle { display: flex; align-items: center; gap: 10px; font-weight: 600; cursor: pointer; }
  .wb-toggle input { width: 18px; height: 18px; accent-color: var(--c-green); }
  .a-row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
</style>
