---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Thèmes" active="themes">
  <div class="admin-toolbar">
    <div class="left">
      <input class="admin-search" id="th-search" type="search" placeholder="Rechercher un thème…" />
    </div>
    <button class="abtn primary" id="th-new">+ Nouveau thème</button>
  </div>

  <div class="panel">
    <p class="hint" style="padding:12px 16px 0">Ces thèmes sont partagés par les formations, les sessions et les articles. Les couleurs pilotent les badges et dégradés du site.</p>
    <table class="admin-table">
      <thead><tr><th>Thème</th><th>Couleur</th><th>Utilisations</th><th>Ordre</th><th></th></tr></thead>
      <tbody data-rows><tr class="a-loading-row"><td colspan="5">Chargement…</td></tr></tbody>
    </table>
  </div>

  <!-- Tiroir éditeur -->
  <div class="a-drawer-overlay" id="th-overlay"></div>
  <aside class="a-drawer" id="th-drawer" aria-hidden="true">
    <div class="a-drawer-head">
      <h2 id="th-drawer-title">Nouveau thème</h2>
      <button class="icon-btn" id="th-close" aria-label="Fermer">✕</button>
    </div>
    <div class="a-drawer-body">
      <input type="hidden" id="f-id" />
      <div class="a-field"><label for="f-name">Nom *</label><input class="a-input" id="f-name" placeholder="Ex. Intelligence artificielle" /></div>
      <div class="a-field"><label for="f-slug">Slug (URL) *</label><input class="a-input" id="f-slug" /><div class="hint">Utilisé dans les filtres et adresses.</div></div>
      <div class="a-field"><label for="f-color">Couleur</label>
        <div class="th-swatches" id="th-swatches" role="radiogroup" aria-label="Couleur du thème"></div>
      </div>
      <div class="a-field"><label for="f-order">Ordre d'affichage</label><input class="a-input" id="f-order" type="number" min="0" value="0" /><div class="hint">Plus petit = affiché en premier dans les filtres.</div></div>
    </div>
    <div class="a-drawer-foot">
      <span class="grow"></span>
      <button class="abtn" id="th-cancel">Annuler</button>
      <button class="abtn primary" id="th-save">Enregistrer</button>
    </div>
  </aside>
</AdminLayout>

<script>
  import { supabaseBrowser } from "../../lib/supabaseBrowser";
  import { slugify, esc, toast, confirmModal } from "../../scripts/adminUtils";
  import { THEME_COLORS, themeSwatchStyle } from "../../lib/themes";

  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const rows = document.querySelector("[data-rows]")!;
  const drawer = document.getElementById("th-drawer")!;
  const overlay = document.getElementById("th-overlay")!;
  let all: any[] = [];
  let usage: Record<string, number> = {};
  let slugTouched = false;
  let currentColor = "blue";

  const openDrawer = () => { drawer.classList.add("open"); overlay.classList.add("open"); document.body.style.overflow = "hidden"; };
  const closeDrawer = () => { drawer.classList.remove("open"); overlay.classList.remove("open"); document.body.style.overflow = ""; };

  // Palette de sélection de couleur
  function renderSwatches() {
    const box = document.getElementById("th-swatches")!;
    box.innerHTML = THEME_COLORS.map((c) => `
      <button type="button" class="th-swatch ${c.key === currentColor ? "is-on" : ""}" data-color="${c.key}"
        role="radio" aria-checked="${c.key === currentColor}" title="${c.label}" style="${themeSwatchStyle(c.key)}">
        <span class="lbl">${c.label}</span>
      </button>`).join("");
    box.querySelectorAll<HTMLElement>("[data-color]").forEach((b) =>
      b.addEventListener("click", () => { currentColor = b.dataset.color!; renderSwatches(); }));
  }

  function render(list: any[]) {
    if (!list.length) { rows.innerHTML = `<tr><td class="empty" colspan="5">Aucun thème. Cliquez sur « Nouveau thème ».</td></tr>`; return; }
    rows.innerHTML = list.map((t) => `
      <tr>
        <td><strong>${esc(t.name)}</strong><br><span style="color:var(--c-gray-500);font-size:.78rem">${esc(t.slug)}</span></td>
        <td><span class="th-chip" style="${themeSwatchStyle(t.color)}">${esc(t.color)}</span></td>
        <td>${usage[t.id] ? `${usage[t.id]}` : '<span style="color:var(--c-gray-400)">0</span>'}</td>
        <td>${t.sort_order ?? 0}</td>
        <td><div class="row-actions">
          <button class="icon-btn" data-edit="${t.id}" title="Éditer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></button>
          <button class="icon-btn danger" data-del="${t.id}" title="Supprimer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg></button>
        </div></td>
      </tr>`).join("");
    rows.querySelectorAll<HTMLElement>("[data-edit]").forEach((b) => b.addEventListener("click", () => edit(b.dataset.edit!)));
    rows.querySelectorAll<HTMLElement>("[data-del]").forEach((b) => b.addEventListener("click", () => del(b.dataset.del!)));
  }

  function applySearch() {
    const q = ($("th-search").value || "").toLowerCase();
    render(all.filter((t) => !q || (t.name + " " + t.slug).toLowerCase().includes(q)));
  }

  async function load() {
    const { data, error } = await supabaseBrowser.from("themes").select("*").order("sort_order", { ascending: true }).order("name", { ascending: true });
    if (error) { rows.innerHTML = `<tr><td class="empty" colspan="5">Erreur de chargement (la table « themes » existe-t-elle ? Migration 0013 appliquée ?).</td></tr>`; return; }
    all = data || [];
    // Compte d'utilisation (formations + sessions + posts)
    usage = {};
    const [f, s, p] = await Promise.all([
      supabaseBrowser.from("formations").select("theme_id"),
      supabaseBrowser.from("sessions").select("theme_id"),
      supabaseBrowser.from("posts").select("theme_id"),
    ]);
    for (const set of [f.data, s.data, p.data]) {
      for (const r of set || []) { if (r.theme_id) usage[r.theme_id] = (usage[r.theme_id] || 0) + 1; }
    }
    applySearch();
  }

  function fill(t: any) {
    $("f-id").value = t?.id || "";
    $("f-name").value = t?.name || "";
    $("f-slug").value = t?.slug || "";
    $("f-order").value = (t?.sort_order ?? 0).toString();
    currentColor = t?.color || "blue";
    slugTouched = !!t?.slug;
    renderSwatches();
    document.getElementById("th-drawer-title")!.textContent = t ? "Modifier le thème" : "Nouveau thème";
  }

  function openNew() { fill(null); openDrawer(); }
  function edit(id: string) { const t = all.find((x) => x.id === id); fill(t); openDrawer(); }

  async function del(id: string) {
    const t = all.find((x) => x.id === id);
    const n = usage[id] || 0;
    const warn = n ? `\n\n${n} contenu(s) y sont rattachés : ils perdront ce thème (le contenu reste, mais sans thème).` : "";
    if (!(await confirmModal({ title: "Supprimer le thème", message: `Supprimer le thème « ${t?.name} » ?${warn}`, danger: true, confirmLabel: "Supprimer" }))) return;
    const { error } = await supabaseBrowser.from("themes").delete().eq("id", id);
    if (error) { toast("Suppression impossible.", "err"); return; }
    toast("Thème supprimé.");
    await load();
  }

  async function save() {
    const name = $("f-name").value.trim();
    const slug = $("f-slug").value.trim() || slugify(name);
    if (!name || !slug) { toast("Nom et slug obligatoires.", "err"); return; }
    const payload: any = { name, slug, color: currentColor, sort_order: parseInt($("f-order").value || "0") || 0 };
    const id = $("f-id").value;
    const btn = document.getElementById("th-save")!;
    btn.setAttribute("disabled", "true"); btn.textContent = "Enregistrement…";
    const q = id ? supabaseBrowser.from("themes").update(payload).eq("id", id) : supabaseBrowser.from("themes").insert(payload);
    const { error } = await q;
    btn.removeAttribute("disabled"); btn.textContent = "Enregistrer";
    if (error) {
      const dup = (error.message || "").includes("duplicate") || (error.code === "23505");
      toast(dup ? "Ce nom ou ce slug existe déjà." : "Enregistrement impossible.", "err");
      return;
    }
    toast(id ? "Thème mis à jour." : "Thème créé.");
    closeDrawer();
    await load();
  }

  document.getElementById("th-new")!.addEventListener("click", openNew);
  document.getElementById("th-close")!.addEventListener("click", closeDrawer);
  document.getElementById("th-cancel")!.addEventListener("click", closeDrawer);
  overlay.addEventListener("click", closeDrawer);
  document.getElementById("th-save")!.addEventListener("click", save);
  $("th-search").addEventListener("input", applySearch);
  $("f-name").addEventListener("input", () => { if (!slugTouched) $("f-slug").value = slugify($("f-name").value); });
  $("f-slug").addEventListener("input", () => { slugTouched = true; });

  renderSwatches();
  (async () => {
    const { data: { session } } = await supabaseBrowser.auth.getSession();
    if (!session) return;
    await load();
  })();
</script>

<style is:global>
  .th-swatches { display: flex; flex-wrap: wrap; gap: 8px; }
  .th-swatch { display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px 7px 8px; border: 2px solid var(--c-border);
    border-radius: 10px; background: var(--surface, #fff); cursor: pointer; font: inherit; font-size: .82rem; font-weight: 600; color: var(--c-gray-700); transition: .15s; }
  .th-swatch::before { content: ""; width: 16px; height: 16px; border-radius: 5px; background: var(--sw, #1f6ced); box-shadow: inset 0 0 0 1px rgba(0,0,0,.08); }
  .th-swatch.is-on { border-color: var(--sw, #1f6ced); color: var(--c-ink); box-shadow: 0 0 0 3px color-mix(in srgb, var(--sw) 18%, transparent); }
  .th-chip { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 999px; font-size: .74rem; font-weight: 800;
    text-transform: capitalize; color: #fff; background: var(--sw, #1f6ced); }
</style>
