---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import Card from "../../components/starwind/card/Card.astro";
import Button from "../../components/starwind/button/Button.astro";
---

<AdminLayout title="Sessions" active="sessions">
  <div class="sw space-y-6">
    <div class="admin-toolbar">
      <div class="left">
        <input class="admin-search" id="s-search" type="search" placeholder="Rechercher une session…" />
        <select class="admin-filter" id="s-status-filter">
          <option value="">Tous les statuts</option><option value="published">Publiées</option><option value="draft">Brouillons</option><option value="full">Complètes</option><option value="cancelled">Annulées</option><option value="archived">Archivées</option>
        </select>
      </div>
      <Button variant="primary" id="new-btn">+ Nouvelle session</Button>
    </div>

    <Card class="gap-0 overflow-hidden p-0">
      <div class="overflow-x-auto">
        <table class="admin-table min-w-[640px]">
          <thead><tr><th>Session</th><th>Date</th><th>Remplissage</th><th>Statut</th><th></th></tr></thead>
          <tbody data-rows><tr class="a-loading-row"><td colspan="5">Chargement…</td></tr></tbody>
        </table>
      </div>
    </Card>
  </div>

  <div class="a-drawer-overlay" id="overlay"></div>
  <aside class="a-drawer" id="drawer" aria-hidden="true">
    <div class="a-drawer-head"><h2 id="drawer-title">Nouvelle session</h2><button class="icon-btn" id="close-btn">✕</button></div>
    <div class="a-drawer-body">
      <input type="hidden" id="s-id" />
      <div class="a-field"><label for="s-formation">Formation liée</label><select class="a-select" id="s-formation"><option value="">— Aucune —</option></select></div>
      <div class="a-field"><label for="s-title">Titre *</label><input class="a-input" id="s-title" /></div>
      <div class="a-field"><label for="s-slug">Slug *</label><input class="a-input" id="s-slug" /></div>
      <div class="a-row2">
        <div class="a-field"><label for="s-theme">Thème</label><input class="a-input" id="s-theme" list="th-list" /><datalist id="th-list"><option value="IA"></option><option value="Marketing"></option><option value="Vente en ligne"></option><option value="Automatisation"></option></datalist></div>
        <div class="a-field"><label for="s-status">Statut</label><select class="a-select" id="s-status"><option value="draft">Brouillon</option><option value="published">Publiée</option><option value="full">Complète</option><option value="cancelled">Annulée</option><option value="archived">Archivée</option></select></div>
      </div>
      <div class="a-row2">
        <div class="a-field"><label for="s-city">Ville</label><input class="a-input" id="s-city" value="Abidjan" /></div>
        <div class="a-field"><label for="s-venue">Lieu</label><input class="a-input" id="s-venue" value="Espace de formation Bweb · Cocody" /></div>
      </div>
      <div class="a-row2">
        <div class="a-field"><label for="s-start">Début *</label><input class="a-input" id="s-start" type="datetime-local" /></div>
        <div class="a-field"><label for="s-end">Fin</label><input class="a-input" id="s-end" type="datetime-local" /></div>
      </div>
      <div class="a-field"><label for="s-image">Image / affiche (URL)</label><input class="a-input" id="s-image" placeholder="https://… (optionnel, paysage 16/9)" /></div>

      <div class="a-section-title">Tarifs / billets</div>
      <div class="tt-list" id="tt-list"></div>
      <button class="abtn sm" id="tt-add" style="margin-top:10px">+ Ajouter un tarif</button>
    </div>
    <div class="a-drawer-foot"><span class="grow"></span><button class="abtn" id="cancel-btn">Annuler</button><button class="abtn primary" id="save-btn">Enregistrer</button></div>
  </aside>
</AdminLayout>

<script>
  import { supabaseBrowser } from "../../lib/supabaseBrowser";
  import { slugify, esc, dshort, dtLocalValue, toast, confirmModal } from "../../scripts/adminUtils";

  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const rows = document.querySelector("[data-rows]")!;
  const drawer = document.getElementById("drawer")!, overlay = document.getElementById("overlay")!;
  const ttList = document.getElementById("tt-list")!;
  let all: any[] = [], formations: any[] = [], slugTouched = false, originalTtIds: string[] = [];

  const open = () => { drawer.classList.add("open"); overlay.classList.add("open"); document.body.style.overflow = "hidden"; };
  const close = () => { drawer.classList.remove("open"); overlay.classList.remove("open"); document.body.style.overflow = ""; };
  const BADGES = [["", "— Aucun —"], ["hot", "Forte demande"], ["limited", "Places limitées"], ["ok", "Avantageux"]];

  function statusPill(s: string) {
    return { published: '<span class="tag-pill pub">Publiée</span>', draft: '<span class="tag-pill draft">Brouillon</span>', full: '<span class="tag-pill full">Complète</span>', cancelled: '<span class="tag-pill wait">Annulée</span>', archived: '<span class="tag-pill archived">Archivée</span>' }[s] || s;
  }
  function render(list: any[]) {
    rows.innerHTML = list.length ? list.map((s) => {
      const cap = (s.ticket_types || []).reduce((a: number, t: any) => a + t.capacity, 0);
      const sold = (s.ticket_types || []).reduce((a: number, t: any) => a + t.sold, 0);
      return `<tr>
        <td><strong>${esc(s.title)}</strong><br><span style="color:var(--c-gray-500);font-size:.78rem">${esc(s.venue || "")}</span></td>
        <td>${dshort(s.starts_at)}</td>
        <td style="font-variant-numeric:tabular-nums">${sold}/${cap}${cap ? " · " + Math.round((sold / cap) * 100) + "%" : ""}</td>
        <td>${statusPill(s.status)}</td>
        <td><div class="row-actions">
          <a class="icon-btn" href="/formations/session/${esc(s.slug)}" target="_blank" title="Voir"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></a>
          <button class="icon-btn" data-edit="${s.id}" title="Éditer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></button>
          <button class="icon-btn" data-dup="${s.id}" title="Dupliquer (nouvelle date, en brouillon)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg></button>
          <button class="icon-btn" data-arch="${s.id}" title="${s.status === "archived" ? "Désarchiver (repasser en brouillon)" : "Archiver (retirer du site)"}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8M9 12h6"/></svg></button>
          <button class="icon-btn danger" data-del="${s.id}" title="Supprimer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg></button>
        </div></td></tr>`;
    }).join("") : `<tr><td class="empty" colspan="5">Aucune session.</td></tr>`;
    rows.querySelectorAll<HTMLElement>("[data-edit]").forEach((b) => b.addEventListener("click", () => edit(b.dataset.edit!)));
    rows.querySelectorAll<HTMLElement>("[data-dup]").forEach((b) => b.addEventListener("click", () => duplicate(b.dataset.dup!)));
    rows.querySelectorAll<HTMLElement>("[data-arch]").forEach((b) => b.addEventListener("click", () => archive(b.dataset.arch!)));
    rows.querySelectorAll<HTMLElement>("[data-del]").forEach((b) => b.addEventListener("click", () => del(b.dataset.del!)));
  }
  function applyFilters() {
    const q = ($("s-search").value || "").toLowerCase(); const st = $("s-status-filter").value;
    render(all.filter((s) => (!q || s.title.toLowerCase().includes(q)) && (!st || s.status === st)));
  }
  async function load() {
    const { data } = await supabaseBrowser.from("sessions").select("*, ticket_types(id,name,price,compare_at_price,capacity,sold,badge,sales_end,sort)").order("starts_at", { ascending: false });
    all = (data || []).map((s: any) => ({ ...s, ticket_types: (s.ticket_types || []).sort((a: any, b: any) => a.sort - b.sort) }));
    applyFilters();
  }

  // ---- Tarifs (sous-formulaire) ----
  function addTtRow(tt: any = null) {
    const div = document.createElement("div");
    div.className = "tt-item";
    div.dataset.ttId = tt?.id || "";
    div.innerHTML = `
      <div class="tt-item-head"><strong>${tt ? "Vendus : " + tt.sold : "Nouveau tarif"}</strong>
        <button type="button" class="icon-btn danger" data-tt-remove title="Retirer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button></div>
      <div class="a-field" style="margin-bottom:8px"><label>Nom du tarif</label><input class="a-input" data-tt-name value="${esc(tt?.name || "")}" placeholder="Ex. Inscription standard" /></div>
      <div class="a-row2">
        <div class="a-field" style="margin:0"><label>Prix (FCFA)</label><input class="a-input" data-tt-price type="number" min="0" value="${tt?.price ?? ""}" /></div>
        <div class="a-field" style="margin:0"><label>Quota (places)</label><input class="a-input" data-tt-cap type="number" min="0" value="${tt?.capacity ?? ""}" /></div>
      </div>
      <div class="a-row2" style="margin-top:8px">
        <div class="a-field" style="margin:0"><label>Badge</label><select class="a-select" data-tt-badge>${BADGES.map(([v, l]) => `<option value="${v}" ${tt?.badge === v || (!tt?.badge && v === "") ? "selected" : ""}>${l}</option>`).join("")}</select></div>
        <div class="a-field" style="margin:0"><label>Fin de validité</label><input class="a-input" data-tt-end type="datetime-local" value="${tt?.sales_end ? dtLocalValue(tt.sales_end) : ""}" /></div>
      </div>`;
    div.querySelector("[data-tt-remove]")!.addEventListener("click", () => div.remove());
    ttList.appendChild(div);
  }

  function fill(s: any) {
    $("s-id").value = s?.id || ""; $("s-formation").value = s?.formation_id || ""; $("s-title").value = s?.title || "";
    $("s-slug").value = s?.slug || ""; $("s-theme").value = s?.theme || ""; $("s-status").value = s?.status || "draft";
    $("s-city").value = s?.city || "Abidjan"; $("s-venue").value = s?.venue || "Espace de formation Bweb · Cocody";
    $("s-start").value = s?.starts_at ? dtLocalValue(s.starts_at) : ""; $("s-end").value = s?.ends_at ? dtLocalValue(s.ends_at) : "";
    $("s-image").value = s?.image_url || "";
    ttList.innerHTML = ""; originalTtIds = (s?.ticket_types || []).map((t: any) => t.id);
    (s?.ticket_types || []).forEach((t: any) => addTtRow(t));
    slugTouched = !!s?.slug; document.getElementById("drawer-title")!.textContent = s ? "Modifier la session" : "Nouvelle session";
  }
  const openNew = () => { location.href = "/admin/editeur/session/nouveau"; };
  const edit = (id: string) => { location.href = "/admin/editeur/session/" + id; };

  async function del(id: string) {
    const s = all.find((x) => x.id === id);
    if (!(await confirmModal({ title: "Supprimer la date", message: `Supprimer « ${s?.title} » et ses tarifs ?\nImpossible s'il existe des réservations.`, danger: true, confirmLabel: "Supprimer" }))) return;
    const { error } = await supabaseBrowser.from("sessions").delete().eq("id", id);
    if (error) { toast("Suppression impossible (réservations existantes ?).", "err"); return; }
    toast("Session supprimée."); await load();
  }

  // Archiver : retire du site sans supprimer (réversible). Une session terminée s'archive.
  async function archive(id: string) {
    const s = all.find((x) => x.id === id);
    const back = s?.status === "archived";
    if (!(await confirmModal({
      title: back ? "Désarchiver la session" : "Archiver la session",
      message: back ? `Remettre « ${s?.title} » en brouillon ?` : `Archiver « ${s?.title} » ? Elle sera retirée du site (réversible).`,
      confirmLabel: back ? "Désarchiver" : "Archiver",
    }))) return;
    const { error } = await supabaseBrowser.from("sessions").update({ status: back ? "draft" : "archived" }).eq("id", id);
    if (error) { toast("Action impossible.", "err"); return; }
    toast(back ? "Session désarchivée (brouillon)." : "Session archivée."); await load();
  }

  // Dupliquer : nouvelle session en brouillon (slug horodaté), tarifs copiés, ventes remises à 0.
  async function duplicate(id: string) {
    const s = all.find((x) => x.id === id);
    if (!s) return;
    if (!(await confirmModal({ title: "Dupliquer la session", message: `Créer une copie de « ${s.title} » en brouillon ?\nVous ajusterez la nouvelle date ensuite.`, confirmLabel: "Dupliquer" }))) return;
    const suffix = "-copie-" + Date.now().toString(36);
    const payload: any = {
      formation_id: s.formation_id, title: s.title + " (copie)", slug: (s.slug || slugify(s.title)) + suffix,
      theme: s.theme, theme_id: s.theme_id, status: "draft", mode: s.mode, level: s.level,
      starts_at: s.starts_at, ends_at: s.ends_at, city: s.city, venue: s.venue, address: s.address,
      meeting_url: s.meeting_url, meeting_info: s.meeting_info, image_url: s.image_url,
    };
    const { data: ns, error } = await supabaseBrowser.from("sessions").insert(payload).select("id").single();
    if (error || !ns) { toast("Duplication impossible.", "err"); return; }
    const tts = (s.ticket_types || []).map((t: any, i: number) => ({
      session_id: ns.id, name: t.name, price: t.price, compare_at_price: t.compare_at_price ?? null,
      capacity: t.capacity, badge: t.badge || null, sales_end: t.sales_end || null, sort: t.sort ?? i,
    }));
    if (tts.length) await supabaseBrowser.from("ticket_types").insert(tts);
    toast("Session dupliquée (brouillon). Ajustez la date puis publiez.");
    location.href = "/admin/editeur/session/" + ns.id;
  }

  async function save() {
    const title = $("s-title").value.trim(); const slug = $("s-slug").value.trim() || slugify(title);
    if (!title || !slug) { toast("Titre et slug obligatoires.", "err"); return; }
    if (!$("s-start").value) { toast("La date de début est obligatoire.", "err"); return; }
    const payload: any = {
      formation_id: $("s-formation").value || null, title, slug, theme: $("s-theme").value.trim() || null, status: $("s-status").value,
      city: $("s-city").value.trim() || null, venue: $("s-venue").value.trim() || null,
      starts_at: new Date($("s-start").value).toISOString(), ends_at: $("s-end").value ? new Date($("s-end").value).toISOString() : null,
      image_url: $("s-image").value.trim() || null,
    };
    const btn = document.getElementById("save-btn")!; btn.setAttribute("disabled", "true"); btn.textContent = "Enregistrement…";
    let id = $("s-id").value;
    try {
      if (id) {
        const { error } = await supabaseBrowser.from("sessions").update(payload).eq("id", id); if (error) throw error;
      } else {
        const { data, error } = await supabaseBrowser.from("sessions").insert(payload).select("id").single(); if (error) throw error; id = data.id;
      }
      // Sync des tarifs
      const items = Array.from(ttList.querySelectorAll<HTMLElement>(".tt-item"));
      const keptIds: string[] = [];
      let sort = 0;
      for (const it of items) {
        const name = (it.querySelector("[data-tt-name]") as HTMLInputElement).value.trim();
        const price = parseInt((it.querySelector("[data-tt-price]") as HTMLInputElement).value || "0");
        const cap = parseInt((it.querySelector("[data-tt-cap]") as HTMLInputElement).value || "0");
        const badge = (it.querySelector("[data-tt-badge]") as HTMLSelectElement).value || null;
        const endV = (it.querySelector("[data-tt-end]") as HTMLInputElement).value;
        if (!name) continue;
        const ttPayload: any = { session_id: id, name, price, capacity: cap, badge, sales_end: endV ? new Date(endV).toISOString() : null, sort: sort++ };
        const ttId = it.dataset.ttId;
        if (ttId) { keptIds.push(ttId); const { error } = await supabaseBrowser.from("ticket_types").update(ttPayload).eq("id", ttId); if (error) throw error; }
        else { const { error } = await supabaseBrowser.from("ticket_types").insert(ttPayload); if (error) throw error; }
      }
      const toDelete = originalTtIds.filter((x) => !keptIds.includes(x));
      if (toDelete.length) { const { error } = await supabaseBrowser.from("ticket_types").delete().in("id", toDelete); if (error) throw error; }
      toast($("s-id").value ? "Session mise à jour." : "Session créée."); close(); await load();
    } catch (e: any) {
      const m = String(e?.message || "");
      toast(m.includes("duplicate") ? "Ce slug existe déjà." : m.includes("ticket_sold_within_capacity") ? "Le quota ne peut pas être inférieur au nombre déjà vendu." : m.includes("restrict") ? "Un tarif avec des réservations ne peut pas être retiré." : "Enregistrement impossible.", "err");
    } finally { btn.removeAttribute("disabled"); btn.textContent = "Enregistrer"; }
  }

  document.getElementById("new-btn")!.addEventListener("click", openNew);
  document.getElementById("close-btn")!.addEventListener("click", close);
  document.getElementById("cancel-btn")!.addEventListener("click", close);
  overlay.addEventListener("click", close);
  document.getElementById("save-btn")!.addEventListener("click", save);
  document.getElementById("tt-add")!.addEventListener("click", () => addTtRow(null));
  $("s-search").addEventListener("input", applyFilters);
  $("s-status-filter").addEventListener("change", applyFilters);
  $("s-title").addEventListener("input", () => { if (!slugTouched) $("s-slug").value = slugify($("s-title").value); });
  $("s-slug").addEventListener("input", () => { slugTouched = true; });
  $("s-formation").addEventListener("change", () => {
    const f = formations.find((x) => x.id === $("s-formation").value);
    if (f) { if (!$("s-title").value) { $("s-title").value = f.title; $("s-slug").value = slugify(f.title); } if (!$("s-theme").value) $("s-theme").value = f.theme || ""; }
  });

  (async () => {
    const { data: { session } } = await supabaseBrowser.auth.getSession(); if (!session) return;
    const { data: fs } = await supabaseBrowser.from("formations").select("id,title,theme").order("title");
    formations = fs || [];
    $("s-formation").innerHTML = '<option value="">— Aucune —</option>' + formations.map((f) => `<option value="${f.id}">${esc(f.title)}</option>`).join("");
    await load();
  })();
</script>
