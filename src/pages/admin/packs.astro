---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import Card from "../../components/starwind/card/Card.astro";
import Button from "../../components/starwind/button/Button.astro";
---

<AdminLayout title="Packs" active="packs">
  <div class="sw space-y-6">
    <p class="admin-sub" style="margin-top:0">Vends plusieurs formations d'un parcours en une fois (places prépayées). Dès qu'une date s'ouvre pour une formation incluse, l'acheteur est inscrit automatiquement.</p>

    <div class="admin-toolbar">
      <div class="left"><input class="admin-search" id="pk-search" type="search" placeholder="Rechercher un pack…" /></div>
      <Button variant="primary" id="pk-new">+ Nouveau pack</Button>
    </div>

    <Card class="gap-0 overflow-hidden p-0">
      <div class="overflow-x-auto">
        <table class="admin-table min-w-[640px]">
          <thead><tr><th>Pack</th><th>Parcours</th><th>Formations</th><th style="text-align:right">Prix</th><th>Statut</th><th></th></tr></thead>
          <tbody data-rows><tr class="a-loading-row"><td colspan="6">Chargement…</td></tr></tbody>
        </table>
      </div>
    </Card>

    <div>
      <h2 class="sectitle" style="font-size:1.05rem;margin:8px 2px 10px">Acheteurs &amp; places</h2>
      <Card class="p-0 overflow-hidden">
        <div data-buyers style="padding:6px"><div class="dash-empty" style="padding:18px">Chargement…</div></div>
      </Card>
    </div>
  </div>

  <!-- Tiroir éditeur -->
  <div class="a-drawer-overlay" id="pk-overlay"></div>
  <aside class="a-drawer" id="pk-drawer" aria-hidden="true">
    <div class="a-drawer-head">
      <h2 id="pk-drawer-title">Nouveau pack</h2>
      <button class="icon-btn" id="pk-close" aria-label="Fermer">✕</button>
    </div>
    <div class="a-drawer-body">
      <input type="hidden" id="f-id" />
      <div class="a-field"><label for="f-theme">Parcours *</label><select class="a-input" id="f-theme"></select><div class="hint">Le parcours (thème) auquel ce pack se rattache.</div></div>
      <div class="a-field"><label for="f-title">Titre *</label><input class="a-input" id="f-title" placeholder="Ex. Le pack complet · 5 formations" /></div>
      <div class="a-field"><label for="f-slug">Slug (URL) *</label><input class="a-input" id="f-slug" /><div class="hint">Adresse : /pack/&lt;slug&gt;</div></div>
      <div class="a-grid2">
        <div class="a-field"><label for="f-price">Prix (F CFA) *</label><input class="a-input" id="f-price" type="number" min="0" placeholder="90000" /></div>
        <div class="a-field"><label for="f-compare">Prix barré (option)</label><input class="a-input" id="f-compare" type="number" min="0" placeholder="125000" /></div>
      </div>
      <div class="a-field"><label>Description (option)</label><textarea class="a-input" id="f-desc" rows="2" placeholder="Une phrase d'accroche affichée sur la page du pack."></textarea></div>
      <div class="a-field">
        <label>Formations incluses *</label>
        <div class="pk-checks" id="f-formations"></div>
        <div class="hint">Coche les formations à inclure. Utilise ↑ ↓ pour définir l'ordre d'affichage sur la page du pack.</div>
      </div>
      <div class="a-field">
        <label class="pk-toggle"><input type="checkbox" id="f-active" /> <span>Pack visible sur le site</span></label>
      </div>
    </div>
    <div class="a-drawer-foot">
      <span class="grow"></span>
      <button class="abtn" id="pk-cancel">Annuler</button>
      <button class="abtn primary" id="pk-save">Enregistrer</button>
    </div>
  </aside>
</AdminLayout>

<script>
  import { supabaseBrowser } from "../../lib/supabaseBrowser";
  import { slugify, esc, toast, confirmModal, fmtFCFA, dshort } from "../../scripts/adminUtils";

  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const rows = document.querySelector("[data-rows]")!;
  const buyersBox = document.querySelector("[data-buyers]")!;
  const drawer = document.getElementById("pk-drawer")!;
  const overlay = document.getElementById("pk-overlay")!;

  let packs: any[] = [];
  let themes: any[] = [];
  let formations: any[] = [];
  let selected = new Set<string>();
  let ordered: string[] = [];       // ordre d'affichage (réordonnable)
  let slugTouched = false;

  const openDrawer = () => { drawer.classList.add("open"); overlay.classList.add("open"); document.body.style.overflow = "hidden"; };
  const closeDrawer = () => { drawer.classList.remove("open"); overlay.classList.remove("open"); document.body.style.overflow = ""; };
  const themeName = (id: string) => themes.find((t) => t.id === id)?.name || "—";

  // (Re)construit l'ordre d'affichage pour le parcours courant : garde l'ordre
  // existant pour les formations encore présentes, ajoute les nouvelles à la fin,
  // et ne conserve comme sélectionnées que les formations de ce parcours.
  function rebuildOrdered(themeId: string) {
    const inTheme = formations.filter((f) => !themeId || f.theme_id === themeId).map((f) => f.id);
    const set = new Set(inTheme);
    const kept = ordered.filter((id) => set.has(id));
    const added = inTheme.filter((id) => !kept.includes(id));
    ordered = [...kept, ...added];
    selected = new Set([...selected].filter((id) => set.has(id)));
  }

  function move(id: string, dir: -1 | 1) {
    const i = ordered.indexOf(id);
    const j = i + dir;
    if (i < 0 || j < 0 || j >= ordered.length) return;
    [ordered[i], ordered[j]] = [ordered[j], ordered[i]];
    renderFormations();
  }

  function renderFormations() {
    const box = document.getElementById("f-formations")!;
    const titleOf = (id: string) => formations.find((f) => f.id === id)?.title || "—";
    if (!ordered.length) { box.innerHTML = `<div class="hint">Aucune formation dans ce parcours pour l'instant.</div>`; return; }
    box.innerHTML = ordered.map((id, i) => `
      <div class="pk-fitem ${selected.has(id) ? "sel" : ""}">
        <label class="pk-fitem-main">
          <input type="checkbox" data-fid="${id}" ${selected.has(id) ? "checked" : ""} />
          <span class="pk-fitem-num">${i + 1}</span>
          <span>${esc(titleOf(id))}</span>
        </label>
        <span class="pk-fitem-ord">
          <button type="button" class="pk-ordbtn" data-up="${id}" title="Monter" aria-label="Monter" ${i === 0 ? "disabled" : ""}>↑</button>
          <button type="button" class="pk-ordbtn" data-down="${id}" title="Descendre" aria-label="Descendre" ${i === ordered.length - 1 ? "disabled" : ""}>↓</button>
        </span>
      </div>`).join("");
    box.querySelectorAll<HTMLInputElement>("[data-fid]").forEach((c) =>
      c.addEventListener("change", () => {
        const id = c.dataset.fid!;
        if (c.checked) selected.add(id); else selected.delete(id);
        c.closest(".pk-fitem")?.classList.toggle("sel", c.checked);
      }));
    box.querySelectorAll<HTMLElement>("[data-up]").forEach((b) => b.addEventListener("click", () => move(b.dataset.up!, -1)));
    box.querySelectorAll<HTMLElement>("[data-down]").forEach((b) => b.addEventListener("click", () => move(b.dataset.down!, 1)));
  }

  function render(list: any[]) {
    if (!list.length) { rows.innerHTML = `<tr><td class="empty" colspan="6">Aucun pack. Cliquez sur « Nouveau pack ».</td></tr>`; return; }
    rows.innerHTML = list.map((p) => `
      <tr>
        <td><strong>${esc(p.title)}</strong><br><span style="color:var(--c-gray-500);font-size:.78rem">/pack/${esc(p.slug)}</span></td>
        <td>${esc(themeName(p.theme_id))}</td>
        <td>${(p.pack_items || []).length}</td>
        <td style="text-align:right">${fmtFCFA(p.price)}</td>
        <td>${p.active ? '<span class="tag-pill ok">En ligne</span>' : '<span class="tag-pill draft">Brouillon</span>'}</td>
        <td><div class="row-actions">
          <button class="icon-btn" data-edit="${p.id}" title="Éditer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></button>
          <button class="icon-btn danger" data-del="${p.id}" title="Supprimer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg></button>
        </div></td>
      </tr>`).join("");
    rows.querySelectorAll<HTMLElement>("[data-edit]").forEach((b) => b.addEventListener("click", () => edit(b.dataset.edit!)));
    rows.querySelectorAll<HTMLElement>("[data-del]").forEach((b) => b.addEventListener("click", () => del(b.dataset.del!)));
  }

  function applySearch() {
    const q = ($("pk-search").value || "").toLowerCase();
    render(packs.filter((p) => !q || (p.title + " " + p.slug).toLowerCase().includes(q)));
  }

  function renderBuyers(list: any[]) {
    if (!list.length) { buyersBox.innerHTML = `<div class="dash-empty" style="padding:18px">Aucun achat de pack pour l'instant.</div>`; return; }
    buyersBox.innerHTML = list.map((p) => {
      const ents = p.pack_entitlements || [];
      const used = ents.filter((e: any) => e.status === "enrolled" || e.status === "done").length;
      const seats = ents.map((e: any) => {
        const t = e.formations?.title || "Formation";
        const ok = e.status === "enrolled" || e.status === "done";
        return `<span class="pk-seat ${ok ? "ok" : "wait"}">${ok ? "✓ " : ""}${esc(t)}${ok ? "" : " · en attente de date"}</span>`;
      }).join("");
      return `<div class="pk-buyer">
        <div class="pk-buyer-hd">
          <div><div class="who">${esc(p.full_name)}</div><div class="meta">${esc(p.email)} · ${esc(p.packs?.title || "Pack")} · ${dshort(p.created_at)} · ${esc(p.reference)}</div></div>
          <div class="prog">${used} / ${ents.length} places utilisées</div>
        </div>
        <div class="pk-seats">${seats || '<span class="pk-seat wait">Aucune formation</span>'}</div>
      </div>`;
    }).join("");
  }

  function fill(p: any) {
    $("f-id").value = p?.id || "";
    $("f-theme").innerHTML = themes.map((t) => `<option value="${t.id}" ${p?.theme_id === t.id ? "selected" : ""}>${esc(t.name)}</option>`).join("");
    $("f-title").value = p?.title || "";
    $("f-slug").value = p?.slug || "";
    $("f-price").value = (p?.price ?? "").toString();
    $("f-compare").value = (p?.compare_at_price ?? "").toString();
    ($("f-desc") as unknown as HTMLTextAreaElement).value = p?.description || "";
    ($("f-active") as HTMLInputElement).checked = !!p?.active;
    const sortedItems = (p?.pack_items || []).slice().sort((a: any, b: any) => (a.sort ?? 0) - (b.sort ?? 0));
    selected = new Set(sortedItems.map((i: any) => i.formation_id));
    ordered = sortedItems.map((i: any) => i.formation_id);
    rebuildOrdered($("f-theme").value);
    slugTouched = !!p?.slug;
    renderFormations();
    document.getElementById("pk-drawer-title")!.textContent = p ? "Modifier le pack" : "Nouveau pack";
  }

  function openNew() { fill(null); openDrawer(); }
  function edit(id: string) { fill(packs.find((x) => x.id === id)); openDrawer(); }

  async function del(id: string) {
    const p = packs.find((x) => x.id === id);
    if (!(await confirmModal({ title: "Supprimer le pack", message: `Supprimer « ${p?.title} » ? Les achats déjà effectués sont conservés.`, danger: true, confirmLabel: "Supprimer" }))) return;
    const { error } = await supabaseBrowser.from("packs").delete().eq("id", id);
    if (error) { toast("Suppression impossible.", "err"); return; }
    toast("Pack supprimé."); await load();
  }

  async function save() {
    const theme_id = $("f-theme").value || null;
    const title = $("f-title").value.trim();
    const slug = $("f-slug").value.trim() || slugify(title);
    const price = parseInt($("f-price").value || "0") || 0;
    const compare = parseInt($("f-compare").value || "0") || 0;
    if (!theme_id || !title || !slug || price <= 0) { toast("Parcours, titre, slug et prix sont obligatoires.", "err"); return; }
    if (selected.size === 0) { toast("Sélectionne au moins une formation.", "err"); return; }

    const payload: any = {
      theme_id, title, slug, price,
      compare_at_price: compare > price ? compare : null,
      description: ($("f-desc") as unknown as HTMLTextAreaElement).value.trim() || null,
      active: ($("f-active") as HTMLInputElement).checked,
    };
    const id = $("f-id").value;
    const btn = document.getElementById("pk-save")!;
    btn.setAttribute("disabled", "true"); btn.textContent = "Enregistrement…";

    let packId = id;
    let error: any = null;
    if (id) {
      ({ error } = await supabaseBrowser.from("packs").update(payload).eq("id", id));
    } else {
      const r = await supabaseBrowser.from("packs").insert(payload).select("id").single();
      error = r.error; packId = r.data?.id;
    }
    if (!error && packId) {
      // Synchronise les formations incluses (remplace l'ensemble).
      await supabaseBrowser.from("pack_items").delete().eq("pack_id", packId);
      const items = ordered.filter((id) => selected.has(id)).map((fid, i) => ({ pack_id: packId, formation_id: fid, sort: i }));
      ({ error } = await supabaseBrowser.from("pack_items").insert(items));
    }

    btn.removeAttribute("disabled"); btn.textContent = "Enregistrer";
    if (error) {
      const dup = (error.message || "").includes("duplicate") || error.code === "23505";
      toast(dup ? "Ce slug existe déjà." : "Enregistrement impossible.", "err");
      return;
    }
    toast(id ? "Pack mis à jour." : "Pack créé.");
    closeDrawer(); await load();
  }

  async function load() {
    const [t, f, p, b] = await Promise.all([
      supabaseBrowser.from("themes").select("id,name").order("sort_order", { ascending: true }).order("name"),
      supabaseBrowser.from("formations").select("id,title,theme_id").order("title"),
      supabaseBrowser.from("packs").select("*, pack_items(formation_id, sort)").order("created_at", { ascending: false }),
      supabaseBrowser.from("pack_purchases")
        .select("id, reference, full_name, email, created_at, packs(title), pack_entitlements(status, formations(title))")
        .eq("status", "confirmed").order("created_at", { ascending: false }).limit(100),
    ]);
    themes = t.data || []; formations = f.data || [];
    if (p.error) { rows.innerHTML = `<tr><td class="empty" colspan="6">Erreur de chargement (la table « packs » existe-t-elle ? Migration 0026 appliquée ?).</td></tr>`; return; }
    packs = p.data || [];
    applySearch();
    renderBuyers(b.data || []);
  }

  document.getElementById("pk-new")!.addEventListener("click", openNew);
  document.getElementById("pk-close")!.addEventListener("click", closeDrawer);
  document.getElementById("pk-cancel")!.addEventListener("click", closeDrawer);
  overlay.addEventListener("click", closeDrawer);
  document.getElementById("pk-save")!.addEventListener("click", save);
  $("pk-search").addEventListener("input", applySearch);
  $("f-theme").addEventListener("change", () => { rebuildOrdered($("f-theme").value); renderFormations(); });
  $("f-title").addEventListener("input", () => { if (!slugTouched) $("f-slug").value = slugify($("f-title").value); });
  $("f-slug").addEventListener("input", () => { slugTouched = true; });

  (async () => {
    const { data: { session } } = await supabaseBrowser.auth.getSession();
    if (!session) return;
    await load();
  })();
</script>

<style is:global>
  .a-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .pk-checks { display: flex; flex-direction: column; gap: 6px; }
  .pk-fitem { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 10px 8px 12px; border: 1px solid var(--c-border); border-radius: 10px; }
  .pk-fitem.sel { background: rgba(31, 108, 237, 0.07); border-color: rgba(31, 108, 237, 0.3); }
  .pk-fitem-main { display: flex; align-items: center; gap: 10px; cursor: pointer; font-size: .88rem; min-width: 0; }
  .pk-fitem-main input { width: 17px; height: 17px; accent-color: var(--c-blue); flex: none; }
  .pk-fitem-main > span:last-child { overflow: hidden; text-overflow: ellipsis; }
  .pk-fitem-num { flex: none; width: 20px; height: 20px; border-radius: 6px; background: var(--c-gray-100); color: var(--c-gray-600); font-size: .72rem; font-weight: 800; display: grid; place-items: center; }
  .pk-fitem.sel .pk-fitem-num { background: rgba(31, 108, 237, 0.16); color: var(--c-blue-dark); }
  .pk-fitem-ord { display: flex; gap: 4px; flex: none; }
  .pk-ordbtn { width: 26px; height: 26px; border: 1px solid var(--c-border); background: #fff; border-radius: 7px; cursor: pointer; font-size: .8rem; line-height: 1; color: var(--c-gray-700); }
  .pk-ordbtn:hover:not([disabled]) { background: var(--c-gray-100); }
  .pk-ordbtn[disabled] { opacity: .35; cursor: default; }
  .pk-toggle { display: flex; align-items: center; gap: 10px; font-weight: 600; cursor: pointer; }
  .pk-toggle input { width: 18px; height: 18px; accent-color: var(--c-green); }
  .pk-buyer { padding: 14px 16px; border-bottom: 1px solid var(--c-border); }
  .pk-buyer:last-child { border-bottom: 0; }
  .pk-buyer-hd { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 9px; }
  .pk-buyer-hd .who { font-weight: 700; font-size: .92rem; }
  .pk-buyer-hd .meta { font-size: .75rem; color: var(--c-gray-500); }
  .pk-buyer-hd .prog { font-size: .78rem; color: var(--c-gray-600); font-weight: 600; white-space: nowrap; }
  .pk-seats { display: flex; flex-wrap: wrap; gap: 6px; }
  .pk-seat { font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 8px; }
  .pk-seat.ok { background: var(--c-success-bg); color: var(--c-success); }
  .pk-seat.wait { background: #fff; border: 1px solid var(--c-border); color: var(--c-gray-600); }
</style>
