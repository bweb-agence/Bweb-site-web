---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { supabase } from "../../lib/supabase";
import { site, contact } from "../../config/site";
import { priceFCFA, frDateLong, frDateShort, frTime, gradClass, gradSuffix, levelLabel, modeLabel, themeColorMap } from "../../lib/format";
import { marked } from "marked";
import "../../styles/formations.css";

const { slug } = Astro.params;

const { data: formation } = await supabase.from("formations").select("*").eq("slug", slug).maybeSingle();
if (!formation) Astro.response.status = 404;

const { data: themesData } = await supabase.from("themes").select("name,color");
const tmap = themeColorMap(themesData);

let upcoming: any[] = [];
let faqs: { question: string; answer_md: string }[] = [];
let reviews: { author_name: string; author_role: string | null; rating: number; comment: string }[] = [];
if (formation) {
  const { data: sess } = await supabase
    .from("sessions")
    .select("id,slug,title,starts_at,ends_at,venue,city,mode,status,image_url, ticket_types(price,capacity,sold,compare_at_price)")
    .eq("formation_id", formation.id)
    .in("status", ["published", "full"])
    .gte("starts_at", new Date().toISOString())
    .order("starts_at", { ascending: true });
  upcoming = sess ?? [];
  const { data: fq } = await supabase
    .from("faqs").select("question,answer_md,sort")
    .or(`formation_id.is.null,formation_id.eq.${formation.id}`).order("sort", { ascending: true });
  faqs = fq ?? [];
  const { data: rv } = await supabase
    .from("reviews").select("author_name,author_role,rating,comment")
    .eq("formation_id", formation.id).eq("status", "approved").order("created_at", { ascending: false }).limit(12);
  reviews = rv ?? [];
}

const comingSoon = !!formation?.coming_soon && upcoming.length === 0;
const themeColor = gradSuffix(formation?.theme, tmap);
const levelText = (formation?.level || "Tous niveaux").trim();
const levelSlug = (() => {
  const l = levelText.toLowerCase();
  if (l.includes("débutant") || l.includes("debutant")) return "debutant";
  if (l.includes("intermédiaire") || l.includes("intermediaire")) return "intermediaire";
  if (l.includes("avancé") || l.includes("avance")) return "avance";
  if (l.includes("prérequis") || l.includes("prerequis")) return "prerequis";
  return "tous";
})();

const sessMin = (s: any) => { const t = s.ticket_types ?? []; return t.length ? Math.min(...t.map((x: any) => x.price)) : null; };
const sessRemaining = (s: any) => {
  const t = s.ticket_types ?? [];
  const cap = t.reduce((a: number, x: any) => a + x.capacity, 0);
  const sold = t.reduce((a: number, x: any) => a + x.sold, 0);
  return Math.max(0, cap - sold);
};
const allTickets = upcoming.flatMap((s) => s.ticket_types ?? []);
const minPrice = allTickets.length ? Math.min(...allTickets.map((t: any) => t.price)) : (formation?.default_price ?? null);
const nextSession = upcoming[0] ?? null;

// Intro + « Au programme » (identique à la page date).
const desc = formation?.description_md ?? "";
const [introRaw, progRaw] = desc.split(/##\s*Au programme/i);
const intro = (introRaw || formation?.summary || "").trim();
const learnItems = (progRaw || "").split("\n").map((l) => l.trim()).filter((l) => l.startsWith("- ")).map((l) => l.slice(2).trim());
const richHtml = formation?.description_html || "";
let detailHtml = richHtml || (intro ? (marked.parse(intro, { async: false }) as string) : "");
if (learnItems.length > 0 && richHtml) detailHtml = detailHtml.replace(/<h[1-6][^>]*>\s*au programme[\s\S]*$/i, "").trim();

const ck = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>`;
const dNum = (s: string) => new Date(s).getDate();
const mShort = (s: string) => { const m = new Date(s).toLocaleDateString("fr-FR", { month: "short" }).replace(".", ""); return m.charAt(0).toUpperCase() + m.slice(1); };

const reviewCount = reviews.length;
const reviewAvg = reviewCount ? Math.round((reviews.reduce((s, r) => s + r.rating, 0) / reviewCount) * 10) / 10 : 0;
const stars = (n: number) => "★★★★★".slice(0, Math.round(n)) + "☆☆☆☆☆".slice(0, 5 - Math.round(n));

const waNotify = `https://wa.me/${contact.whatsapp.primary}?text=${encodeURIComponent("Bonjour Bweb Agence, je souhaite être prévenu·e des prochaines dates de la formation « " + (formation?.title || "") + " ».")}`;
const waQuestion = `https://wa.me/${contact.whatsapp.primary}?text=${encodeURIComponent("Bonjour Bweb Agence, j'ai une question sur la formation « " + (formation?.title || "") + " ».")}`;

const crumbs = formation ? [
  { name: "Accueil", path: "/" },
  { name: "Formations", path: "/formations" },
  { name: formation.title, path: `/formations/${formation.slug}` },
] : undefined;

const courseLd = formation ? {
  "@context": "https://schema.org",
  "@type": "Course",
  name: formation.title,
  description: formation.summary || formation.seo_description || `Formation ${formation.title} à Abidjan.`,
  provider: { "@type": "Organization", name: site.name, url: site.url },
  ...(reviewCount ? { aggregateRating: { "@type": "AggregateRating", ratingValue: reviewAvg, reviewCount, bestRating: 5, worstRating: 1 } } : {}),
  ...(upcoming.length ? {
    hasCourseInstance: upcoming.map((s: any) => ({
      "@type": "CourseInstance",
      courseMode: s.mode === "en_ligne" ? "Online" : s.mode === "hybride" ? "Blended" : "Onsite",
      startDate: s.starts_at,
      location: s.mode === "en_ligne"
        ? { "@type": "VirtualLocation", url: new URL(`/formations/session/${s.slug}`, site.url).href }
        : { "@type": "Place", name: s.venue || "Espace de formation Bweb", address: { "@type": "PostalAddress", addressLocality: s.city || "Abidjan", addressCountry: "CI" } },
      ...(sessMin(s) !== null ? { offers: { "@type": "Offer", price: sessMin(s), priceCurrency: "XOF", url: new URL(`/formations/session/${s.slug}`, site.url).href } } : {}),
    })),
  } : {}),
} : null;
---

{formation ? (
  <BaseLayout
    title={formation.seo_title || `${formation.title} — Formation à Abidjan | Bweb`}
    description={formation.seo_description || formation.summary || `Formation ${formation.title} en présentiel à Abidjan.`}
    breadcrumbs={crumbs}
    hideWhatsApp={true}
  >
    {courseLd && <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(courseLd)} />}

    <article class="section" style="padding-top:calc(var(--header-h) + var(--space-lg))">
      <div class="container">
        <a class="sess-back" href="/formations/calendrier">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M15 18l-6-6 6-6" /></svg>
          Voir toutes les formations
        </a>

        <!-- ===== En-tête formation ===== -->
        <div class="fmp-head">
          <div class="fmp-head__text">
            <div class="sess-eyebrows">
              {formation.theme && <span class="eyebrow">{formation.theme}</span>}
              <span class={`sess-level ${levelSlug}`}>{levelText}</span>
              {comingSoon && <span class="fmp-soon-badge">● Bientôt</span>}
            </div>
            <h1 class="fmp-title">{formation.title}</h1>
            {formation.summary && <p class="sess-desc" style="max-width:60ch">{formation.summary}</p>}
            <div class="sess-meta">
              {formation.duration && <span class="m"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>{formation.duration}</span>}
              <span class="m"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 19a5.6 5.6 0 0 1 11 0"/></svg>{formation.instructor_name ?? "Expert Bweb"}</span>
              {!comingSoon && upcoming.length > 0 && <span class="m"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg>{upcoming.length} date{upcoming.length > 1 ? "s" : ""} à venir</span>}
              {reviewCount > 0 && <span class="m"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6 6.6.6-5 4.3 1.5 6.5L12 16l-6 3.4 1.5-6.5-5-4.3 6.6-.6z"/></svg>{reviewAvg.toFixed(1).replace(".", ",")} · {reviewCount} avis</span>}
            </div>
          </div>
          <div class={`fmp-head__media ev-media ${gradClass(formation.theme, tmap)}`} data-grad={themeColor}>
            {formation.image_url && <img src={formation.image_url} alt="" />}
            <span class="ev-scrim"></span>
            {formation.theme && <span class="ev-theme"><span class="dot"></span>{formation.theme}</span>}
          </div>
        </div>

        <!-- ===== Dates / Bientôt (conversion) ===== -->
        <section class="fmp-dates" id="dates">
          {comingSoon ? (
            <div class="fmp-soon">
              <div class="fmp-soon__ic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></div>
              <div class="fmp-soon__body">
                <h2>Cette formation arrive bientôt.</h2>
                <p>Les prochaines dates ne sont pas encore ouvertes. Laissez-nous votre message sur WhatsApp : on vous prévient dès qu'une session est programmée.</p>
              </div>
              <a class="btn btn-primary btn-lg" href={waNotify} target="_blank" rel="noopener">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 00-8.6 15l-1.3 4.8 4.9-1.3A10 10 0 1012 2z"/></svg>
                Être prévenu·e
              </a>
            </div>
          ) : upcoming.length > 0 ? (
            <>
              <h2 class="sectitle" style="margin-top:0">Choisissez votre date</h2>
              <div class="fmp-datelist">
                {upcoming.map((s: any) => {
                  const rem = sessRemaining(s);
                  const full = s.status === "full" || rem <= 0;
                  const p = sessMin(s);
                  return (
                    <div class={`fmp-datecard ${full ? "is-full" : ""}`}>
                      <span class="fmp-dc__date" data-grad={themeColor}><span class="d">{dNum(s.starts_at)}</span><span class="m">{mShort(s.starts_at)}</span></span>
                      <div class="fmp-dc__info">
                        <div class="fmp-dc__when">{frDateLong(s.starts_at)} · {frTime(s.starts_at)}</div>
                        <div class="fmp-dc__meta">
                          <span>{modeLabel(s.mode)}</span>
                          {s.mode !== "en_ligne" && <span>· {s.venue ?? "Espace Bweb"}, {s.city ?? "Abidjan"}</span>}
                          <span class="fmp-dc__places">· {full ? "Complet" : `${rem} place${rem > 1 ? "s" : ""}`}</span>
                        </div>
                      </div>
                      {p !== null && <div class="fmp-dc__price"><small>dès</small><b>{priceFCFA(p)}</b></div>}
                      <a class={`btn ${full ? "btn-outline" : "btn-primary"} fmp-dc__cta`} href={`/formations/session/${s.slug}`}>
                        {full ? "Liste d'attente" : "Réserver"}
                      </a>
                    </div>
                  );
                })}
              </div>
            </>
          ) : (
            <div class="fmp-soon">
              <div class="fmp-soon__ic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg></div>
              <div class="fmp-soon__body">
                <h2>Aucune date programmée pour le moment.</h2>
                <p>Écrivez-nous sur WhatsApp pour connaître les prochaines sessions ou organiser cette formation pour votre équipe.</p>
              </div>
              <a class="btn btn-primary btn-lg" href={waNotify} target="_blank" rel="noopener">Être prévenu·e</a>
            </div>
          )}
        </section>

        <!-- ===== Contenu ===== -->
        <div class="fmp-body">
          {learnItems.length > 0 && (
            <div class="learn-box">
              <h2>Ce que vous apprendrez</h2>
              <ul class="learn-grid">
                {learnItems.map((it) => (<li><Fragment set:html={ck} />{it}</li>))}
              </ul>
            </div>
          )}

          {detailHtml && (
            <>
              <h2 class="sectitle">À propos de cette formation</h2>
              <div class="sess-prose" set:html={detailHtml} />
            </>
          )}

          {(formation.audience || formation.prerequisites) && (
            <>
              <h2 class="sectitle">À qui s'adresse cette formation</h2>
              <div class="audience-grid">
                {formation.audience && (
                  <div class="ag-card">
                    <div class="ag-h"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 5.5a3 3 0 0 1 0 5.5M22 20a6.5 6.5 0 0 0-4-6"/></svg>Public visé</div>
                    <p>{formation.audience}</p>
                  </div>
                )}
                {formation.prerequisites && (
                  <div class="ag-card">
                    <div class="ag-h"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>Prérequis</div>
                    <p>{formation.prerequisites}</p>
                  </div>
                )}
              </div>
            </>
          )}

          {formation.instructor_name && (formation.instructor_bio || formation.instructor_photo_url) && (
            <>
              <h2 class="sectitle">Votre formateur</h2>
              <div class="instructor">
                {formation.instructor_photo_url && <img class="instructor__photo" src={formation.instructor_photo_url} alt={formation.instructor_name} loading="lazy" />}
                <div class="instructor__body">
                  <div class="instructor__name">{formation.instructor_name}</div>
                  {formation.instructor_role && <div class="instructor__role">{formation.instructor_role}</div>}
                  {formation.instructor_bio && <p class="instructor__bio">{formation.instructor_bio}</p>}
                </div>
              </div>
            </>
          )}

          {reviewCount > 0 && (
            <>
              <h2 class="sectitle">Avis des participants</h2>
              <div class="reviews">
                <div class="reviews__head">
                  <span class="rv-avg">{reviewAvg.toFixed(1).replace(".", ",")}</span>
                  <span class="rv-stars" aria-hidden="true">{stars(reviewAvg)}</span>
                  <span class="rv-count">{reviewCount} avis</span>
                </div>
                <div class="reviews__list">
                  {reviews.map((r) => (
                    <figure class="rv-item">
                      <div class="rv-stars sm" aria-label={`${r.rating} sur 5`}>{stars(r.rating)}</div>
                      <blockquote>{r.comment}</blockquote>
                      <figcaption>{r.author_name}{r.author_role && <span> · {r.author_role}</span>}</figcaption>
                    </figure>
                  ))}
                </div>
              </div>
            </>
          )}

          {faqs.length > 0 && (
            <>
              <h2 class="sectitle">Questions fréquentes</h2>
              <div class="faq">
                {faqs.map((f, i) => (
                  <details class="faq-item" open={i === 0}>
                    <summary>{f.question}</summary>
                    <div class="faq-answer" set:html={marked.parse(f.answer_md, { async: false }) as string} />
                  </details>
                ))}
              </div>
            </>
          )}

          <h2 class="sectitle">Une question ?</h2>
          <div class="ask-box">
            <p>Notre équipe vous répond sur WhatsApp — programme, dates, tarif de groupe, facture…</p>
            <a class="btn btn-wa" href={waQuestion} target="_blank" rel="noopener">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 00-8.6 15l-1.3 4.8 4.9-1.3A10 10 0 1012 2z"/></svg>
              Poser ma question
            </a>
          </div>
        </div>
      </div>

      {!comingSoon && nextSession && (
        <div class="sess-stickycta is-hidden" id="fmp-stickycta">
          <div class="ssc-price">
            {minPrice !== null ? (<><span class="ssc-from">À partir de</span><b>{priceFCFA(minPrice)}</b></>) : <b>Prochaine date</b>}
          </div>
          <a class="btn btn-primary btn-lg ssc-btn" href={`/formations/session/${nextSession.slug}`}>Réserver ma place</a>
        </div>
      )}
    </article>
  </BaseLayout>
) : (
  <BaseLayout title="Formation introuvable | Bweb Agence" noindex={true}>
    <section class="section" style="padding-top:calc(var(--header-h) + var(--space-xl))">
      <div class="container" style="text-align:center">
        <div class="eyebrow" style="justify-content:center">Erreur 404</div>
        <h1>Cette formation n'existe pas (ou plus).</h1>
        <p class="lead">Découvrez toutes nos formations au calendrier.</p>
        <p style="margin-top:var(--space-md)"><a class="btn btn-primary" href="/formations/calendrier">Voir le calendrier</a></p>
      </div>
    </section>
  </BaseLayout>
)}

<style>
  .fmp-head { display: grid; grid-template-columns: 1fr; gap: 22px; margin: 18px 0 8px; }
  @media (min-width: 860px) { .fmp-head { grid-template-columns: 1fr 340px; align-items: start; gap: 30px; } }
  .fmp-title { font-family: var(--f-display); font-weight: 800; font-size: var(--fs-h1); line-height: 1.06; letter-spacing: -.02em; margin: 10px 0 12px; color: var(--c-ink); }
  .fmp-head__media { aspect-ratio: 16 / 9; border-radius: var(--radius-lg); overflow: hidden; position: relative; box-shadow: var(--shadow-md); }
  .fmp-head__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .fmp-soon-badge { font-size: .72rem; font-weight: 800; letter-spacing: .02em; color: #8a5a00; background: #fff2d6; padding: 4px 11px; border-radius: var(--radius-pill); }

  .fmp-dates { margin: 26px 0 8px; }
  .fmp-datelist { display: flex; flex-direction: column; gap: 12px; }
  .fmp-datecard { display: flex; align-items: center; gap: 14px; border: 1px solid var(--c-border); border-radius: var(--radius-md); padding: 12px 14px; background: #fff; transition: border-color .15s, box-shadow .15s; }
  .fmp-datecard:hover { border-color: color-mix(in srgb, var(--c-blue) 40%, var(--c-border)); box-shadow: var(--shadow-sm); }
  .fmp-datecard.is-full { opacity: .75; }
  .fmp-dc__date { flex: none; width: 54px; text-align: center; line-height: 1; background: var(--c-white); border: 1px solid var(--c-border); border-radius: 12px; padding: 8px 6px; }
  .fmp-dc__date .d { display: block; font-family: var(--f-display); font-weight: 800; font-size: 1.3rem; color: var(--c-ink); }
  .fmp-dc__date .m { display: block; font-size: .58rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--c-blue); margin-top: 3px; }
  .fmp-dc__date[data-grad="warm"] .m { color: #cf7a10; } .fmp-dc__date[data-grad="teal"] .m { color: #0e9c8f; } .fmp-dc__date[data-grad="navy"] .m { color: #3a3f8f; } .fmp-dc__date[data-grad="green"] .m { color: #058a70; }
  .fmp-dc__info { flex: 1; min-width: 0; }
  .fmp-dc__when { font-weight: 800; font-size: .95rem; color: var(--c-ink); }
  .fmp-dc__meta { font-size: .8rem; color: var(--c-gray-600); margin-top: 3px; display: flex; flex-wrap: wrap; gap: 4px; }
  .fmp-dc__places { font-weight: 700; color: var(--c-gray-700); }
  .fmp-dc__price { flex: none; text-align: right; }
  .fmp-dc__price small { display: block; font-size: .66rem; font-weight: 700; color: var(--c-gray-400); }
  .fmp-dc__price b { font-family: var(--f-display); font-weight: 800; font-size: 1.02rem; color: var(--c-navy); font-variant-numeric: tabular-nums; }
  .fmp-dc__cta { flex: none; width: auto; }
  @media (max-width: 620px) {
    .fmp-datecard { flex-wrap: wrap; }
    .fmp-dc__info { flex: 1 1 auto; }
    .fmp-dc__cta { flex: 1 0 100%; justify-content: center; }
  }

  .fmp-soon { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; background: linear-gradient(120deg, rgba(31,108,237,.06), rgba(255,199,42,.10)); border: 1px solid var(--c-border); border-radius: var(--radius-lg); padding: 20px 22px; }
  .fmp-soon__ic { flex: none; width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center; color: #fff; background: var(--g-navy); }
  .fmp-soon__body { flex: 1; min-width: 220px; }
  .fmp-soon__body h2 { font-family: var(--f-display); font-weight: 800; font-size: var(--fs-h4); margin: 0 0 4px; color: var(--c-ink); }
  .fmp-soon__body p { margin: 0; color: var(--c-gray-600); font-size: .9rem; max-width: 58ch; }

  .fmp-body { max-width: 760px; margin-top: 20px; }
  .fmp-body .learn-box { margin-top: 0; }
</style>

<script>
  // CTA collant (mobile) : révélé quand la section des dates sort de l'écran.
  const sticky = document.getElementById("fmp-stickycta");
  const dates = document.getElementById("dates");
  if (sticky && dates && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      ([e]) => sticky.classList.toggle("is-hidden", e.isIntersecting),
      { rootMargin: "0px 0px -40px 0px" },
    );
    io.observe(dates);
  } else if (sticky) {
    sticky.classList.remove("is-hidden");
  }
</script>
