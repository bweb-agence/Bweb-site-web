---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { supabase } from "../../../lib/supabase";
import { site, contact } from "../../../config/site";
import { priceFCFA, frDateLong, frDateShort, frTime, gradClass, gradSuffix, levelLabel, isOnline, isHybrid, modeLabel } from "../../../lib/format";
import { marked } from "marked";
import PhoneField from "../../../components/PhoneField.astro";
import "../../../styles/formations.css";

const { slug } = Astro.params;

const { data: session } = await supabase
  .from("sessions")
  .select("*, formations(slug,title,summary,description_md,description_html,duration,level,audience,prerequisites,instructor_name,instructor_role,instructor_photo_url,instructor_bio,included_extra), ticket_types(id,name,price,compare_at_price,capacity,sold,badge,sales_end,sort)")
  .eq("slug", slug)
  .in("status", ["published", "full"])
  .maybeSingle();

if (!session) {
  Astro.response.status = 404;
}

let faqs: { question: string; answer_md: string }[] = [];
if (session) {
  let q = supabase.from("faqs").select("question,answer_md,sort").order("sort", { ascending: true });
  q = session.formation_id
    ? q.or(`formation_id.is.null,formation_id.eq.${session.formation_id}`)
    : q.is("formation_id", null);
  const { data } = await q;
  faqs = data ?? [];
}

const formation = session?.formations as
  | {
      title: string; summary: string | null; description_md: string | null; description_html: string | null;
      duration: string | null; level: string | null;
      audience: string | null; prerequisites: string | null;
      instructor_name: string | null; instructor_role: string | null;
      instructor_photo_url: string | null; instructor_bio: string | null; included_extra: string | null;
    }
  | null;

const tickets = (session?.ticket_types ?? []).slice().sort((a: any, b: any) => a.sort - b.sort);
const totalCap = tickets.reduce((s: number, t: any) => s + t.capacity, 0);
const totalSold = tickets.reduce((s: number, t: any) => s + t.sold, 0);
const totalRemaining = Math.max(0, totalCap - totalSold);
const isFull = session?.status === "full" || totalRemaining <= 0;
const cheapest = tickets.length ? tickets.reduce((a: any, t: any) => (t.price < a.price ? t : a)) : null;
const minPrice = cheapest ? cheapest.price : null;
const minCompareAt = cheapest && cheapest.compare_at_price && cheapest.compare_at_price > cheapest.price ? cheapest.compare_at_price : null;
const minDiscountPct = minCompareAt && minPrice ? Math.round((1 - minPrice / minCompareAt) * 100) : 0;
const ttPromo = (t: any) => (t.compare_at_price && t.compare_at_price > t.price
  ? { compareAt: t.compare_at_price, pct: Math.round((1 - t.price / t.compare_at_price) * 100) }
  : null);

// Mode (présentiel / en ligne / hybride) + niveau — pilotent l'affichage de la page.
const sessMode = (session as any)?.mode as string | null;
const online = isOnline(sessMode);        // 100 % en ligne
const hybrid = isHybrid(sessMode);        // présentiel ET en ligne
const showVenue = sessMode !== "en_ligne"; // présentiel ou hybride → lieu + carte
const showOnline = sessMode !== "presentiel"; // en ligne ou hybride → infos visio
const sessModeLabel = modeLabel(sessMode);
const sessLevel = levelLabel((session as any)?.level);
const levelSlug = ((session as any)?.level || "") as string;
// Libellé du niveau : badge session prioritaire, sinon champ libre de la formation.
const levelText = sessLevel || formation?.level || "Tous niveaux";
const meetingUrl = ((session as any)?.meeting_url as string | null) || null;
const meetingInfo = ((session as any)?.meeting_info as string | null) || null;

// Session déjà passée ? (garde-fou : plus réservable, non indexable)
const isPast = session ? new Date(session.starts_at).getTime() < Date.now() : false;

// Tarif anticipé encore actif (urgence) : plus proche échéance future parmi les tarifs
const earlyDeadline = tickets
  .map((t: any) => t.sales_end)
  .filter((d: any): d is string => !!d && new Date(d).getTime() > Date.now())
  .sort()[0] || null;

// Autres dates de la même formation (repêchage / cross-sell)
let nextSessions: any[] = [];
if (session?.formation_id) {
  const { data: ns } = await supabase
    .from("sessions")
    .select("slug,title,theme,starts_at,venue,city,status")
    .eq("formation_id", session.formation_id)
    .neq("id", session.id)
    .in("status", ["published", "full"])
    .gte("starts_at", new Date().toISOString())
    .order("starts_at", { ascending: true })
    .limit(3);
  nextSessions = ns ?? [];
}

// Avis approuvés (témoignages) de la formation
let reviews: { author_name: string; author_role: string | null; rating: number; comment: string; created_at: string }[] = [];
if (session?.formation_id) {
  const { data: rv } = await supabase
    .from("reviews")
    .select("author_name,author_role,rating,comment,created_at")
    .eq("formation_id", session.formation_id)
    .eq("status", "approved")
    .order("created_at", { ascending: false })
    .limit(12);
  reviews = rv ?? [];
}
const reviewCount = reviews.length;
const reviewAvg = reviewCount ? Math.round((reviews.reduce((s, r) => s + r.rating, 0) / reviewCount) * 10) / 10 : 0;
const stars = (n: number) => "★★★★★".slice(0, Math.round(n)) + "☆☆☆☆☆".slice(0, 5 - Math.round(n));

// Order bumps : offres complémentaires proposées pendant la réservation (max 2).
let orderBumps: {
  ticketTypeId: string; headline: string | null; description: string | null; badge: string | null;
  name: string; ticketName: string; price: number; compareAt: number | null; image: string | null;
}[] = [];
if (session && !isPast && !isFull) {
  const { data: obs } = await supabase
    .from("order_bumps")
    .select("id, headline, description, badge, ticket_type_id, ticket_types(name, price, compare_at_price, capacity, sold, sessions(title, image_url))")
    .eq("session_id", session.id)
    .order("sort", { ascending: true });
  orderBumps = (obs ?? [])
    .map((o: any) => {
      const tt = o.ticket_types;
      if (!tt) return null;
      if (Math.max(0, (tt.capacity ?? 0) - (tt.sold ?? 0)) <= 0) return null; // complet → on masque
      const sess = tt.sessions;
      return {
        ticketTypeId: o.ticket_type_id,
        headline: o.headline,
        description: o.description,
        badge: o.badge,
        name: sess?.title || tt.name,
        ticketName: tt.name,
        price: tt.price,
        compareAt: tt.compare_at_price && tt.compare_at_price > tt.price ? tt.compare_at_price : null,
        image: sess?.image_url ?? null,
      };
    })
    .filter(Boolean)
    .slice(0, 2) as typeof orderBumps;
}
const bumpPct = (price: number, was: number) => Math.round((1 - price / was) * 100);

// Découpe la description en intro + éléments « Au programme »
const desc = formation?.description_md ?? "";
const [introRaw, progRaw] = desc.split(/##\s*Au programme/i);
const intro = (introRaw || formation?.summary || "").trim();
const learnItems = (progRaw || "")
  .split("\n").map((l) => l.trim()).filter((l) => l.startsWith("- ")).map((l) => l.slice(2).trim());
// Contenu riche (éditeur WYSIWYG) prioritaire : d'abord la session, puis la formation ; repli Markdown.
const richHtml = (session as any)?.description_html || formation?.description_html || "";
let detailHtml = richHtml || (intro ? (marked.parse(intro, { async: false }) as string) : "");
// Dé-duplication : si « Ce que vous apprendrez » est affiché (learnItems), on retire la
// section « Au programme » de la prose pour ne pas répéter la même liste deux fois.
if (learnItems.length > 0 && richHtml) {
  detailHtml = detailHtml.replace(/<h[1-6][^>]*>\s*au programme[\s\S]*$/i, "").trim();
}

function badgeInfo(badge: string | null, salesEnd: string | null) {
  if (badge === "hot") return { cls: "hot", label: "📈 Forte demande" };
  if (badge === "limited") return { cls: "limited", label: salesEnd ? `⏱ Jusqu'au ${frDateShort(salesEnd)}` : "⏱ Places limitées" };
  if (badge === "ok") return { cls: "ok", label: "Avantageux" };
  return null;
}

const dNum = (s: string) => new Date(s).getDate();
const mShort = (s: string) => {
  const m = new Date(s).toLocaleDateString("fr-FR", { month: "short" }).replace(".", "");
  return m.charAt(0).toUpperCase() + m.slice(1);
};

const mapQuery = `${(session?.venue ?? "").split("·").pop()?.trim() || session?.city || "Abidjan"}, Côte d'Ivoire`;
const mapEmbed = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&output=embed`;
const shareUrl = Astro.url.href;

// Données structurées Schema.org — rich results Google (date, lieu, prix, disponibilité).
const maxPrice = tickets.length ? Math.max(...tickets.map((t: any) => t.price)) : null;
const eventLd = session
  ? {
      "@context": "https://schema.org",
      "@type": "EducationEvent",
      name: session.title,
      description:
        session.seo_description || formation?.summary ||
        (online
          ? `Formation en ligne (visioconférence) le ${frDateLong(session.starts_at)}.`
          : hybrid
          ? `Formation en présentiel à Abidjan et en ligne le ${frDateLong(session.starts_at)}.`
          : `Formation en présentiel à Abidjan le ${frDateLong(session.starts_at)}.`),
      startDate: session.starts_at,
      eventAttendanceMode: online
        ? "https://schema.org/OnlineEventAttendanceMode"
        : hybrid
        ? "https://schema.org/MixedEventAttendanceMode"
        : "https://schema.org/OfflineEventAttendanceMode",
      eventStatus: "https://schema.org/EventScheduled",
      ...(session.image_url ? { image: [session.image_url] } : {}),
      location: online
        ? { "@type": "VirtualLocation", url: shareUrl }
        : (() => {
            const place = {
              "@type": "Place",
              name: session.venue || "Espace de formation Bweb",
              address: { "@type": "PostalAddress", addressLocality: session.city || "Abidjan", addressCountry: "CI" },
            };
            return hybrid ? [place, { "@type": "VirtualLocation", url: shareUrl }] : place;
          })(),
      organizer: { "@type": "Organization", name: site.name, url: site.url },
      ...(minPrice !== null
        ? {
            offers: {
              "@type": "AggregateOffer",
              priceCurrency: "XOF",
              lowPrice: minPrice,
              highPrice: maxPrice,
              offerCount: tickets.length,
              availability: isFull ? "https://schema.org/SoldOut" : "https://schema.org/InStock",
              url: shareUrl,
            },
          }
        : {}),
    }
  : null;

// Schéma Course avec note agrégée (étoiles dans les résultats Google) — seulement si avis.
const courseLd = session && reviewCount
  ? {
      "@context": "https://schema.org",
      "@type": "Course",
      name: formation?.title || session.title,
      description:
        session.seo_description || formation?.summary ||
        `Formation en présentiel à Abidjan.`,
      provider: { "@type": "Organization", name: site.name, url: site.url },
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: reviewAvg,
        reviewCount,
        bestRating: 5,
        worstRating: 1,
      },
      hasCourseInstance: {
        "@type": "CourseInstance",
        courseMode: online ? "Online" : hybrid ? "Blended" : "Onsite",
        startDate: session.starts_at,
        location: online
          ? { "@type": "VirtualLocation", url: shareUrl }
          : {
              "@type": "Place",
              name: session.venue || "Espace de formation Bweb",
              address: { "@type": "PostalAddress", addressLocality: session.city || "Abidjan", addressCountry: "CI" },
            },
        ...(minPrice !== null
          ? { offers: { "@type": "Offer", price: minPrice, priceCurrency: "XOF", availability: isFull ? "https://schema.org/SoldOut" : "https://schema.org/InStock", url: shareUrl } }
          : {}),
      },
    }
  : null;
const ck = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>`;
---

{session ? (
  <BaseLayout
    title={session.seo_title || `${session.title} — ${frDateShort(session.starts_at)} | Formations Bweb`}
    description={session.seo_description || formation?.summary || (online ? `Formation en ligne (visioconférence) le ${frDateLong(session.starts_at)}.` : hybrid ? `Formation en présentiel à Abidjan et en ligne le ${frDateLong(session.starts_at)}.` : `Session de formation en présentiel à Abidjan le ${frDateLong(session.starts_at)}.`)}
    image={session.image_url || undefined}
    noindex={isPast}
  >
    {eventLd && <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(eventLd)} />}
    {courseLd && <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(courseLd)} />}
    <article class="section" style="padding-top:calc(var(--header-h) + var(--space-lg))">
      <div class="container">
        <a class="sess-back" href="/formations/calendrier">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M15 18l-6-6 6-6" /></svg>
          Retour au calendrier
        </a>

        {isPast && (
          <div class="sess-past" role="status">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            <span>Cette session est <b>passée</b>. Découvrez les prochaines dates au <a href="/formations/calendrier">calendrier</a>.</span>
          </div>
        )}

        <div class="sess-layout">
          <!-- ===== Titre (col. gauche, ligne 1) ===== -->
          <div class="sess-head">
            <div class="sess-eyebrows">
              {session.theme && <span class="eyebrow">{session.theme} · {sessModeLabel}</span>}
              {sessLevel && <span class={`sess-level ${levelSlug}`}>{sessLevel}</span>}
            </div>
            <h1 style="font-family:var(--f-display);font-weight:800;font-size:var(--fs-h1);line-height:1.08;letter-spacing:-.02em;margin:8px 0 10px;color:var(--c-ink)">{session.title}</h1>
            {formation?.summary && <p class="sess-desc" style="max-width:60ch">{formation.summary}</p>}

            <div class="sess-meta">
              <span class="m"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg>{frDateLong(session.starts_at)} · {frTime(session.starts_at)}</span>
              <span class="m"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 19a5.6 5.6 0 0 1 11 0"/></svg>{isPast ? "Session passée" : isFull ? "Session complète" : `${totalRemaining} places restantes`}</span>
              {showVenue && (
                <span class="m"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6-7-11a7 7 0 0 1 14 0c0 5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>{session.venue ?? "Espace Bweb · Cocody"}, {session.city ?? "Abidjan"}</span>
              )}
              {showOnline && (
                <span class="m"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="15" height="13" rx="2"/><path d="M17 9l5-3v11l-5-3z"/></svg>En ligne · Visioconférence</span>
              )}
            </div>
          </div>

          <!-- ===== Contenu (col. gauche, ligne 2) ===== -->
          <div class="sess-main">
            {learnItems.length > 0 && (
              <div class="learn-box">
                <h2>Ce que vous apprendrez</h2>
                <ul class="learn-grid">
                  {learnItems.map((it) => (
                    <li><Fragment set:html={ck} />{it}</li>
                  ))}
                </ul>
              </div>
            )}

            {detailHtml && (
              <>
                <h2 class="sectitle">À propos de cette formation</h2>
                <div class="sess-prose" set:html={detailHtml} />
              </>
            )}

            {(formation?.audience || formation?.prerequisites) && (
              <>
                <h2 class="sectitle">À qui s'adresse cette formation</h2>
                <div class="audience-grid">
                  {formation?.audience && (
                    <div class="ag-card">
                      <div class="ag-h"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 5.5a3 3 0 0 1 0 5.5M22 20a6.5 6.5 0 0 0-4-6"/></svg>Public visé</div>
                      <p>{formation.audience}</p>
                    </div>
                  )}
                  {formation?.prerequisites && (
                    <div class="ag-card">
                      <div class="ag-h"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>Prérequis</div>
                      <p>{formation.prerequisites}</p>
                    </div>
                  )}
                </div>
              </>
            )}

            {formation?.instructor_name && (formation.instructor_bio || formation.instructor_photo_url) && (
              <>
                <h2 class="sectitle">Votre formateur</h2>
                <div class="instructor">
                  {formation.instructor_photo_url && <img class="instructor__photo" src={formation.instructor_photo_url} alt={formation.instructor_name} loading="lazy" />}
                  <div class="instructor__body">
                    <div class="instructor__name">{formation.instructor_name}</div>
                    {formation.instructor_role && <div class="instructor__role">{formation.instructor_role}</div>}
                    {formation.instructor_bio && <p class="instructor__bio">{formation.instructor_bio}</p>}
                  </div>
                </div>
              </>
            )}

            <h2 class="sectitle">Infos pratiques</h2>
            <div class="info-grid">
              <div class="c"><div class="k">Durée</div><div class="v">{formation?.duration ?? "—"}</div></div>
              <div class="c"><div class="k">Niveau</div><div class="v">{levelText}</div></div>
              <div class="c"><div class="k">Formateur</div><div class="v">{formation?.instructor_name ?? "Expert Bweb"}{formation?.instructor_role && <span class="isub">{formation.instructor_role}</span>}</div></div>
              <div class="c"><div class="k">Langue</div><div class="v">Français</div></div>
              <div class="c"><div class="k">Format</div><div class="v">{sessModeLabel}</div></div>
              <div class="c"><div class="k">Places</div><div class="v">{totalCap} max.</div></div>
            </div>

            {showOnline && (
              <>
                <h2 class="sectitle">Se connecter à la session</h2>
                <div class="meet-box">
                  <div class="meet-box__head">
                    <span class="meet-box__ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="15" height="13" rx="2"/><path d="M17 9l5-3v11l-5-3z"/></svg></span>
                    <div>
                      <div class="meet-box__title">Formation en visioconférence</div>
                      <div class="meet-box__sub">Suivez la session en direct, où que vous soyez.</div>
                    </div>
                  </div>
                  {meetingInfo && <p class="meet-box__info">{meetingInfo}</p>}
                  {meetingUrl ? (
                    <a class="btn btn-primary" href={meetingUrl} target="_blank" rel="noopener">
                      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="15" height="13" rx="2"/><path d="M17 9l5-3v11l-5-3z"/></svg>
                      Rejoindre la visioconférence
                    </a>
                  ) : (
                    <p class="meet-box__note">🔗 Le lien de connexion vous sera envoyé par e-mail et WhatsApp après votre inscription.</p>
                  )}
                </div>
              </>
            )}

            {showVenue && (
              <>
                <h2 class="sectitle">Lieu sur carte</h2>
                <div class="map-facade" id="map-facade" data-src={mapEmbed} data-title="Lieu de la formation">
                  <div class="map-facade__info">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 11-8 11s-8-5-8-11a8 8 0 0116 0z"/><circle cx="12" cy="10" r="2.6"/></svg>
                    <div>
                      <div class="mf-place">{session.venue ?? "Espace de formation Bweb · Cocody"}</div>
                      {(session as any).address && <div class="mf-addr">{(session as any).address}</div>}
                      <div class="mf-city">{session.city ?? "Abidjan"}, Côte d'Ivoire</div>
                    </div>
                  </div>
                  <button type="button" class="btn btn-outline map-facade__btn" id="map-load">Afficher la carte</button>
                  <p class="map-facade__note">La carte est fournie par Google Maps. En l'affichant, vous acceptez le dépôt de cookies Google.</p>
                </div>
              </>
            )}

            {session.formation_id && (
              <>
                <h2 class="sectitle">Avis des participants</h2>
                <div class="reviews">
                  {reviewCount > 0 ? (
                    <div class="reviews__head">
                      <span class="rv-avg">{reviewAvg.toFixed(1).replace(".", ",")}</span>
                      <span class="rv-stars" aria-hidden="true">{stars(reviewAvg)}</span>
                      <span class="rv-count">{reviewCount} avis</span>
                    </div>
                  ) : (
                    <p class="reviews__empty">Pas encore d'avis — soyez le premier à partager votre expérience.</p>
                  )}

                  {reviewCount > 0 && (
                    <div class="reviews__list">
                      {reviews.map((r) => (
                        <figure class="rv-item">
                          <div class="rv-stars sm" aria-label={`${r.rating} sur 5`}>{stars(r.rating)}</div>
                          <blockquote>{r.comment}</blockquote>
                          <figcaption>{r.author_name}{r.author_role && <span> · {r.author_role}</span>}</figcaption>
                        </figure>
                      ))}
                    </div>
                  )}

                  <details class="rv-form-wrap">
                    <summary>Laisser un avis</summary>
                    <form class="rv-form" id="rv-form" data-formation={session.formation_id} data-session={session.id}>
                      <div class="rv-field">
                        <label>Votre note *</label>
                        <div class="rv-rate" id="rv-rate" role="radiogroup" aria-label="Note sur 5">
                          {[1, 2, 3, 4, 5].map((n) => (
                            <button type="button" class="rv-star" data-n={n} aria-label={`${n} étoile${n > 1 ? "s" : ""}`}>★</button>
                          ))}
                        </div>
                      </div>
                      <div class="rz-2col">
                        <div class="rv-field"><label for="rv-name">Nom *</label><input class="rz-input" id="rv-name" maxlength="80" required /></div>
                        <div class="rv-field"><label for="rv-role">Rôle / activité (optionnel)</label><input class="rz-input" id="rv-role" maxlength="80" /></div>
                      </div>
                      <div class="rv-field"><label for="rv-comment">Votre avis *</label><textarea class="rz-input" id="rv-comment" rows="3" maxlength="1000" required></textarea></div>
                      <button type="submit" class="btn btn-primary" id="rv-submit">Envoyer mon avis</button>
                      <p class="rv-msg" id="rv-msg" hidden></p>
                    </form>
                  </details>
                </div>
              </>
            )}

            {faqs.length > 0 && (
              <>
                <h2 class="sectitle">Questions fréquentes</h2>
                <div class="faq">
                  {faqs.map((f, i) => (
                    <details class="faq-item" open={i === 0}>
                      <summary>{f.question}</summary>
                      <div class="faq-answer" set:html={marked.parse(f.answer_md, { async: false }) as string} />
                    </details>
                  ))}
                </div>
              </>
            )}

            <h2 class="sectitle">Une question avant de vous inscrire ?</h2>
            <div class="ask-box">
              <p>Notre équipe vous répond directement sur WhatsApp — programme détaillé, prérequis, facture, paiement en plusieurs fois…</p>
              <a class="btn btn-primary" target="_blank" rel="noopener"
                href={`https://wa.me/${contact.whatsapp.primary}?text=${encodeURIComponent("Bonjour Bweb Agence, j'ai une question sur la formation « " + session.title + " » du " + frDateLong(session.starts_at) + ".")}`}>
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 00-8.6 15l-1.3 4.8 4.9-1.3A10 10 0 1012 2zm5.6 14.2c-.2.6-1.2 1.2-1.7 1.2-.4.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.5-2.6-1.1-4.3-3.8-4.4-4-.1-.2-1-1.4-1-2.6 0-1.2.6-1.8.9-2 .2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.4.5c-.2.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2 1.3 2.3 1.5.2.1.4.1.5-.1l.7-.8c.2-.2.3-.2.6-.1l1.8.9c.3.1.4.2.5.3.1.2.1.7-.1 1.3z"/></svg>
                Poser ma question
              </a>
            </div>

            {nextSessions.length > 0 && (
              <>
                <h2 class="sectitle">Autres dates pour cette formation</h2>
                <div class="next-list">
                  {nextSessions.map((n: any) => (
                    <a class="next-item" href={`/formations/session/${n.slug}`}>
                      <span class="ni-date"><span class="d">{dNum(n.starts_at)}</span><span class="m">{mShort(n.starts_at)}</span></span>
                      <span class="ni-body">
                        <span class="ni-title">{n.title}</span>
                        <span class="ni-meta">{frDateLong(n.starts_at)} · {frTime(n.starts_at)}{n.status === "full" ? " · Complet" : ""}</span>
                      </span>
                      <svg class="ni-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
                    </a>
                  ))}
                </div>
              </>
            )}

            <h2 class="sectitle">Partager cette formation</h2>
            <div class="share-row">
              <a class="share-wa" target="_blank" rel="noopener" href={`https://wa.me/?text=${encodeURIComponent(session.title + " " + shareUrl)}`}>WhatsApp</a>
              <a class="share-fb" target="_blank" rel="noopener" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`}>Facebook</a>
              <a class="share-x" target="_blank" rel="noopener" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(session.title)}&url=${encodeURIComponent(shareUrl)}`}>X</a>
              <a class="share-in" target="_blank" rel="noopener" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`}>LinkedIn</a>
            </div>
          </div>

          <!-- ===== Carte d'achat (collante) ===== -->
          <aside class="sess-aside">
            <div class="buy-card" data-grad={gradSuffix(session.theme)}>
              <div class={`buy-card__media ev-media ${gradClass(session.theme)}`}>
                {session.image_url && <img src={session.image_url} alt="" />}
                <span class="ev-scrim"></span>
                {session.theme && <span class="ev-theme"><span class="dot"></span>{session.theme}</span>}
                <button type="button" class="ev-fav" id="fav" data-session-id={session.id} aria-label="Ajouter aux favoris">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.6-9.5-9C.7 8.4 2.4 5 5.8 5c2 0 3.3 1.1 4.2 2.4C11 6.1 12.2 5 14.2 5c3.4 0 5.1 3.4 3.3 7-2.5 4.4-9.5 9-9.5 9z"/></svg>
                  <span class="fav-count">{session.likes_count}</span>
                </button>
                <div class="ev-date"><span class="d">{dNum(session.starts_at)}</span><span class="m">{mShort(session.starts_at)}</span></div>
                {isPast ? (
                  <span class="ev-sold ev-sold--past">Passée</span>
                ) : isFull ? (
                  <span class="ev-sold">Complet</span>
                ) : minCompareAt ? (
                  <span class="ev-promo">−{minDiscountPct}%</span>
                ) : null}
              </div>
              <div class="buy-card__pad">
                <div class="buy-card__when">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg>
                  {frDateLong(session.starts_at)} · {frTime(session.starts_at)}
                </div>
                {minPrice !== null && (
                  <div class={`buy-card__price ${minCompareAt ? "has-promo" : ""}`}>
                    <span class="bcp-line">À partir de <b>{priceFCFA(minPrice)}</b>{minCompareAt && <span class="bcp-off">−{minDiscountPct}%</span>}</span>
                    {minCompareAt && <span class="bcp-was">{priceFCFA(minCompareAt)}</span>}
                  </div>
                )}
                {!isPast && earlyDeadline && (
                  <p class="buy-card__early">⏱ Tarif anticipé jusqu'au <b>{frDateShort(earlyDeadline)}</b></p>
                )}
                {!isPast && !isFull && <p class="buy-card__note">💺 Plus que <strong>{totalRemaining}</strong> places pour cette session.</p>}
                {isPast ? (
                  <a class="btn btn-outline btn-block btn-lg" href="/formations/calendrier">Voir les prochaines sessions</a>
                ) : isFull ? (
                  <a class="btn btn-outline btn-block btn-lg" href={`https://wa.me/${contact.whatsapp.primary}?text=${encodeURIComponent("Bonjour, je souhaite être sur la liste d'attente pour « " + session.title + " » du " + frDateLong(session.starts_at) + ".")}`} target="_blank" rel="noopener">Rejoindre la liste d'attente</a>
                ) : (
                  <button type="button" class="btn btn-primary btn-block btn-lg btn-shine" id="open-rz"><span class="btn-shine__label">Réserver ma place</span></button>
                )}
                <div class="buy-includes-title">Cette formation comprend :</div>
                <ul class="buy-includes">
                  <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg><span><b>{formation?.duration ?? "Session"}</b> {online ? "en visioconférence" : hybrid ? "en présentiel ou en ligne" : "en présentiel"}</span></li>
                  <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/></svg>Groupe limité à <b>{totalCap} participants</b></li>
                  <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="6"/><path d="M8.5 13.5L7 22l5-3 5 3-1.5-8.5"/></svg><b>Attestation</b> de fin de formation</li>
                  <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h12l4 4v12H4z"/><path d="M8 9h6M8 13h8M8 17h5"/></svg><b>Support</b> de formation fourni</li>
                  <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 4 5.8 4 9s-1.5 6.4-4 9c-2.5-2.6-4-5.8-4-9s1.5-6.4 4-9z"/></svg>Formation en <b>français</b></li>
                  {formation?.included_extra && formation.included_extra.split("\n").map((l) => l.trim()).filter(Boolean).map((l) => (
                    <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg><span>{l}</span></li>
                  ))}
                </ul>
                <p class="buy-card__secure">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                  Paiement mobile sécurisé (Wave · Orange Money · MoMo) · place bloquée dès le justificatif reçu.
                </p>
              </div>
            </div>
          </aside>
        </div>
      </div>

      <!-- ===================== MODALE RÉSERVATION ===================== -->
      <div class="rz-overlay" id="rz" role="dialog" aria-modal="true" aria-label="Réserver votre place"
        data-wa={contact.whatsapp.primary} data-phone={contact.phoneDisplay}
        data-title={session.title} data-date={frDateLong(session.starts_at)} data-session={session.id}
        data-mode={sessMode ?? "presentiel"} data-pay-api={import.meta.env.PAYMENT_API_URL}>
        <div class="rz-top">
          <div class="rz-top-brand">
            <img class="rz-logo" src="/images/logo.svg" alt="Bweb Agence" width="120" height="28" />
            <span class="rz-title">{session.title} · {frDateShort(session.starts_at)}</span>
          </div>
          <button type="button" class="rz-close" id="rz-close" aria-label="Fermer">✕</button>
        </div>
        <div class="rz-progress" id="rz-progress">
          <div class="p active" data-p="1">Tarif<span class="bar"></span></div>
          <div class="p" data-p="2">Vos infos<span class="bar"></span></div>
          <div class="p" data-p="3">Paiement<span class="bar"></span></div>
          <div class="p" data-p="4">Justificatif<span class="bar"></span></div>
        </div>

        <div class="rz-scroll" data-lenis-prevent>
          <div class="rz-container">
            <!-- Étape 1 : tarifs -->
            <section class="rz-step active" data-step="1">
              {hybrid && (
                <div class="rz-attend" id="rz-attend">
                  <h2 class="rz-h">Comment souhaitez-vous participer ?</h2>
                  <p class="rz-sub">Cette session se tient en présentiel et en ligne — choisissez votre mode.</p>
                  <div class="rz-attend-grid" role="radiogroup" aria-label="Mode de participation">
                    <button type="button" class="rz-attend-opt" data-attend="presentiel" aria-pressed="false">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 11-8 11s-8-5-8-11a8 8 0 0116 0z"/><circle cx="12" cy="10" r="2.6"/></svg>
                      <span class="rz-attend-txt"><span class="rz-attend-t">Sur place</span><span class="rz-attend-s">{session.venue ?? "Espace Bweb · Cocody"}</span></span>
                    </button>
                    <button type="button" class="rz-attend-opt" data-attend="en_ligne" aria-pressed="false">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="15" height="13" rx="2"/><path d="M17 9l5-3v11l-5-3z"/></svg>
                      <span class="rz-attend-txt"><span class="rz-attend-t">En ligne</span><span class="rz-attend-s">Visioconférence en direct</span></span>
                    </button>
                  </div>
                </div>
              )}
              <h2 class="rz-h">Réservez une place</h2>
              <p class="rz-sub">Sélectionnez le nombre de places par tarif.</p>
              <div class="ticket-grid" style="grid-template-columns:1fr">
                {tickets.map((t: any) => {
                  const remaining = Math.max(0, t.capacity - t.sold);
                  const featured = t.badge === "popular";
                  const bi = badgeInfo(t.badge, t.sales_end);
                  const promo = ttPromo(t);
                  return (
                    <div class={`ticket ${featured ? "featured" : ""}`} data-ticket data-id={t.id} data-name={t.name} data-price={t.price} data-remaining={remaining}>
                      {featured && <span class="t-ribbon"><svg viewBox="0 0 24 24" fill="currentColor" width="11" height="11"><path d="M12 2l2.9 6.3 6.9.6-5.2 4.6 1.6 6.7L12 17.3 5.8 20.8l1.6-6.7L2.2 8.9l6.9-.6z"/></svg>Le plus choisi</span>}
                      <div class="t-row">
                        <div class="t-info">
                          <div class="t-name-row">
                            <span class="tn">{t.name}</span>
                            {bi && <span class={`t-badge ${bi.cls}`}>{bi.label}</span>}
                            {remaining > 0 && remaining <= 3 && <span class="t-left">🔥 Plus que {remaining}</span>}
                          </div>
                          <div class={`tp ${promo ? "has-promo" : ""}`}>{priceFCFA(t.price)}{promo && <span class="tp-was">{priceFCFA(promo.compareAt)}</span>}{promo && <span class="tp-off">−{promo.pct}%</span>}</div>
                        </div>
                        {remaining <= 0 ? <span class="t-soldout">Épuisé</span> : (
                          <div class="stepper" data-stepper>
                            <button type="button" data-dec aria-label="Retirer">−</button>
                            <span class="val" data-val>0</span>
                            <button type="button" data-inc aria-label="Ajouter">+</button>
                          </div>
                        )}
                      </div>
                    </div>
                  );
                })}
              </div>

              {orderBumps.length > 0 && (
                <div class="rz-bumps" id="rz-bumps">
                  <div class="rz-bumps-lead"><span class="ob-spark" aria-hidden="true">✨</span> Complétez votre parcours — offre spéciale</div>
                  {orderBumps.map((b) => (
                    <label class="ob-card" data-bump data-id={b.ticketTypeId} data-price={b.price} data-name={b.ticketName}>
                      <input type="checkbox" class="ob-check" aria-label={`Ajouter ${b.name}`} />
                      <span class="ob-box" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
                      {b.image && <img class="ob-thumb" src={b.image} alt="" loading="lazy" />}
                      <span class="ob-main">
                        <span class="ob-head">
                          {b.badge && <span class="ob-badge">{b.badge}</span>}
                          {b.headline && <span class="ob-kicker">{b.headline}</span>}
                        </span>
                        <span class="ob-title">{b.name}</span>
                        {b.description && <span class="ob-desc">{b.description}</span>}
                        <span class="ob-price">
                          <span class="ob-add">+ {priceFCFA(b.price)}</span>
                          {b.compareAt && <s class="ob-was">{priceFCFA(b.compareAt)}</s>}
                          {b.compareAt && <span class="ob-off">−{bumpPct(b.price, b.compareAt)}%</span>}
                        </span>
                      </span>
                      <span class="ob-cta" aria-hidden="true">Ajouter</span>
                    </label>
                  ))}
                </div>
              )}

              <div class="rz-summary">
                <div id="rz-lines"><div class="row muted"><span>Aucune place sélectionnée</span></div></div>
                <div class="row tot"><span>Total</span><b id="rz-total">0 F CFA</b></div>
              </div>
            </section>

            <!-- Étape 2 : informations -->
            <section class="rz-step" data-step="2">
              <h2 class="rz-h">Vos informations</h2>
              <p class="rz-sub">Pour établir votre inscription et votre attestation.</p>
              <div class="rz-field"><label for="rz-name">Nom complet *</label><input class="rz-input" id="rz-name" name="name" autocomplete="name" required /></div>
              <div class="rz-2col">
                <div class="rz-field"><label for="rz-email">E-mail *</label><input class="rz-input" id="rz-email" name="email" type="email" autocomplete="email" required /></div>
                <div class="rz-field"><label for="rz-phone">Téléphone / WhatsApp *</label><PhoneField id="rz-phone" /></div>
              </div>
              <div class="rz-note-pay" style="font-size:.82rem;color:#7a5200;background:#fff8ea;border:1px solid #ffe1a3;border-radius:10px;padding:9px 12px;margin:2px 0 10px">📱 Le <b>numéro de téléphone</b> ci-dessus est celui qui servira à <b>valider votre paiement Mobile Money</b>. Indiquez bien le numéro depuis lequel vous réglerez.</div>
              <div class="rz-field"><label for="rz-company">Entreprise / organisation (optionnel)</label><input class="rz-input" id="rz-company" name="company" /></div>
            </section>

            <!-- Étape 3 : paiement -->
            <section class="rz-step" data-step="3">
              <h2 class="rz-h">Réserver avec acompte</h2>
              <p class="rz-sub">Réglez l'acompte de 50 % en ligne pour bloquer votre place — le solde se paie sur place le jour J.</p>
              <div class="pm-grid" id="pm-grid">
                <div class="pm pm-online sel" data-method="money_fusion" style="grid-column:1/-1;border-color:var(--c-green,#00c89e);cursor:default">
                  <span class="lg" style="background:var(--c-green,#00c89e);color:#fff">🔒</span>
                  <span>Acompte 50 % en ligne<span class="sub">Mobile Money · Wave · carte — solde sur place</span></span>
                </div>
              </div>
              <div class="pay-note" id="pm-note" style="display:none"></div>
            </section>

            <!-- Étape 4 : justificatif -->
            <section class="rz-step" data-step="4">
              <h2 class="rz-h">Justificatif de paiement</h2>
              <p class="rz-sub">Après avoir payé, indiquez la référence et joignez la capture. Votre place est bloquée immédiatement.</p>
              <div class="rz-field"><label for="rz-ref">Référence de la transaction</label><input class="rz-input" id="rz-ref" name="reference" placeholder="Ex. TXN-WAVE-83920145" /></div>
              <label class="rz-upload" id="rz-upload-label">
                📎 Déposer la capture d'écran du paiement
                <span class="sub" id="rz-upload-sub">JPG ou PNG</span>
                <input type="file" id="rz-file" accept="image/*" />
              </label>
              <label class="rz-check"><input type="checkbox" id="rz-confirm" /> <span>Je confirme avoir effectué le paiement (ou l'acompte pour un règlement sur place).</span></label>
              <div class="rz-summary" id="rz-summary2"></div>
            </section>

            <!-- Étape 5 : confirmation -->
            <section class="rz-step" data-step="5">
              <div class="rz-success">
                <div class="ic">✓</div>
                <h2 class="rz-h" id="rz-success-title">Inscription enregistrée !</h2>
                <p class="rz-sub" id="rz-success-sub">Votre place est réservée.</p>
                <div class="ref" id="rz-ref-out"></div>
                <div class="rz-wait-note" id="rz-wait-note">Votre paiement va être vérifié par notre équipe. Vous recevrez un e-mail de confirmation dès validation.</div>
              </div>
            </section>

            <div class="rz-foot">
              <button type="button" class="btn btn-ghost" id="rz-prev" style="display:none">‹ Précédent</button>
              <button type="button" class="btn btn-primary btn-lg btn-shine" id="rz-next"><span class="btn-shine__label">Continuer ›</span></button>
              <a class="btn btn-primary btn-lg" id="rz-done" href="/formations/calendrier" style="display:none">Terminer</a>
              <span class="rz-err" id="rz-err"></span>
            </div>
          </div>
        </div>
      </div>
    </article>
  </BaseLayout>
) : (
  <BaseLayout title="Session introuvable | Bweb Agence" noindex={true}>
    <section class="section" style="padding-top:calc(var(--header-h) + var(--space-xl))">
      <div class="container" style="text-align:center">
        <div class="eyebrow" style="justify-content:center">Erreur 404</div>
        <h1>Cette session n'existe pas (ou plus).</h1>
        <p class="lead">Elle est peut-être passée ou complète. Voir les prochaines sessions au calendrier.</p>
        <p style="margin-top:var(--space-md)"><a class="btn btn-primary" href="/formations/calendrier">Voir le calendrier</a></p>
      </div>
    </section>
  </BaseLayout>
)}

<script>
  import { initReservation } from "../../../scripts/reservation";
  initReservation();

  // Carte Google Maps chargée au clic (RGPD : pas de cookie tiers avant consentement).
  const mf = document.getElementById("map-facade");
  document.getElementById("map-load")?.addEventListener("click", () => {
    if (!mf) return;
    const iframe = document.createElement("iframe");
    iframe.className = "map-embed";
    iframe.title = mf.dataset.title || "Lieu de la formation";
    iframe.loading = "lazy";
    iframe.referrerPolicy = "no-referrer-when-downgrade";
    iframe.src = mf.dataset.src || "";
    mf.replaceWith(iframe);
  });

  // Formulaire « Laisser un avis »
  import("../../../lib/supabaseBrowser").then(({ supabaseBrowser }) => {
    const form = document.getElementById("rv-form") as HTMLFormElement | null;
    if (!form) return;
    const rate = document.getElementById("rv-rate")!;
    const msg = document.getElementById("rv-msg") as HTMLElement;
    const submit = document.getElementById("rv-submit") as HTMLButtonElement;
    let rating = 0;
    const stars = Array.from(rate.querySelectorAll<HTMLButtonElement>(".rv-star"));
    const paint = (v: number) => stars.forEach((s, i) => s.classList.toggle("on", i < v));
    stars.forEach((s) => {
      s.addEventListener("click", () => { rating = Number(s.dataset.n); paint(rating); });
      s.addEventListener("mouseenter", () => paint(Number(s.dataset.n)));
    });
    rate.addEventListener("mouseleave", () => paint(rating));

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const name = (document.getElementById("rv-name") as HTMLInputElement).value.trim();
      const role = (document.getElementById("rv-role") as HTMLInputElement).value.trim();
      const comment = (document.getElementById("rv-comment") as HTMLTextAreaElement).value.trim();
      const show = (text: string, ok: boolean) => { msg.textContent = text; msg.hidden = false; msg.className = "rv-msg " + (ok ? "ok" : "err"); };
      if (!rating) return show("Merci d'indiquer une note.", false);
      if (name.length < 2) return show("Merci d'indiquer votre nom.", false);
      if (comment.length < 5) return show("Votre avis est un peu court.", false);
      submit.disabled = true; submit.textContent = "Envoi…";
      const { error } = await supabaseBrowser.rpc("submit_review", {
        p_formation_id: form.dataset.formation || null,
        p_session_id: form.dataset.session || null,
        p_author_name: name, p_author_role: role || null, p_rating: rating, p_comment: comment,
      });
      submit.disabled = false; submit.textContent = "Envoyer mon avis";
      if (error) { show("Envoi impossible pour le moment. Réessayez.", false); return; }
      form.reset(); rating = 0; paint(0);
      show("Merci ! Votre avis sera publié après validation. ✓", true);
    });
  });
</script>
