                      </button>
                      <div class="month-pop" id="month-pop" role="dialog" aria-label="Choisir une date" hidden>
                        <div class="mp-head">
                          <button type="button" class="mp-nav" id="mp-prev" aria-label="Mois précédent">‹</button>
                          <span id="mp-label">—</span>
                          <button type="button" class="mp-nav" id="mp-next" aria-label="Mois suivant">›</button>
                        </div>
                        <div class="mp-dow"><span>L</span><span>M</span><span>M</span><span>J</span><span>V</span><span>S</span><span>D</span></div>
                        <div class="mp-days" id="mp-days"></div>
                        <button type="button" class="mp-reset" id="mp-reset">Toutes les dates</button>
                      </div>
                    </div>
                  </div>

                  <div class="fg-section fg-section--row fg-section--wide">
                    <span class="fg-label">Disponibilité</span>
                    <button type="button" class="fchip" id="dispo-btn"><span class="fchip__knob"></span>Places disponibles</button>
                  </div>
                </div>

                <div class="fg-foot">
                  <button type="button" class="fg-reset" id="fg-reset">Réinitialiser</button>
                  <button type="button" class="fg-apply" id="fg-apply">Voir les résultats</button>
                </div>
              </div>
            </div>

            <div class="cal-toolbar-right" id="cal-sort-wrap">
              <label class="sort-field" for="sort-select">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h12M3 12h9M3 18h6M17 5v14M17 19l3-3M17 19l-3-3"/></svg>
                <span class="sort-lbl">Trier</span>
                <select id="sort-select" class="sort-select" aria-label="Trier les sessions">
                  <option value="date">Date : plus proche</option>
                  <option value="new">Nouveautés</option>
                  <option value="price-asc">Prix croissant</option>
                  <option value="price-desc">Prix décroissant</option>
                  <option value="rating">Mieux notées</option>
                </select>
              </label>
            </div>

            <div class="fg-backdrop" id="fg-backdrop" hidden></div>
          </div>

          <script type="application/json" id="cal-data" set:html={JSON.stringify(calData)}></script>

          <div class="ev-grid" id="ev-grid">
            {sessions.map((s, i) => {
              const d = derive(s);
              const rt = ratingOf(s.formation_id);
              return (
                <article
                  class="ev-card"
                  data-theme={s.theme ?? ""}
                  data-grad={gradSuffix(s.theme, tmap)}
                  data-date={dateISO(s.starts_at)}
                  data-full={d.full ? "1" : "0"}
                  data-level={s.level ?? ""}
                  data-mode={s.mode ?? "presentiel"}
                  data-idx={i}
                  data-price={d.minPrice ?? ""}
                  data-created={s.created_at}
                  data-rating={rt.avg}
                  data-reviews={rt.n}
                >
                  <div class={`ev-media ${gradClass(s.theme, tmap)}`}>
                    {s.image_url && <img src={s.image_url} alt="" loading="lazy" />}
                    <span class="ev-scrim"></span>
                    <div class="ev-tags">
                      {s.theme && <span class="ev-theme"><span class="dot"></span>{s.theme}</span>}
                      {levelLabel(s.level) && <span class={`ev-level ${s.level}`}>{levelLabel(s.level)}</span>}
                    </div>
                    <button type="button" class="ev-fav" data-session-id={s.id} aria-label="Ajouter aux favoris">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.6-9.5-9C.7 8.4 2.4 5 5.8 5c2 0 3.3 1.1 4.2 2.4C11 6.1 12.2 5 14.2 5c3.4 0 5.1 3.4 3.3 7-2.5 4.4-9.5 9-9.5 9z"/></svg>
                      <span class="fav-count">{s.likes_count}</span>
                    </button>
                    <div class="ev-date"><span class="d">{dayNum(s.starts_at)}</span><span class="m">{monthShort(s.starts_at)}</span></div>
                    {d.full ? (
                      <span class="ev-sold">Complet</span>
                    ) : d.compareAt && (
                      <span class="ev-promo">−{d.discountPct}%</span>
                    )}
                  </div>

                  <div class="ev-fold"><span class="dash"></span></div>

                  <div class="ev-body">
                    <h3 class="ev-title">{s.title}</h3>
                    <div class="ev-meta">
                      <div class="r">
                        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                        {weekdayLine(s.starts_at)} · {frTime(s.starts_at)}
                      </div>
                      <div class="r">
                        {isOnline(s.mode) ? (
                          <>
                            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="15" height="13" rx="2"/><path d="M17 9l5-3v11l-5-3z"/></svg>
                            En ligne · Visioconférence
                          </>
                        ) : isHybrid(s.mode) ? (
                          <>
                            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="15" height="13" rx="2"/><path d="M17 9l5-3v11l-5-3z"/></svg>
                            Présentiel &amp; en ligne
                          </>
                        ) : (
                          <>
                            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 11-8 11s-8-5-8-11a8 8 0 0116 0z"/><circle cx="12" cy="10" r="2.6"/></svg>
                            {s.venue ?? "Espace de formation Bweb · Cocody"}
                          </>
                        )}
                      </div>
                    </div>

                    {d.minPrice !== null && (
                      <div class={`ev-price ${d.compareAt ? "has-promo" : ""}`}>
                        <div class="pr-line">
                          <span class="lbl">À partir de</span>
                          <span class="val">{d.minPrice.toLocaleString("fr-FR")}</span>
                          <span class="cur">F CFA</span>
                          {d.compareAt && <span class="off">−{d.discountPct}%</span>}
                        </div>
                        {d.compareAt && (
                          <div class="pr-promo">
                            <span class="was">{d.compareAt.toLocaleString("fr-FR")} F CFA</span>
                            <span class="save">Économisez {d.savings.toLocaleString("fr-FR")} F CFA</span>
                          </div>
                        )}
                      </div>
                    )}

                    <div class={`ev-avail ${d.level}`}>
                      <div class="top">
                        <span class="cnt">{d.full ? "Session complète" : (<><b>{d.remaining}</b> places restantes</>)}</span>
                        <span class="st">{availLabel(d.level)}</span>
                      </div>
                      <div class="track"><i style={`width:${d.cap ? Math.round((d.sold / d.cap) * 100) : 100}%`}></i></div>
                    </div>

                    {d.full ? (
                      <a class="btn btn-outline btn-block" href={`/formations/session/${s.slug}`}>Rejoindre la liste d'attente</a>
                    ) : (
                      <a class="btn btn-primary btn-block" href={`/formations/session/${s.slug}`}>
                        Réserver ma place
                        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                      </a>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
          <p class="cal-empty" id="no-result" style="display:none;margin-top:16px">Aucune session ne correspond à ces filtres. <button type="button" class="mp-reset" id="clear-all">Réinitialiser</button></p>

          <!-- ===== Vue Calendrier (façon Calendly) ===== -->
          <div class="cal-view" id="cal-view" hidden>
            <div class="cal-main">
              <div class="cal-panel">
                <div class="cal-topbar">
                  <div class="cal-month" id="big-month">—</div>
                  <div class="cal-navs">
                    <button type="button" class="cal-today" id="big-today">Aujourd'hui</button>
                    <button type="button" class="mp-nav" id="big-prev" aria-label="Mois précédent">‹</button>
                    <button type="button" class="mp-nav" id="big-next" aria-label="Mois suivant">›</button>
                  </div>
                </div>
                <div class="big-dow"><span>Lun</span><span>Mar</span><span>Mer</span><span>Jeu</span><span>Ven</span><span>Sam</span><span>Dim</span></div>
                <div class="big-grid" id="big-grid"></div>
              </div>
              <div class="cal-legend">
                <span><i class="grad--blue"></i> IA</span>
                <span><i class="grad--warm"></i> Marketing</span>
                <span><i class="grad--navy"></i> Vente en ligne</span>
                <span><i class="grad--muted"></i> Complet</span>
              </div>
            </div>

            <div class="cal-panel day-panel">
              <div class="dp-head">
                <div class="dp-kicker">Sessions du jour</div>
                <div class="dp-date" id="dp-date">Sélectionnez une date</div>
              </div>
              <div class="dp-body" id="dp-body"></div>
            </div>
          </div>
        </>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  const SB_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SB_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  const grid = document.getElementById("ev-grid");
  if (grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>(".ev-card"));
    const state = { theme: "all", level: "all", mode: "all", date: "", dispo: false, sort: "date", view: "cards" as "cards" | "cal" };

    type Ev = {
      id: string; slug: string; title: string; theme: string; grad: string;
      date: string; time: string; minPrice: number | null;
      compareAt: number | null; discountPct: number; remaining: number;
      cap: number; sold: number; full: boolean; level: string; diff: string; mode: string; venue: string;
    };
    const EV: Ev[] = JSON.parse(document.getElementById("cal-data")?.textContent || "[]");
    const MOIS = ["janvier","février","mars","avril","mai","juin","juillet","août","septembre","octobre","novembre","décembre"];
    const JOURS = ["dimanche","lundi","mardi","mercredi","jeudi","vendredi","samedi"];
    const isoOf = (dt: Date) => `${dt.getFullYear()}-${String(dt.getMonth() + 1).padStart(2, "0")}-${String(dt.getDate()).padStart(2, "0")}`;
    const todayISO = isoOf(new Date());
    // Filtres hors date (thème / niveau / format / dispo) — partagés avec la vue Calendrier.
    const passTd = (e: Ev) =>
      (state.theme === "all" || e.theme === state.theme) &&
      (state.level === "all" || e.diff === state.level) &&
      (state.mode === "all" || e.mode === "hybride" || (e.mode || "presentiel") === state.mode) &&
      (!state.dispo || !e.full);

    // ---- Filtres combinés (vue Cartes) ----
    function apply() {
      let visible = 0;
      cards.forEach((c) => {
        const okTheme = state.theme === "all" || c.dataset.theme === state.theme;
        const okLevel = state.level === "all" || c.dataset.level === state.level;
        const okMode = state.mode === "all" || c.dataset.mode === "hybride" || (c.dataset.mode || "presentiel") === state.mode;
        const okDate = !state.date || c.dataset.date === state.date;
        const okDispo = !state.dispo || c.dataset.full === "0";
        const show = okTheme && okLevel && okMode && okDate && okDispo;
        c.classList.toggle("is-hidden", !show);
        if (show) visible++;
      });
      const nr = document.getElementById("no-result");
      if (nr) nr.style.display = visible === 0 ? "block" : "none";
    }

    // ---- Tri (vue Cartes) : réordonne les cartes dans le DOM ----
    const byIdx = (a: HTMLElement, b: HTMLElement) => Number(a.dataset.idx) - Number(b.dataset.idx);
    const numAttr = (el: HTMLElement, attr: string) => {
      const v = el.dataset[attr];
      return v === "" || v == null ? NaN : Number(v);
    };
    function sortCards() {
      const arr = cards.slice();
      arr.sort((a, b) => {
        switch (state.sort) {
          case "price-asc":
          case "price-desc": {
            const pa = numAttr(a, "price"), pb = numAttr(b, "price");
            if (isNaN(pa) && isNaN(pb)) return byIdx(a, b);
            if (isNaN(pa)) return 1;      // prix inconnu en dernier
            if (isNaN(pb)) return -1;
            return (state.sort === "price-asc" ? pa - pb : pb - pa) || byIdx(a, b);
          }
          case "new":
            return (b.dataset.created || "").localeCompare(a.dataset.created || "") || byIdx(a, b);
          case "rating": {
            const ra = numAttr(a, "rating") || 0, rb = numAttr(b, "rating") || 0;
            if (rb !== ra) return rb - ra;
            const na = numAttr(a, "reviews") || 0, nb = numAttr(b, "reviews") || 0;
            return (nb - na) || byIdx(a, b);
          }
          case "date":
          default:
            return (a.dataset.date || "").localeCompare(b.dataset.date || "") || byIdx(a, b);
        }
      });
      arr.forEach((c) => grid!.appendChild(c));
    }

    // ---- Rafraîchit la vue active ----
    function refresh() {
      if (state.view === "cards") apply();
      else { renderBig(); renderDayPanel(); }
    }

    // ---- Sélecteur de date : bouton compact ⇄ calendrier (jours à événements colorés) ----
    const monthPop = document.getElementById("month-pop");
    const monthBtn = document.getElementById("month-btn");
    const dateBtnLabel = document.getElementById("date-btn-label");
    const mpLabel = document.getElementById("mp-label");
    const mpDays = document.getElementById("mp-days");
    const eventDates = new Set(cards.map((c) => c.dataset.date));
    const firstDate = EV.map((e) => e.date).filter(Boolean).sort()[0];
    let cursor = firstDate ? new Date(firstDate + "T00:00:00") : new Date();
    cursor = new Date(cursor.getFullYear(), cursor.getMonth(), 1);

    const frDateBtn = (iso: string) => {
      const [y, m, d] = iso.split("-").map(Number);
      return new Date(y, m - 1, d).toLocaleDateString("fr-FR", { day: "numeric", month: "short", year: "numeric" });
    };
    function updateDateBtn() {
      if (dateBtnLabel) dateBtnLabel.textContent = state.date ? frDateBtn(state.date) : "Toutes les dates";
      monthBtn?.classList.toggle("has-value", !!state.date);
    }
    function renderCal() {
      if (!mpLabel || !mpDays) return;
      mpLabel.textContent = cursor.toLocaleDateString("fr-FR", { month: "long", year: "numeric" });
      const y = cursor.getFullYear(), m = cursor.getMonth();
      const startDow = (new Date(y, m, 1).getDay() + 6) % 7; // lundi = 0
      const nbDays = new Date(y, m + 1, 0).getDate();
      let html = "";
      for (let i = 0; i < startDow; i++) html += `<button class="mut" disabled></button>`;
      for (let d = 1; d <= nbDays; d++) {
        const iso = `${y}-${String(m + 1).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
        const has = eventDates.has(iso);
        const sel = state.date === iso;
        html += `<button data-iso="${iso}" class="${has ? "has" : ""} ${sel ? "sel" : ""}" ${has ? "" : "disabled"}>${d}</button>`;
      }
      mpDays.innerHTML = html;
      mpDays.querySelectorAll<HTMLElement>("button[data-iso]").forEach((b) =>
        b.addEventListener("click", () => { setDate(b.dataset.iso || ""); closeMonthPop(); }));
    }
    function setDate(iso: string) {
      state.date = state.date === iso ? "" : iso;
      updateDateBtn();
      renderCal();
      refresh();
      updateBadge();
    }
    function openMonthPop() { if (monthPop) { monthPop.hidden = false; monthBtn?.setAttribute("aria-expanded", "true"); renderCal(); } }
    function closeMonthPop() { if (monthPop) { monthPop.hidden = true; monthBtn?.setAttribute("aria-expanded", "false"); } }
    monthBtn?.addEventListener("click", (e) => { e.stopPropagation(); if (monthPop?.hidden) openMonthPop(); else closeMonthPop(); });
    // Ferme le calendrier au clic en dehors (sans fermer le panneau de filtres)
    document.addEventListener("click", (e) => {
      if (monthPop && !monthPop.hidden) {
        const anchor = document.getElementById("month-anchor");
        if (anchor && !anchor.contains(e.target as Node)) closeMonthPop();
      }
    });
    document.getElementById("mp-prev")?.addEventListener("click", () => { cursor = new Date(cursor.getFullYear(), cursor.getMonth() - 1, 1); renderCal(); });
    document.getElementById("mp-next")?.addEventListener("click", () => { cursor = new Date(cursor.getFullYear(), cursor.getMonth() + 1, 1); renderCal(); });
    document.getElementById("mp-reset")?.addEventListener("click", () => { state.date = ""; updateDateBtn(); renderCal(); refresh(); updateBadge(); closeMonthPop(); });
    renderCal();
    updateDateBtn();

    // ---- Thème (liste déroulante, extensible) ----
    const themeSelect = document.getElementById("theme-select") as HTMLSelectElement | null;
    themeSelect?.addEventListener("change", () => { state.theme = themeSelect.value || "all"; refresh(); updateBadge(); });

    // ---- Chips à sélection unique (niveau / format) ----
    function wireChips(attr: "level" | "mode") {
      const sel = `.fchip[data-${attr}]`;
      document.querySelectorAll<HTMLElement>(sel).forEach((chip) => {
        chip.addEventListener("click", () => {
          document.querySelectorAll(sel).forEach((c) => c.classList.remove("is-active"));
          chip.classList.add("is-active");
          state[attr] = chip.dataset[attr] || "all";
          refresh();
          updateBadge();
        });
      });
    }
    wireChips("level");
    wireChips("mode");

    // ---- Places disponibles ----
    const dispoBtn = document.getElementById("dispo-btn");
    dispoBtn?.addEventListener("click", () => {
      state.dispo = !state.dispo;
      dispoBtn.classList.toggle("is-on", state.dispo);
      refresh();
      updateBadge();
    });

    // ---- Réinitialisation complète des filtres ----
    function resetFilters() {
      state.theme = "all"; state.level = "all"; state.mode = "all"; state.date = ""; state.dispo = false;
      if (themeSelect) themeSelect.value = "all";
      (["level", "mode"] as const).forEach((attr) =>
        document.querySelectorAll<HTMLElement>(`.fchip[data-${attr}]`).forEach((c) =>
          c.classList.toggle("is-active", c.dataset[attr] === "all")));
      dispoBtn?.classList.remove("is-on");
      updateDateBtn(); renderCal(); closeMonthPop();
      refresh();
      updateBadge();
    }
    document.getElementById("clear-all")?.addEventListener("click", resetFilters);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && filtersGroup?.classList.contains("is-open")) closeSheet();
    });

    // ---- Grande vue Calendrier (façon Calendly) ----
    const bigGrid = document.getElementById("big-grid");
    const bigMonth = document.getElementById("big-month");
    const startCursor = firstDate ? new Date(firstDate + "T00:00:00") : new Date();
    let bigCursor = new Date(startCursor.getFullYear(), startCursor.getMonth(), 1);

    function renderBig() {
      if (!bigGrid || !bigMonth) return;
      const y = bigCursor.getFullYear(), m = bigCursor.getMonth();
      bigMonth.textContent = `${MOIS[m]} ${y}`;
      const startDow = (new Date(y, m, 1).getDay() + 6) % 7;
      const nbDays = new Date(y, m + 1, 0).getDate();
      const prevNb = new Date(y, m, 0).getDate();
      const cells: { d: number; out: boolean; iso: string }[] = [];
      for (let i = startDow - 1; i >= 0; i--) { const dt = new Date(y, m - 1, prevNb - i); cells.push({ d: dt.getDate(), out: true, iso: isoOf(dt) }); }
      for (let d = 1; d <= nbDays; d++) cells.push({ d, out: false, iso: isoOf(new Date(y, m, d)) });
      while (cells.length % 7 !== 0 || cells.length < 42) {
        const last = cells[cells.length - 1].iso.split("-").map(Number);
        const dt = new Date(last[0], last[1] - 1, last[2] + 1);
        cells.push({ d: dt.getDate(), out: true, iso: isoOf(dt) });
        if (cells.length >= 42) break;
      }
      bigGrid.innerHTML = cells.map((c) => {
        const evs = EV.filter((e) => e.date === c.iso && passTd(e));
        const chips = evs.slice(0, 2).map((e) =>
          `<span class="chip ${e.full ? "is-full" : ""}"><span class="cdot grad--${e.grad}"></span>${e.title}</span>`
        ).join("");
        const more = evs.length > 2 ? `<span class="cell-more">+${evs.length - 2} autre${evs.length - 2 > 1 ? "s" : ""}</span>` : "";
        const cls = ["big-cell", c.out ? "out" : "", evs.length ? "has" : "", c.iso === todayISO ? "today" : "", state.date === c.iso ? "sel" : ""].filter(Boolean).join(" ");
        return `<button type="button" class="${cls}" data-iso="${c.iso}" ${evs.length ? "" : 'tabindex="-1" disabled'}>
          <span class="dnum">${c.d}</span>${chips}${more}
        </button>`;
      }).join("");
      bigGrid.querySelectorAll<HTMLElement>(".big-cell.has").forEach((b) => {
        b.addEventListener("click", () => { state.date = b.dataset.iso || ""; updateDateBtn(); renderCal(); renderBig(); renderDayPanel(); });
      });
    }

    // ---- Panneau détail du jour ----
    const dpDate = document.getElementById("dp-date");
    const dpBody = document.getElementById("dp-body");
    function renderDayPanel() {
      if (!dpDate || !dpBody) return;
      if (!state.date) {
        dpDate.textContent = "Sélectionnez une date";
        dpBody.innerHTML = `<p class="dp-empty">Cliquez sur un jour surligné pour voir les sessions et réserver.</p>`;
        return;
      }
      const [yy, mm, dd] = state.date.split("-").map(Number);
      const dt = new Date(yy, mm - 1, dd);
      const long = `${JOURS[dt.getDay()]} ${dd} ${MOIS[mm - 1]} ${yy}`;
      dpDate.textContent = long.charAt(0).toUpperCase() + long.slice(1);
      const evs = EV.filter((e) => e.date === state.date && passTd(e));
      if (!evs.length) { dpBody.innerHTML = `<p class="dp-empty">Aucune session ce jour-là avec ces filtres.</p>`; return; }
      dpBody.innerHTML = evs.map((e) => {
        const priceHtml = e.minPrice !== null
          ? `<span class="di-price">
               <span class="now">À partir de ${e.minPrice.toLocaleString("fr-FR")} F CFA</span>
               ${e.compareAt ? `<span class="was">${e.compareAt.toLocaleString("fr-FR")} F CFA</span><span class="off">−${e.discountPct}%</span>` : ""}
             </span>`
          : "";
        return `<div class="dp-item">
          <div class="di-top">
            <span class="di-badge grad--${e.grad}">${e.theme || "Formation"}</span>
            <span class="di-time">🕘 ${e.time}</span>
          </div>
          <h4 class="di-title">${e.title}</h4>
          <div class="di-meta">${priceHtml}<span class="di-loc">📍 ${e.venue}</span></div>
          <div><span class="di-seat ${e.level}">${e.full ? "Session complète" : e.remaining + " places restantes"}</span></div>
          <a class="btn ${e.full ? "btn-outline" : "btn-primary"} di-btn" href="/formations/session/${e.slug}">${e.full ? "Liste d'attente" : "Réserver"}</a>
        </div>`;
      }).join("");
    }
    document.getElementById("big-prev")?.addEventListener("click", () => { bigCursor = new Date(bigCursor.getFullYear(), bigCursor.getMonth() - 1, 1); renderBig(); });
    document.getElementById("big-next")?.addEventListener("click", () => { bigCursor = new Date(bigCursor.getFullYear(), bigCursor.getMonth() + 1, 1); renderBig(); });
    document.getElementById("big-today")?.addEventListener("click", () => { const n = new Date(); bigCursor = new Date(n.getFullYear(), n.getMonth(), 1); renderBig(); });

    // ---- Bascule Cartes / Calendrier ----
    const calView = document.getElementById("cal-view");
    const dateSection = document.getElementById("fg-date-section");
    const sortWrap = document.getElementById("cal-sort-wrap");
    const btnCards = document.getElementById("view-cards");
    const btnCal = document.getElementById("view-cal");
    function setView(v: "cards" | "cal") {
      state.view = v;
      btnCards?.classList.toggle("is-on", v === "cards");
      btnCal?.classList.toggle("is-on", v === "cal");
      btnCards?.setAttribute("aria-pressed", String(v === "cards"));
      btnCal?.setAttribute("aria-pressed", String(v === "cal"));
      grid.hidden = v !== "cards";
      if (calView) calView.hidden = v !== "cal";
      // Le filtre « Date » n'a pas de sens en vue Calendrier (la grille EST un calendrier).
      if (dateSection) dateSection.hidden = v === "cal";
      // Le tri ne s'applique qu'aux cartes (la vue Calendrier est ordonnée par date).
      if (sortWrap) sortWrap.style.display = v === "cal" ? "none" : "";
      if (v === "cal") { renderBig(); renderDayPanel(); }
      else apply();
    }
    btnCards?.addEventListener("click", () => setView("cards"));
    btnCal?.addEventListener("click", () => setView("cal"));

    // ---- Tri ----
    const sortSelect = document.getElementById("sort-select") as HTMLSelectElement | null;
    sortSelect?.addEventListener("change", () => { state.sort = sortSelect.value; sortCards(); });

    // ---- Panneau de filtres mobile (modal) + badge ----
    const filtersGroup = document.getElementById("filters-group");
    const filtersTrigger = document.getElementById("filters-trigger");
    const fgBackdrop = document.getElementById("fg-backdrop");
    const fgBadge = document.getElementById("fg-badge");
    const fgApply = document.getElementById("fg-apply");

    function activeCount() {
      return (state.theme !== "all" ? 1 : 0) + (state.level !== "all" ? 1 : 0) +
             (state.mode !== "all" ? 1 : 0) + (state.date ? 1 : 0) + (state.dispo ? 1 : 0);
    }
    function resultCount() {
      return EV.filter((e) => passTd(e) && (!state.date || e.date === state.date)).length;
    }
    function updateBadge() {
      const n = activeCount();
      if (fgBadge) { fgBadge.textContent = String(n); fgBadge.hidden = n === 0; }
      filtersTrigger?.classList.toggle("has-filters", n > 0);
      const rc = resultCount();
      if (fgApply) fgApply.textContent = `Voir ${rc} résultat${rc > 1 ? "s" : ""}`;
    }

    // Mobile : feuille modale (backdrop + verrou de défilement). Desktop : dropdown ancré.
    const mqMobile = window.matchMedia("(max-width: 640px)");
    function openSheet() {
      filtersGroup?.classList.add("is-open");
      filtersTrigger?.setAttribute("aria-expanded", "true");
      if (mqMobile.matches) {
        if (fgBackdrop) { fgBackdrop.hidden = false; requestAnimationFrame(() => fgBackdrop.classList.add("is-open")); }
        document.body.style.overflow = "hidden";
      }
    }
    function closeSheet() {
      filtersGroup?.classList.remove("is-open");
      fgBackdrop?.classList.remove("is-open");
      filtersTrigger?.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      window.setTimeout(() => { if (fgBackdrop && !fgBackdrop.classList.contains("is-open")) fgBackdrop.hidden = true; }, 340);
    }
    filtersTrigger?.addEventListener("click", (e) => {
      e.stopPropagation();
      if (filtersGroup?.classList.contains("is-open")) closeSheet(); else openSheet();
    });
    document.getElementById("fg-close")?.addEventListener("click", closeSheet);
    fgBackdrop?.addEventListener("click", closeSheet);
    fgApply?.addEventListener("click", closeSheet);
    // Desktop : fermer au clic à l'extérieur du panneau (le mobile utilise le backdrop).
    document.addEventListener("click", (e) => {
      if (mqMobile.matches || !filtersGroup?.classList.contains("is-open")) return;
      const anchor = document.getElementById("filters-anchor");
      if (anchor && !anchor.contains(e.target as Node)) closeSheet();
    });
    document.getElementById("fg-reset")?.addEventListener("click", resetFilters);

    // ---- Favoris ----
    let anon = localStorage.getItem("bweb_anon");
    if (!anon) { anon = crypto.randomUUID(); localStorage.setItem("bweb_anon", anon); }
    const favSet = new Set<string>(JSON.parse(localStorage.getItem("bweb_favs") || "[]"));
    document.querySelectorAll<HTMLElement>(".ev-fav").forEach((btn) => {
      const id = btn.dataset.sessionId!;
      if (favSet.has(id)) btn.classList.add("is-on");
      btn.addEventListener("click", async (e) => {
        e.preventDefault();
        const countEl = btn.querySelector(".fav-count")!;
        const wasOn = btn.classList.contains("is-on");
        // Optimiste
        btn.classList.toggle("is-on", !wasOn);
        countEl.textContent = String(Math.max(0, parseInt(countEl.textContent || "0") + (wasOn ? -1 : 1)));
        wasOn ? favSet.delete(id) : favSet.add(id);
        localStorage.setItem("bweb_favs", JSON.stringify([...favSet]));
        try {
          await fetch(`${SB_URL}/rest/v1/rpc/toggle_favorite`, {
            method: "POST",
            headers: { "Content-Type": "application/json", apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}` },
            body: JSON.stringify({ p_target_type: "session", p_target_id: id, p_anon_id: anon }),
          });
        } catch {}
      });
    });

    // ---- Init ----
    updateBadge();
  }
</script>
