---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { supabase } from "../../lib/supabase";
import { priceFCFA, frTime, gradClass, gradSuffix, levelLabel, isOnline, isHybrid, themeColorMap } from "../../lib/format";
import "../../styles/formations.css";

type TT = { price: number; capacity: number; sold: number; compare_at_price: number | null };
type Session = {
  id: string;
  slug: string;
  title: string;
  theme: string | null;
  city: string | null;
  venue: string | null;
  image_url: string | null;
  starts_at: string;
  status: string;
  likes_count: number;
  formation_id: string | null;
  level: string | null;
  mode: string | null;
  created_at: string;
  ticket_types: TT[];
};

const { data } = await supabase
  .from("sessions")
  .select("id,slug,title,theme,city,venue,image_url,starts_at,status,likes_count,formation_id,level,mode,created_at,ticket_types(price,capacity,sold,compare_at_price)")
  .in("status", ["published", "full"])
  .order("starts_at", { ascending: true });

const sessions: Session[] = data ?? [];

// Couleurs des thèmes (source de vérité) pour des dégradés uniformes.
const { data: themesData } = await supabase.from("themes").select("name,color");
const tmap = themeColorMap(themesData);

// Notes moyennes par formation (pour le tri « Mieux notées »).
const { data: rv } = await supabase.from("reviews").select("formation_id,rating").eq("status", "approved");
const ratingMap = new Map<string, { sum: number; n: number }>();
(rv ?? []).forEach((r: any) => {
  if (!r.formation_id) return;
  const m = ratingMap.get(r.formation_id) ?? { sum: 0, n: 0 };
  m.sum += r.rating; m.n += 1;
  ratingMap.set(r.formation_id, m);
});
const ratingOf = (fid: string | null): { avg: number; n: number } => {
  const m = fid ? ratingMap.get(fid) : null;
  return m ? { avg: m.sum / m.n, n: m.n } : { avg: 0, n: 0 };
};

function derive(s: Session) {
  const tts = s.ticket_types ?? [];
  const cap = tts.reduce((a, t) => a + t.capacity, 0);
  const sold = tts.reduce((a, t) => a + t.sold, 0);
  const remaining = Math.max(0, cap - sold);
  const cheapest = tts.length ? tts.reduce((a, t) => (t.price < a.price ? t : a)) : null;
  const minPrice = cheapest ? cheapest.price : null;
  const compareAt =
    cheapest && cheapest.compare_at_price && cheapest.compare_at_price > cheapest.price
      ? cheapest.compare_at_price
      : null;
  const discountPct = compareAt && minPrice ? Math.round((1 - minPrice / compareAt) * 100) : 0;
  const savings = compareAt && minPrice ? compareAt - minPrice : 0;
  const pct = cap > 0 ? Math.round((sold / cap) * 100) : 0;
  const full = s.status === "full" || remaining <= 0;
  const level = full ? "full" : pct >= 80 ? "warn" : "ok";
  return { cap, sold, remaining, minPrice, compareAt, discountPct, savings, pct, full, level };
}

const themes = [...new Set(sessions.map((s) => s.theme).filter(Boolean))] as string[];
const dateISO = (s: string) => new Date(s).toISOString().slice(0, 10);
const weekday = (s: string) =>
  new Date(s).toLocaleDateString("fr-FR", { weekday: "short", day: "numeric", month: "short", year: "numeric" });
const posterDate = (s: string) =>
  new Date(s).toLocaleDateString("fr-FR", { day: "numeric", month: "short", year: "numeric" }).toUpperCase();
const dayNum = (s: string) => new Date(s).getDate();
const monthShort = (s: string) => {
  const m = new Date(s).toLocaleDateString("fr-FR", { month: "short" }).replace(".", "");
  return m.charAt(0).toUpperCase() + m.slice(1);
};
const weekdayLine = (s: string) => {
  const w = new Date(s).toLocaleDateString("fr-FR", { weekday: "long", day: "numeric", month: "short" }).replace(".", "");
  return w.charAt(0).toUpperCase() + w.slice(1);
};
const availLabel = (level: string) => (level === "full" ? "Complet" : level === "warn" ? "Bientôt complet" : "Disponible");

// Données pré-dérivées pour la vue Calendrier (façon Calendly), consommées côté client.
const calData = sessions.map((s) => {
  const d = derive(s);
  return {
    id: s.id,
    slug: s.slug,
    title: s.title,
    theme: s.theme ?? "",
    grad: gradSuffix(s.theme, tmap),
    date: dateISO(s.starts_at),
    time: frTime(s.starts_at),
    minPrice: d.minPrice,
    compareAt: d.compareAt,
    discountPct: d.discountPct,
    remaining: d.remaining,
    cap: d.cap,
    sold: d.sold,
    full: d.full,
    level: d.level,
    diff: s.level ?? "",
    mode: s.mode ?? "presentiel",
    venue: s.venue ?? "Espace de formation Bweb · Cocody",
  };
});
---

<BaseLayout
  title="Calendrier des formations en présentiel | Bweb Agence"
  description="Réservez votre place aux prochaines sessions de formation en présentiel de Bweb Agence à Abidjan : IA, marketing, vente en ligne."
  breadcrumbs={[{ name: "Accueil", path: "/" }, { name: "Formations", path: "/formations" }, { name: "Calendrier", path: "/formations/calendrier" }]}
>
  <section class="page-hero" data-nav-section="Calendrier">
    <div class="mesh-bg"></div>
    <div class="grid-lines"></div>
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Accueil</a>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18" /></svg>
        <a href="/formations">Formations</a>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18" /></svg>
        <span>Calendrier</span>
      </div>
      <div class="text-white" data-hero-in>
        <div class="eyebrow on-dark">Formations en présentiel</div>
        <h1>Calendrier des sessions.</h1>
        <p class="lead">Réservez votre place aux prochaines sessions à l'espace de formation Bweb Agence, à Abidjan.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {sessions.length === 0 ? (
        <p class="cal-empty">Aucune session programmée pour le moment. Revenez bientôt, ou <a href="/devis">demandez le catalogue</a>.</p>
      ) : (
        <>
          <div class="cal-filters" role="group" aria-label="Filtres et tri">
            <div class="view-switch" role="group" aria-label="Choisir la vue">
              <button type="button" id="view-cards" class="is-on" aria-pressed="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                Cartes
              </button>
              <button type="button" id="view-cal" aria-pressed="false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg>
                Calendrier
              </button>
            </div>

            <div class="filters-anchor" id="filters-anchor">
              <button type="button" class="filters-trigger" id="filters-trigger" aria-expanded="false" aria-controls="filters-group">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
                Filtres<span class="fg-badge" id="fg-badge" hidden></span>
              </button>

              <div class="filters-group" id="filters-group">
                <div class="fg-head">
                  <span class="fg-title">Filtres</span>
                  <button type="button" class="fg-close" id="fg-close" aria-label="Fermer les filtres">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
                  </button>
                </div>

                <div class="fg-body">
                  <div class="fg-section">
                    <span class="fg-label">Thème</span>
                    <select class="fg-select" id="theme-select" aria-label="Filtrer par thème">
                      <option value="all">Tous les thèmes</option>
                      {themes.map((t) => (
                        <option value={t}>{t}</option>
                      ))}
                    </select>
                  </div>

                  <div class="fg-section">
                    <span class="fg-label">Niveau</span>
                    <div class="filter-levels chip-scroll">
                      <button type="button" class="fchip is-active" data-level="all">Tous</button>
                      <button type="button" class="fchip" data-level="debutant">Débutant</button>
                      <button type="button" class="fchip" data-level="intermediaire">Intermédiaire</button>
                      <button type="button" class="fchip" data-level="avance">Avancé</button>
                    </div>
                  </div>

                  <div class="fg-section">
                    <span class="fg-label">Format</span>
                    <div class="filter-modes chip-scroll">
                      <button type="button" class="fchip is-active" data-mode="all">Tous</button>
                      <button type="button" class="fchip" data-mode="presentiel">Présentiel</button>
                      <button type="button" class="fchip" data-mode="en_ligne">En ligne</button>
                    </div>
                  </div>

                  <div class="fg-section" id="fg-date-section">
                    <span class="fg-label">Date</span>
                    <div class="month-anchor" id="month-anchor">
                      <button type="button" class="fg-datebtn" id="month-btn" aria-expanded="false" aria-haspopup="dialog">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg>
                        <span id="date-btn-label">Toutes les dates</span>
