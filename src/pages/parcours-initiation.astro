  .pi-pnav { font-family: var(--f-display); font-weight: 600; font-size: .88rem; color: #fff; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.18); padding: 10px 20px; border-radius: var(--radius-pill); cursor: pointer; transition: background var(--dur-fast); white-space: nowrap; }
  .pi-pnav:hover:not(:disabled) { background: rgba(255,255,255,.2); }
  .pi-pnav:disabled { opacity: .35; cursor: default; }
  .pi-panel-side { display: flex; align-items: center; justify-content: center; }

  /* Visuel de phase : l'image (qui embarque déjà son propre carreau de verre)
     flotte librement sur le panneau — le cadre CSS n'existe que pour le fallback. */
  .pi-glass-frame { position: relative; width: 100%; max-width: 320px; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; }
  .pi-glass-frame img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 12px 22px rgba(0,0,0,.22)); animation: pi-float 6s var(--ease) infinite; }
  .pi-glass-fallback { display: none; position: absolute; inset: 0; flex-direction: column; align-items: center; justify-content: center; gap: 2px; }
  .pi-glass-frame.no-img {
    max-width: 230px; border-radius: 26px; overflow: hidden;
    background: linear-gradient(155deg, rgba(255,255,255,.16), rgba(255,255,255,.04) 55%, rgba(255,255,255,.09));
    border: 1px solid rgba(255,255,255,.24);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.28), inset 0 -18px 34px rgba(255,255,255,.05), 0 22px 48px -20px rgba(0,0,0,.55);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  }
  .pi-glass-frame.no-img::before {
    content: ""; position: absolute; top: -60%; left: -30%; width: 70%; height: 220%;
    background: linear-gradient(105deg, transparent, rgba(255,255,255,.14), transparent);
    transform: rotate(18deg); pointer-events: none;
  }
  .pi-glass-frame.no-img .pi-glass-fallback { display: flex; }
  .pi-panel-index { font-family: var(--f-display); font-weight: 700; font-size: clamp(3.4rem, 7vw, 5rem); line-height: 1; background: linear-gradient(150deg, #fff, rgba(255,255,255,.35)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .pi-panel-index-tag { font-family: var(--f-display); font-weight: 700; text-transform: uppercase; letter-spacing: .12em; font-size: .8rem; color: var(--c-yellow); }

  /* ---------- 6 · Auteur (glass sur blobs colorés) ---------- */
  .pi-author { position: relative; overflow: hidden; }
  .pi-author-blobs {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(380px 320px at 10% 18%, rgba(31,108,237,.12), transparent 65%),
      radial-gradient(440px 400px at 90% 26%, rgba(255,199,42,.14), transparent 65%),
      radial-gradient(400px 360px at 68% 100%, rgba(0,200,158,.11), transparent 65%);
  }
  .pi-author .container { position: relative; z-index: 1; }
  .pi-author-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 56px; align-items: center; }

  /* Portrait dans un cadre glassmorphism */
  .pi-portrait {
    position: relative; margin: 0; max-width: 360px; justify-self: center; width: 100%;
    padding: 14px; border-radius: 28px;
    background: linear-gradient(155deg, rgba(255,255,255,.62), rgba(255,255,255,.22));
    border: 1px solid rgba(255,255,255,.75);
    box-shadow: var(--shadow-lg), inset 0 1px 0 rgba(255,255,255,.9);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
  }
  .pi-portrait::before {
    content: ""; position: absolute; top: -26px; right: -22px; width: 84px; height: 84px; border-radius: 50%;
    background: linear-gradient(135deg, rgba(255,199,42,.65), rgba(255,131,95,.55)); filter: blur(2px); z-index: -1;
  }
  .pi-portrait::after {
    content: ""; position: absolute; bottom: -30px; left: -26px; width: 110px; height: 110px; border-radius: 50%;
    background: linear-gradient(135deg, rgba(31,108,237,.5), rgba(0,200,158,.4)); filter: blur(4px); z-index: -1;
  }
  .pi-portrait img { display: block; width: 100%; height: auto; border-radius: 18px; }
  .pi-portrait figcaption { text-align: center; padding: 12px 4px 2px; font-weight: 700; font-size: .88rem; color: var(--c-gray-700); }
  .pi-portrait-fallback { display: none; aspect-ratio: 640/760; border-radius: 18px; background: var(--g-navy); align-items: center; justify-content: center; }
  .pi-portrait-fallback span { font-family: var(--f-display); font-weight: 700; font-size: 4rem; color: rgba(255,255,255,.85); letter-spacing: .04em; }
  .pi-portrait.no-img img { display: none; }
  .pi-portrait.no-img .pi-portrait-fallback { display: flex; }

  /* Bande de stats glass */
  .pi-author-stats { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; margin-top: 52px; }
  .pi-astat {
    background: linear-gradient(160deg, rgba(255,255,255,.78), rgba(255,255,255,.42));
    border: 1px solid rgba(255,255,255,.85); outline: 1px solid var(--c-border-soft);
    border-radius: 18px; padding: 22px 20px;
    box-shadow: var(--shadow-sm), inset 0 1px 0 #fff;
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  }
  .pi-astat b { display: block; font-family: var(--f-display); font-weight: 700; font-size: clamp(1.35rem, 1.8vw, 1.65rem); color: var(--c-blue); line-height: 1.1; }
  .pi-astat span { display: block; margin-top: 5px; font-size: .86rem; color: var(--c-gray-700); }
  .pi-astat--gold b { color: #b98600; }

  /* ---------- 7 · Preuves (navy) ---------- */
  .pi-proofs { position: relative; }
  .pi-mesh { position: absolute; inset: 0; background: var(--g-mesh); opacity: .5; pointer-events: none; }
  .pi-proofs .container { position: relative; z-index: 1; }
  .pi-testi-carousel { max-width: 1100px; margin: 0 auto; }
  .pi-testi-hint { margin: 0 0 12px; text-align: right; font-size: .82rem; color: var(--c-gray-400); }
  .pi-testi { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; padding: 4px 2px 12px; scrollbar-width: thin; scrollbar-color: rgba(255,255,255,.35) transparent; }
  .pi-testi::-webkit-scrollbar { height: 6px; }
  .pi-testi::-webkit-scrollbar-thumb { background: rgba(255,255,255,.35); border-radius: 999px; }
  .pi-vslot { flex: 0 0 min(260px, 74vw); scroll-snap-align: start; aspect-ratio: 9/16; position: relative; isolation: isolate; overflow: hidden; cursor: pointer; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 0; background: transparent; border: 1px solid rgba(255,255,255,.28); border-radius: var(--radius-md); color: var(--c-gray-300); transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease); }
  .pi-vslot--landscape { flex-basis: min(420px, 88vw); aspect-ratio: 16/9; }
  .pi-vslot:hover { transform: translateY(-4px); border-color: rgba(255,199,42,.8); }
  .pi-vthumb { position: absolute; z-index: -2; inset: 0; width: 100%; height: 100%; object-fit: cover; background: transparent; }
  .pi-vshade { position: absolute; z-index: -1; inset: 0; background: linear-gradient(180deg, rgba(1,5,46,.08) 22%, rgba(1,5,46,.76)); transition: background var(--dur) var(--ease); }
  .pi-vslot:hover .pi-vshade { background: linear-gradient(180deg, rgba(1,5,46,.02) 20%, rgba(1,5,46,.58)); }
  .pi-vplay { width: 52px; height: 52px; border-radius: 50%; background: var(--c-blue); display: flex; align-items: center; justify-content: center; color: #fff; box-shadow: 0 0 0 0 rgba(31,108,237,.45); animation: pi-pulse 2.2s infinite; }
  .pi-vplay svg { width: 20px; height: 20px; margin-left: 2px; }
  .pi-vname { font-family: var(--f-display); font-weight: 600; text-align: center; line-height: 1.4; color: #fff; }
  .pi-vname small { display: block; color: var(--c-gray-400); font-weight: 400; font-size: .78rem; }
  .pi-video-dialog { width: min(94vw, 900px); margin: auto; padding: 0; overflow: visible; background: transparent; border: 0; }
  .pi-video-dialog::backdrop { background: rgba(1,5,46,.84); backdrop-filter: blur(8px); }
  .pi-video-dialog-player { position: relative; width: 100%; aspect-ratio: 16/9; overflow: hidden; border-radius: 18px; background: #050a28; box-shadow: 0 30px 80px rgba(0,0,0,.5); }
  .pi-video-dialog-player.is-portrait { width: min(100%, 430px); margin: 0 auto; aspect-ratio: 9/16; }
  .pi-video-dialog-player iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .pi-video-dialog-close { position: absolute; z-index: 2; top: -14px; right: -8px; width: 40px; height: 40px; border: 1px solid rgba(255,255,255,.25); border-radius: 50%; background: #fff; color: var(--c-navy); font-size: 1.7rem; line-height: 1; cursor: pointer; box-shadow: var(--shadow-md); }
  .pi-video-dialog-close:hover { background: var(--c-yellow); }
  /* Chiffres témoignages : bande de résultats — lisible avant tout */
  .pi-testi-stats-intro { margin: 54px auto 16px; max-width: 1050px; display: flex; align-items: baseline; justify-content: space-between; gap: 20px; }
  .pi-testi-stats-intro span { font-family: var(--f-display); font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--c-yellow); }
  .pi-testi-stats-intro p { margin: 0; color: rgba(255,255,255,.7); font-size: .95rem; }
  .pi-testi-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; max-width: 1050px; margin: 0 auto; padding: 1px; overflow: hidden; background: rgba(255,255,255,.17); border: 1px solid rgba(255,255,255,.18); border-radius: 24px; box-shadow: 0 24px 50px -30px rgba(0,0,0,.85); }
  /* Lignes compactes : icône à gauche, chiffre + libellé à droite — même
     principe qu'en mobile, pour supprimer le vide autour de chaque colonne. */
  .pi-tstat {
    --pi-stat-accent: var(--c-blue);
    position: relative; overflow: hidden; padding: 24px 24px 23px;
    display: grid; grid-template-columns: 52px minmax(0, 1fr);
    grid-template-areas: "icon value" "icon label";
    column-gap: 18px; align-items: center;
    background: linear-gradient(145deg, rgba(255,255,255,.11), rgba(255,255,255,.035));
    box-shadow: inset 0 1px 0 rgba(255,255,255,.14); transition: background var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .pi-tstat::before { content: ""; position: absolute; top: 0; bottom: 0; left: 0; width: 3px; height: auto; border-radius: 0 3px 3px 0; background: var(--pi-stat-accent); box-shadow: 0 0 18px color-mix(in srgb, var(--pi-stat-accent) 70%, transparent); }
  .pi-tstat--satisfaction { --pi-stat-accent: var(--c-green); }
  .pi-tstat--sales { --pi-stat-accent: var(--c-yellow); }
  .pi-tstat:hover { transform: translateY(-3px); background: linear-gradient(145deg, rgba(255,255,255,.15), rgba(255,255,255,.055)); }
  .pi-tstat-ico {
    grid-area: icon; width: 52px; height: 52px; border-radius: 14px; margin: 0;
    display: flex; align-items: center; justify-content: center;
    background: color-mix(in srgb, var(--pi-stat-accent) 16%, transparent); border: 1px solid color-mix(in srgb, var(--pi-stat-accent) 52%, transparent); color: var(--pi-stat-accent);
  }
  .pi-tstat-ico svg { width: 22px; height: 22px; }
  .pi-tstat b {
    grid-area: value; display: block; font-family: var(--f-display); font-weight: 700;
    font-size: clamp(1.7rem, 2.4vw, 2.15rem); line-height: 1.05; color: #fff;
    font-variant-numeric: tabular-nums;
  }
  .pi-tstat-l { grid-area: label; display: block; max-width: none; margin-top: 5px; font-size: .86rem; line-height: 1.4; color: rgba(255,255,255,.74); }

  /* ---------- 8 · Garantie (navy) ---------- */
  .pi-guarantee { position: relative; overflow: hidden; color: #fff; background: radial-gradient(900px 480px at 78% 8%, rgba(31,108,237,.22), transparent 58%), radial-gradient(700px 520px at 8% 100%, rgba(0,200,158,.1), transparent 60%), linear-gradient(180deg, var(--c-navy), #01052e); }
  .pi-guarantee::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, transparent, rgba(255,199,42,.8), transparent); }
  .pi-guar-grid { display: grid; grid-template-columns: 1.02fr .98fr; gap: 56px; align-items: center; }
  .pi-guar-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: var(--f-display); font-weight: 700; font-size: .76rem; letter-spacing: .09em; text-transform: uppercase; color: var(--c-yellow); background: rgba(255,199,42,.1); border: 1px solid rgba(255,199,42,.32); padding: 8px 16px; border-radius: var(--radius-pill); margin-bottom: 22px; }
  .pi-guar-content h2 { color: #fff; margin-bottom: 18px; }
  .pi-gold { color: var(--c-yellow); }
  .pi-guar-lede { color: var(--c-gray-300); font-size: 1.05rem; max-width: 520px; margin-bottom: 16px; }
  .pi-guar-lede b { color: #fff; }
  .pi-guar-cta.pi-btn-buy { margin-top: 12px; }
  .pi-guar-sign { margin-top: 20px; display: flex; align-items: center; gap: 10px; color: var(--c-gray-400); font-size: .92rem; }
  .pi-guar-sign .nm { font-family: var(--f-display); font-weight: 700; font-style: italic; color: #fff; font-size: 1.05rem; }
  .pi-guar-art { display: flex; align-items: center; justify-content: center; }
  /* Vidéo du sceau : fond noir « effacé » par screen → fondu invisible sur le
     navy, comme une animation native. object-fit contain conserve le badge. */
  .pi-guar-video {
    width: 100%; max-width: 400px; height: auto; display: block;
    mix-blend-mode: screen;
    filter: drop-shadow(0 24px 44px rgba(0,0,0,.4)) saturate(1.05);
    pointer-events: none;
  }
  @keyframes pi-float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }

  /* ---------- 9 · Rareté ---------- */
  .pi-scarcity { display: grid; grid-template-columns: 240px 1fr; gap: 40px; align-items: center; }
  .pi-scarcity-count { text-align: center; background: var(--surface-2); border: 1px solid var(--c-border-soft); border-radius: var(--radius-lg); padding: 32px 24px; box-shadow: var(--shadow-sm); }
  .pi-scarcity-n { display: block; font-family: var(--f-display); font-weight: 700; font-size: 4.2rem; line-height: 1; color: var(--c-blue); font-variant-numeric: tabular-nums; }
  .pi-scarcity-l { display: block; margin-top: 8px; font-size: .9rem; color: var(--c-gray-600); }
  .pi-scarcity-text p { margin-bottom: 12px; color: var(--c-gray-700); }
  .pi-scarcity-bar { max-width: 720px; margin: 28px auto 0; height: 10px; background: var(--c-gray-100); border-radius: var(--radius-pill); overflow: hidden; }
  .pi-scarcity-bar span { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--c-blue), var(--c-orange)); border-radius: var(--radius-pill); transition: width 1.1s var(--ease); }

  /* ---------- 10 · Bonus ---------- */
  .pi-bonus-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .pi-bonus-card { display: flex; gap: 16px; align-items: flex-start; background: #fff; border: 1px solid var(--c-border-soft); border-radius: var(--radius-lg); padding: 26px 26px; box-shadow: var(--shadow-sm); transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
  .pi-bonus-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  /* Tuile glass de l'icône bonus (image générée, fallback emoji) */
  .pi-bonus-ico {
    flex: none; width: 64px; height: 64px; border-radius: 17px; position: relative; overflow: hidden;
    background: linear-gradient(150deg, rgba(31,108,237,.12), rgba(0,200,158,.08) 60%, rgba(255,199,42,.1));
    border: 1px solid rgba(31,108,237,.16);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.85), 0 8px 18px -8px rgba(2,11,80,.18);
    display: flex; align-items: center; justify-content: center;
  }
  .pi-bonus-ico::before {
    content: ""; position: absolute; top: -50%; left: -25%; width: 55%; height: 200%;
    background: linear-gradient(105deg, transparent, rgba(255,255,255,.5), transparent);
    transform: rotate(18deg); pointer-events: none;
  }
  .pi-bonus-ico img { width: 84%; height: 84%; object-fit: contain; filter: drop-shadow(0 6px 10px rgba(2,11,80,.22)); }
  .pi-bonus-emoji { display: none; font-size: 1.6rem; }
  .pi-bonus-ico.no-img img { display: none; }
  .pi-bonus-ico.no-img .pi-bonus-emoji { display: block; }
  .pi-bonus-body h3 { font-size: 1.08rem; margin-bottom: 6px; }
  .pi-bonus-body p { font-size: .92rem; color: var(--c-gray-600); line-height: 1.55; }
  .pi-bonus-value { display: inline-block; margin-top: 12px; font-family: var(--f-display); font-weight: 700; font-size: .82rem; color: var(--c-success); background: var(--c-success-bg); border: 1px solid rgba(10,156,119,.2); padding: 5px 14px; border-radius: var(--radius-pill); }
  .pi-bonus-value.free { color: var(--c-blue); background: var(--c-skyblue); border-color: rgba(31,108,237,.18); }
  .pi-bonus-total { text-align: center; margin-top: 30px; font-family: var(--f-display); font-size: 1.15rem; color: var(--c-navy); }
  .pi-bonus-total b { color: var(--c-blue); }

  /* ---------- 11 · Prix ---------- */
  .pi-pricing {
    position: relative; max-width: 620px; margin: 0 auto; text-align: center;
    background: radial-gradient(420px 200px at 50% 0%, rgba(31,108,237,.05), transparent 70%), #fff;
    border: 1px solid rgba(31,108,237,.22); border-radius: 30px;
    padding: clamp(36px, 5vw, 52px) clamp(22px, 4vw, 48px) clamp(30px, 3vw, 40px);
    box-shadow: 0 1px 2px rgba(2,11,80,.04), 0 24px 70px -28px rgba(2,11,80,.22), 0 0 0 6px rgba(31,108,237,.035);
  }
  /* filet dégradé au sommet de la carte */
  .pi-pricing::before {
    content: ""; position: absolute; top: -1px; left: 48px; right: 48px; height: 3px; border-radius: 3px;
    background: linear-gradient(90deg, transparent, var(--c-blue) 30%, var(--c-green) 70%, transparent);
  }
  .pi-price-tag { position: absolute; top: -17px; left: 50%; transform: translateX(-50%); background: linear-gradient(135deg, var(--c-orange), #ef5f36); color: #fff; font-family: var(--f-display); font-weight: 700; font-size: .76rem; letter-spacing: .05em; text-transform: uppercase; padding: 9px 22px; border-radius: var(--radius-pill); white-space: nowrap; box-shadow: 0 10px 24px -8px rgba(255,131,95,.75); }

  .pi-stack { list-style: none; text-align: left; margin: 6px 0 26px; }
  .pi-stack li { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; padding: 13px 2px; border-bottom: 1px dashed rgba(2,11,80,.1); font-size: .95rem; color: var(--c-gray-700); }
  .pi-stack li b { font-family: var(--f-display); font-weight: 700; font-size: .92rem; color: var(--c-ink); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .pi-stack-total { border-bottom: none !important; margin-top: 8px; padding: 14px 16px !important; background: linear-gradient(135deg, rgba(31,108,237,.07), rgba(0,200,158,.06)); border: 1px solid rgba(31,108,237,.14); border-radius: 14px; }
  .pi-stack-total span { font-family: var(--f-display); font-weight: 700; color: var(--c-ink); }
  .pi-stack-total b { color: var(--c-blue) !important; font-size: 1.06rem; }

  .pi-price-block { padding: 4px 0 2px; }
  .pi-price-real { font-size: .92rem; color: var(--c-gray-600); }
  .pi-price-real s { font-family: var(--f-display); font-weight: 600; color: var(--c-gray-500); text-decoration-thickness: 2px; }
  .pi-price { font-family: var(--f-display); font-weight: 800; font-size: clamp(2.8rem, 6vw, 4rem); color: var(--c-ink); line-height: 1.05; letter-spacing: -.025em; margin: 6px 0 12px; font-variant-numeric: tabular-nums; }
  .pi-price small { font-size: 1.3rem; color: var(--c-gray-600); font-weight: 600; }
  .pi-deal { display: inline-flex; align-items: center; gap: 8px; background: rgba(0,200,158,.1); border: 1px solid rgba(0,200,158,.3); color: #067a5d; font-weight: 700; font-size: .93rem; padding: 9px 20px; border-radius: var(--radius-pill); }
  .pi-deal b { font-family: var(--f-display); font-size: 1.05rem; color: #067a5d; white-space: nowrap; }

  /* Compte à rebours 48 h — inline, sur une seule phrase (evergreen, par visiteur) */
  .pi-deal-timer { margin-top: 14px; font-size: .88rem; color: var(--c-gray-600); line-height: 1.9; }
  .pi-deal-timer b { color: #d0491f; font-weight: 700; white-space: nowrap; }
  .pi-dt-clock {
    display: inline-flex; align-items: baseline; gap: 1px; margin: 0 3px;
    vertical-align: baseline;
    font-family: var(--f-display); font-weight: 800; font-size: .98rem;
    color: #c2410c; font-variant-numeric: tabular-nums; white-space: nowrap;
  }
  .pi-dt-clock i { font-style: normal; font-weight: 600; font-size: .76rem; color: #b3593c; margin-right: 4px; }
  .pi-dt-clock i:last-child { margin-right: 0; }

  /* CTA en surbrillance */
  .pi-btn-buy {
    position: relative; overflow: hidden; display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    width: 100%; max-width: 440px; margin-top: 26px; padding: 21px 40px; border-radius: var(--radius-pill); white-space: nowrap;
    font-family: var(--f-display); font-weight: 700; font-size: 1.12rem; color: #fff;
    background: linear-gradient(135deg, #2f7bff, var(--c-blue) 55%, var(--c-blue-dark));
    box-shadow: 0 14px 38px -10px rgba(31,108,237,.65);
    animation: pi-glow 2.6s ease-in-out infinite;
    transition: transform var(--dur) var(--ease);
  }
  .pi-btn-buy:hover { transform: translateY(-2px); }
  @keyframes pi-glow {
    0%, 100% { box-shadow: 0 14px 38px -10px rgba(31,108,237,.65), 0 0 0 0 rgba(31,108,237,.4); }
    50% { box-shadow: 0 14px 44px -8px rgba(31,108,237,.8), 0 0 0 12px rgba(31,108,237,0); }
  }
  .pi-btn-buy::after {
    content: ""; position: absolute; top: 0; bottom: 0; left: -70%; width: 40%;
    background: linear-gradient(115deg, transparent, rgba(255,255,255,.45), transparent);
    transform: skewX(-20deg); animation: pi-shine 3s ease-in-out infinite;
  }

  /* Paiement : le widget est chargé une fois puis ouvert depuis chaque CTA. */
  .pi-payment-modal {
    width: min(620px, calc(100% - 24px)); max-height: min(760px, calc(100dvh - 32px));
    margin: auto; padding: 0; border: 0; border-radius: 24px; color: var(--c-navy); background: #fff;
    box-shadow: 0 28px 80px rgba(5, 12, 40, .42);
  }
