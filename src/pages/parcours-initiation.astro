  <script define:vars={{ YOUTUBE_HERO }} is:inline>
    (function () {
      // ---- Vidéo hero (lazy YouTube) ----
      var heroPlay = document.getElementById("heroPlay");
      if (heroPlay) {
        heroPlay.addEventListener("click", function () {
          var frame = document.getElementById("heroFrame");
          if (!YOUTUBE_HERO) { heroPlay.classList.add("shake"); setTimeout(function(){heroPlay.classList.remove("shake");}, 500); return; }
          frame.src = "https://www.youtube.com/embed/" + YOUTUBE_HERO + "?autoplay=1&rel=0";
          frame.hidden = false;
          heroPlay.style.display = "none";
        });
      }

      // ---- Témoignages : aperçu puis lecture complète dans une fenêtre dédiée ----
      var testimonialDialog = document.getElementById("testimonialDialog");
      var testimonialPlayer = document.getElementById("testimonialPlayer");
      var testimonialFrame = document.getElementById("testimonialFrame");
      function closeTestimonial() {
        if (testimonialDialog && testimonialDialog.open) testimonialDialog.close();
      }
      document.querySelectorAll(".pi-vslot").forEach(function (el) {
        el.addEventListener("click", function () {
          var id = el.getAttribute("data-video");
          if (!id || !testimonialDialog || !testimonialPlayer || !testimonialFrame) return;
          testimonialPlayer.classList.toggle("is-portrait", el.getAttribute("data-format") === "portrait");
          testimonialFrame.src = "https://www.youtube.com/embed/" + id + "?autoplay=1&rel=0";
          testimonialDialog.showModal();
        });
      });
      document.querySelectorAll("[data-close-testimonial]").forEach(function (btn) { btn.addEventListener("click", closeTestimonial); });
      if (testimonialDialog && testimonialFrame) {
        testimonialDialog.addEventListener("close", function () { testimonialFrame.src = ""; });
        testimonialDialog.addEventListener("click", function (event) { if (event.target === testimonialDialog) closeTestimonial(); });
      }

      // ---- Témoignages : défilement lent, sans empêcher le geste horizontal ----
      (function () {
        var track = document.querySelector("[data-testimonials-track]");
        if (!track || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        var paused = false;
        function next() {
          if (paused) return;
          var card = track.querySelector(".pi-vslot");
          if (!card) return;
          var step = card.getBoundingClientRect().width + 16;
          var end = track.scrollWidth - track.clientWidth;
          var target = track.scrollLeft + step;
          track.scrollTo({ left: target >= end - 4 ? 0 : target, behavior: "smooth" });
        }
        var timer = setInterval(next, 5000);
        ["pointerdown", "pointerenter", "focusin"].forEach(function (event) {
          track.addEventListener(event, function () { paused = true; });
        });
        ["pointerup", "pointerleave", "focusout"].forEach(function (event) {
          track.addEventListener(event, function () { paused = false; });
        });
        window.addEventListener("pagehide", function () { clearInterval(timer); }, { once: true });
      })();

      // ---- Stepper programme ----
      (function () {
        var steps = [].slice.call(document.querySelectorAll(".pi-step"));
        var bodies = [].slice.call(document.querySelectorAll(".pi-panel-body"));
        var fill = document.getElementById("stepsFill");
        if (!steps.length) return;
        var n = steps.length, cur = 0;
        function go(i) {
          cur = i;
          steps.forEach(function (s, idx) {
            s.classList.toggle("active", idx === i);
            s.classList.toggle("done", idx < i);
          });
          bodies.forEach(function (b) { b.classList.toggle("on", +b.dataset.i === i); });
          // La ligne commence au centre de l'étape 1 et se termine au centre
          // de l'étape 5 : elle ne doit jamais dépasser le dernier repère.
          if (fill) fill.style.width = (i / n) * 100 + "%";
        }
        steps.forEach(function (s) { s.addEventListener("click", function () { go(+s.dataset.i); }); });
        document.querySelectorAll(".pi-pnav").forEach(function (btn) {
          btn.addEventListener("click", function () {
            if (btn.dataset.nav === "next" && cur < n - 1) go(cur + 1);
            if (btn.dataset.nav === "prev" && cur > 0) go(cur - 1);
          });
        });
        go(0);
      })();

      // ---- FAQ accordéon ----
      document.querySelectorAll(".pi-faq-q").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var item = btn.parentElement;
          var open = item.classList.contains("open");
          document.querySelectorAll(".pi-faq-item.open").forEach(function (i) {
            i.classList.remove("open");
            i.querySelector(".pi-faq-a").style.maxHeight = "0";
            i.querySelector(".pi-faq-q").setAttribute("aria-expanded", "false");
          });
          if (!open) {
            item.classList.add("open");
            var a = item.querySelector(".pi-faq-a");
            a.style.maxHeight = a.scrollHeight + "px";
            btn.setAttribute("aria-expanded", "true");
          }
        });
      });
      window.addEventListener("resize", function () {
        var o = document.querySelector(".pi-faq-item.open .pi-faq-a");
        if (o) o.style.maxHeight = o.scrollHeight + "px";
      });

      // ---- Countdown (toutes les instances [data-target]) ----
      (function () {
        var roots = [].slice.call(document.querySelectorAll("[data-target]"));
        if (!roots.length) return;
        function pad(v) { return String(v).padStart(2, "0"); }
        function tick() {
          roots.forEach(function (root) {
            var diff = new Date(root.getAttribute("data-target")).getTime() - Date.now();
            if (diff < 0) diff = 0;
            root.querySelector('[data-cd="d"]').textContent = pad(Math.floor(diff / 86400000));
            root.querySelector('[data-cd="h"]').textContent = pad(Math.floor((diff % 86400000) / 3600000));
            root.querySelector('[data-cd="m"]').textContent = pad(Math.floor((diff % 3600000) / 60000));
            root.querySelector('[data-cd="s"]').textContent = pad(Math.floor((diff % 60000) / 1000));
          });
        }
        tick();
        setInterval(tick, 1000);
      })();

      // ---- Sceau garantie : respecte « réduire les animations » (fige le poster) ----
      (function () {
        var v = document.querySelector(".pi-guar-video");
        if (v && matchMedia("(prefers-reduced-motion: reduce)").matches) {
          v.removeAttribute("autoplay");
          v.addEventListener("loadeddata", function () { v.pause(); });
          v.pause();
        }
      })();

      // ---- Compte à rebours 48 h de l'offre (evergreen, par visiteur) ----
      // Démarre à la 1re visite et persiste entre les rechargements ; une fois
      // écoulé, il repart pour 48 h. Le prix affiché, lui, ne change pas.
      (function () {
        var root = document.getElementById("dealTimer");
        if (!root) return;
        var KEY = "pi_deal_deadline", DUR = 48 * 3600 * 1000, deadline;
        try {
          deadline = parseInt(localStorage.getItem(KEY), 10);
          if (!deadline || deadline < Date.now()) {
            deadline = Date.now() + DUR;
            localStorage.setItem(KEY, String(deadline));
          }
        } catch (e) { deadline = Date.now() + DUR; } // navigation privée : timer de session
        function pad(v) { return String(v).padStart(2, "0"); }
        function tick() {
          var d = deadline - Date.now();
          if (d < 0) d = 0;
          root.querySelector('[data-t="h"]').textContent = pad(Math.floor(d / 3600000));
          root.querySelector('[data-t="m"]').textContent = pad(Math.floor((d % 3600000) / 60000));
          root.querySelector('[data-t="s"]').textContent = pad(Math.floor((d % 60000) / 1000));
        }
        tick();
        setInterval(tick, 1000);
      })();

      // ---- Count-up des chiffres témoignages ----
      (function () {
        var els = [].slice.call(document.querySelectorAll(".pi-count"));
        if (!els.length || !("IntersectionObserver" in window)) return;
        var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        function fmt(v, fr) { return fr ? v.toLocaleString("fr-FR").replace(/ | /g, " ") : String(v); }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            io.unobserve(e.target);
            var el = e.target, target = parseInt(el.dataset.count, 10) || 0, fr = el.dataset.format === "fr", prefix = el.dataset.prefix || "";
            if (reduce) { el.textContent = prefix + fmt(target, fr); return; }
            var t0 = null, dur = 1300;
            function step(ts) {
              if (!t0) t0 = ts;
              var p = Math.min(1, (ts - t0) / dur);
              var eased = 1 - Math.pow(1 - p, 3);
              el.textContent = prefix + fmt(Math.round(target * eased), fr);
              if (p < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
          });
        }, { threshold: 0.4 });
        els.forEach(function (el) { io.observe(el); });
      })();

      // ---- Jauge de places ----
      (function () {
        var el = document.getElementById("placesLeft");
        var bar = document.getElementById("placesBar");
        if (!el || !bar) return;
        var left = parseInt(el.getAttribute("data-places"), 10) || 0;
        var cap = parseInt(el.getAttribute("data-capacity"), 10) || 30;
        var pct = Math.max(4, Math.min(100, (left / cap) * 100));
        requestAnimationFrame(function () { bar.style.width = pct + "%"; });
      })();

      // ---- Sticky CTA : visible après le hero + le compte à rebours,
      // pour ne jamais recouvrir la vidéo ou le CTA principal du hero. ----
      (function () {
        var sticky = document.querySelector(".pi-sticky");
        var countdown = document.querySelector(".pi-countdown");
        var pricing = document.getElementById("reserver");
        if (!sticky || !("IntersectionObserver" in window)) return;
        var pastIntro = false, atPricing = false;
        function update() { sticky.classList.toggle("show", pastIntro && !atPricing); }
        if (countdown) new IntersectionObserver(function (e) {
          pastIntro = !e[0].isIntersecting && e[0].boundingClientRect.bottom < 0;
          update();
        }, { threshold: 0 }).observe(countdown);
        if (pricing) new IntersectionObserver(function (e) { atPricing = e[0].isIntersecting; update(); }, { threshold: 0 }).observe(pricing);
      })();

      // ---- Landing CRO : la marque ne concurrence pas le CTA au défilement ----
      (function () {
        var nav = document.querySelector(".site-header--bare");
        if (!nav) return;
        function update() { nav.classList.toggle("pi-nav-hidden", window.scrollY > 28); }
        update();
        window.addEventListener("scroll", update, { passive: true });
      })();
    })();
  </script>

  <script is:inline>
    (function () {
      var modal = document.getElementById("paymentModal");
      var close = document.querySelector("[data-payment-close]");
      var triggers = document.querySelectorAll("[data-payment-trigger]");

      function openPayment(event) {
        event.preventDefault();
        if (window.fbq) window.fbq("track", "InitiateCheckout");
        if (modal && typeof modal.showModal === "function") modal.showModal();
      }

      triggers.forEach(function (trigger) {
        trigger.addEventListener("click", openPayment);
      });

      if (close && modal) close.addEventListener("click", function () { modal.close(); });
      if (modal) modal.addEventListener("click", function (event) {
        if (event.target === modal) modal.close();
      });

      var stylesheet = document.createElement("link");
      stylesheet.rel = "stylesheet";
      stylesheet.href = "https://js.chariowcdn.com/v1/widget.min.css";
      document.head.appendChild(stylesheet);

      var widgetScript = document.createElement("script");
      widgetScript.src = "https://js.chariowcdn.com/v1/widget.min.js";
      widgetScript.async = true;
      document.head.appendChild(widgetScript);
    })();
  </script>
</BaseLayout>

