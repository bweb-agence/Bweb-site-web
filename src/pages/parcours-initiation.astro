---
/* Rendu à la demande : le compteur de places doit refléter le tableau de bord
   à chaque visite, pas l'état du dernier déploiement. */
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import { supabase } from "../lib/supabase";
import MetaPixel from "../components/MetaPixel.astro";

/* Les visuels WebP optimisés font partie du dépôt et sont servis directement
   depuis /public : cela évite toute dépendance au système de fichiers du build. */
const IMG_BASE = "/images/parcours-initiation/";
const imgSrc = (base: string): string => IMG_BASE + base + ".webp";

/* =========================================================
   PARCOURS INITIATION — Page de vente (Bweb Academy)
   Landing campagne intégrée au site : design system Bweb
   (tokens, Sora/Jakarta, .btn/.eyebrow/.card…) + styles
   page-scoped pour les blocs sur-mesure (stepper, sceau,
   stack de prix, sticky CTA).
   ---------------------------------------------------------
   À CONFIGURER (Godwin) :
   - Places et date de démarrage : écran /admin/cohortes (cohorte
     « parcours-initiation ») — plus rien à toucher dans ce fichier
   - Paiement Chariow : product_id / store-domain ci-dessous
   - YOUTUBE_HERO / témoignages : IDs vidéo
   ========================================================= */

/* Places restantes : source de vérité = la cohorte du tableau de bord.
   `cohorte_places` additionne les ventes Chariow déjà reçues par le Pulse et
   les places prises à la main, puis ne rend que des compteurs — le rôle public
   ne lit ni la table `cohortes` ni la timeline des contacts.
   Si la base est injoignable, on retombe sur les valeurs de secours : mieux
   vaut une landing vendable avec un chiffre daté qu'un compteur vide. */
const COHORTE_SLUG = "parcours-initiation";
const SECOURS = { capacity: 30, remaining: 25, starts_at: "2026-09-01T09:00:00", deadline_at: "2026-09-07T00:00:00Z" };

const { data: cohorteRows } = await supabase.rpc("cohorte_places", { p_slug: COHORTE_SLUG });
const cohorte = (Array.isArray(cohorteRows) ? cohorteRows[0] : cohorteRows) ?? null;

const CAPACITE = cohorte?.capacity ?? SECOURS.capacity;
const PLACES_RESTANTES = cohorte?.remaining ?? SECOURS.remaining;
const COMPLET = PLACES_RESTANTES <= 0;
const COHORTE_ISO = cohorte?.starts_at ?? SECOURS.starts_at;

/* Le compte à rebours vise la CLÔTURE DES INSCRIPTIONS, pas le démarrage : c'est
   l'échéance qui fait décider. Réglée dans le tableau de bord (`deadline_at`),
   elle retombe sur la date de démarrage quand elle n'est pas renseignée. */
const ECHEANCE_ISO = cohorte?.deadline_at ?? SECOURS.deadline_at;

/* « Septembre 2026 » : écrit une fois, réutilisé dans tous les rappels de la
   page (badge, CTA, rareté, section finale). */
const moisAnnee = new Date(COHORTE_ISO).toLocaleDateString("fr-FR", { month: "long", year: "numeric", timeZone: "UTC" });
const COHORTE_LABEL = moisAnnee.charAt(0).toUpperCase() + moisAnnee.slice(1);

/* Le rendu est dynamique, mais la page encaisse du trafic publicitaire : on la
   laisse en cache 60 s au bord plutôt que de la recalculer à chaque clic. */
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=60, stale-while-revalidate=300");

const YOUTUBE_HERO = ""; // ex: "dQw4w9WgXcQ"

const proof = [
  { n: "17 116", t: "personnes formées" },
  { n: "95 %", t: "d'avis positifs" },
  { n: "+63 453", t: "ventes cumulées par nos apprenants" },
];

const getYouTubeId = (url: string): string | null => {
  try {
    const parsed = new URL(url);
    if (parsed.hostname === "youtu.be") return parsed.pathname.slice(1) || null;
    if (parsed.pathname.startsWith("/shorts/")) return parsed.pathname.split("/")[2] || null;
    return parsed.searchParams.get("v");
  } catch {
    return null;
  }
};

/* Ajouter ici les témoignages publiables. Le carrousel ne rend que les
   témoignages ayant une vidéo : aucune carte vide ou faux avis n'apparaît
   sur la landing. Il peut en accueillir une dizaine ou plus. */
const testimonials = [
  { name: "Joseph Amon", url: "https://youtube.com/shorts/ViMoaJH7XHA?feature=share" },
  { name: "Kendra Anudike", url: "https://youtube.com/shorts/BnY0sYFcJws?feature=share" },
  { name: "Khalil", url: "https://youtube.com/shorts/xjAyKr5OXwY?feature=share" },
  { name: "Jennifer", url: "https://youtube.com/shorts/fj6dGj8ZUKw?feature=share" },
  { name: "Membre du programme", url: "https://youtube.com/shorts/93Adl9t8aDc?feature=share" },
];
const publishedTestimonials = testimonials
  .map((testimonial) => ({
    ...testimonial,
    video: getYouTubeId(testimonial.url),
    format: new URL(testimonial.url).pathname.startsWith("/shorts/") ? "portrait" : "landscape",
  }))
  .filter((testimonial): testimonial is typeof testimonial & { video: string } => Boolean(testimonial.video));

/* Visuels glassmorphism par phase, optimisés dans
   /public/images/parcours-initiation/ sous les noms phase-1.webp … phase-5.webp. */
const phases = [
  {
    week: "Semaine 1",
    tag: "Idée",
    title: "Trouve ton idée et valide-la avant de créer",
    sub: "« Comment générer +325 000 FCFA/mois avec tes compétences »",
    items: [
      "Tu identifies LA compétence que tu peux monétiser (matrice guidée)",
      "Tu définis ton client idéal (âge, problème, budget)",
      "Tu contactes 10 vrais prospects pour valider que ton idée va se vendre",
    ],
    livrable: "Idée validée + client cible + rapport de validation",
  },
  {
    week: "Semaine 2",
    tag: "Produit",
    title: "Crée ton produit digital de A à Z",
    sub: "6 cas pratiques : ebook, formation, template, outil IA, communauté, coaching",
    items: [
      "Tu choisis le format adapté à ton client et ton marché",
      "Tu crées ton produit avec l'IA (prompts fournis, méthode complète)",
      "Mise en page pro avec Canva, Claude Design ou Codex",
    ],
    livrable: "Produit créé, accessible, prêt à vendre",
  },
  {
    week: "Semaine 3",
    tag: "Offre",
    title: "Construis une offre irrésistible",
    sub: "Structure, copywriting, prix, page de vente",
    items: [
      "Tu appliques la méthode OFFRE™ (Observer → Formuler → Fabriquer → Renforcer → Emballer)",
      "Tu écris un texte de vente qui convertit — sans sonner comme une pub",
      "Tu fixes ton prix avec la stack de valeur (5 techniques)",
      "Tu crées ta page de vente complète (template fourni)",
    ],
    livrable: "Offre structurée + page de vente publiée",
  },
  {
    week: "Semaine 4",
    tag: "Boutique",
    title: "Ouvre ta boutique et automatise tout",
    sub: "Cas pratique Chariow, paiements Mobile Money, relances automatiques",
    items: [
      "Tu configures ta boutique de A à Z sur Chariow",
      "Tu actives les paiements (Wave, Orange Money, carte bancaire)",
      "Tu paramètres la livraison automatique et les relances",
      "Tu testes ton parcours client complet",
    ],
    livrable: "Boutique en ligne + paiement testé + livraison fonctionnelle",
  },
  {
    week: "Semaine 5",
    tag: "Lancement",
    title: "Lance tes publicités et attire tes premiers clients",
    sub: "Facebook Ads, contenu organique, stratégie d'acquisition 30 jours",
    items: [
      "Tu crées ton plan d'acquisition (actions quotidiennes)",
      "Tu lances ta première campagne Facebook (budget : 3 000 FCFA/jour)",
      "Tu publies du contenu sur 2+ plateformes",
      "Tu mets en place ton tableau de bord de suivi",
    ],
    livrable: "Campagne active + contenu diffusé + tableau de bord",
  },
];

const bonuses = [
  { icon: "🤖", title: "Bot Telegram Coach Godwin IA", desc: "Feedback 24 h/24 sur tes livrables. Il valide tes idées, relit tes offres, corrige tes pages. Comme si j'étais dans ta poche.", value: "Inestimable" },
  { icon: "📊", title: "Banque de 100 niches rentables", desc: "Avec chiffres, exemples et promesses prêtes à copier. Trouve ton idée en 30 minutes au lieu de 3 semaines.", value: "25 000 FCFA" },
  { icon: "💡", title: "Pack 50 idées de produits digitaux validés", desc: "Chaque idée vient avec sa promesse, son prix recommandé et sa cible. Des produits qui se sont déjà vendus.", value: "25 000 FCFA" },
  { icon: "✍️", title: "10 prompts IA pour créer 3× plus vite", desc: "Les prompts exacts que j'utilise pour écrire un ebook, une page de vente ou une formation en une fraction du temps.", value: "20 000 FCFA" },
  { icon: "🎨", title: "Template page de vente Canva", desc: "Design professionnel, prêt à remplir. Pas besoin d'être graphiste.", value: "20 000 FCFA" },
  { icon: "📱", title: "Pack 15 scripts WhatsApp", desc: "Prospection, relance, objection, closing. Copie, colle, adapte.", value: "15 000 FCFA" },
  { icon: "👥", title: "Communauté privée des diplômés", desc: "Réseau, entraide, opportunités.", value: "Inestimable" },
  { icon: "🔁", title: "Replay des 10 lives à vie", desc: "+ mises à jour du programme incluses.", value: "75 000 FCFA" },
];

const faqs = [
  { q: "Je n'ai jamais vendu quoi que ce soit en ligne. Ce parcours est vraiment pour moi ?", a: "Oui. C'est exactement pour toi. Le parcours est conçu pour les débutants complets — la première phase t'apprend à valider ton idée avant même de créer ton produit. Tu n'as pas besoin d'audience, de site web ou d'expérience." },
  { q: "J'ai un emploi à temps plein. Est-ce que je peux suivre le rythme ?", a: "Oui. Le parcours demande environ 1 h par jour + 2 lives de 90 minutes par semaine. Les lives sont enregistrés si tu ne peux pas être présent. Des centaines de salariés ont suivi mes programmes avant toi." },
  { q: "Est-ce que je dois être un expert en tech ou en IA ?", a: "Non. Si tu sais envoyer un message WhatsApp et utiliser Google, tu as le niveau. On utilise l'IA pour accélérer la création (prompts fournis, tutoriels pas à pas), mais tu n'as besoin d'aucune compétence technique." },
  { q: "Et si je n'ai pas de compétence à monétiser ?", a: "Tout le monde a une compétence. Tu sais peut-être cuisiner, organiser, écrire, parler anglais, gérer des réseaux sociaux, utiliser Excel, coiffer, maquiller, conseiller… La Phase 1 est spécifiquement conçue pour t'aider à identifier ta compétence monétisable — même si tu penses n'en avoir aucune." },
  { q: "65 000 FCFA, c'est un investissement. Comment être sûr que ça va marcher ?", a: "C'est pour ça qu'on a une garantie. Si tu exécutes le programme et qu'à J+30 tu n'as pas de produit en ligne, on continue de t'accompagner gratuitement. Le risque est de notre côté." },
  { q: "Est-ce que je reçois un certificat ?", a: "Oui. Mais la vraie certification, c'est ton produit en ligne et tes premières ventes. Un PDF ne paie pas tes factures." },
  { q: "Quelle est la différence entre ce parcours et les formations gratuites sur YouTube ?", a: "YouTube te donne des morceaux. Bweb Academy te fait construire un système complet, dans le bon ordre, avec des livrables obligatoires à chaque étape. Tu repars avec un produit fini, pas avec une liste de vidéos regardées." },
  { q: "Je suis au Cameroun / Sénégal / Bénin / Burkina… je peux participer ?", a: "Oui. La formation est 100 % accessible en ligne (Zoom). Les paiements fonctionnent avec Mobile Money (Wave, Orange Money). Les exemples et templates sont adaptés à l'Afrique francophone." },
];
---

<BaseLayout
  title="Parcours Initiation aux Produits Digitaux | Bweb Academy"
  description={`En 30 jours, transforme une compétence que tu possèdes déjà en un produit digital prêt à vendre, mets-le en ligne et décroche tes premières ventes. Cohorte ${COHORTE_LABEL} — ${CAPACITE} places.`}
  hideWhatsApp={true}
  bareChrome={true}
>
  <!-- Meta Pixel (verbatim, dans le <head>) -->
  <Fragment slot="head">
    <MetaPixel id="150267587094280" />
  </Fragment>

  <!-- ============================================================
       1 · HERO (clair) -->
  <header class="pi-hero" data-nav-section="Le parcours">
    <div class="pi-hero-halo" aria-hidden="true"></div>
    <img class="pi-hero-glass pi-hero-glass--right" src="/images/parcours-initiation/glass-shapes.webp" alt="" aria-hidden="true" width="1200" height="675" loading="eager" decoding="async" />
    <img class="pi-hero-glass pi-hero-glass--left" src="/images/parcours-initiation/glass-shapes.webp" alt="" aria-hidden="true" width="1200" height="675" loading="lazy" decoding="async" />
    <div class="container">
      <div class="pi-hero-inner">
        <span class="pi-badge-urgence" data-hero-in>🚀 Cohorte {COHORTE_LABEL} — {CAPACITE} places uniquement</span>

        <h1 data-hero-in>
          Tu possèdes déjà une compétence qui peut te rapporter <span class="pi-hl-gold">325 000 FCFA</span> par mois.
          <span class="pi-h1-hook">Et si tu la transformais en produit digital en 30 jours&nbsp;?</span>
        </h1>

        <p class="lead pi-hero-sub" data-hero-in>
          Un parcours de 5 semaines pour créer, lancer et vendre ton premier produit digital
          — même si tu n'as jamais rien vendu en ligne.
        </p>

        <div class="pi-hero-cta" data-hero-in>
          <a href="#reserver" class="pi-btn-buy pi-cta">Je réserve ma place — 65 000 FCFA <span class="pi-arrow">→</span></a>
          <p class="pi-cta-note">Prochaine cohorte : {COHORTE_LABEL} · {CAPACITE} places · Paiement sécurisé</p>
        </div>

        <div class="pi-proof" data-hero-in>
          {proof.map((p) => (
            <div class="pi-proof-chip"><b>{p.n}</b> <span>{p.t}</span></div>
          ))}
        </div>

        <!-- Vidéo hero : preuve et explication, après l'action principale. -->
        <div class="pi-video pi-video--wide" id="heroVideo" data-hero-in>
          <button class="pi-video-ph" id="heroPlay" type="button" aria-label="Lire la vidéo de présentation">
            <img class="pi-video-cover" src="/images/parcours-initiation/hero-cover.webp" alt="Entrepreneur en train de construire son produit digital sur son ordinateur" width="1400" height="788" fetchpriority="high" />
            <span class="pi-video-shade" aria-hidden="true"></span>
            <span class="pi-play"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span>
            <span class="pi-video-lbl">Regarde comment on construit ton produit, ensemble (2 min)</span>
          </button>
          <iframe id="heroFrame" title="Vidéo de présentation — Parcours Initiation" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen hidden></iframe>
        </div>
      </div>
    </div>
  </header>

  <!-- Countdown -->
  <div class="pi-countdown">
    <div class="container pi-countdown-inner">
      <span class="pi-countdown-label">⏳ Fin des inscriptions dans</span>
      <div class="pi-fcd pi-countdown-clock" id="countdown" data-target={ECHEANCE_ISO}>
        <span class="pi-fcd-box"><span class="n" data-cd="d">00</span><span class="u">Jours</span></span>
        <span class="pi-fcd-sep" aria-hidden="true">:</span>
        <span class="pi-fcd-box"><span class="n" data-cd="h">00</span><span class="u">Heures</span></span>
        <span class="pi-fcd-sep" aria-hidden="true">:</span>
        <span class="pi-fcd-box"><span class="n" data-cd="m">00</span><span class="u">Min</span></span>
        <span class="pi-fcd-sep" aria-hidden="true">:</span>
        <span class="pi-fcd-box"><span class="n" data-cd="s">00</span><span class="u">Sec</span></span>
      </div>
    </div>
  </div>

  <!-- ============================================================
       2 · PROBLÈME -->
  <section class="section" data-nav-section="Le problème">
    <div class="container pi-narrow">
      <div class="section-head center reveal">
        <div class="eyebrow" style="justify-content:center">Reconnais-tu ça&nbsp;?</div>
        <h2>Tu passes tes soirées à chercher. Et au final, t'as toujours rien lancé.</h2>
      </div>
      <div class="pi-prose reveal">
        <p>Tu as une compétence. Tu sais faire quelque chose que d'autres aimeraient apprendre.</p>
        <p>Tu regardes des vidéos TikTok. Des tutos YouTube. Tu suis des créateurs sur Instagram. Tu enregistres des publications. Tu achètes parfois des petites formations à 5 000 ou 10 000 FCFA.</p>
        <p>Mais chaque personne te donne une méthode différente. L'un te dit de créer un ebook. L'autre te dit de construire une audience d'abord. Un autre te dit que tu peux vendre sans audience.</p>
        <p class="pi-prose-punch">Résultat : tu apprends beaucoup. Mais tu ne lances rien.</p>
      </div>

      <figure class="pi-quote reveal">
        <blockquote>« Je sais que je pourrais gagner de l'argent avec ce que je sais. Mais je ne sais pas quoi vendre, ni comment le transformer en produit, ni comment trouver des gens prêts à payer. »</blockquote>
        <figcaption>C'est peut-être toi, à 23 h, dans ton lit, en train de chercher « comment créer un produit digital » sur YouTube.</figcaption>
      </figure>
    </div>
  </section>

  <!-- ============================================================
       3 · AGITATION -->
  <section class="section section-gray" data-nav-section="Le coût de l'inaction">
    <div class="container pi-narrow">
      <div class="section-head center reveal">
        <div class="eyebrow" style="justify-content:center">Le coût de l'inaction</div>
        <h2>Pendant ce temps, des gens moins compétents que toi encaissent des paiements tous les jours.</h2>
        <p class="lead">Chaque mois que tu passes sans agir&nbsp;:</p>
      </div>

      <ul class="pi-cost reveal" data-stagger>
        <li><span class="pi-cost-ico">💸</span><p>Tu laisses <b>100 000 à 300 000 FCFA</b> de revenu supplémentaire sur la table.</p></li>
        <li><span class="pi-cost-ico">👀</span><p>Tu regardes des freelances moins expérimentés que toi signer des clients à <b>150 000 FCFA/mois</b>.</p></li>
        <li><span class="pi-cost-ico">🎁</span><p>Tu donnes tes conseils gratuitement dans des groupes WhatsApp pendant que d'autres les vendent sous forme de formation.</p></li>
        <li><span class="pi-cost-ico">⏳</span><p>Tu passes ~260 heures par an à consommer du contenu sans jamais exécuter. C'est plus de <b>32 journées de travail complètes</b>.</p></li>
      </ul>

      <div class="pi-projection reveal">
        <div class="pi-proj-item"><span class="pi-proj-h">Dans 1 an</span><span class="pi-proj-n">− 1 200 000 FCFA</span><span class="pi-proj-s">de revenu supplémentaire perdu</span></div>
        <div class="pi-proj-item"><span class="pi-proj-h">Dans 3 ans</span><span class="pi-proj-n">− 3 600 000 FCFA</span><span class="pi-proj-s">de revenu supplémentaire perdu</span></div>
      </div>

      <p class="pi-reframe reveal">Les 65 000 FCFA de ce parcours, c'est environ <b>5 jours de ton salaire actuel</b> — pour apprendre une compétence qui peut te rapporter tous les mois.</p>
    </div>
  </section>

  <!-- ============================================================
       4 · SOLUTION -->
  <section class="section" data-nav-section="La solution">
    <div class="container">
      <div class="section-head center reveal">
        <div class="eyebrow" style="justify-content:center">La solution</div>
        <h2>Le Parcours Initiation Bweb Academy&nbsp;: 30 jours pour transformer ta compétence en produit digital qui se vend.</h2>
        <span class="pi-tag-atelier">📦 Un atelier de production, pas une bibliothèque de cours.</span>
      </div>

      <div class="pi-solution-grid">
        <div class="pi-solution-text reveal">
          <p class="lead">YouTube t'apprend des choses. Bweb Academy te fait <b>sortir avec quelque chose de construit, testé et mis sur le marché.</b></p>
          <p>Tu ne viens pas pour « apprendre les produits digitaux ». Tu viens avec ta compétence, et tu repars avec&nbsp;:</p>
          <ul class="tick-list card pi-outcomes">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Ton produit créé et accessible en ligne</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Ton offre structurée (promesse, prix, cible)</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Ta page de vente publiée</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Ta boutique configurée avec paiement Mobile Money</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Ta campagne d'acquisition lancée</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Tes premiers prospects contactés</li>
          </ul>
        </div>
        <div class="pi-solution-side reveal" data-delay=".1">
          <figure class="pi-solution-art">
            <img src="/images/parcours-initiation/glass-orbit.webp" alt="Formes 3D abstraites représentant la progression du parcours" width="1200" height="800" loading="lazy" decoding="async" />
          </figure>
          <div class="pi-promise">
            En 30 jours, transforme une compétence que tu possèdes déjà en un produit digital prêt à vendre, mets-le en ligne et lance-toi pour décrocher tes premières ventes.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       5 · MÉCANIQUE (5 phases) -->
  <section class="section section-gray" id="programme" data-nav-section="Le programme">
    <div class="container">
      <div class="section-head center reveal">
        <div class="eyebrow" style="justify-content:center">Le programme</div>
        <h2><span class="pi-h2-accent">5 phases. 10 lives. 30 jours.</span> Voici exactement ce que tu vas construire.</h2>
        <p class="lead">Clique sur chaque phase pour voir ce que tu produis — et ce que tu repars avec.</p>
      </div>

      <div class="pi-stepper reveal">
        <div class="pi-steps" id="steps" style={`--n:${phases.length}`}>
          <div class="pi-steps-track" aria-hidden="true"></div>
          <div class="pi-steps-fill" id="stepsFill" aria-hidden="true"></div>
          {phases.map((p, i) => (
            <button class:list={["pi-step", { active: i === 0 }]} data-i={i} type="button" aria-label={`Phase ${i + 1} : ${p.tag}`}>
              <span class="pi-dot">{i + 1}</span>
              <span class="pi-step-week">{p.week}</span>
              <span class="pi-step-tag">{p.tag}</span>
            </button>
          ))}
        </div>

        <div class="pi-panel" id="panel">
          {phases.map((p, i) => (
            <div class:list={["pi-panel-body", { on: i === 0 }]} data-i={i}>
              <div class="pi-panel-main">
                <span class="pi-phase-pill">Phase {i + 1} · {p.week}</span>
                <h3>{p.title}</h3>
                <p class="pi-panel-sub">{p.sub}</p>
                <ul class="pi-panel-list">
                  {p.items.map((it) => <li>{it}</li>)}
                </ul>
                <div class="pi-livrable"><span class="pi-livrable-ico">🎯</span><span><b>Livrable&nbsp;:</b> {p.livrable}</span></div>
                <div class="pi-panel-nav">
                  <span class="pi-counter">Phase {i + 1} / {phases.length}</span>
                  <div class="pi-panel-nav-btns">
