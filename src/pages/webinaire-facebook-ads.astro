---
/* Rendu à la demande : la date, la durée et le groupe viennent de l'édition en
   cours (écran /admin/webinaires, entonnoir « webinaire-facebook-ads »). Le
   prochain live se règle en dupliquant l'édition, sans toucher à ce fichier. */
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import VideoLazy from "../components/VideoLazy.astro";
import { supabase } from "../lib/supabase";
import { whatsappLink } from "../config/site";
/* Tuiles .tb-* partagées avec le reste du site (voir webinaire-initiation). */
import "../styles/tiles.css";

/* =========================================================
   WEBINAIRE « 1 M/mois avec les produits digitaux grâce à la pub Facebook »
   Landing sans formulaire : rejoindre le groupe WhatsApp EST l'inscription.
   Un formulaire de plus, c'est un écran de plus entre l'envie et le geste,
   sur un téléphone venu de la publicité. Le lien du live, les rappels et
   l'offre de fin de live passent par le groupe.
   ---------------------------------------------------------
   Réglé dans /admin/webinaires (édition « Inscription par le groupe ») :
   date, durée, lien du groupe WhatsApp. Chaque clic vers le groupe y est
   compté (/api/webinaire/clic).
   Reste ici : VIDEO_ID, l'ID YouTube de la vidéo de présentation. Vide = pas
   de bloc vidéo en ligne.
   ========================================================= */

const TUNNEL = "webinaire-facebook-ads";
const VIDEO_ID = "UBsffwlxOh8";

/* Base injoignable : on garde l'édition du 4 octobre plutôt qu'une landing
   vide. Le « Z » compte : sans lui, le navigateur lirait 19:00 dans SON fuseau
   et un visiteur à Paris verrait un décompte faux de 2 heures. */
const SECOURS = {
  starts_at: "2026-10-04T19:00:00Z",
  duration_min: 90,
  groupe_url: "https://chat.whatsapp.com/Gg9cYqejJB71h9OMMmP2MM",
};
const { data: editionRows } = await supabase.rpc("webinaire_public", { p_slug: TUNNEL });
const edition = (Array.isArray(editionRows) ? editionRows[0] : editionRows) ?? null;

const LIVE_ISO = edition?.starts_at ?? SECOURS.starts_at;
const DUREE = edition?.duration_min ?? SECOURS.duration_min;
/* Édition trouvée mais sans groupe renseigné : les boutons ouvrent une
   discussion avec l'agence, jamais un lien mort. */
const GROUPE_WHATSAPP = edition ? (edition.groupe_url ?? "") : SECOURS.groupe_url;

/* Trafic publicitaire : cache de 5 minutes au bord, comme la landing du
   webinaire à formulaire. Une date changée en admin met au plus ce délai à
   se propager. */
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=300, stale-while-revalidate=600");

const TZ = "Africa/Abidjan";
const dateLive = new Date(LIVE_ISO);
/* « Dimanche 4 octobre » */
const JOUR = (() => {
  const j = dateLive.toLocaleDateString("fr-FR", { weekday: "long", day: "numeric", month: "long", timeZone: TZ });
  return j.charAt(0).toUpperCase() + j.slice(1);
})();
const jour = JOUR.toLowerCase();
/* « 19 h » */
const HEURE = dateLive
  .toLocaleTimeString("fr-FR", { hour: "2-digit", minute: "2-digit", timeZone: TZ })
  .replace(":", " h ")
  .replace(/ h 00$/, " h");

/* Nom du Lead envoyé à Meta : « Webinaire Facebook Ads 04-10 ». La date
   distingue les éditions dans le gestionnaire d'événements et permet une
   conversion personnalisée par live ; elle suit l'édition en base. */
const NOM_LEAD = `Webinaire Facebook Ads ${dateLive
  .toLocaleDateString("fr-FR", { day: "2-digit", month: "2-digit", timeZone: TZ })
  .replace("/", "-")}`;

const AVEC_GROUPE = GROUPE_WHATSAPP !== "";
const LIEN = AVEC_GROUPE
  ? GROUPE_WHATSAPP
  : whatsappLink(`Bonjour, je veux participer au live du ${jour} à ${HEURE} : « Comment tu peux gagner +33 000 FCFA/jour avec les produits digitaux grâce à la publicité Facebook ». Envoyez-moi le lien.`);
/* Le libellé dit ce qui va se passer : « rejoindre un groupe » quand on
   ouvre un groupe, « recevoir le lien » quand on ouvre une discussion. */
const CTA = AVEC_GROUPE ? "Rejoindre le groupe WhatsApp du live" : "Recevoir le lien du live sur WhatsApp";
const CTA_COURT = AVEC_GROUPE ? "Rejoindre le groupe — gratuit" : "Recevoir le lien — gratuit";
---

<BaseLayout
  title="Webinaire gratuit — +33 000 FCFA/jour avec la pub Facebook | Bweb Academy"
  description={`Live gratuit le ${jour} à ${HEURE} (Abidjan) : comment gagner +33 000 FCFA par jour avec les produits digitaux grâce à la publicité Facebook. Rejoins le groupe WhatsApp du live.`}
  hideWhatsApp={true}
  bareChrome={true}
>

  <!-- ═══════════ 1 · HERO ═══════════ -->
  <header class="fb-hero">
    <div class="fb-hero-halo" aria-hidden="true"></div>
    <div class="container fb-hero-inner">
      <span class="fb-badge-live" data-hero-in>
        <span class="fb-dot" aria-hidden="true"></span>
        Live gratuit · {JOUR} · {HEURE}
      </span>

      <h1 data-hero-in>
        Comment tu peux gagner +33&nbsp;000&nbsp;FCFA/jour avec les produits digitaux
        <span class="fb-h1-accent">grâce à la publicité Facebook.</span>
      </h1>

      <p class="lead fb-hero-sub" data-hero-in>
        <b>{DUREE} minutes en direct</b> pour comprendre comment une publicité à quelques
        milliers de FCFA par jour peut vendre ton produit digital pendant que tu dors.
      </p>

      {VIDEO_ID && (
        <div class="fb-video-slot" data-hero-in>
          <VideoLazy
            id={VIDEO_ID}
            autoplay
            label="Découvre en 1 minute ce qu'on va voir ensemble"
            title="Présentation du webinaire — Godwin Soola"
          />
        </div>
      )}

      <div class="fb-hero-cta" data-hero-in>
        <a href={LIEN} class="fb-cta fb-cta--glow" target="_blank" rel="noopener" data-fb-join>
          <svg class="fb-wa" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2m0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23a8.2 8.2 0 0 1 8.24 8.24c0 4.54-3.7 8.23-8.24 8.23m4.52-6.16c-.25-.13-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.22.25-.87.85-.87 2.07s.9 2.4 1.02 2.56c.12.17 1.75 2.67 4.25 3.75.59.25 1.05.4 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29"/></svg>
          {CTA}
        </a>
        <p class="fb-cta-note">Gratuit · aucun formulaire · le lien du live est partagé dans le groupe</p>
      </div>

      <div class="fb-countdown" data-hero-in>
        <span class="fb-cd-label" data-cd-label>⏳ Le live démarre dans</span>
        <div class="fb-cd" data-countdown={LIVE_ISO} data-duree={DUREE}>
          <span class="fb-cd-box"><b data-cd="d">00</b><span>Jours</span></span>
          <span class="fb-cd-sep">:</span>
          <span class="fb-cd-box"><b data-cd="h">00</b><span>Heures</span></span>
          <span class="fb-cd-sep">:</span>
          <span class="fb-cd-box"><b data-cd="m">00</b><span>Min</span></span>
          <span class="fb-cd-sep">:</span>
          <span class="fb-cd-box"><b data-cd="s">00</b><span>Sec</span></span>
        </div>
      </div>
    </div>
  </header>

  <!-- ═══════════ 2 · CE QUE TU VAS VOIR ═══════════ -->
  <section class="section" data-nav-section="Le contenu">
    <div class="container">
      <div class="section-head center reveal">
        <div class="eyebrow" style="justify-content:center">Le contenu du live</div>
        <h2>Ce que tu repars avec, en {DUREE} minutes</h2>
      </div>

      <div class="tb-bento fb-bento" data-stagger>
        <article class="tb-tile" style="--c:#1f6ced">
          <span class="tb-num">01</span>
          <span class="tb-ic"><svg viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="m7 15 4-4 3 3 5-6"/></svg></span>
          <h3>La campagne à 3&nbsp;000&nbsp;FCFA par jour</h3>
          <p>Comment monter ta première campagne pour vendre un produit digital, sans brûler ton budget en « boostant » des publications.</p>
        </article>
        <article class="tb-tile" style="--c:#ff835f">
          <span class="tb-num">02</span>
          <span class="tb-ic"><svg viewBox="0 0 24 24"><path d="M13 2 4.5 13H11l-1 9 8.5-11H12z"/></svg></span>
          <h3>La publicité qui fait acheter</h3>
          <p>L'accroche, la vidéo et le texte&nbsp;: ce qui arrête le pouce sur le fil d'actualité, et ce qui fait cliquer jusqu'au paiement.</p>
        </article>
        <article class="tb-tile" style="--c:#00c89e">
          <span class="tb-num">03</span>
          <span class="tb-ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9.5 9.5c0-1.1 1.1-1.8 2.5-1.8s2.5.7 2.5 1.8-1 1.6-2.5 2-2.5.9-2.5 2 1.1 1.8 2.5 1.8 2.5-.7 2.5-1.8"/></svg></span>
          <h3>Le calcul du million</h3>
          <p>Prix, coût par vente, budget&nbsp;: les chiffres à atteindre pour 1&nbsp;000&nbsp;000&nbsp;FCFA par mois, et où les lire dans ton gestionnaire de publicités.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ═══════════ 3 · LE CALCUL (rupture navy) ═══════════ -->
  <section class="section fb-math" data-nav-section="Le calcul">
    <div class="container fb-math-inner">
      <div class="eyebrow on-dark reveal" style="justify-content:center">Pas de magie, un calcul</div>
      <h2 class="reveal">1&nbsp;000&nbsp;000&nbsp;FCFA par mois, ça fait <span class="fb-gold">combien de ventes&nbsp;?</span></h2>
      <div class="fb-eq reveal">
        <div class="fb-eq-item"><b>100</b><span>ventes par mois</span></div>
        <span class="fb-eq-op" aria-hidden="true">×</span>
        <div class="fb-eq-item"><b>10&nbsp;000</b><span>FCFA le produit</span></div>
        <span class="fb-eq-op" aria-hidden="true">=</span>
        <div class="fb-eq-item fb-eq-item--total"><b>1&nbsp;M</b><span>FCFA par mois</span></div>
      </div>
      <p class="fb-math-text reveal">
        100 ventes par mois, c'est <b>un peu plus de 3 ventes par jour</b>. Personne ne les obtient en
        envoyant des messages un par un. La publicité Facebook, si. Le live te montre comment elle fait
        ce travail chaque jour, et comment savoir si ta campagne gagne de l'argent ou en perd.
      </p>
    </div>
  </section>

  <!-- ═══════════ 4 · POUR QUI / PAS POUR QUI ═══════════ -->
  <section class="section section-gray" data-nav-section="Pour qui">
    <div class="container">
      <div class="section-head center reveal">
        <div class="eyebrow" style="justify-content:center">Le filtre</div>
        <h2>Ce live est fait pour toi… ou pas.</h2>
      </div>

      <div class="fb-fit-grid">
        <div class="fb-fit fb-fit--yes reveal">
          <h3><span class="fb-fit-ico" aria-hidden="true">✓</span> C'est pour toi si…</h3>
          <ul>
            <li>Tu as un produit digital, ou une idée, mais presque personne ne l'achète</li>
            <li>Tu as déjà « boosté » une publication sans rien vendre</li>
            <li>Tu veux vendre tous les jours sans passer tes journées dans les messages privés</li>
          </ul>
        </div>
        <div class="fb-fit fb-fit--no reveal" data-delay=".1">
          <h3><span class="fb-fit-ico" aria-hidden="true">✕</span> Ce n'est pas pour toi si…</h3>
          <ul>
            <li>Tu veux gagner sans rien investir, ni temps ni budget publicitaire</li>
            <li>Tu n'es pas prêt à tester, mesurer et ajuster ce qui ne marche pas</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ 5 · QUI ANIME ═══════════ -->
  <section class="section" data-nav-section="L'animateur">
    <div class="container">
      <div class="fb-host reveal">
        <div class="fb-host-photo" aria-hidden="true">
          <img src="/images/godwin-soola.webp" alt="" width="800" height="800" loading="lazy" decoding="async" />
        </div>
        <div class="fb-host-body">
          <div class="eyebrow">Animé par</div>
          <h2>Godwin Soola</h2>
          <p class="lead">Fondateur de Bweb Agence, spécialiste en marketing digital, ayant déjà aidé ses apprenants à générer plus de <b>300&nbsp;000&nbsp;000&nbsp;FCFA</b> avec les produits digitaux.</p>
          <ul class="fb-host-stats">
            <li><b>42 948 €</b><span>investis en publicité Facebook</span></li>
            <li><b>17 116</b><span>personnes formées</span></li>
            <li><b>95 %</b><span>d'avis positifs sur 593 clients</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ 6 · APPEL FINAL + FAQ ═══════════ -->
  <section class="section section-gray" data-nav-section="Questions">
    <div class="container fb-narrow">
      <div class="fb-final reveal">
        <h2>{JOUR}, {HEURE}. On t'attend.</h2>
        <p>Rejoins le groupe maintenant&nbsp;: c'est là que tu reçois le lien du live et les rappels.</p>
        <a href={LIEN} class="fb-cta fb-cta--glow" target="_blank" rel="noopener" data-fb-join>{CTA} <span class="fb-arrow">→</span></a>
      </div>

      <div class="fb-faq reveal">
        <div class="fb-faq-item">
          <button class="fb-faq-q" type="button" aria-expanded="false">
            <span>C'est vraiment gratuit&nbsp;?</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
          <div class="fb-faq-a"><div class="fb-faq-a-in">Oui. Le live est gratuit et tu repars avec la méthode. À la fin, je présente le Parcours Initiation&nbsp;: optionnel, 65&nbsp;000&nbsp;FCFA. Tu n'es obligé à rien.</div></div>
        </div>
        <div class="fb-faq-item">
          <button class="fb-faq-q" type="button" aria-expanded="false">
            <span>Je n'ai pas encore de produit digital. Ça me concerne&nbsp;?</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
          <div class="fb-faq-a"><div class="fb-faq-a-in">Oui. Tu sauras ce qu'un produit doit avoir pour se vendre en publicité avant même de le créer. C'est le meilleur moment pour l'apprendre.</div></div>
        </div>
        <div class="fb-faq-item">
          <button class="fb-faq-q" type="button" aria-expanded="false">
            <span>Il faut quel budget publicitaire&nbsp;?</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
          <div class="fb-faq-a"><div class="fb-faq-a-in">Rien pour assister au live. Pour lancer ta première campagne ensuite, on part de 3&nbsp;000&nbsp;FCFA par jour, et le live te montre comment ne pas les dépenser à l'aveugle.</div></div>
        </div>
        <div class="fb-faq-item">
          <button class="fb-faq-q" type="button" aria-expanded="false">
            <span>Je ne peux pas être là à {HEURE}&nbsp;?</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
          <div class="fb-faq-a"><div class="fb-faq-a-in">Rejoins quand même le groupe&nbsp;: tout ce qui concerne le live y est partagé. Mais en direct, tu peux poser tes questions sur ton cas à toi, et ça, un enregistrement ne le fait pas.</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA collant mobile -->
  <div class="fb-sticky">
    <a href={LIEN} class="fb-cta fb-sticky-cta" target="_blank" rel="noopener" data-fb-join>{CTA_COURT} →</a>
  </div>

  <script is:inline define:vars={{ TUNNEL, LIVE_ISO, NOM_LEAD }}>
    (function () {
      /* ---------- Compte à rebours ----------
         Avant le live : le décompte. Pendant : « en direct », le groupe reste
         la porte d'entrée. Après : le décompte disparaît plutôt que de rester
         bloqué sur 00:00:00. */
      var root = document.querySelector("[data-countdown]");
      if (root) {
        var label = document.querySelector("[data-cd-label]");
        var debut = new Date(root.getAttribute("data-countdown")).getTime();
        var fin = debut + Number(root.getAttribute("data-duree") || 90) * 60000;
        var pad = function (v) { return String(v).padStart(2, "0"); };
        var timer;
        var tick = function () {
          var now = Date.now();
          if (now >= fin) {
            root.hidden = true;
            if (label) label.textContent = "Le live est terminé · rejoins le groupe pour la suite";
            clearInterval(timer);
            return;
          }
          if (now >= debut) {
            root.hidden = true;
            if (label) label.textContent = "🔴 En direct maintenant · rejoins le groupe pour le lien";
            return;
          }
          var d = debut - now;
          root.querySelector('[data-cd="d"]').textContent = pad(Math.floor(d / 86400000));
          root.querySelector('[data-cd="h"]').textContent = pad(Math.floor((d % 86400000) / 3600000));
          root.querySelector('[data-cd="m"]').textContent = pad(Math.floor((d % 3600000) / 60000));
          root.querySelector('[data-cd="s"]').textContent = pad(Math.floor((d % 60000) / 1000));
        };
        tick();
        timer = setInterval(tick, 1000);
      }

      /* ---------- Conversion ----------
         Pas de formulaire : le clic vers WhatsApp EST l'inscription, c'est
         donc lui qui part en Lead vers Meta. Un seul Lead par visiteur, même
         s'il clique trois boutons, sinon le coût par inscrit est sous-évalué.

         Sur téléphone, le lien bascule aussitôt dans l'app WhatsApp et le
         navigateur met la page en pause : un Lead encore en file d'attente
         (pixel pas fini de charger, réseau lent) ne partait jamais. On retient
         donc la navigation le temps que le pixel soit chargé et ait envoyé
         l'événement, 1,5 s au plus : au-delà, on laisse partir le visiteur
         plutôt que de le bloquer sur un bouton qui ne répond pas.

         Le même premier clic est enregistré en base (/api/webinaire/clic) :
         c'est le compteur « ont rejoint le groupe » de /admin/webinaires. La
         clé porte la date de l'édition, pour qu'un visiteur d'octobre compte
         à nouveau au live suivant. */
      var CLE_LEAD = "bweb_lead_" + TUNNEL + "_" + String(LIVE_ISO).slice(0, 10);
      var visiteurId = function () {
        var id = "";
        try { id = localStorage.getItem("bweb_visiteur") || ""; } catch (e) {}
        if (!/^[a-z0-9-]{8,64}$/.test(id)) {
          id = (window.crypto && crypto.randomUUID)
            ? crypto.randomUUID()
            : Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 12);
          try { localStorage.setItem("bweb_visiteur", id); } catch (e) {}
        }
        return id;
      };
      var enregistrerClic = function () {
        var p = new URLSearchParams(location.search);
        try {
          /* `keepalive` : la requête survit au départ vers WhatsApp. */
          fetch("/api/webinaire/clic", {
            method: "POST",
            keepalive: true,
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              tunnel: TUNNEL,
              visiteur: visiteurId(),
              source: p.get("utm_source") || (p.get("fbclid") ? "facebook" : ""),
              campagne: p.get("utm_campaign") || "",
            }),
          }).catch(function () {});
        } catch (e) {}
      };
      /* Vrai si un Lead vient de partir (il faut alors lui laisser le temps). */
      var envoyerLead = function () {
        try {
          if (localStorage.getItem(CLE_LEAD)) return false;
          localStorage.setItem(CLE_LEAD, String(Date.now()));
        } catch (e) {}
        enregistrerClic();
        if (!window.fbq) return false;
        window.fbq("track", "Lead", { content_name: NOM_LEAD });
        return true;
      };
      var enRoute = false;
      document.querySelectorAll("[data-fb-join]").forEach(function (a) {
        a.addEventListener("click", function (e) {
          /* Ctrl/Cmd-clic, clic molette : le navigateur ouvre un onglet et la
             page reste là, l'événement a tout le temps de partir. */
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) { envoyerLead(); return; }
          e.preventDefault();
          if (enRoute) return;
          enRoute = true;
          var href = a.href;
          if (!envoyerLead()) { location.href = href; return; }
          var t0 = Date.now();
          (function attendre() {
            /* `callMethod` n'existe qu'une fois fbevents.js chargé : avant,
               l'événement n'est qu'en file d'attente. */
            var charge = !!(window.fbq && window.fbq.callMethod);
            if (charge || Date.now() - t0 > 1500) {
              setTimeout(function () { location.href = href; }, charge ? 300 : 0);
            } else {
              setTimeout(attendre, 100);
            }
          })();
        });
      });
      /* Retour arrière depuis WhatsApp : la page revient du cache, les
         boutons doivent de nouveau répondre. */
      window.addEventListener("pageshow", function () { enRoute = false; });

      /* ---------- FAQ ---------- */
      document.querySelectorAll(".fb-faq-q").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var item = btn.parentElement;
          var open = item.classList.contains("open");
          document.querySelectorAll(".fb-faq-item.open").forEach(function (i) {
            i.classList.remove("open");
