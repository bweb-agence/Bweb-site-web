---
import BaseLayout from "../layouts/BaseLayout.astro";
import PhoneField from "../components/PhoneField.astro";
---

<BaseLayout title="Demande de devis — Projet IA & digital | Bweb" description="Décrivez votre projet IA, digital ou de formation : Bweb vous répond avec une proposition claire et personnalisée.">
<section class="page-hero" data-nav-section="Devis">
  <div class="mesh-bg"></div>
  <div class="grid-lines"></div>
  <div class="container">
    <div class="breadcrumb"><a href="/">Accueil</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
      <span>Demande de devis</span>
    </div>
    <div class="text-white" data-hero-in style="max-width:760px">
      <div class="eyebrow on-dark">Demande de devis</div>
      <h1>Décrivez votre projet, on vous répond.</h1>
      <p class="lead">Plus votre demande est précise, plus notre proposition le sera. Comptez 5 minutes pour la compléter.</p>
    </div>
  </div>
</section>

<section class="section" data-nav-section="Le formulaire">
  <div class="container">
    <div class="container-narrow">
      <div class="form-card reveal">
        <!-- Formulaire segmenté en assistant multi-étapes par src/scripts/wizard.ts.
             Sans JS, toutes les étapes restent visibles et le formulaire fonctionne
             normalement (soumission gérée par src/scripts/forms.ts). -->
        <form data-form data-wizard data-wizard-cta="Démarrer ma demande" data-form-title="Nouvelle demande de devis">
          <!-- Honeypot anti-spam : masqué aux humains, laissé vide ; rejeté côté serveur si rempli. -->
          <div class="hp-field" aria-hidden="true"><label>Ne pas remplir<input type="text" name="company_site" tabindex="-1" autocomplete="off" /></label></div>

          <!-- Étape 1 — Le besoin (une question simple pour démarrer) -->
          <div class="wizard-step" data-wizard-step data-step-title="Votre besoin" data-wizard-auto>
            <p class="wizard-q">Bonjour&nbsp;! Sur quoi peut-on vous aider&nbsp;?</p>
            <p class="wizard-help">Choisissez ce qui se rapproche le plus — on affinera ensemble.</p>
            <fieldset class="field full wizard-fieldset">
              <legend class="sr-only">Votre besoin</legend>
              <div class="wizard-cards">
                <label class="wizard-card"><input type="radio" name="project_type" value="Site web" required><span class="wizard-card__text">Créer un site web</span></label>
                <label class="wizard-card"><input type="radio" name="project_type" value="Boutique en ligne"><span class="wizard-card__text">Vendre en ligne (boutique)</span></label>
                <label class="wizard-card"><input type="radio" name="project_type" value="Marketing digital"><span class="wizard-card__text">Gagner en visibilité</span></label>
                <label class="wizard-card"><input type="radio" name="project_type" value="Automatisation / IA"><span class="wizard-card__text">Automatiser avec l'IA</span></label>
                <label class="wizard-card"><input type="radio" name="project_type" value="Formation"><span class="wizard-card__text">Former mon équipe</span></label>
                <label class="wizard-card"><input type="radio" name="project_type" value="Conseil / diagnostic"><span class="wizard-card__text">Être conseillé·e</span></label>
                <label class="wizard-card"><input type="radio" name="project_type" value="Autre"><span class="wizard-card__text">Autre chose</span></label>
              </div>
            </fieldset>
          </div>

          <!-- Étape 2 — L'objectif -->
          <div class="wizard-step" data-wizard-step data-step-title="Votre objectif">
            <p class="wizard-q">Super&nbsp;! Quel résultat aimeriez-vous obtenir&nbsp;?</p>
            <p class="wizard-help">Dites-le avec vos mots — pas besoin de jargon.</p>
            <div class="form-grid">
              <div class="field full"><label for="d-objective">Votre objectif principal *</label><input id="d-objective" type="text" name="objective" required placeholder="Ex : vendre en ligne, gagner du temps, être plus visible…"></div>
              <div class="field full"><label for="d-audience">À qui s'adresse ce projet&nbsp;? <span class="opt">(optionnel)</span></label><input id="d-audience" type="text" name="audience" placeholder="Ex : particuliers, entreprises, les deux…"></div>
            </div>
          </div>

          <!-- Étape 3 — Les besoins concrets -->
          <div class="wizard-step" data-wizard-step data-step-title="Vos besoins">
            <p class="wizard-q">De quoi avez-vous besoin concrètement&nbsp;?</p>
            <p class="wizard-help">Cochez ce qui vous parle — on complétera ensemble si besoin.</p>
            <fieldset class="field full wizard-fieldset">
              <legend class="sr-only">Services recherchés</legend>
              <div class="field-radio-group">
                <label><input type="checkbox" name="services" value="conseil"><span>Conseil &amp; stratégie</span></label>
                <label><input type="checkbox" name="services" value="site"><span>Création de site web</span></label>
                <label><input type="checkbox" name="services" value="marketing"><span>Marketing digital</span></label>
                <label><input type="checkbox" name="services" value="digitalisation"><span>Digitalisation</span></label>
                <label><input type="checkbox" name="services" value="automatisation"><span>Automatisation &amp; IA</span></label>
                <label><input type="checkbox" name="services" value="formation"><span>Formation</span></label>
              </div>
            </fieldset>
            <div class="field full" style="margin-top:18px"><label for="d-features">Des fonctionnalités précises en tête&nbsp;? <span class="opt">(optionnel)</span></label><textarea id="d-features" name="features" placeholder="Ex : paiement en ligne, prise de rendez-vous, espace membre…"></textarea></div>
          </div>

          <!-- Étape 4 — Le cadre (choix rapides) -->
          <div class="wizard-step" data-wizard-step data-step-title="Budget &amp; délai">
            <p class="wizard-q">Parlons cadre&nbsp;: budget et délai&nbsp;?</p>
            <p class="wizard-help">Une fourchette suffit — ça nous aide à bien calibrer la proposition.</p>
            <fieldset class="field full wizard-fieldset" style="margin-bottom:22px">
              <legend class="field-legend">Votre budget *</legend>
              <div class="field-radio-group">
                <label><input type="radio" name="budget" value="Moins de 300 000 FCFA" required><span>&lt; 300 000 FCFA</span></label>
                <label><input type="radio" name="budget" value="300 000 – 800 000 FCFA"><span>300 000 – 800 000</span></label>
                <label><input type="radio" name="budget" value="800 000 – 2 000 000 FCFA"><span>800 000 – 2 000 000</span></label>
                <label><input type="radio" name="budget" value="Plus de 2 000 000 FCFA"><span>&gt; 2 000 000 FCFA</span></label>
                <label><input type="radio" name="budget" value="À définir ensemble"><span>À définir ensemble</span></label>
              </div>
            </fieldset>
            <fieldset class="field full wizard-fieldset">
              <legend class="field-legend">Pour quand&nbsp;? *</legend>
              <div class="field-radio-group">
                <label><input type="radio" name="timeline" value="Le plus tôt possible" required><span>Dès que possible</span></label>
                <label><input type="radio" name="timeline" value="Sous 1 mois"><span>Sous 1 mois</span></label>
                <label><input type="radio" name="timeline" value="1 à 3 mois"><span>1 à 3 mois</span></label>
                <label><input type="radio" name="timeline" value="Plus de 3 mois"><span>Plus de 3 mois</span></label>
              </div>
            </fieldset>
          </div>

          <!-- Étape 5 — Vos coordonnées (dernière étape) -->
          <div class="wizard-step" data-wizard-step data-step-title="Vos coordonnées">
            <p class="wizard-q">On y est presque&nbsp;! Où peut-on vous répondre&nbsp;?</p>
            <p class="wizard-help">Vos coordonnées servent uniquement à traiter votre demande.</p>
            <div class="form-grid">
              <div class="field"><label for="d-fullname">Votre nom *</label><input id="d-fullname" type="text" name="fullname" autocomplete="name" required></div>
              <div class="field"><label for="d-company">Entreprise <span class="opt">(optionnel)</span></label><input id="d-company" type="text" name="company" autocomplete="organization"></div>
              <div class="field"><label for="d-sector">Votre secteur *</label><input id="d-sector" type="text" name="sector" required placeholder="Ex : Commerce, Santé…"></div>
              <div class="field"><label for="d-phone">Téléphone / WhatsApp *</label><PhoneField id="d-phone" /></div>
              <div class="field full"><label for="d-email">Adresse e-mail *</label><input id="d-email" type="email" name="email" autocomplete="email" inputmode="email" required></div>
              <div class="field full">
                <label>Documents à joindre <span class="opt">(optionnel)</span></label>
                <label class="file-drop" style="display:block">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 16V4"/><polyline points="7 9 12 4 17 9"/><path d="M4 16v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/></svg>
                  Cahier des charges, logo, exemples…
                  <input type="file" name="documents" multiple style="display:none">
                </label>
              </div>
            </div>
          </div>

          <button type="submit" class="btn btn-primary btn-block wizard-submit" style="margin-top:16px">Envoyer ma demande
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>
          </button>
          <p class="form-status" role="status" aria-live="polite"></p>
          <p class="form-note">Votre demande nous est envoyée par e-mail. Vos informations servent uniquement à traiter votre demande — voir notre <a href="/politique-confidentialite" style="color:var(--c-blue)">politique de confidentialité</a>.</p>
        </form>
        <div class="form-success" role="status">
          <div class="success-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></div>
          <h3 data-success-title>Votre demande est bien envoyée&nbsp;!</h3>
          <p data-success-msg>Nous l'avons reçue par e-mail et revenons vers vous très vite.</p>
          <p class="success-optional" data-success-optional>Envie de nous prévenir tout de suite&nbsp;? <span class="opt">(optionnel)</span></p>
          <a class="btn btn-whatsapp" href="#" data-wa-fallback target="_blank" rel="noopener">Prévenir sur WhatsApp
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="width:18px;height:18px" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.8 13.4L3 21l4.7-1.2A9 9 0 1 0 12 3z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
</BaseLayout>
