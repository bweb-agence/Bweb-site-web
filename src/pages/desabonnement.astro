---
// Désabonnement e-mail en 1 clic via un jeton opaque (?t=uuid).
// Aucune donnée personnelle dans l'URL. Appelle l'RPC publique unsubscribe_by_token.
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import { whatsappLink } from "../config/site";

const token = Astro.url.searchParams.get("t") || "";
const validFormat = /^[0-9a-f-]{36}$/i.test(token);
---

<BaseLayout title="Désabonnement — Bweb Agence" description="Gérer vos préférences e-mail Bweb Agence." noindex>
  <section class="hero" style="padding-bottom:clamp(80px,8vw,120px)">
    <div class="mesh-bg"></div>
    <div class="grid-lines"></div>
    <div class="container">
      <div class="text-center text-white" style="max-width:560px;margin:0 auto" data-hero-in>
        <div class="pr-halo" style="width:76px;height:76px;border-radius:50%;background:rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;margin:0 auto 28px">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:34px;height:34px"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        </div>

        {!validFormat ? (
          <div>
            <h1>Lien invalide</h1>
            <p class="lead" style="margin:20px auto 12px">Ce lien de désabonnement est incomplet ou expiré. Écris-nous sur WhatsApp et nous te retirons de la liste manuellement.</p>
            <div class="hero-actions" style="justify-content:center;margin-top:24px">
              <a href={whatsappLink("Bonjour, je souhaite me désabonner des e-mails.")} class="btn btn-whatsapp" target="_blank" rel="noopener">WhatsApp</a>
            </div>
          </div>
        ) : (
          <div>
            <div data-state="ask">
              <h1>Se désabonner des e-mails</h1>
              <p class="lead" style="margin:20px auto 20px">Tu ne recevras plus nos e-mails d'information et d'offres. (Les e-mails liés à tes inscriptions te seront toujours envoyés.)</p>
              <div class="hero-actions" style="justify-content:center">
                <button class="btn btn-warm" id="unsub-btn" data-token={token}>Confirmer le désabonnement</button>
                <a href="/" class="btn btn-outline-light">Rester abonné·e</a>
              </div>
            </div>
            <div data-state="done" hidden>
              <h1 id="done-title">C'est fait ✓</h1>
              <p class="lead" style="margin:20px auto 12px" id="done-text">Tu es désabonné·e de nos e-mails d'information. Merci d'avoir fait un bout de chemin avec Bweb Agence.</p>
              <div class="hero-actions" style="justify-content:center;margin-top:24px">
                <a href="/formations" class="btn btn-outline-light">Voir les formations</a>
              </div>
            </div>
            <div data-state="err" hidden>
              <h1>Oups…</h1>
              <p class="lead" style="margin:20px auto 12px">Le désabonnement n'a pas pu être enregistré. Réessaie, ou écris-nous sur WhatsApp.</p>
              <div class="hero-actions" style="justify-content:center;margin-top:24px">
                <a href={whatsappLink("Bonjour, je souhaite me désabonner des e-mails.")} class="btn btn-whatsapp" target="_blank" rel="noopener">WhatsApp</a>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { supabaseBrowser } from "../lib/supabaseBrowser";

  const btn = document.getElementById("unsub-btn") as HTMLButtonElement | null;
  const show = (name: string) => document.querySelectorAll<HTMLElement>("[data-state]").forEach((el) => {
    el.hidden = el.getAttribute("data-state") !== name;
  });

  btn?.addEventListener("click", async () => {
    const t = btn.dataset.token!;
    btn.setAttribute("disabled", "true"); btn.textContent = "Un instant…";
    try {
      const { data, error } = await supabaseBrowser.rpc("unsubscribe_by_token", { p_token: t });
      if (error || data === "notfound") { show("err"); return; }
      const prenom = typeof data === "string" && data !== "ok" ? data : "";
      if (prenom) {
        const dt = document.getElementById("done-text");
        if (dt) dt.textContent = `${prenom}, tu es désabonné·e de nos e-mails d'information. Merci d'avoir fait un bout de chemin avec Bweb Agence.`;
      }
      show("done");
    } catch {
      show("err");
    }
  });
</script>
