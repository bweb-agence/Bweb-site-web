---
import { contact, whatsappLink } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroViz from "../components/HeroViz.astro";
---

<BaseLayout title="Marketing digital orienté résultats | Bweb" description="Contenu, réseaux sociaux et publicité pilotés par la donnée : Bweb aide les entreprises à gagner en visibilité et en clients.">
<section class="page-hero" data-nav-section="Marketing digital">
  <div class="mesh-bg"></div>
  <div class="grid-lines"></div>
  <div class="container">
    <div class="breadcrumb"><a href="/">Accueil</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
      <a href="/services">Services</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
      <span>Marketing digital</span>
    </div>
    <div class="page-hero-grid">
      <div class="text-white" data-hero-in>
        <div class="eyebrow on-dark">Marketing digital</div>
        <h1>Une visibilité pilotée par la donnée.</h1>
        <p class="lead">Contenu, réseaux sociaux et campagnes publicitaires pilotés par les résultats — pour développer la visibilité et les ventes de votre entreprise.</p>
        <div class="hero-actions" style="margin-top:32px;margin-bottom:0">
          <a href="/devis" class="btn btn-warm">Développer ma visibilité</a>
          <a href="/services" class="btn btn-outline-light">Tous nos services</a>
        </div>
      </div>
      <div class="visual" data-hero-in>
        <HeroViz variant="marketing" />
      </div>
    </div>
  </div>
</section>

<section class="section" data-nav-section="Notre approche">
  <div class="container">
    <div class="split-block">
      <div class="reveal">
        <div class="eyebrow">Ce que comprend ce service</div>
        <h2>Une visibilité construite, pas improvisée.</h2>
        <p class="lead" style="margin:20px 0">Nous structurons votre communication digitale — réseaux sociaux, contenu, publicité — autour d'objectifs mesurables : notoriété, engagement, acquisition de clients.</p>
      </div>
      <div class="card reveal" data-delay=".1">
        <ul class="tick-list">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Stratégie de communication</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Gestion des réseaux sociaux</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Création de contenu</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Publicité Facebook &amp; Instagram</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Acquisition de clients</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Création de campagnes</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="5 13 10 18 19 7"/></svg>Suivi &amp; analyse des performances</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="section section-gray" data-nav-section="Autres services">
  <div class="container">
    <div class="section-head center reveal">
      <div class="eyebrow" style="justify-content:center">Explorez aussi</div>
      <h2>Nos autres services</h2>
    </div>
    <div class="grid grid-3" data-stagger>
      <a class="card service-card" href="/services-creation-sites-web"><h4>Création de sites web</h4><p style="margin-top:8px">Site vitrine, boutique en ligne, plateforme de formation.</p></a>
      <a class="card service-card" href="/services-automatisation-ia"><h4>Automatisation &amp; IA</h4><p style="margin-top:8px">WhatsApp, chatbots et agents conversationnels.</p></a>
      <a class="card service-card" href="/services-formation"><h4>Formation professionnelle</h4><p style="margin-top:8px">Marketing digital, IA, vente en ligne.</p></a>
    </div>
  </div>
</section>

<section class="section" data-nav-section="Contact">
  <div class="container">
    <div class="cta-band reveal-scale">
      <div class="mesh-bg"></div>
      <div class="grid-lines"></div>
      <div style="position:relative;z-index:2">
        <h2 class="text-white">Envie de développer votre visibilité ?</h2>
        <p class="lead text-white">Parlons de vos objectifs et construisons un plan de communication réaliste.</p>
        <div class="hero-actions">
          <a href="/devis" class="btn btn-warm">Développer ma visibilité</a>
          <a href={whatsappLink()} class="btn btn-outline-light" data-whatsapp-link target="_blank" rel="noopener">Discuter sur WhatsApp</a>
        </div>
      </div>
    </div>
  </div>
</section>
</BaseLayout>
