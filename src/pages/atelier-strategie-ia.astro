<style is:global>
  /* =====================================================================
     ATELIER STRATÉGIE IA — styles de page
     Préfixe `at-` : rien ici ne doit pouvoir déborder sur une autre page.
     Tout ce qui existait déjà (btn, card, badge, accordion, form-card,
     section-dark, cta-band) est réutilisé tel quel.
     ===================================================================== */

  /* ---------- 1. Hero clair ----------
     Le site pose un hero NAVY (.page-hero). Ici il est blanc : décision de
     l'offre (scope §10) — une page de vente doit respirer et laisser le navy
     aux deux sections de rupture. On reprend donc le décalage sous l'en-tête
     fixe à la main, sans hériter du fond. */
  .at-hero { position: relative; background: #fff; padding-top: clamp(120px, 12vw, 158px); padding-bottom: clamp(48px, 5vw, 72px); overflow: hidden; }
  .at-hero::before {
    content: ""; position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background:
      radial-gradient(46% 42% at 84% 12%, rgba(31, 108, 237, .1) 0%, transparent 70%),
      radial-gradient(38% 38% at 6% 82%, rgba(0, 200, 158, .09) 0%, transparent 72%);
  }
  .at-hero .container { position: relative; z-index: 1; }

  .at-breadcrumb { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; font-size: .82rem; font-weight: 600; color: var(--c-gray-500); margin-bottom: 26px; }
  .at-breadcrumb a { color: var(--c-gray-500); }
  .at-breadcrumb a:hover { color: var(--c-blue); }
  .at-breadcrumb svg { width: 12px; height: 12px; flex: none; }

  /* Zones nommées plutôt que colonnes : sur mobile, l'illustration doit se
     glisser ENTRE les boutons et les chiffres. Un simple passage à une colonne
     ne le permet pas — elle suivrait l'ordre du balisage, où les chiffres la
     précèdent en version desktop. */
  .at-hero-grid {
    display: grid; grid-template-columns: 1.08fr .92fr;
    gap: clamp(22px, 2.6vw, 34px) clamp(28px, 4vw, 56px);
    grid-template-areas: "texte visuel" "preuves visuel"; align-items: center;
  }
  .at-hero-text { grid-area: texte; }
  .at-hero-visual { grid-area: visuel; }

  .at-pill { display: inline-flex; align-items: center; gap: 9px; padding: 8px 16px; border-radius: var(--radius-pill); background: var(--c-skyblue); color: var(--c-blue-darker); font-size: .8rem; font-weight: 700; line-height: 1.45; margin-bottom: 20px; }
  .at-pill__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--c-orange); flex: none; }

  .at-h1 { font-size: clamp(2rem, 1.4rem + 2.5vw, 3.35rem); line-height: 1.08; max-width: 16ch; margin-bottom: 20px; }
  /* Surlignage du bénéfice : un trait épais posé DERRIÈRE le texte, pas un
     fond plein — le mot reste en navy et garde son contraste. */
  .at-underline { position: relative; white-space: nowrap; }
  .at-underline::after { content: ""; position: absolute; left: -2px; right: -2px; bottom: .06em; height: .3em; background: var(--c-yellow); opacity: .5; border-radius: 4px; z-index: -1; }

  .at-hero-sub { max-width: 46ch; margin-bottom: 30px; }
  .at-hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 34px; }
  /* Règle Godwin : le texte d'un bouton tient sur UNE ligne. */
  .at-cta { white-space: nowrap; }

  .at-proof { grid-area: preuves; align-self: end; display: flex; flex-wrap: wrap; gap: 14px 36px; list-style: none; margin: 0; padding: 22px 0 0; border-top: 1px solid var(--c-border-soft); }
  .at-proof li { display: flex; flex-direction: column; }
  .at-proof b { font-family: var(--f-display); font-size: 1.4rem; font-weight: 800; color: var(--c-navy); line-height: 1.1; }
  .at-proof span { font-size: .84rem; color: var(--c-gray-500); }

  /* ---------- 2. Le problème ---------- */
  .at-problem .section-head { margin-bottom: clamp(20px, 2.4vw, 32px); }
  /* `position: relative` + `z-index: 0` sont OBLIGATOIRES : le surlignage de
     « clarté » est un ::after en z-index -1. Sans contexte d'empilement ici,
     il passe derrière le fond de la section et disparaît. */
  .at-chapeau { position: relative; z-index: 0; max-width: 52ch; margin: 18px auto 0; font-size: clamp(1rem, .95rem + .3vw, 1.12rem); line-height: 1.6; color: var(--c-gray-600); }
  .at-chapeau b { color: var(--c-navy); }

  .at-blocs { max-width: 1160px; margin-inline: auto; }
  .at-bloc { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(30px, 5vw, 80px); align-items: center; padding: clamp(28px, 3.4vw, 44px) 0; }
  .at-bloc__vis { display: flex; justify-content: center; }
  .at-bloc--inverse .at-bloc__vis { order: 2; }
  .at-bloc h3 { font-size: clamp(1.3rem, 1.05rem + 1vw, 1.85rem); line-height: 1.22; letter-spacing: -.01em; margin-bottom: 14px; max-width: 19ch; }
  .at-bloc__intro { font-size: clamp(.98rem, .93rem + .3vw, 1.06rem); line-height: 1.65; color: var(--c-gray-600); margin: 0 0 24px; max-width: 46ch; }

  .at-checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; max-width: 48ch; }
  .at-checks li { position: relative; padding-left: 36px; font-size: .96rem; line-height: 1.6; color: var(--c-gray-700); }
  .at-checks li svg { position: absolute; left: 0; top: 2px; width: 19px; height: 19px; color: var(--c-blue); }

  /* ---------- 3. La solution (navy) ---------- */
  .at-sol-chapeau { max-width: 58ch; margin: 16px auto 0; }
  .at-sol-grid { display: grid; grid-template-columns: 1fr; gap: clamp(30px, 4vw, 64px); align-items: start; max-width: 1180px; margin-inline: auto; }

  /* Le rail : un trait vertical qui relie les quatre pastilles. Il s'arrête au
     centre des pastilles extrêmes, pas aux bords de la liste. */
  .at-rail { position: relative; list-style: none; margin: 0; padding: 0; }
  .at-rail::before { content: ""; position: absolute; left: 13px; top: 26px; bottom: 26px; width: 2px; background: rgba(255, 255, 255, .16); }
  .at-rail li { position: relative; padding: 0 0 8px 46px; }
  .at-rail__dot { position: absolute; left: 5px; top: 20px; width: 18px; height: 18px; border-radius: 50%; background: var(--c-navy-soft); border: 2px solid rgba(255, 255, 255, .28); transition: background-color var(--dur-fast), border-color var(--dur-fast), box-shadow var(--dur-fast); }
  .at-rail__btn { display: block; width: 100%; padding: 14px 0; background: none; border: none; text-align: left; cursor: pointer; font: inherit; color: inherit; }
  .at-rail__num { display: block; font-family: var(--f-display); font-size: .7rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: rgba(255, 255, 255, .5); }
  .at-rail__titre { display: block; font-family: var(--f-display); font-size: clamp(1.05rem, .95rem + .45vw, 1.25rem); font-weight: 700; line-height: 1.3; color: rgba(255, 255, 255, .62); margin-top: 4px; transition: color var(--dur-fast); }
  .at-rail__desc { margin: 10px 0 0; font-size: .95rem; line-height: 1.62; color: rgba(255, 255, 255, .74); max-width: 44ch; }

  .at-rail li.is-on .at-rail__dot { background: var(--c-yellow); border-color: var(--c-yellow); box-shadow: 0 0 0 5px rgba(255, 199, 42, .16); }
  .at-rail li.is-on .at-rail__titre { color: var(--c-yellow); }
  .at-rail li.is-on .at-rail__num { color: rgba(255, 199, 42, .75); }

  /* Hors mode onglets, les quatre livrables sont ouverts : ils portent donc
     tous la couleur d'un livrable actif. */
  .at-sol-grid:not(.is-onglets) .at-rail__dot { background: var(--c-yellow); border-color: var(--c-yellow); }
  .at-sol-grid:not(.is-onglets) .at-rail__titre { color: var(--c-yellow); }
  .at-sol-grid:not(.is-onglets) .at-rail__num { color: rgba(255, 199, 42, .75); }
  .at-sol-grid:not(.is-onglets) .at-rail__btn { cursor: default; }

  .at-sol-scene { display: none; }
  .at-sol-fig { margin-top: 16px; border-radius: var(--radius-md); background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .12); padding: 14px; }

  .at-bonus { color: rgba(255, 255, 255, .86); font-size: .95rem; line-height: 1.6; max-width: 46ch; margin: 30px 0 0; padding: 18px 22px; border-radius: var(--radius-md); background: rgba(255, 255, 255, .06); border: 1px dashed rgba(255, 199, 42, .42); }
  .at-bonus b { color: var(--c-yellow); }

  /* Onglets : posé par le script UNIQUEMENT au-dessus de 1080 px. En dessous,
     et sans JavaScript, tout reste déplié — chaque document sous son titre. */
  .at-sol-grid.is-onglets { grid-template-columns: .82fr 1.18fr; }
  .is-onglets .at-sol-scene { display: block; }
  .is-onglets .at-rail__desc { display: none; }
  .is-onglets .at-rail li.is-on .at-rail__desc { display: block; }
  .is-onglets .at-sol-fig { display: none; margin-top: 0; padding: 22px; }
  .is-onglets .at-sol-fig.is-on { display: block; }

  /* ---------- 4. Le programme ---------- */
  .at-timeline { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 2.4vw, 32px); position: relative; }
  /* La ligne de temps : un trait derrière les trois pastilles. Sa position
     (29px) est le RAYON de la pastille, qui est le premier élément de chaque
     étape — le trait passe donc exactement par leur centre, quelle que soit la
     longueur des titres. */
  .at-timeline::before { content: ""; position: absolute; left: 8%; right: 8%; top: 29px; height: 2px; background: linear-gradient(90deg, var(--c-skyblue), var(--c-blue), var(--c-green)); opacity: .45; }
  /* Colonne : chaque bloc s'empile (pastille → heure → titre → texte). En flux
     normal, la pastille et l'heure sont toutes deux « inline » et se
     retrouveraient côte à côte, l'heure tronquée derrière la pastille. */
  .at-step { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 0 8px; }
  .at-step__time { font-size: .78rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--c-blue); margin-bottom: 12px; }
  .at-step__ico { position: relative; z-index: 1; display: inline-flex; align-items: center; justify-content: center; width: 58px; height: 58px; border-radius: 50%; background: #fff; border: 2px solid var(--c-blue); color: var(--c-blue); box-shadow: 0 0 0 8px #fff; margin-bottom: 16px; }
  .at-step__ico svg { width: 26px; height: 26px; }
  .at-step h3 { font-size: 1.05rem; line-height: 1.35; margin-bottom: 10px; }
  .at-step p { font-size: .93rem; color: var(--c-gray-600); margin: 0; max-width: 34ch; margin-inline: auto; }

  /* ---------- 5. Pour qui / pas pour qui ---------- */
  .at-fit-card h3 { display: flex; align-items: center; gap: 12px; font-size: 1.15rem; margin-bottom: 20px; }
  .at-fit-badge { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; font-size: .95rem; font-weight: 800; flex: none; }
  .at-fit-badge--yes { background: var(--c-success-bg); color: var(--c-success); }
  .at-fit-badge--no { background: var(--c-danger-bg); color: var(--c-danger); }
  .at-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .at-list li { position: relative; padding-left: 26px; font-size: .95rem; color: var(--c-gray-700); line-height: 1.55; }
  .at-list li::before { content: "✓"; position: absolute; left: 0; top: -1px; color: var(--c-success); font-weight: 800; }
  .at-list--no li::before { content: "✕"; color: var(--c-danger); }
  .at-fit-note { margin-top: 20px; padding-top: 18px; border-top: 1px solid var(--c-border-soft); font-size: .9rem; color: var(--c-gray-600); }
  .at-fit-note a { color: var(--c-blue); font-weight: 700; }

  /* ---------- 6. La preuve (navy) ---------- */
  .at-stats { display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(24px, 5vw, 72px); margin-bottom: clamp(40px, 5vw, 64px); }
  .at-stat { text-align: center; }
  .at-stat b { display: block; font-family: var(--f-display); font-size: clamp(1.7rem, 1.2rem + 1.8vw, 2.6rem); font-weight: 800; color: var(--c-yellow); line-height: 1.05; }
  .at-stat span { font-size: .88rem; color: rgba(255, 255, 255, .75); }

  .at-videos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(16px, 2.4vw, 28px); max-width: 720px; margin-inline: auto; }
  .at-video { margin: 0; }
  .at-video__slot { aspect-ratio: 9 / 16; border-radius: var(--radius-md); background: rgba(255, 255, 255, .05); border: 1px dashed rgba(255, 255, 255, .28); display: flex; align-items: center; justify-content: center; padding: 12px; text-align: center; }
  .at-video figcaption { margin-top: 12px; text-align: center; font-size: .84rem; color: rgba(255, 255, 255, .7); }

  /* ---------- 7. La garantie ---------- */
  .at-guarantee { display: flex; align-items: center; gap: clamp(20px, 3vw, 36px); max-width: 860px; margin-inline: auto; padding: clamp(26px, 3.4vw, 40px); border-radius: var(--radius-lg); background: linear-gradient(135deg, #fffdf6 0%, #f4fbf8 100%); border: 1px solid rgba(255, 199, 42, .38); box-shadow: var(--shadow-sm); }
  .at-guarantee__badge { flex: none; width: 64px; height: 64px; }
  .at-guarantee__badge svg { width: 100%; height: 100%; }
  .at-guarantee h2 { font-size: clamp(1.3rem, 1.1rem + 1vw, 1.9rem); margin-bottom: 10px; }
  .at-guarantee .lead { font-size: 1rem; margin: 0; }

  /* ---------- 8. Le prix ---------- */
  .at-pricing { max-width: 620px; margin-inline: auto; text-align: center; padding: clamp(30px, 4vw, 48px) clamp(22px, 3vw, 44px); border-radius: var(--radius-xl); background: #fff; border: 2px solid var(--c-blue); box-shadow: var(--shadow-lg); }
  .at-pricing__flag { display: inline-block; padding: 7px 18px; border-radius: var(--radius-pill); background: var(--c-navy); color: #fff; font-size: .78rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; margin-bottom: 22px; }
  .at-pricing__old { font-size: 1.25rem; color: var(--c-gray-400); margin-bottom: 2px; }
  .at-pricing__old s { text-decoration-thickness: 2px; }
  .at-pricing__now { font-family: var(--f-display); font-size: clamp(2.4rem, 1.6rem + 3.4vw, 4rem); font-weight: 800; color: var(--c-navy); line-height: 1; margin-bottom: 12px; }
  .at-pricing__save { display: inline-block; padding: 7px 16px; border-radius: var(--radius-pill); background: var(--c-success-bg); color: var(--c-success); font-size: .88rem; font-weight: 800; margin-bottom: 26px; }

  .at-pricing__facts { list-style: none; margin: 0 0 24px; padding: 0; display: grid; gap: 9px; text-align: left; max-width: 420px; margin-inline: auto; }
  .at-pricing__facts li { position: relative; padding-left: 26px; font-size: .95rem; color: var(--c-gray-700); }
  .at-pricing__facts li::before { content: "•"; position: absolute; left: 6px; color: var(--c-blue); font-weight: 800; }
  .at-pricing__facts b { color: var(--c-navy); }

  .at-pricing__pay { padding: 18px 20px; border-radius: var(--radius-md); background: var(--surface-2); border: 1px solid var(--c-border-soft); margin-bottom: 26px; text-align: left; }
  .at-pricing__pay h3 { font-size: .95rem; margin-bottom: 6px; }
  .at-pricing__pay p { font-size: .9rem; color: var(--c-gray-600); margin: 0; }

  .at-pricing__trust { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 18px; }

  /* ---------- 9. Le formulaire ---------- */
  .at-form-section .section-head .lead { max-width: 52ch; margin-inline: auto; }
  /* Plafond de réponses atteint : les options restantes s'effacent au lieu de
     disparaître — on veut que le visiteur comprenne qu'il doit décocher, pas
     qu'il croie à un bug. */
  .at-form-section .field-radio-group label.is-disabled { opacity: .42; cursor: not-allowed; }

  /* ---------- FAQ + CTA final ---------- */
  .at-faq { border-top: 1px solid var(--c-border-soft); }
  .at-legal { max-width: 760px; margin: clamp(32px, 4vw, 48px) auto 0; text-align: center; font-size: .8rem; line-height: 1.7; color: var(--c-gray-500); }
  .at-legal a { color: var(--c-gray-600); text-decoration: underline; }
  .at-legal a:hover { color: var(--c-blue); }

  /* ---------- CTA collant (mobile) ---------- */
  .at-sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: var(--z-float); padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); background: rgba(255, 255, 255, .95); backdrop-filter: blur(10px); border-top: 1px solid var(--c-border); transform: translateY(110%); transition: transform var(--dur) var(--ease); }
  .at-sticky.is-visible { transform: translateY(0); }
  .at-sticky .btn { white-space: nowrap; }
  /* La modale du formulaire couvre l'écran : le CTA collant n'a plus rien à
     y faire, et resterait au-dessus d'elle. */
  .wiz-lock .at-sticky { display: none; }

  /* ---------- Adaptations ---------- */
  /* Le hero bascule en une colonne au MÊME seuil que l'en-tête (1080 px, cf.
     components.css). En dessous, la colonne de texte n'a plus la place : le
     titre se brise en trois lignes et les deux boutons s'empilent alors qu'on
     est encore sur un écran d'ordinateur. */
  @media (max-width: 1080px) {
    /* L'ordre décidé le 29/08/2026 : promesse, boutons, PUIS illustration.
       Elle passait avant le titre — un visiteur venu d'une publicité voyait
       300 px de blanc avant de lire ce qu'on lui vend. */
    .at-hero-grid { grid-template-columns: 1fr; grid-template-areas: "texte" "visuel" "preuves"; align-items: start; }
    .at-hero-visual { max-width: 420px; margin-inline: auto; }
    .at-h1 { max-width: none; }
  }

  /* Les blocs du problème passent en une colonne plus tôt que le reste : à
     860 px, le texte à côté d'un visuel de 390 px n'a plus de place utile. */
  @media (max-width: 860px) {
    .at-bloc { grid-template-columns: 1fr; gap: 22px; padding: 26px 0; border-bottom: 1px solid var(--c-border-soft); }
    .at-bloc:last-child { border-bottom: none; }
    /* Le texte d'abord dans TOUS les blocs. L'inversion des blocs pairs est
       annulée, sinon un bloc sur deux montrerait son visuel avant son titre. */
    .at-bloc__vis, .at-bloc--inverse .at-bloc__vis { order: 2; }
    .at-bloc h3 { max-width: none; }
    .at-bloc__vis .pb-illus { max-width: 300px; }
  }

  /* Sur un téléphone, chaque illustration ajoute sa hauteur SOUS un bloc de
     texte déjà long : à 300 px, les trois portaient la section à près de
     2 600 px. Elles restent lisibles bien plus petites, ce sont des visuels
     d'accompagnement et non des schémas à déchiffrer. */
  @media (max-width: 560px) {
    .at-bloc { padding: 20px 0; gap: 18px; }
    .at-bloc__vis .pb-illus { max-width: 210px; }
    .at-checks { gap: 14px; }
    .at-bloc__intro { margin-bottom: 18px; }
  }

  @media (max-width: 980px) {
    .at-timeline { grid-template-columns: 1fr; gap: 28px; }
    .at-timeline::before { display: none; }
    .at-step { text-align: left; display: grid; grid-template-columns: 58px 1fr; grid-template-areas: "ico time" "ico title" "ico text"; column-gap: 18px; align-items: start; }
    .at-step__time { grid-area: time; margin-bottom: 6px; align-self: center; }
    .at-step__ico { grid-area: ico; box-shadow: none; margin-bottom: 0; }
    .at-step h3 { grid-area: title; }
    .at-step p { grid-area: text; margin-inline: 0; max-width: none; }
    .at-guarantee { flex-direction: column; text-align: center; }
  }
  @media (max-width: 720px) {
    /* Godwin déteste le vide : sous l'en-tête, on resserre au lieu de laisser
       respirer un écran qu'on n'a pas les moyens de remplir. */
    .at-hero { padding-top: clamp(100px, 24vw, 124px); padding-bottom: 34px; }
    .at-breadcrumb { margin-bottom: 18px; }
    .at-hero-sub { margin-bottom: 24px; }
    .at-hero-actions { margin-bottom: 0; }
    .at-hero-visual { max-width: 340px; }
    .at-fit-grid { grid-template-columns: 1fr; }
    .at-videos { grid-template-columns: 1fr; max-width: 300px; }
    .at-hero-actions .btn { width: 100%; justify-content: center; }
    .at-proof { gap: 14px 24px; }
    /* Le CTA collant occupe le bas de l'écran : on dégage la fin de page. */
    .at-final { padding-bottom: 110px; }
  }
  @media (max-width: 560px) {
    .at-underline { white-space: normal; }
  }
</style>

<script>
  /* =====================================================================
     Comportements propres à la page. Tout est facultatif : sans JS, le
     formulaire reste complet et la page entièrement lisible.
     ===================================================================== */

  /* ---------- Cases à cocher limitées (2 maximum) ----------
     Le scope plafonne `pain` et `call_goal` à deux réponses : au-delà, la
     qualification perd son sens (« tout me pose problème » n'oriente rien).
     On désactive les cases restantes plutôt que d'afficher une erreur après
     coup — la limite se voit avant d'être franchie. La route API applique de
     toute façon le même plafond côté serveur. */
  document.querySelectorAll<HTMLFieldSetElement>("fieldset[data-max]").forEach((group) => {
    const max = Number(group.dataset.max || 0);
    if (!max) return;
    const boxes = Array.from(group.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'));
    const sync = () => {
      const atteint = boxes.filter((b) => b.checked).length >= max;
      boxes.forEach((b) => {
        b.disabled = atteint && !b.checked;
        b.closest("label")?.classList.toggle("is-disabled", b.disabled);
      });
    };
    boxes.forEach((b) => b.addEventListener("change", sync));
    sync();
  });

  /* ---------- Conversion Meta ----------
     `Lead` est émis UNIQUEMENT quand la soumission a réellement abouti
     (événement `bweb:submitted` de forms.ts, `ok: true`). Le déclencher sur
     l'affichage de l'écran de succès compterait aussi les replis WhatsApp,
     c'est-à-dire les soumissions qui n'ont pas été enregistrées. */
  document.querySelector<HTMLFormElement>('form[data-form-key="atelier-strategie-ia"]')
    ?.addEventListener("bweb:submitted", (e) => {
      const ok = (e as CustomEvent<{ ok: boolean }>).detail?.ok;
      if (ok && typeof window.fbq === "function") window.fbq("track", "Lead");
    });

  /* ---------- Les livrables en onglets ----------
     Au-dessus de 1080 px seulement. En dessous, la liste reste dépliée : sur un
     téléphone, des onglets forceraient à revenir en haut pour changer de
     livrable, et le visuel serait de toute façon trop petit pour valoir le
     détour. Le seuil est le même que celui du hero et de l'en-tête.

     Les visuels sont écrits DANS leur livrable et déplacés ici vers la scène
     de droite. Sans ce script, ils restent où ils sont : la section fonctionne
     entièrement sans JavaScript, simplement dépliée. */
  const solution = document.querySelector<HTMLElement>("[data-solution]");
  const scene = solution?.querySelector<HTMLElement>("[data-scene]");
  if (solution && scene && window.matchMedia("(min-width: 1081px)").matches) {
    const items = Array.from(solution.querySelectorAll<HTMLElement>("[data-livrable]"));
    const figures = items.map((li) => li.querySelector<HTMLElement>("[data-fig]")!);
    figures.forEach((fig) => scene.appendChild(fig));
    solution.classList.add("is-onglets");

    const activer = (index: number) => {
      items.forEach((li, i) => li.classList.toggle("is-on", i === index));
      figures.forEach((fig, i) => fig.classList.toggle("is-on", i === index));
      /* `aria-expanded` plutôt que le motif tablist : ces boutons déplient un
         contenu qui reste dans le flux, ils ne changent pas de panneau. */
      items.forEach((li, i) =>
        li.querySelector("[data-go]")?.setAttribute("aria-expanded", String(i === index)),
      );
    };
    solution.querySelectorAll<HTMLButtonElement>("[data-go]").forEach((btn) => {
      /* Les boutons naissent `disabled` : sans ce script ils ne commanderaient
         rien, et un bouton inerte qui prend le focus est un piège. */
      btn.disabled = false;
      btn.addEventListener("click", () => activer(Number(btn.dataset.go)));
    });
    activer(0);
  }

  /* ---------- CTA collant mobile ----------
     Apparaît une fois le hero passé, disparaît quand le formulaire est à
     l'écran (le bouton pointerait sur ce que le visiteur regarde déjà). */
  const sticky = document.querySelector<HTMLElement>("[data-at-sticky]");
  const reservation = document.getElementById("reservation");
  if (sticky && reservation && window.matchMedia("(max-width: 720px)").matches) {
    sticky.hidden = false;
    const hero = document.querySelector<HTMLElement>(".at-hero");
    let horsHero = false;
    let surForm = false;
    const maj = () => sticky.classList.toggle("is-visible", horsHero && !surForm);
    if (hero) {
      new IntersectionObserver(([entry]) => { horsHero = !entry.isIntersecting; maj(); }).observe(hero);
    } else {
      horsHero = true;
    }
    new IntersectionObserver(([entry]) => { surForm = entry.isIntersecting; maj(); }).observe(reservation);
    maj();
  }
</script>
</BaseLayout>
