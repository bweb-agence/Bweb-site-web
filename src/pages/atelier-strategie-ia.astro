            <p class="wizard-help">Quinze minutes, pas plus — et on s'y tient.</p>
            <fieldset class="field full wizard-fieldset" data-max="2">
              <legend class="field-legend">Qu'aimeriez-vous repartir avec&nbsp;? <span class="opt">(2 maximum)</span></legend>
              <div class="field-radio-group">
                <label><input type="checkbox" name="call_goal" value="Une feuille de route claire"><span>Une feuille de route claire</span></label>
                <label><input type="checkbox" name="call_goal" value="Des outils concrets prêts à l'emploi"><span>Des outils concrets prêts à l'emploi</span></label>
                <label><input type="checkbox" name="call_goal" value="Former mon équipe"><span>Former mon équipe</span></label>
                <label><input type="checkbox" name="call_goal" value="Des exemples dans mon secteur"><span>Des exemples dans mon secteur</span></label>
              </div>
            </fieldset>
            <div class="field full" style="margin-top:22px">
              <label for="at-question">Une question brûlante à préparer avant l'appel&nbsp;? <span class="opt">(optionnel)</span></label>
              <textarea id="at-question" name="call_question" placeholder="Ex : comment automatiser le suivi de mes devis&nbsp;?"></textarea>
            </div>
            <fieldset class="field full wizard-fieldset" style="margin-top:22px">
              <legend class="field-legend">Par quel canal préférez-vous être appelé·e&nbsp;? *</legend>
              <div class="field-radio-group">
                <label><input type="radio" name="call_channel" value="WhatsApp" required checked><span>WhatsApp</span></label>
                <label><input type="radio" name="call_channel" value="Téléphone"><span>Téléphone</span></label>
                <label><input type="radio" name="call_channel" value="Visio"><span>Visio</span></label>
              </div>
            </fieldset>
            <fieldset class="field full wizard-fieldset" style="margin-top:22px">
              <legend class="field-legend">Quel créneau vous arrange&nbsp;? *</legend>
              <div class="field-radio-group">
                <label><input type="checkbox" name="call_slot" value="Matin (9h-12h)" required><span>Matin (9h — 12h)</span></label>
                <label><input type="checkbox" name="call_slot" value="Midi (12h-15h)"><span>Midi (12h — 15h)</span></label>
                <label><input type="checkbox" name="call_slot" value="Fin de journée (15h-18h)"><span>Fin de journée (15h — 18h)</span></label>
              </div>
            </fieldset>
          </div>

          <!-- ÉTAPE 5 — Vos coordonnées -->
          <div class="wizard-step" data-wizard-step data-step-title="Vos coordonnées">
            <p class="wizard-q">Où peut-on vous joindre&nbsp;?</p>
            <p class="wizard-help">Vos coordonnées servent uniquement à vous rappeler pour cet atelier.</p>
            <div class="form-grid">
              <div class="field"><label for="at-name">Votre nom *</label><input id="at-name" type="text" name="full_name" autocomplete="name" required></div>
              <div class="field"><label for="at-company">Votre entreprise *</label><input id="at-company" type="text" name="company" autocomplete="organization" required></div>
              <div class="field"><label for="at-phone">Téléphone / WhatsApp *</label><PhoneField id="at-phone" /></div>
              <div class="field"><label for="at-email">Adresse e-mail *</label><input id="at-email" type="email" name="email" autocomplete="email" inputmode="email" required></div>
            </div>
          </div>

          <button type="submit" class="btn btn-primary btn-block wizard-submit" style="margin-top:16px">Réserver mon appel découverte
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>
          </button>
          <p class="form-status" role="status" aria-live="polite"></p>
          <p class="form-note">
            Votre demande nous est envoyée par e-mail. Vos informations servent uniquement
            à préparer votre appel — voir notre <a href="/politique-confidentialite" style="color:var(--c-blue)">politique de confidentialité</a>.
          </p>
        </form>

        <div class="form-success" role="status">
          <div class="success-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></div>
          <h3 data-success-title>Votre demande est reçue&nbsp;!</h3>
          <p data-success-msg>
            Nous vous rappelons sur le créneau que vous avez choisi, au{" "}
            <b data-phone-display>{contact.phoneDisplay}</b>. Gardez votre téléphone à portée de main.
          </p>
          <p class="success-optional" data-success-optional>Une précision à nous transmettre tout de suite&nbsp;? <span class="opt">(optionnel)</span></p>
          <a class="btn btn-whatsapp" href="#" data-wa-fallback target="_blank" rel="noopener">Nous écrire sur WhatsApp
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="width:18px;height:18px" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.8 13.4L3 21l4.7-1.2A9 9 0 1 0 12 3z"/></svg>
          </a>
