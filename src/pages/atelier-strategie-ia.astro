      <div class="form-card reveal">
        <!-- Assistant multi-étapes (src/scripts/wizard.ts) : une modale plein
             écran, une question à la fois. Sans JS, les 5 étapes restent
             visibles et la soumission fonctionne normalement (forms.ts). -->
        <form
          data-form
          data-form-key="atelier-strategie-ia"
          data-wizard
          data-wizard-cta="Réserver mon appel découverte"
          data-form-title="Réservation appel découverte — Atelier Stratégie IA"
          data-endpoint="/api/atelier-reservation"
        >
          <!-- Honeypot anti-spam : masqué aux humains, laissé vide ; la route API rejette silencieusement s'il est rempli. -->
          <div class="hp-field" aria-hidden="true"><label>Ne pas remplir<input type="text" name="company_site" tabindex="-1" autocomplete="off" /></label></div>

          <!-- ÉTAPE 1 — Votre plus gros problème -->
          <div class="wizard-step" data-wizard-step data-step-title="Votre problème">
            <p class="wizard-q">Qu'est-ce qui vous coûte le plus cher aujourd'hui&nbsp;?</p>
            <p class="wizard-help">Choisissez ce qui pèse le plus — 2 réponses au maximum.</p>
            <fieldset class="field full wizard-fieldset" data-max="2">
              <legend class="sr-only">Ce qui vous coûte le plus cher</legend>
              <div class="field-radio-group">
                <label><input type="checkbox" name="pain" value="Je perds des clients ou des ventes" required><span>Je perds des clients ou des ventes</span></label>
                <label><input type="checkbox" name="pain" value="Je perds du temps dans des tâches manuelles"><span>Je perds du temps dans des tâches manuelles</span></label>
                <label><input type="checkbox" name="pain" value="J'ai investi dans le digital sans résultats"><span>J'ai investi dans le digital sans résultats</span></label>
                <label><input type="checkbox" name="pain" value="Mon équipe n'est pas formée aux outils"><span>Mon équipe n'est pas formée aux outils</span></label>
                <label><input type="checkbox" name="pain" value="Je ne sais pas par où commencer"><span>Je ne sais pas par où commencer</span></label>
              </div>
            </fieldset>
            <fieldset class="field full wizard-fieldset" style="margin-top:22px">
              <legend class="field-legend">Depuis combien de temps&nbsp;? *</legend>
              <div class="field-radio-group">
                <label><input type="radio" name="pain_since" value="Moins de 3 mois" required><span>Moins de 3 mois</span></label>
                <label><input type="radio" name="pain_since" value="3 à 12 mois"><span>3 à 12 mois</span></label>
                <label><input type="radio" name="pain_since" value="Plus d'un an"><span>Plus d'un an</span></label>
              </div>
            </fieldset>
          </div>

          <!-- ÉTAPE 2 — Votre entreprise -->
          <div class="wizard-step" data-wizard-step data-step-title="Votre entreprise">
            <p class="wizard-q">Parlez-nous de votre entreprise.</p>
            <p class="wizard-help">C'est ce qui nous permet de préparer des exemples de votre secteur.</p>
            <div class="field full">
              <label for="at-sector">Votre secteur d'activité *</label>
              <select id="at-sector" name="sector" required>
                <option value="">Choisissez votre secteur…</option>
                <option value="Commerce">Commerce</option>
                <option value="Distribution">Distribution</option>
                <option value="Services">Services</option>
                <option value="Santé">Santé</option>
                <option value="Éducation">Éducation</option>
                <option value="Industrie">Industrie</option>
                <option value="Autre">Autre</option>
              </select>
            </div>
            <fieldset class="field full wizard-fieldset" style="margin-top:22px">
              <legend class="field-legend">Combien d'employés&nbsp;? *</legend>
              <div class="field-radio-group">
                <label><input type="radio" name="company_size" value="1 à 9 employés" required><span>1 à 9 employés</span></label>
                <label><input type="radio" name="company_size" value="10 à 49 employés"><span>10 à 49 employés</span></label>
                <label><input type="radio" name="company_size" value="50 à 100 employés"><span>50 à 100 employés</span></label>
                <label><input type="radio" name="company_size" value="Plus de 100 employés"><span>Plus de 100 employés</span></label>
              </div>
            </fieldset>
            <fieldset class="field full wizard-fieldset" style="margin-top:22px">
              <legend class="field-legend">Votre rôle dans l'entreprise&nbsp;? *</legend>
              <div class="field-radio-group">
                <label><input type="radio" name="role" value="Dirigeant·e" required><span>Dirigeant·e</span></label>
                <label><input type="radio" name="role" value="Associé·e"><span>Associé·e</span></label>
                <label><input type="radio" name="role" value="Responsable marketing ou ventes"><span>Responsable marketing ou ventes</span></label>
                <label><input type="radio" name="role" value="Autre"><span>Autre</span></label>
              </div>
            </fieldset>
          </div>

          <!-- ÉTAPE 3 — Votre expérience & votre budget -->
          <div class="wizard-step" data-wizard-step data-step-title="Expérience &amp; budget">
            <p class="wizard-q">Où en êtes-vous avec le digital&nbsp;?</p>
            <p class="wizard-help">Aucune mauvaise réponse — beaucoup de dirigeants viennent après une déception.</p>
            <fieldset class="field full wizard-fieldset">
              <legend class="field-legend">Avez-vous déjà investi dans le digital ou l'IA&nbsp;? *</legend>
              <div class="field-radio-group">
                <label><input type="radio" name="past_invest" value="Oui, sans résultats convaincants" required><span>Oui, sans résultats convaincants</span></label>
                <label><input type="radio" name="past_invest" value="Oui, avec des résultats"><span>Oui, avec des résultats</span></label>
                <label><input type="radio" name="past_invest" value="Pas encore"><span>Pas encore</span></label>
              </div>
            </fieldset>
            <fieldset class="field full wizard-fieldset" style="margin-top:22px">
              <legend class="field-legend">Budget envisagé cette année pour le digital et l'IA&nbsp;? *</legend>
              <div class="field-radio-group">
                <label><input type="radio" name="budget" value="Moins de 500 000 FCFA" required><span>Moins de 500 000 FCFA</span></label>
                <label><input type="radio" name="budget" value="500 000 à 1 000 000 FCFA"><span>500 000 à 1 000 000 FCFA</span></label>
                <label><input type="radio" name="budget" value="1 à 5 millions FCFA"><span>1 à 5 millions FCFA</span></label>
                <label><input type="radio" name="budget" value="Plus de 5 millions FCFA"><span>Plus de 5 millions FCFA</span></label>
                <label><input type="radio" name="budget" value="À définir ensemble"><span>À définir ensemble</span></label>
              </div>
            </fieldset>
          </div>

          <!-- ÉTAPE 4 — Votre rendez-vous -->
          <div class="wizard-step" data-wizard-step data-step-title="Votre rendez-vous">
