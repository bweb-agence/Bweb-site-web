<style>
  .moyens-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: clamp(20px, 3vw, 30px); }
  .moyens-head h2 { margin-top: 12px; }
  .moyens-nav { display: none; gap: 10px; }
  @media (min-width: 760px) { .moyens-nav { display: flex; } }
  .moyens-nav button { width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center; cursor: pointer;
    background: var(--c-white); border: 1px solid var(--c-border); color: var(--c-ink); box-shadow: var(--shadow-sm);
    transition: transform .18s var(--ease), box-shadow .18s var(--ease), color .18s, border-color .18s; }
  .moyens-nav button:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); color: var(--c-blue); border-color: color-mix(in srgb, var(--c-blue) 35%, var(--c-border)); }
  .moyens-nav button:disabled { opacity: .38; cursor: default; transform: none; box-shadow: var(--shadow-sm); color: var(--c-ink); border-color: var(--c-border); }
  .moyens-nav svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }

  .moyens-railwrap { position: relative; }
  .moyens-railwrap::before, .moyens-railwrap::after { content: ""; position: absolute; top: 0; bottom: 16px; width: 30px; z-index: 2; pointer-events: none; }
  .moyens-railwrap::before { left: 0; background: linear-gradient(90deg, var(--bg), transparent); }
  .moyens-railwrap::after { right: 0; background: linear-gradient(270deg, var(--bg), transparent); }

  .moyens-rail { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    padding: 10px 2px 18px; scrollbar-width: none; -webkit-overflow-scrolling: touch; cursor: grab; }
  .moyens-rail::-webkit-scrollbar { display: none; }
  .moyens-rail.is-dragging { cursor: grabbing; scroll-behavior: auto; scroll-snap-type: none; user-select: none; }
  .moyens-rail.is-dragging .tb-tile { pointer-events: none; }
  @media (prefers-reduced-motion: reduce) { .moyens-rail { scroll-behavior: auto; } }
  .moyens-rail .tb-tile { flex: 0 0 auto; width: clamp(214px, 76vw, 246px); scroll-snap-align: start; }

  .moyens-track { height: 4px; border-radius: 4px; background: var(--c-border); margin: 6px 2px 0; overflow: hidden; }
  .moyens-thumb { height: 100%; border-radius: 4px; background: var(--c-blue); width: 30%; }
</style>

<script>
  (() => {
    const rail = document.getElementById("moyens-rail");
    const thumb = document.getElementById("moyens-thumb");
    const prev = document.getElementById("moyens-prev");
    const next = document.getElementById("moyens-next");
    if (!rail) return;
    const step = () => { const c = rail.querySelector(".tb-tile"); return c ? c.getBoundingClientRect().width + 16 : 246; };
    prev && prev.addEventListener("click", () => rail.scrollBy({ left: -step() * 2, behavior: "smooth" }));
    next && next.addEventListener("click", () => rail.scrollBy({ left: step() * 2, behavior: "smooth" }));
    function update() {
      const max = rail.scrollWidth - rail.clientWidth;
      const ratio = rail.clientWidth / rail.scrollWidth;
      const w = Math.max(12, ratio * 100);
      thumb.style.width = w + "%";
      const p = max > 0 ? rail.scrollLeft / max : 0;
      thumb.style.marginLeft = (p * (100 - w)) + "%";
      if (prev) prev.disabled = rail.scrollLeft < 4;
      if (next) next.disabled = rail.scrollLeft > max - 4;
    }
    rail.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();

    // Glisser-déposer à la souris/stylet pour faire défiler (le tactile garde le scroll natif)
    let down = false, startX = 0, startScroll = 0;
    rail.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "touch") return;
      down = true; startX = e.clientX; startScroll = rail.scrollLeft;
      rail.classList.add("is-dragging");
      try { rail.setPointerCapture(e.pointerId); } catch (_) {}
    });
    rail.addEventListener("pointermove", (e) => {
      if (!down) return;
      rail.scrollLeft = startScroll - (e.clientX - startX);
    });
    function endDrag(e) {
      if (!down) return;
      down = false;
      rail.classList.remove("is-dragging"); // restaure le snap -> alignement au relâcher
      try { rail.releasePointerCapture(e.pointerId); } catch (_) {}
    }
    rail.addEventListener("pointerup", endDrag);
    rail.addEventListener("pointercancel", endDrag);
    rail.addEventListener("dragstart", (e) => e.preventDefault());
  })();
</script>

