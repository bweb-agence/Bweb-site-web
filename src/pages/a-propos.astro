---
import { existsSync } from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import IllusApropos from "../components/illus/IllusApropos.astro";
import TeamAvatar from "../components/TeamAvatar.astro";
import "../styles/formations.css";

// Photos d'équipe : dépose le fichier dans public/images/ au nom indiqué,
// il est utilisé automatiquement dès qu'il existe (sinon on retombe sur les initiales).
function teamPhoto(filename: string) {
  const src = `/images/${filename}`;
  return { src, exists: existsSync(path.join(process.cwd(), "public", src)) };
}
const godwin = teamPhoto("godwin-soola.png");
const opsManager = teamPhoto("ops-manager.png");
const mediaBuyer = teamPhoto("media-buyer.png");
const closerSenior = teamPhoto("closer-senior.png");
const sdrCloser2 = teamPhoto("sdr-closer2.png");
---

<BaseLayout title="À propos — Cabinet conseil, formation & IA | Bweb" description="Bweb est un cabinet de conseil, de formation et d'accompagnement en IA et nouvelles technologies, fondé par Godwin Soola pour faire avancer les entreprises." breadcrumbs={[{ name: "Accueil", path: "/" }, { name: "À propos", path: "/a-propos" }]}>
<section class="page-hero" data-nav-section="À propos">
  <div class="mesh-bg"></div>
  <div class="grid-lines"></div>
  <div class="sparkle" style="top:110px;left:5%;width:24px;height:24px" data-hero-in>
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 6.4L20 10l-6.2 1.6L12 18l-1.8-6.4L4 10l6.2-1.6z"/></svg>
  </div>
  <div class="dot-accent" style="top:65%;right:8%" data-hero-in></div>
  <div class="container">
    <div class="breadcrumb"><a href="/">Accueil</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
      <span>À propos</span>
    </div>
    <div class="page-hero-grid">
      <div class="text-white" data-hero-in>
        <h1>Le digital au service de votre croissance.</h1>
        <p class="lead">Bweb est un cabinet de conseil, de formation et d'accompagnement qui aide les entreprises à intégrer l'IA et les nouvelles technologies dans leur quotidien.</p>
      </div>
      <div class="visual" data-hero-in>
        <IllusApropos />
      </div>
    </div>
  </div>
</section>

<div class="ticker-band">
  <div class="marquee-track">
    <span class="ticker-item"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 6.4L20 10l-6.2 1.6L12 18l-1.8-6.4L4 10l6.2-1.6z"/></svg>Stratégie IA</span>
    <span class="ticker-item"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 6.4L20 10l-6.2 1.6L12 18l-1.8-6.4L4 10l6.2-1.6z"/></svg>Diagnostic digital</span>
    <span class="ticker-item"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 6.4L20 10l-6.2 1.6L12 18l-1.8-6.4L4 10l6.2-1.6z"/></svg>Formation IA</span>
    <span class="ticker-item"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 6.4L20 10l-6.2 1.6L12 18l-1.8-6.4L4 10l6.2-1.6z"/></svg>Automatisation</span>
    <span class="ticker-item"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 6.4L20 10l-6.2 1.6L12 18l-1.8-6.4L4 10l6.2-1.6z"/></svg>Décision &amp; data</span>
    <span class="ticker-item"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 6.4L20 10l-6.2 1.6L12 18l-1.8-6.4L4 10l6.2-1.6z"/></svg>Accompagnement</span>
    <span class="ticker-item"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 6.4L20 10l-6.2 1.6L12 18l-1.8-6.4L4 10l6.2-1.6z"/></svg>Productivité</span>
  </div>
</div>

<!-- ===== Presentation / histoire ===== -->
<section class="section" data-nav-section="Notre histoire">
  <div class="container">
    <div class="split-block">
      <div class="reveal">
        <div class="eyebrow">Présentation</div>
        <h2>Le fondateur</h2>
        <p class="lead" style="margin:20px 0 24px">Bweb Agence est portée par <strong style="color:var(--c-navy)">Godwin Soola</strong>, expert en marketing digital et fondateur de l'agence. Convaincu que le numérique doit avant tout servir des résultats concrets, il a conçu Bweb Agence comme une structure de conseil, de formation et d'exécution — capable d'accompagner un entrepreneur individuel comme une organisation structurée.</p>
        <p>Depuis sa création, l'agence a fait le choix d'une approche à la fois pédagogique et opérationnelle : comprendre le contexte de chaque client, transmettre les compétences, puis construire les outils qui font réellement la différence.</p>
      </div>
      <div class="visual reveal" data-delay=".15">
        <div class="card" style="padding:0;overflow:hidden">
          {godwin.exists ? (
            <img src={godwin.src} alt="Godwin Soola" style="width:100%;display:block;aspect-ratio:1/1;object-fit:cover" />
          ) : (
            <div style="background:var(--g-navy);padding:48px 32px 0;text-align:center">
              <span class="avatar-badge" style="width:96px;height:96px;font-size:1.9rem;margin:0 auto 20px;background:#fff;color:var(--c-navy)">GS</span>
            </div>
          )}
          <div style="background:var(--g-navy);padding:24px 32px;text-align:center">
            <h3 class="text-white" style="margin-bottom:4px">Godwin Soola</h3>
            <p style="color:rgba(255,255,255,.7);font-size:.9rem">Expert en marketing digital &amp; Fondateur de Bweb Agence</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== Mission / Vision ===== -->
<section class="section section-gray" data-nav-section="Mission &amp; vision">
  <div class="container">
    <div class="grid grid-2" data-stagger>
      <div class="card" style="background:var(--g-navy);border-color:transparent">
        <div class="icon-tile" style="background:rgba(255,255,255,.1);color:var(--c-yellow)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r=".6" fill="currentColor" stroke="none"/></svg>
        </div>
        <h3 class="text-white margin-bottom_small">Notre mission</h3>
        <p class="text-reveal on-dark" style="font-size:1.1rem">Rendre l'IA et le digital accessibles à toute entreprise qui veut avancer pas seulement aux grandes structures. Nous accompagnons nos clients avec méthode, proximité et résultats mesurables, du premier diagnostic jusqu'à l'autonomie totale de leurs équipes.</p>
      </div>
      <div class="card">
        <div class="icon-tile">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
        </div>
        <h3 class="margin-bottom_small">Notre vision</h3>
        <p>Dans dix ans, nous voulons avoir contribué à faire émerger une génération d'entrepreneurs et de dirigeants africains qui utilisent l'IA et le digital comme des leviers naturels de performance pas comme des sujets réservés aux experts.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===== Valeurs ===== -->
<section class="section" data-nav-section="Nos valeurs">
  <div class="container">
    <div class="section-head center reveal">
      <div class="eyebrow" style="justify-content:center">Ce qui nous guide</div>
      <h2>Nos valeurs</h2>
      <p class="lead" style="margin-top:16px">Chaque projet Bweb est guidé par des principes non négociables. Ce sont eux qui définissent notre façon de travailler, de communiquer et d'accompagner.</p>
    </div>
    <div class="tb-bento" data-stagger>
      <article class="tb-tile" style="--c:#1f6ced">
        <span class="tb-num">01</span>
        <span class="tb-ic"><svg viewBox="0 0 24 24"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.5.4.8 1 .8 1.6v.5h5.4v-.5c0-.6.3-1.2.8-1.6A6 6 0 0 0 12 3z"/></svg></span>
        <h3>Innovation</h3>
        <p>Explorer sans cesse de nouvelles façons de résoudre les problèmes de nos clients.</p>
      </article>
      <article class="tb-tile" style="--c:#7b5cff">
        <span class="tb-num">02</span>
        <span class="tb-ic"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 19a5.6 5.6 0 0 1 11 0"/><circle cx="17" cy="9" r="2.6"/><path d="M15 13.5c2.4.4 4 2 4 5.5"/></svg></span>
        <h3>Proximité</h3>
        <p>Rester à l'écoute et accessible, à chaque étape de l'accompagnement.</p>
      </article>
      <article class="tb-tile" style="--c:#ec4899">
        <span class="tb-num">03</span>
        <span class="tb-ic"><svg viewBox="0 0 24 24"><path d="M2 9l10-5 10 5-10 5L2 9z"/><path d="M6 11.5V16c0 1.5 3 3 6 3s6-1.5 6-3v-4.5"/></svg></span>
        <h3>Pédagogie</h3>
        <p>Transmettre les compétences pour rendre nos clients autonomes.</p>
      </article>
      <article class="tb-tile" style="--c:#f59e0b">
        <span class="tb-num">04</span>
        <span class="tb-ic"><svg viewBox="0 0 24 24"><polygon points="12 2.5 14.9 8.6 21.5 9.4 16.7 13.9 18 20.5 12 17.2 6 20.5 7.3 13.9 2.5 9.4 9.1 8.6"/></svg></span>
        <h3>Excellence</h3>
        <p>Viser un niveau de qualité élevé dans chaque livrable.</p>
      </article>
      <article class="tb-tile" style="--c:#0ea5a3">
        <span class="tb-num">05</span>
        <span class="tb-ic"><svg viewBox="0 0 24 24"><path d="M4 16c6-10 12-12 16-12-1 4-3 9-9 12-2 1-5 1-7 0z"/><path d="M4 20l4-4"/></svg></span>
        <h3>Simplicité</h3>
        <p>Proposer des outils simples à comprendre et à utiliser au quotidien.</p>
      </article>
      <article class="tb-tile" style="--c:#1fb663">
        <span class="tb-num">06</span>
        <span class="tb-ic"><svg viewBox="0 0 24 24"><path d="M4 17l6-6 4 4 6-7"/><path d="M15 8h5v5"/></svg></span>
        <h3>Résultats</h3>
        <p>Chaque action est pensée pour produire un impact mesurable.</p>
      </article>
      <article class="tb-tile" style="--c:#06b6d4">
        <span class="tb-num">07</span>
        <span class="tb-ic"><svg viewBox="0 0 24 24"><path d="M12 20s-7-4.5-9.5-9C.7 7.4 2.3 4 5.7 4c2 0 3.3 1.1 4.3 2.4C11 5.1 12.3 4 14.3 4c3.4 0 5 3.4 3.2 7-2.5 4.5-9.5 9-9.5 9z"/></svg></span>
        <h3>Engagement</h3>
        <p>Nous restons présents avant, pendant et après chaque projet.</p>
      </article>
    </div>
  </div>
</section>

<!-- ===== Equipe ===== -->
<section class="section section-cream" data-nav-section="Équipe">
  <div class="container">
    <div class="section-head center reveal">
      <div class="eyebrow" style="justify-content:center">L'équipe</div>
      <h2>Une équipe structurée, multidisciplinaire et disponible.</h2>
      <p class="placeholder-note" style="margin-top:24px;text-align:left">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="13"/><line x1="12" y1="16.5" x2="12" y2="16.5"/></svg>
        Organisation de l'équipe par pôle de responsabilité — noms et photos des membres restants à venir.
      </p>
    </div>

    <div class="team-org">
      <div class="team-tier">
        <div class="team-tier__label">Direction</div>
        <div class="team-org__pair reveal">
          <div class="team-card card">
            <span class="avatar-badge">{godwin.exists ? (
              <button type="button" class="avatar-badge__zoom" data-lightbox-src={godwin.src} data-lightbox-alt="Godwin Soola">
                <img src={godwin.src} alt="Godwin Soola" />
              </button>
            ) : "GS"}</span>
            <h4>Godwin Soola</h4>
            <div class="role">CEO &amp; Fondateur</div>
            <p>Pilote la vision, la stratégie et incarne la marque Bweb Agence.</p>
          </div>
          <div class="team-org__connector team-org__connector--h" aria-hidden="true"></div>
          <div class="team-card card">
            <TeamAvatar photo={opsManager} name="Désiré Yobouet" />
            <h4>Désiré Yobouet</h4>
            <div class="role">Ops Manager · Chef d'orchestre</div>
            <p>Coordonne les six pôles de l'équipe et pilote l'exécution au quotidien.</p>
          </div>
        </div>
      </div>

      <div class="team-org__connector" aria-hidden="true"></div>

      <div class="team-tier">
        <div class="team-tier__label">Pôles opérationnels</div>
        <div class="grid grid-3" data-stagger>
          <div class="team-card card">
            <TeamAvatar photo={mediaBuyer} name="Davy Affo" />
            <h4>Davy Affo</h4>
            <div class="role">Media Buyer · Acquisition payante</div>
            <p>Pilote les campagnes Meta, le tracking et le budget publicitaire.</p>
          </div>
          <div class="team-card card">
            <TeamAvatar photo={closerSenior} name="Laure Kalo" />
            <h4>Laure Kalo</h4>
            <div class="role">Closer Senior · Ventes haute valeur</div>
            <p>Conclut les ventes à forte valeur et supervise le SDR.</p>
          </div>
          <div class="team-card card">
            <TeamAvatar photo={sdrCloser2} name="N'drin Jemima" />
            <h4>N'drin Jemima</h4>
            <div class="role">SDR / Closer #2 · Qualification &amp; mid-ticket</div>
            <p>Qualifie les leads entrants et conclut les ventes mid-ticket. Supervisé par le Closer Senior.</p>
          </div>
          <div class="team-card card">
            <span class="avatar-badge is-placeholder">?</span>
            <h4>Content Creator</h4>
            <div class="role is-placeholder">Production visuelle</div>
            <p>Produit les vidéos, visuels et contenus de la marque.</p>
          </div>
          <div class="team-card card">
            <span class="avatar-badge is-placeholder">?</span>
            <h4>Content Creator #2</h4>
            <div class="role is-placeholder">Production visuelle</div>
            <p>Produit les vidéos, visuels et contenus de la marque.</p>
          </div>
          <div class="team-card card">
            <span class="avatar-badge is-placeholder">?</span>
            <h4>Tech Manager</h4>
            <div class="role is-placeholder">Systèmes &amp; automation</div>
            <p>Construit les funnels, automatisations et intégrations techniques.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== Moyens operationnels ===== -->
<section class="section" data-nav-section="Nos moyens">
  <div class="container">
    <div class="section-head center reveal">
      <div class="eyebrow" style="justify-content:center">Nos moyens</div>
      <h2>Les ressources mobilisées pour exécuter vos projets.</h2>
    </div>
    <div class="grid-4-col collapse_tablet" data-stagger>
      <div class="audience-pill"><div class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 19a5.6 5.6 0 0 1 11 0"/><circle cx="17" cy="9" r="2.6"/></svg></div><span>Équipe multidisciplinaire</span></div>
      <div class="audience-pill"><div class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="M8 15l2.5-3 2 2L16 9"/></svg></div><span>Outils de création</span></div>
      <div class="audience-pill"><div class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="6" y="6" width="12" height="12" rx="2"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg></div><span>Solutions d'automatisation</span></div>
      <div class="audience-pill"><div class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3.5" y="5" width="17" height="16" rx="2"/><line x1="3.5" y1="10" x2="20.5" y2="10"/></svg></div><span>Gestion de projet</span></div>
      <div class="audience-pill"><div class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M2 9l10-5 10 5-10 5L2 9z"/><path d="M6 11.5V16c0 1.5 3 3 6 3s6-1.5 6-3v-4.5"/></svg></div><span>Plateformes de formation</span></div>
      <div class="audience-pill"><div class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 20s-7-4.5-9.5-9C.7 7.4 2.3 4 5.7 4c2 0 3.3 1.1 4.3 2.4C11 5.1 12.3 4 14.3 4c3.4 0 5 3.4 3.2 7-2.5 4.5-9.5 9-9.5 9z"/></svg></div><span>Partenaires &amp; experts</span></div>
      <div class="audience-pill"><div class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="18" height="13" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg></div><span>Matériel informatique &amp; audiovisuel</span></div>
      <div class="audience-pill"><div class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><line x1="3" y1="12" x2="21" y2="12"/><path d="M12 3c2.5 2.6 4 5.8 4 9s-1.5 6.4-4 9c-2.5-2.6-4-5.8-4-9s1.5-6.4 4-9z"/></svg></div><span>Connaissance du terrain africain</span></div>
    </div>
  </div>
</section>

<!-- ===== STATEMENT ===== -->
<section class="section-dark text-center" style="overflow:hidden;padding:clamp(56px,6vw,90px) 0 clamp(120px,11vw,170px)">
  <div class="mesh-bg"></div>
  <div class="container">
    <div class="stack-text reveal-scale" style="color:#fff">
      <span class="solid display-huge">Bâtissons ensemble.</span>
      <span class="ghost display-huge" aria-hidden="true">Bâtissons ensemble.</span>
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="section" data-nav-section="Contact">
  <div class="container">
    <div class="cta-band reveal-scale">
      <div class="mesh-bg"></div>
      <div class="grid-lines"></div>
      <div style="position:relative;z-index:2">
        <h2 class="text-white">Envie de travailler avec nous ?</h2>
        <p class="lead text-white">Parlons de votre projet et voyons comment Bweb Agence peut vous accompagner.</p>
        <div class="hero-actions">
          <a href="/devis" class="btn btn-warm">Demander un devis</a>
          <a href="/contact" class="btn btn-outline-light">Nous contacter</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== Lightbox photo équipe ===== -->
<div class="photo-lightbox" id="photo-lightbox" role="dialog" aria-modal="true" aria-label="Photo agrandie">
  <button type="button" class="photo-lightbox__close" aria-label="Fermer">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
  </button>
  <img class="photo-lightbox__img" src="" alt="" />
</div>
</BaseLayout>

<script>
  import { initTeamLightbox } from "../scripts/teamLightbox";
  initTeamLightbox();
</script>
