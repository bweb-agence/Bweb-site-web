<style>
  .mv-tabs { display: flex; gap: 10px; flex-wrap: wrap; margin: 22px 0 20px; }
  .mv-tab { padding: 11px 22px; border-radius: var(--radius-pill); border: 1.5px solid var(--c-border); background: #fff; color: var(--c-gray-600); font-weight: 700; font-size: .88rem; cursor: pointer; transition: background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease); }
  .mv-tab:hover { border-color: var(--c-blue); color: var(--c-blue); }
  .mv-tab.is-active { background: var(--c-navy); border-color: var(--c-navy); color: #fff; }
  .mv-panels { position: relative; min-height: 8em; }
  .mv-statement { transition: opacity var(--dur-slow) var(--ease), transform var(--dur-slow) var(--ease); }
  .mv-statement.is-out { opacity: 0; transform: translateY(10px); }
  .mv-photo-slot { transition: transform var(--dur-slow) var(--ease), box-shadow var(--dur-slow) var(--ease); }
  .mv-photo-slot:hover { transform: translateY(-6px) scale(1.015); box-shadow: var(--shadow-md); }
  .mv-photo--portrait { object-position: 30% 12%; }
  /* :where(img) en base.css force display:block — sans ce garde-fou, [hidden]
     ne masque pas l'image inactive et les deux photos du slot se superposent. */
  .mv-photo[hidden] { display: none; }
</style>

<script>
  (() => {
    const tabs = document.querySelectorAll(".mv-tab");
    const panels = document.querySelectorAll("[data-mv-panel]");
    const photos = document.querySelectorAll("[data-mv-photo]");
    if (!tabs.length) return;
    const FADE_MS = 600; // doit rester aligné avec --dur-slow (voir <style> ci-dessus)

    // Fondu séquentiel (sortie puis entrée) sur un groupe d'éléments partageant
    // le même attribut de données (peut contenir plusieurs paires, ex. les 2 photos).
    function crossfade(group, attr, target) {
      const toHide = Array.from(group).filter((el) => !el.hidden && el.dataset[attr] !== target);
      const toShow = Array.from(group).filter((el) => el.hidden && el.dataset[attr] === target);
      if (!toShow.length) return;
      toHide.forEach((el) => el.classList.add("is-out"));
      setTimeout(() => {
        toHide.forEach((el) => { el.hidden = true; el.classList.remove("is-out"); });
        toShow.forEach((el) => {
          el.hidden = false;
          el.classList.add("is-out");
          requestAnimationFrame(() => requestAnimationFrame(() => el.classList.remove("is-out")));
        });
      }, FADE_MS);
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        if (tab.classList.contains("is-active")) return;
        const target = tab.dataset.mvTab;
        tabs.forEach((t) => {
          const active = t === tab;
          t.classList.toggle("is-active", active);
          t.setAttribute("aria-selected", String(active));
          t.tabIndex = active ? 0 : -1;
        });
        crossfade(panels, "mvPanel", target);
        crossfade(photos, "mvPhoto", target);
      });
    });
  })();
</script>

