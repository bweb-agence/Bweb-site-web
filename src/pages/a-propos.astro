---
import { existsSync } from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import IllusApropos from "../components/illus/IllusApropos.astro";
import TeamAvatar from "../components/TeamAvatar.astro";
import "../styles/formations.css";

// Photos d'équipe : dépose le fichier dans public/images/ au nom indiqué,
// il est utilisé automatiquement dès qu'il existe (sinon on retombe sur les initiales).
function teamPhoto(filename: string) {
  const src = `/images/${filename}`;
  return { src, exists: existsSync(path.join(process.cwd(), "public", src)) };
}
const godwin = teamPhoto("godwin-soola.webp");
const opsManager = teamPhoto("ops-manager.webp");
const mediaBuyer = teamPhoto("media-buyer.webp");
const closerSenior = teamPhoto("closer-senior.webp");
const contentCreator2 = teamPhoto("content-creator-2.webp");
const techManager = teamPhoto("tech-manager.webp");
const contentCreator = teamPhoto("content-creator.webp");
const sdrCloser2 = teamPhoto("sdr-closer2.webp");
