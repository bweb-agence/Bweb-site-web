---
import "@fontsource-variable/sora";
import "@fontsource-variable/plus-jakarta-sans";
/* Les deux fichiers de police sont importés en tant qu'URL pour pouvoir les
   PRÉCHARGER. Sans ça le navigateur ne les découvre qu'après avoir téléchargé
   et analysé la feuille de styles qui les déclare : mesuré en production, les
   polices ne démarraient qu'à 1 174 ms alors que le document était là depuis
   540 ms. Le texte reste donc invisible ou en police de repli pendant tout ce
   temps. `?url` rend le chemin haché produit par la construction — jamais
   écrire ce chemin à la main, il change à chaque déploiement. */
import soraWoff2 from "@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url";
import jakartaWoff2 from "@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import { site, contact } from "../config/site";
import "../styles/charte.css";
import MetaPixel from "../components/MetaPixel.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /* Type Open Graph : "website" par défaut, "article" pour un article de blog. */
  ogType?: string;
  /* N'émet le bloc JSON-LD Organization + WebSite QUE sur les pages qui
     l'activent (l'accueil). Une seule entité faisant autorité pour le site. */
  organization?: boolean;
  /* Fil d'Ariane (BreadcrumbList JSON-LD). Chaque item : { name, path }. */
  breadcrumbs?: { name: string; path: string }[];
  /* Données structurées additionnelles propres à la page (JSON-LD). */
  schemas?: Record<string, any>[];
  /* Masque le bouton WhatsApp flottant (ex. pages de présentation de formation
     où un CTA collant occupe déjà le bas de l'écran ; WhatsApp reste dans la navbar). */
  hideWhatsApp?: boolean;
  /* Mode « focus CRO » : header et footer réduits à la marque, sans aucun lien
     de navigation. Réservé aux landings de vente (parcours, offres). */
  bareChrome?: boolean;
  /* Typographie de la charte (Garnett + Akkurat). Active par défaut sur tout le
     site ; les tunnels de vente (`bareChrome`) restent sur Sora + Jakarta, dont
     les maquettes ont été dessinées et testées. Ce drapeau permet de forcer
     l'un ou l'autre au cas par cas. */
  charteTypo?: boolean;
  /* Masque la bannière de consentement. Sur une landing de vente ou une page
     d'inscription, elle s'ouvre au-dessus du CTA au moment précis où le
     visiteur décide — et le fait décider d'autre chose. Par défaut, les pages
     en `bareChrome` (les landings) la masquent ; les pages du site la gardent.
     Le bouton « Gérer les cookies » du pied de page reste disponible partout,
     et l'onglet reste accessible aux pages classiques. */
  hideCookieBanner?: boolean;
}

const {
  title, description = site.description, image = site.ogImage, noindex = false,
  ogType = "website", organization = false, breadcrumbs, schemas = [], hideWhatsApp = false,
  bareChrome = false, hideCookieBanner = bareChrome, charteTypo = !bareChrome,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href.replace(/\/$/, "") || site.url;
const ogImageUrl = new URL(image, site.url).href;

// TODO (contenu à confirmer) : ajouter streetAddress, postalCode et
// openingHoursSpecification quand l'adresse réelle sera validée (audit #2).
const orgLd = {
  "@type": "ProfessionalService",
  "@id": site.url + "#organization",
  name: site.name,
  description: site.description,
  url: site.url,
  email: contact.email,
  telephone: "+" + contact.whatsapp.primary,
  image: ogImageUrl,
  logo: new URL("/images/favicon.svg", site.url).href,
  address: {
    "@type": "PostalAddress",
    addressLocality: contact.address.city,
    addressCountry: "CI",
  },
  areaServed: ["Côte d'Ivoire", "Afrique"],
  sameAs: [contact.social.facebook, contact.social.instagram, contact.social.linkedin].filter(Boolean),
};
// Accueil : graphe Organization + WebSite (entités racines réutilisables via @id).
const orgGraph = {
  "@context": "https://schema.org",
  "@graph": [
    orgLd,
    {
      "@type": "WebSite",
      "@id": site.url + "#website",
      url: site.url,
      name: site.name,
      inLanguage: "fr-FR",
      publisher: { "@id": site.url + "#organization" },
    },
  ],
};
const breadcrumbLd = breadcrumbs?.length
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs.map((b, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: b.name,
        item: new URL(b.path, site.url).href.replace(/\/$/, "") || site.url,
      })),
    }
  : null;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />

    {/* Avant tout le reste : ces deux fichiers dessinent le titre et le corps
        de texte de chaque page. `crossorigin` est OBLIGATOIRE même en
        same-origin — une police se charge en mode anonyme, et sans cet
        attribut le navigateur télécharge le fichier DEUX fois. */}
    <link rel="preload" href={soraWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jakartaWoff2} as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    {charteTypo && (
      <>
        {/* Les deux coupes du premier écran : sans préchargement, le texte
            s'affiche d'abord dans la police de repli puis saute (`swap`). */}
        <link rel="preload" href="/fonts/Garnett-Medium.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/Akkurat-Regular.woff2" as="font" type="font/woff2" crossorigin />
      </>
    )}

    <!-- Google tag (gtag.js) — Google Analytics. is:inline = rendu verbatim (script tiers). -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-6WX1PX6W3E" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-6WX1PX6W3E');
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#020B50" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {organization && <script type="application/ld+json" set:html={JSON.stringify(orgGraph)} is:inline />}
    {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} is:inline />}
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} is:inline />)}

    <!-- Balises additionnelles propres à une page (ex. JSON-LD Event). -->
    {/* Pixel Meta — tout le site. Les pages n'ont rien à déclarer ; celles qui
        émettent un événement propre trouvent `fbq` déjà chargé. */}
    <MetaPixel />

    <slot name="head" />

    <!-- Gating motion : masque les révélations AVANT le 1er paint uniquement
         si le JS est actif ET que l'utilisateur ne réduit pas les animations.
         Failsafe : si le bundle ne démarre pas, on ré-affiche tout. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        try {
          if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
            d.classList.add("js-anim");
            setTimeout(function () {
              if (!window.__bwebReady) d.classList.remove("js-anim");
            }, 3000);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class:list={[charteTypo && "charte"]} data-sans-banniere-cookies={hideCookieBanner ? "" : undefined}>
    <a href="#main" class="skip-link">Aller au contenu</a>
    <Header bare={bareChrome} />
    <main id="main">
      <slot />
    </main>
    <Footer bare={bareChrome} />
    {!hideWhatsApp && <WhatsAppFloat />}
    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>
