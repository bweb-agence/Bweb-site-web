---
export const prerender = false;

import "@fontsource-variable/sora";
import "@fontsource-variable/plus-jakarta-sans";
import "../styles/tokens.css";
import "../styles/starwind.css";
import "../styles/admin.css";

interface Props {
  title: string;
  active?: "dashboard" | "articles" | "formations" | "sessions" | "reservations" | "clients" | "campagnes" | "emails" | "avis" | "themes";
}
const { title, active } = Astro.props;

// Menu latéral groupé (Ventes / Catalogue / Contenu). `badge` = compteur « à
// relancer » rempli côté client. Le 1er groupe (sans label) reste en tête.
const navGroups = [
  { label: null, items: [
    { key: "dashboard", href: "/admin", label: "Tableau de bord", icon: '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>' },
  ] },
  { label: "Ventes", items: [
    { key: "reservations", href: "/admin/reservations", label: "Réservations", badge: "reservations", icon: '<path d="M4 6h16v12H4z"/><path d="M4 10h16"/>' },
    { key: "clients", href: "/admin/clients", label: "Clients", badge: "clients", icon: '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 19a5.6 5.6 0 0 1 11 0"/><path d="M16 5.5a3 3 0 0 1 0 5.5M22 19a6 6 0 0 0-4-5.6"/>' },
    { key: "campagnes", href: "/admin/campagnes", label: "Campagnes", icon: '<path d="M3 8l9 5 9-5"/><path d="M3 8v9a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8l-9-5z"/>' },
    { key: "emails", href: "/admin/emails", label: "E-mails", icon: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 8 9 5 9-5"/>' },
  ] },
  { label: "Catalogue", items: [
    { key: "sessions", href: "/admin/sessions", label: "Sessions", icon: '<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/>' },
    { key: "formations", href: "/admin/formations", label: "Formations", icon: '<path d="M2 7l10-4 10 4-10 4z"/><path d="M6 12v5c3 2 9 2 12 0v-5"/>' },
    { key: "themes", href: "/admin/themes", label: "Thèmes", icon: '<path d="M12 2l3 3-7 7-3-3z"/><path d="M2 22l4-1 9-9-3-3-9 9z"/><circle cx="17.5" cy="6.5" r="2.5"/>' },
  ] },
  { label: "Contenu", items: [
    { key: "articles", href: "/admin/articles", label: "Articles", icon: '<path d="M4 4h16v16H4z"/><path d="M8 8h8M8 12h8M8 16h5"/>' },
    { key: "avis", href: "/admin/avis", label: "Avis", icon: '<path d="M12 2l2.9 6 6.6.6-5 4.3 1.5 6.5L12 16l-6 3.4 1.5-6.5-5-4.3 6.6-.6z"/>' },
  ] },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Admin Bweb Agence</title>
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
  </head>
  <body class="admin-body" data-active={active}>
    <div class="admin-loading" id="admin-loading">
      <div style="text-align:center"><div class="spin"></div>Vérification de l'accès…</div>
    </div>

    <div class="admin-shell" data-admin hidden>
      <div class="admin-side-overlay" id="admin-side-overlay"></div>
      <aside class="admin-side" id="admin-side">
        <a href="/admin" class="brand"><span class="m">B</span> Admin</a>
        <nav>
          {navGroups.map((group) => (
            <>
              {group.label && <div class="navlbl">{group.label}</div>}
              {group.items.map((item) => (
                <a href={item.href} class={`item ${active === item.key ? "on" : ""}`}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={item.icon} />
                  <span class="lbl">{item.label}</span>
                  {item.badge && <span class="badge" data-navbadge={item.badge} title="Nouveautés depuis votre dernière visite" hidden></span>}
                </a>
              ))}
            </>
          ))}
        </nav>
        <div class="side-foot">
          <button type="button" class="admin-logout" id="admin-logout">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5M21 12H9"/></svg>
            Se déconnecter
          </button>
        </div>
      </aside>

      <div class="admin-main">
        <header class="admin-topbar">
          <button type="button" class="admin-burger" id="admin-burger" aria-label="Ouvrir le menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
          </button>
          <h1>{title}</h1>
          <span class="admin-user"><span class="av" data-user-initials>—</span><span class="admin-user-email" data-user-email>…</span></span>
        </header>
        <div class="admin-content">
          <slot />
        </div>
      </div>
    </div>

    <script>
      import { supabaseBrowser } from "../lib/supabaseBrowser";

      // Défense en profondeur : le back-office n'utilise jamais le smooth-scroll
      // (Lenis) — marque explicitement les tiroirs comme « défilement natif » pour
      // que, même si Lenis était présent, il ne capte pas la molette (le tiroir doit
      // défiler en interne, pas le fond). Couvre toutes les pages admin à tiroir.
      document.querySelectorAll(".a-drawer, .a-drawer-body").forEach((el) => el.setAttribute("data-lenis-prevent", ""));

      // Filet anti-blocage : si la vérification n'aboutit pas, on propose de recharger
      // plutôt que de laisser un spinner infini.
      const failsafe = setTimeout(() => {
        const el = document.getElementById("admin-loading");
        if (el && !el.hasAttribute("hidden")) {
          el.innerHTML =
            '<div style="text-align:center;max-width:340px;padding:0 16px">' +
            '<p style="color:var(--c-gray-700);font-weight:600;margin-bottom:14px">La vérification de la session prend trop de temps.</p>' +
            '<button id="admin-reload" style="padding:11px 20px;border:0;border-radius:10px;background:var(--c-blue);color:#fff;font-weight:700;cursor:pointer">Recharger la page</button>' +
            '<p style="color:var(--c-gray-500);font-size:.8rem;margin-top:12px">Si le problème persiste, faites un rafraîchissement forcé (Ctrl/Cmd + Shift + R).</p></div>';
          document.getElementById("admin-reload")?.addEventListener("click", () => location.reload());
        }
      }, 7000);

      (async () => {
        try {
          const { data: { session } } = await supabaseBrowser.auth.getSession();
          if (!session) {
            location.replace("/admin/connexion?next=" + encodeURIComponent(location.pathname));
            return;
          }
          // Vérifie l'appartenance à l'allowlist admin (défense en profondeur ; la RLS protège déjà les données)
          const { data: isAdmin, error } = await supabaseBrowser.rpc("is_admin");
          if (error) throw error;
          if (!isAdmin) {
            await supabaseBrowser.auth.signOut();
            location.replace("/admin/connexion?err=forbidden");
            return;
          }
          const email = session.user.email || "";
          const emailEl = document.querySelector("[data-user-email]");
          const initEl = document.querySelector("[data-user-initials]");
          if (emailEl) emailEl.textContent = email;
          if (initEl) initEl.textContent = email.slice(0, 2).toUpperCase();
          document.getElementById("admin-loading")?.setAttribute("hidden", "");
          document.querySelector("[data-admin]")?.removeAttribute("hidden");
          window.dispatchEvent(new CustomEvent("admin-ready"));

          // Badges de NOUVEAUTÉS du menu : nombre de réservations / clients arrivés
          // depuis la dernière visite de la page. Le compteur se remet à 0 quand on
          // ouvre la page concernée (horodatage « vu » mémorisé en local, par admin).
          (async () => {
            try {
              const SEEN = { reservations: "bweb_seen_reservations", clients: "bweb_seen_clients" };
              const activeKey = document.body.dataset.active || "";
              const seen = (k: string) => Number(localStorage.getItem(k) || 0);
              const { data: bk } = await supabaseBrowser
                .from("bookings").select("email,created_at").order("created_at", { ascending: false });
              const list = bk || [];
              const nowMs = Date.now();

              // Nouvelles réservations depuis la dernière visite de /admin/reservations.
              const newResa = list.filter((b: any) => +new Date(b.created_at) > seen(SEEN.reservations)).length;
              // Nouveaux clients = e-mails dont la 1re réservation est postérieure à la dernière visite de /admin/clients.
              const firstByEmail = new Map<string, number>();
              for (const b of list) {
                const e = (b.email || "").toLowerCase(); if (!e) continue;
                const t = +new Date(b.created_at);
                if (!firstByEmail.has(e) || t < firstByEmail.get(e)!) firstByEmail.set(e, t);
              }
              const newClients = [...firstByEmail.values()].filter((t) => t > seen(SEEN.clients)).length;

              const setBadge = (key: string, n: number) => {
                const el = document.querySelector(`[data-navbadge="${key}"]`);
                if (el && n > 0) { el.textContent = n > 99 ? "99+" : String(n); el.removeAttribute("hidden"); }
                else if (el) el.setAttribute("hidden", "");
              };
              // Sur la page concernée : on considère les nouveautés comme vues → badge à 0 + horodatage màj.
              setBadge("reservations", activeKey === "reservations" ? 0 : newResa);
              setBadge("clients", activeKey === "clients" ? 0 : newClients);
              if (activeKey === "reservations") localStorage.setItem(SEEN.reservations, String(nowMs));
              if (activeKey === "clients") localStorage.setItem(SEEN.clients, String(nowMs));
            } catch { /* silencieux : le menu marche sans badge */ }
          })();

          document.getElementById("admin-logout")?.addEventListener("click", async () => {
            await supabaseBrowser.auth.signOut();
            location.replace("/admin/connexion");
          });

          // Menu latéral mobile (off-canvas)
          const side = document.getElementById("admin-side");
          const overlay = document.getElementById("admin-side-overlay");
          const openSide = (o: boolean) => { side?.classList.toggle("open", o); overlay?.classList.toggle("open", o); };
          document.getElementById("admin-burger")?.addEventListener("click", () => openSide(!side?.classList.contains("open")));
          overlay?.addEventListener("click", () => openSide(false));
          side?.querySelectorAll("nav a").forEach((a) => a.addEventListener("click", () => openSide(false)));
        } catch (e) {
          console.error("[admin] erreur de vérification de session", e);
          location.replace("/admin/connexion?err=session");
        }
      })();
    </script>
  </body>
</html>
